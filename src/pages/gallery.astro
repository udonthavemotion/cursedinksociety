---
import Layout from '../layouts/Layout.astro';

const title = "Gallery — Cursed Ink Society Portfolio";
const description = "Browse our extensive portfolio of tattoo artwork. See examples of traditional, realism, fine line, Japanese, and custom tattoo designs by our master artists.";

// Import portfolio data from structured data source
import cisData from '../data/cis.json';

const portfolioData = cisData.portfolio;

// Create categories from portfolio data with "All Work" option
const categories = [
  { id: 'all', name: 'All Work', count: portfolioData.featured.length },
  ...portfolioData.categories.map(cat => ({
    id: cat.slug,
    name: cat.name,
    count: portfolioData.featured.filter(item => item.category === cat.slug).length
  }))
];

// Use featured portfolio items from data
const allPortfolioItems = portfolioData.featured.map((item, index) => ({
  id: index + 1,
  image: item.image,
  title: item.title,
  artist: cisData.artists.find(artist => artist.slug === item.artist)?.name || 'Cursed Ink Society',
  category: item.category,
  alt: item.alt
}));
---

<Layout title={title} description={description}>
  <!-- Hero Section -->
  <section class="gallery-hero">
    <div class="container">
      <div class="hero-content">
        <span class="badge">Our Work</span>
        <h1 class="hero-title shine">Portfolio Gallery</h1>
        <p class="hero-description">
          Explore our extensive collection of tattoo artistry. Each piece represents hours of 
          collaboration, creativity, and craftsmanship between our artists and clients.
        </p>
      </div>
    </div>
  </section>

  <!-- Filter Navigation -->
  <section class="gallery-filters">
    <div class="container">
      <div class="filter-nav">
        {categories.map((category) => (
          <button 
            class={`filter-btn ${category.id === 'all' ? 'filter-btn--active' : ''}`}
            data-filter={category.id}
          >
            {category.name}
            <span class="filter-count">({category.count})</span>
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- Gallery Grid -->
  <section class="gallery-section">
    <div class="container">
      <div class="gallery-grid" id="gallery-grid">
        {allPortfolioItems.map((item) => (
          <article 
            class="gallery-item" 
            data-category={item.category}
            data-item-id={item.id}
          >
            <div class="gallery-image-container">
              <img
                data-src={item.image}
                alt={item.alt || `${item.title} by ${item.artist}`}
                class="gallery-image"
                loading="lazy"
                width="300"
                height="400"
              />
              <div class="image-placeholder">
                <div class="placeholder-shimmer"></div>
              </div>
              <div class="gallery-overlay">
                <div class="gallery-info">
                  <h3 class="gallery-title">{item.title}</h3>
                  <p class="gallery-artist">by {item.artist}</p>
                  <span class="gallery-category">{categories.find(c => c.id === item.category)?.name}</span>
                </div>
                <button class="gallery-view-btn" data-lightbox={item.id}>
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/>
                  </svg>
                  View
                </button>
              </div>
            </div>
          </article>
        ))}
      </div>
      
      <!-- Load More Button -->
      <div class="gallery-load-more">
        <button class="btn btn--outline btn--large" id="load-more-btn">
          Load More Work
        </button>
      </div>
    </div>
  </section>

  <!-- Artist Showcase -->
  <section class="artist-showcase">
    <div class="container">
      <h2 class="section-title">Meet the Artists Behind the Work</h2>
      <div class="artist-preview-grid">
        {cisData.artists.map((artist) => (
          <div class="artist-preview">
            <img src={artist.avatar} alt={`${artist.name} - Professional tattoo artist`} class="artist-avatar" />
            <div class="artist-preview-info">
              <h3>{artist.name}</h3>
              <p>{artist.positioning}</p>
              <a href={`/artists/${artist.slug}`} class="artist-link">View Profile →</a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="gallery-cta">
    <div class="container">
      <div class="cta-content">
        <h2>Ready to Create Your Own Masterpiece?</h2>
        <p>Book a consultation with one of our artists and bring your vision to life.</p>
        <div class="cta-actions">
          <a href="/consultation" class="btn btn--primary btn--large">Book Consultation</a>
          <a href="/artists" class="btn btn--outline btn--large">Meet Our Artists</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Lightbox Modal -->
  <div class="lightbox" id="lightbox">
    <div class="lightbox-backdrop"></div>
    <div class="lightbox-content">
      <button class="lightbox-close" id="lightbox-close">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
          <path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
        </svg>
      </button>
      <img class="lightbox-image" id="lightbox-image" alt="" />
      <div class="lightbox-info" id="lightbox-info">
        <h3 class="lightbox-title"></h3>
        <p class="lightbox-artist"></p>
        <span class="lightbox-category"></span>
      </div>
    </div>
  </div>
</Layout>

<script>
  // Gallery filtering and lightbox functionality
  class GalleryManager {
    constructor() {
      this.filterButtons = document.querySelectorAll('.filter-btn');
      this.galleryItems = document.querySelectorAll('.gallery-item');
      this.viewButtons = document.querySelectorAll('.gallery-view-btn');
      this.lightbox = document.getElementById('lightbox');
      this.lightboxImage = document.getElementById('lightbox-image');
      this.lightboxInfo = document.getElementById('lightbox-info');
      this.lightboxClose = document.getElementById('lightbox-close');
      this.loadMoreBtn = document.getElementById('load-more-btn');
      
      this.currentFilter = 'all';
      this.visibleItems = 12; // Initially show 12 items
      
      this.init();
    }

    init() {
      // Filter functionality
      this.filterButtons.forEach(btn => {
        btn.addEventListener('click', (e) => this.handleFilter(e));
      });

      // Lightbox functionality
      this.viewButtons.forEach(btn => {
        btn.addEventListener('click', (e) => this.openLightbox(e));
      });

      if (this.lightboxClose) {
        this.lightboxClose.addEventListener('click', () => this.closeLightbox());
      }

      if (this.lightbox) {
        this.lightbox.addEventListener('click', (e) => {
          if (e.target === this.lightbox || e.target.classList.contains('lightbox-backdrop')) {
            this.closeLightbox();
          }
        });
      }

      // Load more functionality
      if (this.loadMoreBtn) {
        this.loadMoreBtn.addEventListener('click', () => this.loadMoreItems());
      }

      // Keyboard navigation
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && this.lightbox.classList.contains('lightbox--open')) {
          this.closeLightbox();
        }
      });

      // Initial load
      this.updateGalleryDisplay();
    }

    handleFilter(e) {
      const filter = e.target.dataset.filter;
      if (!filter) return;

      // Update active button
      this.filterButtons.forEach(btn => btn.classList.remove('filter-btn--active'));
      e.target.classList.add('filter-btn--active');

      // Update current filter
      this.currentFilter = filter;
      this.visibleItems = 12; // Reset visible items

      // Update display
      this.updateGalleryDisplay();
    }

    updateGalleryDisplay() {
      const filteredItems = Array.from(this.galleryItems).filter(item => {
        return this.currentFilter === 'all' || item.dataset.category === this.currentFilter;
      });

      // Hide all items first
      this.galleryItems.forEach(item => {
        item.style.display = 'none';
        item.classList.remove('gallery-item--visible');
      });

      // Show filtered items up to visible limit
      filteredItems.slice(0, this.visibleItems).forEach(item => {
        item.style.display = 'block';
        setTimeout(() => item.classList.add('gallery-item--visible'), 50);
      });

      // Update load more button
      if (this.loadMoreBtn) {
        if (filteredItems.length > this.visibleItems) {
          this.loadMoreBtn.style.display = 'block';
        } else {
          this.loadMoreBtn.style.display = 'none';
        }
      }
    }

    loadMoreItems() {
      this.visibleItems += 12;
      this.updateGalleryDisplay();
    }

    openLightbox(e) {
      e.preventDefault();
      const button = e.currentTarget;
      const galleryItem = button.closest('.gallery-item');
      const image = galleryItem.querySelector('.gallery-image');
      const title = galleryItem.querySelector('.gallery-title').textContent;
      const artist = galleryItem.querySelector('.gallery-artist').textContent;
      const category = galleryItem.querySelector('.gallery-category').textContent;

      // Update lightbox content
      this.lightboxImage.src = image.src;
      this.lightboxImage.alt = image.alt;
      this.lightboxInfo.querySelector('.lightbox-title').textContent = title;
      this.lightboxInfo.querySelector('.lightbox-artist').textContent = artist;
      this.lightboxInfo.querySelector('.lightbox-category').textContent = category;

      // Show lightbox
      this.lightbox.classList.add('lightbox--open');
      document.body.style.overflow = 'hidden';
    }

    closeLightbox() {
      this.lightbox.classList.remove('lightbox--open');
      document.body.style.overflow = '';
    }
  }

    // Enhanced Lazy Loading Manager
  class LazyImageLoader {
    constructor() {
      this.imageObserver = null;
      this.init();
    }

    init() {
      // Use Intersection Observer for better lazy loading
      if ('IntersectionObserver' in window) {
        this.imageObserver = new IntersectionObserver((entries, observer) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              const img = entry.target;
              this.loadImage(img);
              observer.unobserve(img);
            }
          });
        }, {
          rootMargin: '50px 0px',
          threshold: 0.1
        });

        // Observe all gallery images
        document.querySelectorAll('.gallery-image[data-src]').forEach(img => {
          this.imageObserver.observe(img);
        });
      }
    }

    loadImage(img) {
      const src = img.getAttribute('data-src');
      if (src) {
        img.src = src;
        img.classList.add('loaded');
        img.removeAttribute('data-src');
      }
    }
  }

  // Initialize gallery when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      new GalleryManager();
      new LazyImageLoader();
    });
  } else {
    new GalleryManager();
    new LazyImageLoader();
  }
</script>

<style>
  /* Gallery Hero */
  .gallery-hero {
    padding: 8rem 0 4rem;
    text-align: center;
    background: 
      radial-gradient(1000px 600px at 50% 20%, rgba(255, 60, 43, 0.03) 0%, transparent 60%);
  }

  .hero-content {
    max-width: 700px;
    margin: 0 auto;
  }

  .hero-title {
    font-size: clamp(3rem, 6vw, 4.5rem);
    margin: 1rem 0 1.5rem;
    line-height: 1.1;
  }

  .hero-description {
    font-size: 1.2rem;
    line-height: 1.6;
    opacity: 0.9;
    margin: 0;
  }

  /* Gallery Filters */
  .gallery-filters {
    padding: 2rem 0;
    background: var(--bg-glass);
    border-top: var(--border-glass);
    position: sticky;
    top: 80px;
    z-index: 100;
    backdrop-filter: blur(10px);
  }

  .filter-nav {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .filter-btn {
    background: transparent;
    border: var(--border-glass);
    color: var(--ink);
    padding: 0.75rem 1.5rem;
    border-radius: 25px;
    font-size: 0.9rem;
    font-weight: 500;
    cursor: pointer;
    transition: var(--transition-smooth);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    backdrop-filter: blur(5px);
  }

  .filter-btn:hover,
  .filter-btn--active {
    background: var(--accent0);
    border-color: var(--accent0);
    color: var(--bg0);
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(255, 60, 43, 0.3);
  }

  .filter-count {
    font-size: 0.8rem;
    opacity: 0.8;
  }

  /* Gallery Section */
  .gallery-section {
    padding: 4rem 0;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 2rem;
    margin-bottom: 4rem;
  }

  /* Enhanced grid for larger screens */
  @media (min-width: 1200px) {
    .gallery-grid {
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 2.5rem;
    }
  }

  .gallery-item {
    opacity: 0;
    transform: translateY(20px);
    transition: all 0.5s ease;
  }

  .gallery-item--visible {
    opacity: 1;
    transform: translateY(0);
  }

  .gallery-image-container {
    position: relative;
    aspect-ratio: 3/4;
    border-radius: 16px;
    overflow: hidden;
    background: var(--bg-glass);
    border: var(--border-glass);
  }

  .image-placeholder {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, var(--bg-glass) 25%, rgba(255, 255, 255, 0.1) 50%, var(--bg-glass) 75%);
    background-size: 200% 100%;
    animation: shimmer 2s infinite;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .placeholder-shimmer {
    width: 40px;
    height: 40px;
    border: 3px solid var(--accent0);
    border-top-color: transparent;
    border-radius: 50%;
    animation: spin 1s linear infinite;
  }

  @keyframes shimmer {
    0% { background-position: 200% 0; }
    100% { background-position: -200% 0; }
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .gallery-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: var(--transition-smooth);
    opacity: 0;
  }

  .gallery-image.loaded {
    opacity: 1;
  }

  .gallery-image.loaded + .image-placeholder {
    display: none;
  }

  .gallery-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(11, 11, 13, 0.9) 0%,
      rgba(11, 11, 13, 0.6) 40%,
      transparent 70%
    );
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 1.5rem;
    opacity: 0;
    transition: var(--transition-smooth);
  }

  .gallery-item:hover .gallery-overlay {
    opacity: 1;
  }

  .gallery-item:hover .gallery-image {
    transform: scale(1.05);
  }

  .gallery-info {
    margin-bottom: 1rem;
  }

  .gallery-title {
    font-size: 1.1rem;
    font-weight: 600;
    margin: 0 0 0.25rem;
    color: var(--ink);
  }

  .gallery-artist {
    font-size: 0.9rem;
    opacity: 0.8;
    margin: 0 0 0.5rem;
  }

  .gallery-category {
    font-size: 0.75rem;
    color: var(--accent0);
    background: rgba(255, 60, 43, 0.2);
    padding: 0.25rem 0.5rem;
    border-radius: 12px;
    text-transform: uppercase;
    font-weight: 600;
    letter-spacing: 0.05em;
  }

  .gallery-view-btn {
    background: var(--accent0);
    border: none;
    color: var(--bg0);
    padding: 0.75rem 1rem;
    border-radius: 8px;
    font-weight: 600;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    transition: var(--transition-smooth);
    align-self: flex-start;
  }

  .gallery-view-btn:hover {
    background: var(--accent1);
    transform: translateY(-2px);
  }

  .gallery-load-more {
    text-align: center;
  }

  .btn--large {
    padding: 1rem 2rem;
    font-size: 1rem;
  }

  /* Artist Showcase */
  .artist-showcase {
    padding: 6rem 0;
    background: var(--bg-glass);
    border-top: var(--border-glass);
  }

  .section-title {
    text-align: center;
    font-size: clamp(2rem, 4vw, 2.5rem);
    margin: 0 0 3rem;
    color: var(--ink);
    text-shadow: var(--glow-subtle);
  }

  .artist-preview-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
  }

  .artist-preview {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.5rem;
    background: rgba(255, 255, 255, 0.03);
    border: var(--border-glass);
    border-radius: 16px;
    backdrop-filter: blur(5px);
    transition: var(--transition-smooth);
  }

  .artist-preview:hover {
    transform: translateY(-4px);
    border-color: rgba(255, 60, 43, 0.2);
  }

  .artist-avatar {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid rgba(255, 60, 43, 0.2);
  }

  .artist-preview-info h3 {
    font-size: 1rem;
    margin: 0 0 0.25rem;
    color: var(--ink);
  }

  .artist-preview-info p {
    font-size: 0.85rem;
    opacity: 0.8;
    margin: 0 0 0.5rem;
  }

  .artist-link {
    color: var(--accent0);
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 600;
    transition: var(--transition-smooth);
  }

  .artist-link:hover {
    text-shadow: var(--glow-subtle);
  }

  /* Gallery CTA */
  .gallery-cta {
    padding: 6rem 0;
    text-align: center;
    background: 
      radial-gradient(1000px 600px at 50% 50%, rgba(255, 60, 43, 0.05) 0%, transparent 60%);
  }

  .gallery-cta .cta-content h2 {
    font-size: clamp(2rem, 4vw, 2.5rem);
    margin: 0 0 1rem;
    color: var(--ink);
    text-shadow: var(--glow-subtle);
  }

  .gallery-cta .cta-content p {
    font-size: 1.2rem;
    opacity: 0.9;
    margin: 0 0 2.5rem;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .cta-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  /* Lightbox */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 2000;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s ease;
  }

  .lightbox--open {
    opacity: 1;
    visibility: visible;
  }

  .lightbox-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.9);
    backdrop-filter: blur(5px);
  }

  .lightbox-content {
    position: relative;
    max-width: 90vw;
    max-height: 90vh;
    display: flex;
    flex-direction: column;
    background: var(--bg0);
    border-radius: 16px;
    overflow: hidden;
    border: var(--border-glass);
    transform: scale(0.9);
    transition: transform 0.3s ease;
  }

  .lightbox--open .lightbox-content {
    transform: scale(1);
  }

  .lightbox-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    width: 44px;
    height: 44px;
    background: rgba(0, 0, 0, 0.7);
    border: none;
    border-radius: 50%;
    color: var(--ink);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10;
    transition: var(--transition-smooth);
  }

  .lightbox-close:hover {
    background: var(--accent0);
    color: var(--bg0);
  }

  .lightbox-image {
    max-width: 100%;
    max-height: 70vh;
    object-fit: contain;
  }

  .lightbox-info {
    padding: 2rem;
    text-align: center;
  }

  .lightbox-title {
    font-size: 1.3rem;
    margin: 0 0 0.5rem;
    color: var(--ink);
  }

  .lightbox-artist {
    font-size: 1rem;
    opacity: 0.8;
    margin: 0 0 1rem;
  }

  .lightbox-category {
    font-size: 0.85rem;
    color: var(--accent0);
    background: rgba(255, 60, 43, 0.2);
    padding: 0.5rem 1rem;
    border-radius: 20px;
    text-transform: uppercase;
    font-weight: 600;
  }

  /* Mobile Optimizations */
  @media (max-width: 768px) {
    .gallery-hero {
      padding: 6rem 0 3rem;
    }

    .gallery-filters {
      padding: 1.5rem 0;
      position: static;
    }

    .filter-nav {
      gap: 0.5rem;
    }

    .filter-btn {
      padding: 0.6rem 1rem;
      font-size: 0.8rem;
    }

    .gallery-grid {
      grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
      gap: 1rem;
    }

    .gallery-item {
      opacity: 1; /* Remove animation delay on mobile for better UX */
      transform: none;
    }

    .gallery-overlay {
      opacity: 1;
      background: linear-gradient(
        to top,
        rgba(11, 11, 13, 0.95) 0%,
        rgba(11, 11, 13, 0.7) 50%,
        transparent 80%
      );
    }

    .artist-preview-grid {
      grid-template-columns: 1fr;
    }

    .cta-actions {
      flex-direction: column;
      align-items: center;
    }

    .cta-actions .btn {
      width: 100%;
      max-width: 300px;
    }

    .lightbox-content {
      max-width: 95vw;
      max-height: 95vh;
    }

    .lightbox-info {
      padding: 1.5rem 1rem;
    }
  }

  /* Reduced motion support */
  @media (prefers-reduced-motion: reduce) {
    .gallery-item {
      opacity: 1;
      transform: none;
    }

    .gallery-item:hover .gallery-image {
      transform: none;
    }

    .artist-preview:hover {
      transform: none;
    }
  }
</style>
