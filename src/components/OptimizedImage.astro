---
export interface Props {
  src: string;
  alt: string;
  width?: number;
  height?: number;
  sizes?: string;
  loading?: 'lazy' | 'eager';
  class?: string;
  priority?: boolean;
  placeholder?: 'blur' | 'empty';
  quality?: number;
  format?: 'webp' | 'avif' | 'original';
}

const {
  src,
  alt,
  width,
  height,
  sizes = '(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 33vw',
  loading = 'lazy',
  class: className = '',
  priority = false,
  placeholder = 'empty',
  quality = 80,
  format = 'webp'
} = Astro.props;

// Convert relative paths to absolute for optimization
const imageSrc = src.startsWith('/') ? src : `/${src}`;

// Generate responsive srcset for different formats and sizes
const generateSrcSet = (baseSrc: string, width?: number, fmt = 'webp') => {
  if (!width) return '';
  
  const sizes = [width * 0.5, width, width * 1.5, width * 2];
  return sizes
    .map(size => `${baseSrc}?w=${Math.round(size)}&f=${fmt}&q=${quality} ${size}w`)
    .join(', ');
};

// Generate fallback srcset for older browsers
const generateFallbackSrcSet = (baseSrc: string, width?: number) => {
  if (!width) return '';
  
  const sizes = [width * 0.5, width, width * 1.5, width * 2];
  return sizes
    .map(size => `${baseSrc}?w=${Math.round(size)}&q=${quality} ${size}w`)
    .join(', ');
};

// Determine loading strategy
const imageLoading = priority ? 'eager' : loading;
const fetchPriority = priority ? 'high' : 'auto';

// Generate optimized URLs
const webpSrc = `${imageSrc}?f=webp&q=${quality}`;
const avifSrc = `${imageSrc}?f=avif&q=${quality}`;
const fallbackSrc = `${imageSrc}?q=${quality}`;

// Generate responsive srcsets
const webpSrcSet = generateSrcSet(imageSrc, width, 'webp');
const avifSrcSet = generateSrcSet(imageSrc, width, 'avif');
const fallbackSrcSet = generateFallbackSrcSet(imageSrc, width);
---

<picture class={className}>
  <!-- AVIF format for modern browsers (best compression) -->
  {avifSrcSet && (
    <source
      srcset={avifSrcSet}
      sizes={sizes}
      type="image/avif"
    />
  )}
  
  <!-- WebP format for most modern browsers -->
  {webpSrcSet && (
    <source
      srcset={webpSrcSet}
      sizes={sizes}
      type="image/webp"
    />
  )}
  
  <!-- Fallback for older browsers -->
  <img
    src={fallbackSrc}
    srcset={fallbackSrcSet || undefined}
    alt={alt}
    width={width}
    height={height}
    sizes={sizes}
    loading={imageLoading}
    fetchpriority={fetchPriority}
    class={`transition-opacity duration-300`}
    style={placeholder === 'blur' ? 'filter: blur(5px); transition: filter 0.3s ease;' : ''}
    onload={placeholder === 'blur' ? 'this.style.filter="none"' : undefined}
    onerror="this.style.display='none'"
  />
</picture>

<style>
  picture {
    display: block;
    max-width: 100%;
    height: auto;
  }
  
  picture img {
    max-width: 100%;
    height: auto;
    display: block;
  }
  
  /* Lazy loading placeholder */
  picture img[loading="lazy"] {
    background-color: #f3f4f6;
    background-image: linear-gradient(45deg, #f9fafb 25%, transparent 25%), 
                      linear-gradient(-45deg, #f9fafb 25%, transparent 25%), 
                      linear-gradient(45deg, transparent 75%, #f9fafb 75%), 
                      linear-gradient(-45deg, transparent 75%, #f9fafb 75%);
    background-size: 20px 20px;
    background-position: 0 0, 0 10px, 10px -10px, -10px 0px;
    animation: loading 2s linear infinite;
  }
  
  @keyframes loading {
    0% { background-position: 0 0, 0 10px, 10px -10px, -10px 0px; }
    100% { background-position: 20px 20px, 20px 30px, 30px 10px, 10px 20px; }
  }
  
  /* Remove loading animation when image loads */
  picture img[loading="lazy"]:not([src=""]) {
    animation: none;
    background: none;
  }
  
  /* Aspect ratio preservation */
  picture {
    contain: layout style paint;
  }
  
  /* Performance optimizations */
  picture img {
    will-change: auto;
    transform: translateZ(0); /* Hardware acceleration */
  }
</style>