---
// Dynamic artist profile page
import Layout from '../../layouts/Layout.astro';
import ArtistPortfolioGallery from '../../components/ArtistPortfolioGallery.astro';
import MangaPortfolioGallery from '../../components/MangaPortfolioGallery.astro';
import MicroInteractions from '../../components/MicroInteractions.astro';
import CodyWorkCard from '../../components/CodyWorkCard.astro';
import ImageModal from '../../components/ImageModal.astro';
import { slugify } from '../../lib/slugify';
import normalizedCISData from '../../lib/cisData';

export async function getStaticPaths() {
  return normalizedCISData.artists.map((artist) => ({
    params: { slug: artist.slug },
    props: { artist },
  }));
}

const { slug: rawSlug } = Astro.params;

// If no slug is provided, redirect to the main artists page
if (!rawSlug || rawSlug.trim() === "") {
  return Astro.redirect("/artists", 301);
}

const safeSlug = slugify(rawSlug);

// If the incoming slug differs dramatically (too long or invalid),
// perform a 301 to the normalized version to self-heal old/bad links.
if (rawSlug !== safeSlug) {
  return Astro.redirect(`/artists/${safeSlug}`, 301);
}

// Load artist by safeSlug
const artist = normalizedCISData.artists.find(a => a.slug === safeSlug);

// 404 if not found
if (!artist) {
  return new Response("Artist not found", { status: 404 });
}
const title = `${artist.name} — Tattoo Artist | Cursed Ink Society`;
const description = `${artist.positioning} Specializing in ${artist.specialties.join(', ')}. View ${artist.name}'s portfolio and book a consultation at Cursed Ink Society.`;

  // Check if this is Cody's page for special manga layout
  const isCodyPage = artist.slug === 'cody-crochet';
  const isMangaMode = isCodyPage; // Use manga layout for Cody

  // Check if this is Seth's page for special Affliction layout
  const isSethPage = artist.slug === 'seth-wood';

  // Check if this is Ashley's page for special watercolor layout
  const isAshleyPage = artist.slug === 'ashley-wood';

  // Check if this is Trent's page for special electric apprentice layout
  const isTrentPage = artist.slug === 'trent';

  // Check if this is Anthony's page for special black and white gothic layout
  const isAnthonyPage = artist.slug === 'anthony-boudreaux';

  // Ashley's watercolor data - Watercolor & Color Specialist
  const ashleyData = {
    stats: { creativity: 100, technique: 100, colorMastery: 100 },
    title: "Watercolor & Color Specialist",
    subtitle: "Delicate Touch • Soft-Handed Artistry • Watercolor & Kawaii Specialist",
    creed: "Precision artistry through watercolor mastery",
    badges: ["Watercolor Specialist", "Color Master", "Fine Line Artist", "5yr Veteran"],
    rates: "$150-200/hr • $120 min"
  };

  // Cody's RPG-style data - Anime & Color Specialist
const codyData = {
  stats: { hp: 98, atk: 92, def: 95, ink: 100 },
  moves: [
    { title: "Anime Awakening", desc: "Brings anime characters to life with vibrant colors and emotional depth." },
    { title: "Color Symphony", desc: "Creates stunning color palettes that tell stories through hue and saturation." },
    { title: "Manga Precision", desc: "Captures the intricate linework and shading of manga illustrations." },
    { title: "Character Genesis", desc: "Breathes life into beloved characters with photorealistic anime styling." }
  ],
  badges: ["Anime Master", "Color Virtuoso", "Manga Artist", "Character Creator", "11yr Veteran"],
  rates: "$180-220/hr • $150 min"
};

  // Seth's Mortal Kombat-style data - Elder Warrior & Traditional Specialist
  const sethData = {
    stats: { health: 95, strength: 98, defense: 97, fatality: 100 },
    badges: ["Elder Warrior", "Traditional Champion", "25yr Kombatant", "Fatality Master", "Linework Legend"],
    rates: "$200-280/hr • $180 min",
    creed: "GET OVER HERE!",
    code: "Strength through tradition, power through precision, finish through fatality",
    fightingStyle: "Traditional American Warrior",
    signatureFatality: "Naturalistic Dismemberment",
    victories: "500+ Satisfied Clients"
  };

  // Trent's Professional Apprentice data - Anime & Neo-Traditional Specialist
  const trentData = {
    title: "Professional Tattoo Apprentice",
    subtitle: "Anime & Neo-Traditional Specialist",
    creed: "Excellence through dedication and precision",
    badges: ["Apprentice", "Anime Specialist", "Neo-Traditional", "Precision Master", "Professional Standard"],
    rates: "$120-160/hr • $100 min",
    code: "Apprentice today, master tomorrow"
  };

  // Anthony's Black & White Gothic data - Black & Grey Realism Master
  const anthonyData = {
    stats: { versatility: 91, craftsmanship: 90, adaptability: 92, precision: 88 },
    title: "Black & Grey Realism Master",
    subtitle: "High Contrast & Texture Detail Specialist",
    creed: "Photorealistic precision through black & grey mastery",
    badges: ["Black & Grey Master", "Realism Specialist", "5yr Veteran", "High Contrast", "Texture Detail"],
    rates: "$160-220/hr • $140 min",
    code: "Master of many styles, specialist in all",
    moves: [
      { title: "Traditional Mastery", desc: "Authentic traditional tattoos with bold lines and timeless appeal." },
      { title: "Custom Design Excellence", desc: "Creates personalized pieces that tell unique stories through custom artistry." },
      { title: "Versatile Craftsmanship", desc: "Seamlessly blends traditional techniques with modern innovations." },
      { title: "Walk-in Specialist", desc: "Welcomes spontaneous consultations with professional precision." }
    ]
  };
---

  <Layout title={title} description={description}>
    <!-- Google Fonts for girly script typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Sacramento:wght@400&family=Great+Vibes:wght@400&family=Poppins:wght@300;400;500;600&family=Cinzel:wght@400;500;600;700;900&display=swap" rel="stylesheet">
    
    <!-- DragonCapes Font for Seth's Page -->
    {isSethPage && <link rel="stylesheet" href="/fonts/dragoncapes.css">}
  
  <!-- Micro Interactions -->
  <MicroInteractions />

  {isTrentPage && (
    <!-- TRENT'S PROFESSIONAL APPRENTICE LAYOUT -->

    <!-- Background Overlay -->
    <div class="background-overlay"></div>

    <!-- Hero Section -->
    <section class="trent-hero">
      <div class="container">
        <div class="trent-hero-content">
          <div class="trent-hero-image">
            <div class="professional-frame">
              <img
                src={artist.avatar}
                alt={`${artist.name} - Professional Tattoo Apprentice`}
                class="trent-avatar"
                loading="lazy"
                width="350"
                height="350"
              />
            </div>
          </div>

          <div class="trent-hero-info">
            <div class="trent-badge">
              <span class="professional-badge">🎯 PROFESSIONAL APPRENTICE</span>
            </div>
            <h1 class="trent-name">{artist.name}</h1>
            <p class="trent-title">{trentData.subtitle}</p>
            <p class="trent-creed">{trentData.creed}</p>
            <div class="trent-location">📍 Houma, LA</div>


            <div class="trent-badges">
              {trentData.badges.map(badge => (
                <span class="trent-badge-item">{badge}</span>
              ))}
            </div>

            <div class="trent-cta-section">
              <a href={artist.cta.url} class="trent-cta-btn">
                <span class="cta-icon">🎯</span>
                <span class="cta-text">{artist.cta.text}</span>
              </a>
              <div class="trent-rates">{trentData.rates}</div>
            </div>
          </div>
        </div>
      </div>
    </section>


    <!-- Portfolio Section -->
    <section class="trent-portfolio">
      <div class="container">
        <ArtistPortfolioGallery images={artist.portfolio} artistName={artist.name} artistSlug={artist.slug} />
      </div>
    </section>

    <!-- Code Section -->
    <section class="trent-code">
      <div class="container">
        <div class="code-block">
          <p class="code-text">{trentData.code}</p>
        </div>
      </div>
    </section>

  )}

  {isAnthonyPage && (
    <!-- ANTHONY'S BLACK & WHITE GOTHIC LAYOUT -->

    <!-- Gothic Background Overlay -->
    <div class="gothic-overlay"></div>

    <!-- Hero Section -->
    <section class="anthony-hero">
      <!-- Video Background -->
      <video
        class="anthony-hero-video"
        autoplay
        muted
        loop
        playsinline
        preload="auto"
        poster="/assets/artists/anthony-boudreaux/anthony profile pic.jpg"
        aria-hidden="true"
      >
        <source src="/assets/1730395-uhd_3840_2160_25fps.mp4" type="video/mp4" />
        <!-- Fallback image -->
        <img
          src="/assets/artists/anthony-boudreaux/anthony profile pic.jpg"
          alt="Anthony Boudreaux - Black & Grey Realism Master"
          class="anthony-hero-fallback"
          loading="eager"
        />
      </video>
      
      <!-- Video Overlay -->
      <div class="anthony-video-overlay"></div>
      
      <div class="container">
        <div class="anthony-hero-content">
          <div class="anthony-hero-image">
            <div class="modern-frame">
              <img
                src={artist.avatar}
                alt={`${artist.name} - ${anthonyData.title}`}
                class="anthony-portrait"
              />
              <div class="red-accent"></div>
            </div>
          </div>
          <div class="anthony-hero-text">
            <h1 class="anthony-name">{artist.name}</h1>
            <p class="anthony-title">{anthonyData.title}</p>
            <p class="anthony-subtitle">{anthonyData.subtitle}</p>
            <p class="anthony-creed">{anthonyData.creed}</p>
            
            <!-- Anthony's Specialties & Investment -->
            <div class="anthony-info-container">
              <div class="anthony-specialties">
                <h4 class="specialties-title">Specialties</h4>
                <div class="specialties-list">
                  {anthonyData.badges.map((badge, index) => (
                    <span class="specialty-item">
                      {badge}{index < anthonyData.badges.length - 1 ? ' • ' : ''}
                    </span>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Portfolio Section -->
    <section class="anthony-portfolio">
      <div class="container">
        <ArtistPortfolioGallery images={artist.portfolio} artistName={artist.name} artistSlug={artist.slug} />
      </div>
    </section>

    <!-- Video Performance Manager for Anthony -->
    <script>
      class AnthonyHeroVideoManager {
        video: HTMLVideoElement | null;
        fallback: HTMLElement | null;

        constructor() {
          this.video = document.querySelector('.anthony-hero-video') as HTMLVideoElement | null;
          this.fallback = document.querySelector('.anthony-hero-fallback') as HTMLElement | null;
          this.init();
        }

        init() {
          if (!this.video) return;

          // Performance optimization: Optimize video for mobile while maintaining quality
          if (this.isMobile()) {
            // Use higher quality settings for modern mobile devices
            this.video.style.opacity = '0.5';
            this.video.style.filter = 'contrast(1.1) brightness(0.9) saturate(1.2)';
          }

          // Handle video loading and errors
          this.video.addEventListener('loadeddata', () => {
            if (this.video) {
              // Set final opacity based on device with better visibility
              this.video.style.opacity = this.isMobile() ? '0.5' : '0.7';

              // Ensure video plays on mobile
              if (this.isMobile()) {
                const playPromise = this.video.play();
                if (playPromise !== undefined) {
                  playPromise.catch(error => {
                    console.warn('Anthony hero video autoplay failed on mobile:', error);
                    // Show fallback image if video fails
                    if (this.fallback) {
                      this.fallback.style.display = 'block';
                    }
                  });
                }
              }
            }
          });

          // Handle video errors gracefully
          this.video.addEventListener('error', (e) => {
            console.warn('Anthony hero video failed to load:', e);
            // Show fallback image
            if (this.fallback) {
              this.fallback.style.display = 'block';
            }
          });

          // Intersection Observer for performance
          if ('IntersectionObserver' in window) {
            const observer = new IntersectionObserver((entries) => {
              entries.forEach(entry => {
                if (entry.isIntersecting && this.video) {
                  // Ensure video is playing when visible
                  const playPromise = this.video.play();
                  if (playPromise !== undefined) {
                    playPromise.catch(() => {
                      // Silently handle autoplay failures
                    });
                  }
                } else if (this.video && !this.isMobile()) {
                  // Pause when not visible (except on mobile to prevent issues)
                  this.video.pause();
                }
              });
            }, { threshold: 0.1 });

            observer.observe(this.video);
          }

          // Handle visibility change for performance
          document.addEventListener('visibilitychange', () => {
            if (this.video) {
              if (document.hidden) {
                this.video.pause();
              } else if (!this.isMobile()) {
                // Only auto-resume on desktop, mobile handles this differently
                const playPromise = this.video.play();
                if (playPromise !== undefined) {
                  playPromise.catch(() => {
                    // Handle autoplay restrictions
                  });
                }
              }
            }
          });

          // Mobile-specific handling
          if (this.isMobile()) {
            // Add touch event to ensure video plays on user interaction
            const handleUserInteraction = () => {
              if (this.video && this.video.paused) {
                const playPromise = this.video.play();
                if (playPromise !== undefined) {
                  playPromise.catch(() => {
                    console.warn('Video play failed after user interaction');
                  });
                }
              }
            };

            // Listen for various touch events
            document.addEventListener('touchstart', handleUserInteraction, { once: true, passive: true });
            document.addEventListener('touchend', handleUserInteraction, { once: true, passive: true });
            document.addEventListener('click', handleUserInteraction, { once: true });
          }
        }

        isMobile(): boolean {
          return window.innerWidth < 768 ||
                 /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);
        }
      }

      // Initialize when DOM is ready
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', () => new AnthonyHeroVideoManager());
      } else {
        new AnthonyHeroVideoManager();
      }
    </script>

  )}

  {isAshleyPage && (
    <!-- ASHLEY'S WATERCOLOR FEMININE LAYOUT -->

    <!-- Watercolor Background Overlay -->
    <div class="watercolor-overlay"></div>

    <!-- Hero Section -->
    <section class="ashley-hero">
      <!-- Video Background -->
      <video
        class="ashley-hero-video"
        autoplay
        muted
        loop
        playsinline
        preload="auto"
        poster="/assets/artists/ashley-wood/ashley-profile-pic.jpg"
        aria-hidden="true"
      >
        <source src="/assets/videos/ashleyxxkarma_1753071396_3681351613176961709_181129474.mp4" type="video/mp4">
        <!-- Fallback image -->
        <img
          src="/assets/artists/ashley-wood/ashley-profile-pic.jpg"
          alt="Ashley Wood - Chromancer Tattoo Artist"
          class="ashley-hero-fallback"
          loading="eager"
        />
      </video>

      <!-- Gradient overlays for text readability -->
      <div class="ashley-video-overlay"></div>
      <div class="ashley-gothic-overlay"></div>

      <div class="container">
        <div class="ashley-hero-content">
          <div class="ashley-hero-image">
            <div class="watercolor-frame">
              <img
                src={artist.avatar}
                alt={`${artist.name} - Chromancer Tattoo Artist`}
                class="ashley-avatar"
                loading="lazy"
                width="350"
                height="350"
              />
            </div>
          </div>

          <div class="ashley-hero-info">
            <div class="ashley-badge">
              <span class="watercolor-badge">🌸 Water Color Specialist</span>
            </div>
            <h1 class="ashley-name">{artist.name}</h1>
            <p class="ashley-title">{ashleyData.subtitle}</p>
            <p class="ashley-creed">{ashleyData.creed}</p>
            <div class="ashley-location">📍 Houma, LA</div>
            <div class="ashley-experience">{artist.experience}</div>

            <!-- Chroma Stats -->
            <div class="chroma-stats">
              <div class="chroma-bar">
                <span class="chroma-label">CREATIVITY</span>
                <div class="chroma-fill">
                  <div class="chroma-value" style={`width: ${ashleyData.stats.creativity}%`}></div>
                </div>
                <span class="chroma-number">{ashleyData.stats.creativity}%</span>
              </div>
              <div class="chroma-bar">
                <span class="chroma-label">TECHNIQUE</span>
                <div class="chroma-fill">
                  <div class="chroma-value" style={`width: ${ashleyData.stats.technique}%`}></div>
                </div>
                <span class="chroma-number">{ashleyData.stats.technique}%</span>
              </div>
              <div class="chroma-bar">
                <span class="chroma-label">COLOR MASTERY</span>
                <div class="chroma-fill">
                  <div class="chroma-value" style={`width: ${ashleyData.stats.colorMastery}%`}></div>
                </div>
                <span class="chroma-number">{ashleyData.stats.colorMastery}%</span>
              </div>
            </div>

            <!-- CTA Buttons -->
            <div class="ashley-ctas">
              <a href={artist.cta.url} class="ashley-btn secondary" target="_blank" rel="noopener">
                <span class="btn-icon">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M7 2h10a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5V7a5 5 0 0 1 5-5zm5 5a5 5 0 1 0 .001 10.001A5 5 0 0 0 12 7zm0 2.2a2.8 2.8 0 1 1 0 5.6 2.8 2.8 0 0 1 0-5.6zM18 6.5a1 1 0 1 0 0 2 1 1 0 0 0 0-2z"/>
                  </svg>
                </span>
                DM on Instagram
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Portfolio Gallery -->
    <section class="ashley-portfolio">
      <div class="container">
        <ArtistPortfolioGallery images={artist.portfolio} artistName={artist.name} artistSlug={artist.slug} />
      </div>
    </section>

    <!-- Video Performance Manager -->
    <script>
      class AshleyHeroVideoManager {
        video: HTMLVideoElement | null;
        fallback: HTMLElement | null;

        constructor() {
          this.video = document.querySelector('.ashley-hero-video') as HTMLVideoElement | null;
          this.fallback = document.querySelector('.ashley-hero-fallback') as HTMLElement | null;
          this.init();
        }

        init() {
          if (!this.video) return;

          // Performance optimization: Optimize video for mobile while maintaining quality
          if (this.isMobile()) {
            // Use higher quality settings for modern mobile devices
            this.video.style.opacity = '0.5';
            this.video.style.filter = 'contrast(1.1) brightness(0.9) saturate(1.2)';
          }

          // Handle video loading and errors
          this.video.addEventListener('loadeddata', () => {
            if (this.video) {
              // Set final opacity based on device with better visibility
              this.video.style.opacity = this.isMobile() ? '0.5' : '0.7';
            }
          });

          this.video.addEventListener('error', () => {
            console.warn('Ashley hero video failed to load, using fallback image');
            if (this.fallback) {
              this.fallback.style.display = 'block';
              this.fallback.style.opacity = '0.4';
            }
          });

          // Pause video when page becomes hidden to save resources
          document.addEventListener('visibilitychange', () => {
            if (this.video) {
              if (document.hidden) {
                this.video.pause();
              } else {
                this.video.play().catch(() => {
                  // Silently handle autoplay failures (common on mobile)
                });
              }
            }
          });

          // Intersection Observer for performance
          if ('IntersectionObserver' in window) {
            const observer = new IntersectionObserver((entries) => {
              entries.forEach(entry => {
                if (entry.isIntersecting && this.video) {
                  this.video.play().catch(() => {
                    // Handle autoplay restrictions
                  });
                } else if (this.video) {
                  this.video.pause();
                }
              });
            }, { threshold: 0.1 });

            observer.observe(this.video);
          }
        }

        isMobile(): boolean {
          return window.innerWidth < 768 ||
                 /Android|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);
        }
      }

      // Initialize video manager when DOM is ready
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', () => new AshleyHeroVideoManager());
      } else {
        new AshleyHeroVideoManager();
      }
    </script>

<style>
  /* Mobile Optimizations for Anthony's Hero Video */
  @media (max-width: 768px) {
    .anthony-hero {
      min-height: 90vh;
      padding: 4rem 0;
    }

    .anthony-hero-video {
      opacity: 0.5;
      filter: contrast(1.1) brightness(0.9) saturate(1.2);
    }

    .anthony-video-overlay {
      background: linear-gradient(135deg,
        rgba(0, 0, 0, 0.7) 0%,
        rgba(0, 0, 0, 0.5) 50%,
        rgba(0, 0, 0, 0.8) 100%);
    }

    .anthony-hero-content {
      grid-template-columns: 1fr;
      gap: 2rem;
      text-align: center;
      padding: 2rem 1rem;
    }

    .anthony-portrait {
      width: 250px;
      height: 300px;
    }

    .modern-frame {
      margin: 0 auto;
    }

    .anthony-name {
      font-size: 2rem;
    }

    .anthony-title {
      font-size: 1.1rem;
    }

    .anthony-subtitle {
      font-size: 1rem;
    }
  }

  @media (max-width: 480px) {
    .anthony-hero {
      padding: 3rem 0;
      min-height: 80vh;
    }

    .anthony-hero-video {
      opacity: 0.4;
      filter: contrast(1.2) brightness(0.85) saturate(1.3);
    }

    .anthony-video-overlay {
      background: linear-gradient(135deg,
        rgba(0, 0, 0, 0.8) 0%,
        rgba(0, 0, 0, 0.6) 50%,
        rgba(0, 0, 0, 0.9) 100%);
    }

    .anthony-name {
      font-size: 1.75rem;
    }

    .anthony-portrait {
      width: 200px;
      height: 250px;
    }
  }

  /* Accessibility - Reduced Motion Support */
  @media (prefers-reduced-motion: reduce) {
    .anthony-hero-video {
      animation: none;
      transition: none;
    }
  }
</style>

  )}

  {isSethPage && (
    <!-- SETH'S ENHANCED TATTOO PORTFOLIO LAYOUT -->
    
    <!-- Import Modern Tattoo Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Oswald:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- Seamless Hero with Integrated Background -->
    <section class="seth-hero-seamless">
      <div class="hero-canvas">
        <!-- Background Image -->
        <div class="hero-bg-layer">
          <img
            src="/assets/artists/seth-wood/image0 (2).jpeg"
