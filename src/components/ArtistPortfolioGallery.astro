</style>

<script>
  class ArtistPortfolioGallery {
    private lightbox: HTMLElement;
    private lightboxImage: HTMLImageElement;
    private lightboxVideo: HTMLVideoElement;
    private lightboxArtist: HTMLElement;
    private lightboxCaption: HTMLElement;
    private currentImages: string[] = [];
    private currentArtist: string = '';
    private currentIndex: number = 0;

    constructor() {
      this.lightbox = document.getElementById('portfolio-lightbox')!;
      this.lightboxImage = document.getElementById('lightbox-image') as HTMLImageElement;
      this.lightboxVideo = document.getElementById('lightbox-video') as HTMLVideoElement;
      this.lightboxArtist = document.getElementById('lightbox-artist')!;
      this.lightboxCaption = document.getElementById('lightbox-caption')!;

      this.init();
    }

    private init() {
      // Initialize lightbox functionality
      this.setupGalleryButtons();
      this.setupLightboxControls();
      this.setupKeyboardNavigation();
    }

    private setupGalleryButtons() {
      document.querySelectorAll('.gallery-zoom-btn').forEach(button => {
        button.addEventListener('click', (e) => {
          e.preventDefault();
          const imageSrc = button.getAttribute('data-image');
          const artistName = button.getAttribute('data-artist');
          if (imageSrc && artistName) {
            this.openLightbox(imageSrc, artistName);
          }
        });
      });
    }

    private setupLightboxControls() {
      // Close lightbox
      document.querySelectorAll('[data-close-lightbox]').forEach(element => {
        element.addEventListener('click', () => this.closeLightbox());
      });

      // Navigation
      const prevBtn = document.querySelector('.lightbox-prev');
      const nextBtn = document.querySelector('.lightbox-next');

      if (prevBtn) {
        prevBtn.addEventListener('click', () => this.navigate(-1));
      }

      if (nextBtn) {
        nextBtn.addEventListener('click', () => this.navigate(1));
      }
    }

    private setupKeyboardNavigation() {
      document.addEventListener('keydown', (e) => {
        if (this.lightbox.getAttribute('aria-hidden') === 'false') {
          switch (e.key) {
            case 'Escape':
              this.closeLightbox();
              break;
            case 'ArrowLeft':
              this.navigate(-1);
              break;
            case 'ArrowRight':
              this.navigate(1);
              break;
          }
        }
      });
    }

    private openLightbox(imageSrc: string, artistName: string) {
      // Find all images from the same gallery
      const galleryItem = document.querySelector(`[data-image="${imageSrc}"]`)?.closest('.gallery-item');
      if (!galleryItem) return;

      const galleryContainer = galleryItem.closest('.artist-portfolio-gallery');
      if (!galleryContainer) return;

      this.currentImages = Array.from(galleryContainer.querySelectorAll('.gallery-image, .gallery-video'))
        .map(media => media.getAttribute('src')!)
        .filter(src => src);

      this.currentArtist = artistName;
      this.currentIndex = this.currentImages.indexOf(imageSrc);

      this.updateLightbox();
      this.lightbox.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    private closeLightbox() {
      // Pause any playing video
      if (!this.lightboxVideo.paused) {
        this.lightboxVideo.pause();
      }
      this.lightbox.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    private navigate(direction: number) {
      if (this.currentImages.length === 0) return;

      this.currentIndex = (this.currentIndex + direction + this.currentImages.length) % this.currentImages.length;
      this.updateLightbox();
    }

    private updateLightbox() {
      if (this.currentImages.length === 0) return;

      const mediaSrc = this.currentImages[this.currentIndex];
      const isVideo = mediaSrc.endsWith('.mp4') || mediaSrc.endsWith('.mov') || mediaSrc.endsWith('.webm');
      
      if (isVideo) {
        this.lightboxImage.style.display = 'none';
        this.lightboxVideo.style.display = 'block';
        this.lightboxVideo.src = mediaSrc;
        this.lightboxVideo.load(); // Reload the video
        // Auto-play the video when it's ready
        this.lightboxVideo.addEventListener('loadeddata', () => {
          this.lightboxVideo.play().catch(e => {
            console.log('Video autoplay prevented:', e);
          });
        }, { once: true });
      } else {
        this.lightboxVideo.style.display = 'none';
        this.lightboxImage.style.display = 'block';
        this.lightboxImage.src = mediaSrc;
        this.lightboxImage.alt = `${this.currentArtist} portfolio piece ${this.currentIndex + 1}`;
      }
      
      this.lightboxArtist.textContent = this.currentArtist;
      this.lightboxCaption.textContent = `Portfolio Piece ${this.currentIndex + 1} of ${this.currentImages.length}`;
    }
  }

  // Initialize when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => new ArtistPortfolioGallery());
  } else {
    new ArtistPortfolioGallery();
  }
</script>
