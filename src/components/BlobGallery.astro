---

<section class="gallery-section">
  <div class="container mx-auto max-w-6xl px-4 md:px-6 py-16">
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-semibold tracking-wide mb-3">Mystical Manifestations</h2>
      <p class="text-gray-400 text-sm uppercase tracking-[0.2em]">Witness the transformation of flesh into sacred art</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {galleryItems.map((item) => (
        <div class="group relative overflow-hidden rounded-lg">
          <img
            src={item.image}
            alt={`${item.title} by ${item.artist}`}
            class="w-full h-64 object-cover transition-transform duration-300 group-hover:scale-105"
            loading="lazy"
            decoding="async"
          />

          <div class="absolute inset-0 bg-black/60 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center">
            <div class="text-center text-white">
              <h3 class="text-lg font-medium mb-1">{item.title}</h3>
              <p class="text-gray-300 text-sm">by {item.artist}</p>
              <span class="inline-block mt-2 px-2 py-1 bg-red-600 text-white text-xs uppercase tracking-wide rounded">
                {item.category}
              </span>
            </div>
          </div>
        </div>
      ))}
    </div>

    <div class="text-center mt-16">
      <a href="/gallery" class="btn">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
          <path d="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z"/>
        </svg>
        Explore Full Gallery
      </a>
    </div>
  </div>
</section>

