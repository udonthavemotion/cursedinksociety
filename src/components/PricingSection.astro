---
/**
 * Pricing Section - Harley Halford Verified Pricing
 * Strict pricing data from verified photo - no modifications
 */
---

<section id="pricing" class="pricing-section" aria-labelledby="pricing-heading">
  <div class="pricing-container">
    <!-- Header -->
    <h2 id="pricing-heading" class="pricing-title">Pricing Guide</h2>
    <p class="pricing-disclaimer">All prices include wound-wash saline aftercare and titanium jewelry</p>
    
    <!-- Minors Policy Notice -->
    <div class="minors-policy-notice">
      <div class="policy-icon" aria-hidden="true">ℹ️</div>
      <div class="policy-content">
        <strong>Minors Policy:</strong> If you're under 18, bring your ID, birth certificate, and a parent with their ID.
      </div>
    </div>
    
    <!-- Pricing Grid -->
    <div class="pricing-grid">
      
      <!-- EAR PIERCINGS -->
      <div class="pricing-category">
        <h3 class="category-heading">Ear Piercings</h3>
        <div class="price-list">
          <div class="price-item">
            <span class="price-name">Single Lobe</span>
            <span class="price-value">$50</span>
          </div>
          <div class="price-item">
            <span class="price-name">Double Lobe</span>
            <span class="price-value">$70</span>
          </div>
          <div class="price-item">
            <span class="price-name">Cartilage (helix, daith, etc.)</span>
            <span class="price-value">$50</span>
          </div>
          <div class="price-item">
            <span class="price-name">Industrial</span>
            <span class="price-value">$60</span>
          </div>
        </div>
      </div>
      
      <!-- NOSE PIERCINGS -->
      <div class="pricing-category">
        <h3 class="category-heading">Nose Piercings</h3>
        <div class="price-list">
          <div class="price-item">
            <span class="price-name">Septum</span>
            <span class="price-value">$50</span>
          </div>
          <div class="price-item">
            <span class="price-name">Nostril</span>
            <span class="price-value">$50</span>
          </div>
        </div>
      </div>
      
      <!-- MOUTH PIERCINGS -->
      <div class="pricing-category">
        <h3 class="category-heading">Mouth Piercings</h3>
        <div class="price-list">
          <div class="price-item">
            <span class="price-name">Single Labret (Medusa, Monroe, Vertical etc.)</span>
            <span class="price-value">$60</span>
          </div>
          <div class="price-item">
            <span class="price-name">Double Labret (Snake/Spider Bites etc.)</span>
            <span class="price-value">$100</span>
          </div>
          <div class="price-item">
            <span class="price-name">Tongue</span>
            <span class="price-value">$60</span>
          </div>
          <div class="price-item">
            <span class="price-name">Smiley</span>
            <span class="price-value">$60</span>
          </div>
          <div class="price-item">
            <span class="price-name">Canine Bites</span>
            <span class="price-value">$140</span>
          </div>
        </div>
      </div>
      
      <!-- BODY PIERCINGS -->
      <div class="pricing-category">
        <h3 class="category-heading">Body Piercings</h3>
        <div class="price-list">
          <div class="price-item">
            <span class="price-name">Navel</span>
            <span class="price-value">$50</span>
          </div>
          <div class="price-item">
            <span class="price-name">Eyebrow</span>
            <span class="price-value">$50</span>
          </div>
          <div class="price-item">
            <span class="price-name">Surface</span>
            <span class="price-value">$100</span>
          </div>
          <div class="price-item">
            <span class="price-name">Single Nipple</span>
            <span class="price-value">$50</span>
            <span class="age-badge">18+ only</span>
          </div>
          <div class="price-item">
            <span class="price-name">Double Nipple</span>
            <span class="price-value">$100</span>
            <span class="age-badge">18+ only</span>
          </div>
          <div class="price-item">
            <span class="price-name">Genitals</span>
            <span class="price-value">$100</span>
            <span class="age-badge">18+ only</span>
          </div>
        </div>
      </div>
      
      <!-- JEWELRY PRICES / SERVICES -->
      <div class="pricing-category">
        <h3 class="category-heading">Jewelry Prices / Services</h3>
        <div class="price-list">
          <div class="price-item">
            <span class="price-name">Single Top / Bottom</span>
            <span class="price-value">$5</span>
          </div>
          <div class="price-item">
            <span class="price-name">Single Piece (20g, 18g or 16g)</span>
            <span class="price-value">$10</span>
          </div>
          <div class="price-item">
            <span class="price-name">Single Navel / Industrial (14g)</span>
            <span class="price-value">$15</span>
          </div>
          <div class="price-item">
            <span class="price-name">Double / Pair (20g, 18g or 16g)</span>
            <span class="price-value">$20</span>
          </div>
          <div class="price-item">
            <span class="price-name">Aftercare Replacement</span>
            <span class="price-value">$10</span>
          </div>
          <div class="price-item">
            <span class="price-name">Jewelry Change with purchase of jewelry</span>
            <span class="price-value">Included</span>
          </div>
          <div class="price-item">
            <span class="price-name">Jewelry Change with outside jewelry</span>
            <span class="price-value">$5</span>
          </div>
        </div>
      </div>
      
    </div>
    
    <!-- Visual Pricing Chart -->
    <div class="pricing-chart-wrapper">
      <h3 class="chart-heading">Complete Pricing Chart</h3>
      <p class="chart-subtitle">Reference guide for all piercing and jewelry pricing</p>
      <div class="pricing-chart-container">
        <img 
          src="/images/piercings/Untitled design (61).png" 
          alt="Harley Halford Complete Piercing Pricing Chart - includes ear, nose, mouth, body piercings and jewelry prices"
          width="1200"
          height="900"
          loading="lazy"
          decoding="async"
          class="pricing-chart-image"
        />
      </div>
    </div>
    
    <!-- Footer Note -->
    <p class="pricing-footer">*Prices subject to change based on anatomy or jewelry upgrades.</p>
  </div>
</section>

<style>
  @import "../styles/tattoo-theme.css";


  .pricing-section {
    padding: clamp(6rem, 12vw, 8rem) 1.5rem;
    background: #0B0B0B;
    position: relative;
  }
  
  .pricing-container {
    max-width: 1200px;
    margin: 0 auto;
    position: relative;
  }
  
  /* Header */
  .pricing-title {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    margin: 0 0 1rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text);
    text-align: center;
  }
  
  .pricing-disclaimer {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #98FB98;
    text-align: center;
    margin: 0 0 1.5rem;
    font-weight: 600;
  }
  
  /* Minors Policy Notice */
  .minors-policy-notice {
    max-width: 700px;
    margin: 0 auto 2.5rem;
    padding: 1rem 1.25rem;
    background: rgba(152, 251, 152, 0.12);
    border: 1px solid rgba(152, 251, 152, 0.4);
    border-radius: 6px;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  
  .policy-icon {
    font-size: 1.25rem;
    flex-shrink: 0;
    filter: drop-shadow(0 0 6px rgba(152, 251, 152, 0.5));
  }
  
  .policy-content {
    color: var(--text);
    font-size: 0.875rem;
    line-height: 1.5;
    text-align: left;
  }
  
  .policy-content strong {
    color: #98FB98;
    font-weight: 600;
  }
  
  /* Age Badge for 18+ Items */
  .age-badge {
    display: inline-block;
    padding: 0.125rem 0.5rem;
    background: rgba(255, 182, 193, 0.2);
    border: 1px solid rgba(255, 182, 193, 0.4);
    border-radius: 3px;
    color: #FFB6C1;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-left: 0.5rem;
  }
  
  .price-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    padding: 0.6rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    gap: 0.5rem;
    transition: background 0.15s ease-out;
  }
  
  /* Pricing Grid */
  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2.5rem;
    margin-bottom: 2.5rem;
  }
  
    @media (max-width: 640px) {
    .pricing-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    
    .minors-policy-notice {
      padding: 0.875rem 1rem;
      gap: 0.625rem;
    }
    
    .policy-content {
      font-size: 0.8125rem;
    }
    
    .age-badge {
      font-size: 0.6875rem;
      padding: 0.125rem 0.375rem;
    }
  }
  
  /* Category */
  .pricing-category {
    display: flex;
    flex-direction: column;
  }
  
  .category-heading {
    font-size: 0.875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text);
    margin: 0 0 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid rgba(155, 92, 246, 0.3);
  }
  
  /* Price List */
  .price-list {
    display: flex;
    flex-direction: column;
  }
  
  .price-item:hover {
    background: rgba(255, 255, 255, 0.02);
  }
  
  .price-item:last-child {
    border-bottom: none;
  }
  
  .price-name {
    font-size: 0.9375rem;
    color: var(--muted);
    line-height: 1.4;
    flex: 1;
  }
  
  .price-value {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--text);
    white-space: nowrap;
    text-align: right;
  }
  
  /* Visual Pricing Chart - Clean Minimal Design */
  .pricing-chart-wrapper {
    margin-top: 5rem;
    padding-top: 4rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }
  
  .chart-heading {
    font-size: clamp(1rem, 2vw, 1.25rem);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--muted);
    text-align: center;
    margin: 0 0 1rem;
  }
  
  .chart-subtitle {
    font-size: 0.8125rem;
    color: var(--muted);
    text-align: center;
    margin: 0 0 3rem;
    letter-spacing: 0.03em;
  }
  
  .pricing-chart-container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0;
    position: relative;
  }
  
  .pricing-chart-image {
    width: 100%;
    height: auto;
    display: block;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  
  .pricing-chart-image:hover {
    transform: translateY(-2px);
    opacity: 0.95;
  }
  
  /* Footer Note */
  .pricing-footer {
    font-size: 0.875rem;
    color: var(--muted);
    text-align: center;
    margin: 2rem 0 0;
    font-style: italic;
  }
  
  /* Responsive */
  @media (max-width: 767px) {
    .pricing-section {
      padding: clamp(4rem, 8vw, 6rem) 1rem;
    }
    
    .pricing-disclaimer {
      font-size: 0.6875rem;
    }
    
    .price-item {
      padding: 0.5rem 0;
      flex-direction: row;
      align-items: baseline;
    }
    
    .price-name {
      font-size: 0.875rem;
    }
    
    .price-value {
      font-size: 0.875rem;
    }
    
    .pricing-chart-wrapper {
      margin-top: 3rem;
      padding-top: 2.5rem;
    }
    
    .chart-heading {
      font-size: 0.9375rem;
      margin-bottom: 0.75rem;
    }
    
    .chart-subtitle {
      font-size: 0.75rem;
      margin-bottom: 2rem;
    }
  }
  
  /* Reduced Motion */
  @media (prefers-reduced-motion: reduce) {
    .price-item,
    .pricing-chart-image {
      transition: none;
    }
    
    .pricing-chart-image:hover {
      transform: none;
      opacity: 1;
    }
  }
</style>

