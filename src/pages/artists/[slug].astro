    font-size: 1.5rem;
    font-weight: 900;
    color: #dc143c;
    text-shadow: 0 0 12px rgba(220, 20, 60, 0.5);
    letter-spacing: 0.02em;
  }

  /* Earned Honors Section */
  .affliction-honors {
    padding: 5rem 0;
    background:
      radial-gradient(400px 200px at 30% 70%, rgba(220, 20, 60, 0.06) 0%, transparent 70%),
      linear-gradient(135deg, #0a0a0c 0%, #1a1a1c 100%);
    position: relative;
  }

  .honors-container {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.5rem;
    margin-bottom: 3rem;
    max-width: 900px;
    margin-left: auto;
    margin-right: auto;
  }

  .honor-pill {
    background: linear-gradient(135deg, rgba(0, 0, 0, 0.7), rgba(0, 0, 0, 0.5));
    border: 3px solid rgba(255, 255, 255, 0.15);
    border-radius: 30px;
    padding: 1rem 2rem;
    backdrop-filter: blur(12px);
    transition: all 0.4s ease;
    opacity: 0;
    transform: scale(0.8) rotate(-5deg);
    animation: honorAppear 0.6s ease forwards;
    cursor: default;
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.08) inset,
      0 6px 16px rgba(0, 0, 0, 0.3);
  }

  @keyframes honorAppear {
    to {
      opacity: 1;
      transform: scale(1) rotate(0deg);
    }
  }

  .honor-pill:hover {
    transform: scale(1.08) rotate(2deg);
    border-color: rgba(220, 20, 60, 0.5);
    box-shadow:
      0 0 0 1px rgba(220, 20, 60, 0.3) inset,
      0 8px 24px rgba(0, 0, 0, 0.4),
      0 0 20px rgba(220, 20, 60, 0.3);
  }

  .honor-text {
    font-size: 1rem;
    font-weight: 700;
    color: #ffffff;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    text-shadow: 0 0 10px rgba(220, 20, 60, 0.3);
  }

  .master-note {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    background: rgba(0, 0, 0, 0.4);
    border: 2px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    padding: 2.5rem;
    max-width: 700px;
    margin: 0 auto;
    backdrop-filter: blur(12px);
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.06) inset;
  }

  .master-icon {
    font-size: 3rem;
    flex-shrink: 0;
    filter: drop-shadow(0 0 12px rgba(220, 20, 60, 0.6));
  }

  .master-text {
    color: rgba(255, 255, 255, 0.9);
    line-height: 1.7;
    margin: 0;
    font-size: 1.1rem;
    font-weight: 500;
    text-align: center;
  }

  /* Gallery Section */
  .affliction-gallery {
    padding: 6rem 0;
    background:
      radial-gradient(600px 400px at 60% 40%, rgba(220, 20, 60, 0.08) 0%, transparent 70%),
      linear-gradient(135deg, #1a1a1c 0%, #0a0a0c 100%);
    position: relative;
  }

  .gallery-subtitle {
    text-align: center;
    font-size: 1.2rem;
    color: rgba(255, 255, 255, 0.7);
    margin: -1.5rem 0 3rem;
    font-style: italic;
    text-shadow: 0 0 8px rgba(220, 20, 60, 0.2);
  }

  .tribal-masonry-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2.5rem;
    margin-bottom: 4rem;
    padding: 0 1rem;
  }

  @media (min-width: 1200px) {
    .tribal-masonry-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 3rem;
    }
  }

  .tribal-masonry-item {
    opacity: 0;
    transform: translateY(25px) scale(0.95);
    animation: tribalGalleryItem 0.8s ease forwards;
  }

  @keyframes tribalGalleryItem {
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .tribal-gallery-frame {
    position: relative;
    border: 4px solid rgba(255, 255, 255, 0.12);
    border-radius: 8px;
    overflow: hidden;
    background: rgba(0, 0, 0, 0.4);
    transition: all 0.4s ease;
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.08) inset,
      0 10px 30px rgba(0, 0, 0, 0.3);
    aspect-ratio: 1;
  }

  .tribal-gallery-frame:hover {
    transform: translateY(-8px) scale(1.03);
    border-color: rgba(220, 20, 60, 0.5);
    box-shadow:
      0 0 0 1px rgba(220, 20, 60, 0.3) inset,
      0 16px 40px rgba(0, 0, 0, 0.4),
      0 0 25px rgba(220, 20, 60, 0.3);
  }

  .gallery-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease, filter 0.3s ease;
    background: linear-gradient(135deg, rgba(220, 20, 60, 0.1), rgba(0, 0, 0, 0.2));
  }

  .gallery-image:not([src]) {
    background: linear-gradient(135deg, rgba(220, 20, 60, 0.1), rgba(0, 0, 0, 0.2));
    position: relative;
  }

  .gallery-image:not([src])::after {
    content: '⚔️';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-size: 3rem;
    opacity: 0.4;
  }

  .tribal-gallery-frame:hover .gallery-image {
    transform: scale(1.08);
    filter: brightness(1.1) contrast(1.1);
  }

  .tribal-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(
      135deg,
      rgba(0, 0, 0, 0.9) 0%,
      rgba(220, 20, 60, 0.4) 50%,
      rgba(0, 0, 0, 0.9) 100%
    );
    opacity: 0;
    transition: opacity 0.4s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 1.5rem;
  }

  .tribal-gallery-frame:hover .tribal-overlay {
    opacity: 1;
  }

  .tribal-content {
    color: white;
    transform: translateY(15px);
    transition: transform 0.4s ease;
  }

  .tribal-gallery-frame:hover .tribal-content {
    transform: translateY(0);
  }

  .masterpiece-label {
    font-size: 1.3rem;
    font-weight: bold;
    margin-bottom: 0.75rem;
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.8);
    letter-spacing: 0.02em;
  }

  .view-hint {
    font-size: 1rem;
    opacity: 0.9;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8);
  }

  .gallery-footer {
    background: rgba(0, 0, 0, 0.5);
    border: 3px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    padding: 2.5rem;
    backdrop-filter: blur(12px);
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.06) inset;
