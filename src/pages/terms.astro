---
import Layout from '../layouts/Layout.astro';

const title = "Terms of Service — Cursed Ink Society";
const description = "Terms of service for Cursed Ink Society tattoo studio in Houma, Louisiana. Review our policies on appointments, deposits, cancellations, age restrictions, and client responsibilities.";
---

<Layout title={title} description={description}>
  <section class="legal-page">
    <div class="container">
      <div class="legal-content">
        <header class="legal-header">
          <h1 class="legal-title">Terms of Service</h1>
          <p class="legal-subtitle">Effective Date: January 1, 2025</p>
          <p class="legal-last-updated">Last Updated: January 1, 2025</p>
        </header>

        <div class="legal-body">
          <section class="legal-section">
            <h2 class="section-heading">Introduction and Acceptance of Terms</h2>
            <p>Welcome to Cursed Ink Society! These Terms of Service (the "Terms") govern your access to and use of our website located at cursedinksociety.com (the "Website"), and all services provided by Cursed Ink Society LLC (the "Studio," "we," "us," or "our"), including but not limited to tattoo consultations, appointment booking, and receiving tattoo services (the "Services").</p>
            <p>By accessing or using the Website or Services, you ("User," "Client," "you," or "your") agree to be bound by these Terms and our <a href="/privacy" class="legal-link">Privacy Policy</a>. If you do not agree to these Terms, you may not access or use the Website or Services.</p>
            <p><strong>Important:</strong> These Terms constitute a legally binding agreement between you and Cursed Ink Society LLC. Please read them carefully before using our services.</p>
          </section>

          <section class="legal-section">
            <h2 class="section-heading">Definitions</h2>
            <p>For purposes of these Terms, the following definitions apply:</p>
            <ul class="legal-list">
              <li><strong>"Service"</strong> refers to all tattoo-related services, consultations, and related activities provided by the Studio</li>
              <li><strong>"User" or "Client"</strong> refers to any individual accessing our Website or receiving our Services</li>
              <li><strong>"Studio"</strong> refers to Cursed Ink Society LLC and its artists and staff</li>
              <li><strong>"Website"</strong> refers to cursedinksociety.com and all associated pages and functionality</li>
              <li><strong>"Artist"</strong> refers to any licensed tattoo artist employed by or working at Cursed Ink Society</li>
              <li><strong>"Appointment"</strong> refers to any scheduled tattoo session, consultation, or related service</li>
            </ul>
          </section>

          <section class="legal-section">
            <h2 class="section-heading">Eligibility Requirements</h2>
            
            <h3 class="subsection-heading">Age Restriction</h3>
            <div class="important-notice">
              <p><strong>You must be at least eighteen (18) years of age to receive tattoo services from Cursed Ink Society.</strong> This is a strict requirement under Louisiana law (LSA R.S. 14:93.2). By using our Website or booking an appointment, you represent and warrant that you are 18 years of age or older.</p>
              <p><strong>We do not accept parental consent for tattooing individuals under the age of 18 under any circumstances.</strong> Valid government-issued photo identification will be required before any service.</p>
            </div>

            <h3 class="subsection-heading">Health and Medical Conditions</h3>
            <p>Certain health conditions, medications, or circumstances may preclude you from receiving tattoo services, including but not limited to:</p>
            <ul class="legal-list">
              <li>Pregnancy or breastfeeding</li>
              <li>Blood-borne diseases or infections</li>
              <li>Immunocompromised conditions</li>
              <li>Blood clotting disorders or use of blood-thinning medications</li>
              <li>Skin conditions affecting the tattoo area</li>
              <li>Recent medical procedures or surgeries</li>
              <li>Allergies to tattoo inks or aftercare products</li>
            </ul>
            <p>You are responsible for disclosing all relevant health information. Failure to provide accurate health information may result in refusal of service and forfeiture of deposits.</p>
          </section>

          <section class="legal-section">
            <h2 class="section-heading">Appointment Booking and Deposits</h2>
            
            <h3 class="subsection-heading">Booking Process</h3>
            <p>Appointments may be booked through the following methods:</p>
            <ul class="legal-list">
              <li>Online through our website booking system</li>
              <li>By phone during business hours: (985) 208-2334</li>
              <li>In person at our studio: 488 Corporate Dr, STE 11, Houma, LA 70360</li>
            </ul>
            <p>All appointments require completion of our intake forms and consent documentation before service can be provided.</p>

            <h3 class="subsection-heading">Required Deposits</h3>
            <div class="important-notice">
              <p><strong>A non-refundable deposit is required to secure any tattoo appointment.</strong> Deposits serve multiple purposes:</p>
              <ul class="legal-list">
                <li>To secure the artist's time and prevent scheduling conflicts</li>
                <li>To cover design time and consultation work</li>
                <li>To compensate for lost income due to cancellations or no-shows</li>
                <li>To demonstrate your commitment to the appointment</li>
              </ul>
              <p>Deposit amounts vary based on the size and complexity of the tattoo and will be clearly communicated during the booking process. Deposits are applied toward the final cost of your tattoo service.</p>
            </div>

            <h3 class="subsection-heading">Deposit Forfeiture</h3>
            <p>Your deposit will be forfeited under the following conditions:</p>
            <ul class="legal-list">
              <li><strong>No-Shows:</strong> Failure to appear for your scheduled appointment without prior notice</li>
              <li><strong>Late Cancellations:</strong> Cancelling with less than 48 hours notice</li>
              <li><strong>Excessive Lateness:</strong> Arriving more than 15 minutes late for your appointment</li>
              <li><strong>Design Changes:</strong> Requesting significant design changes that require a new consultation</li>
              <li><strong>Eligibility Issues:</strong> Failure to meet age, health, or other eligibility requirements</li>
              <li><strong>Repeated Rescheduling:</strong> Rescheduling the same appointment more than twice</li>
              <li><strong>Inappropriate Behavior:</strong> Violating our studio policies or code of conduct</li>
            </ul>
          </section>

          <section class="legal-section">
            <h2 class="section-heading">Cancellations, Rescheduling, and Refunds</h2>
            
            <h3 class="subsection-heading">Cancellation Policy</h3>
            <p>To cancel an appointment without forfeiting your deposit, you must provide at least 48 hours advance notice. Cancellations can be made by:</p>
            <ul class="legal-list">
              <li>Calling our studio at (985) 208-2334</li>
              <li>Emailing us at info@cursedinksociety.com</li>
              <li>Visiting the studio in person during business hours</li>
            </ul>
            <p>Cancellations with less than 48 hours notice will result in deposit forfeiture.</p>

            <h3 class="subsection-heading">Rescheduling Policy</h3>
            <p>Appointments may be rescheduled with at least 48 hours advance notice. Rescheduling conditions:</p>
            <ul class="legal-list">
              <li>First reschedule: No additional fees if 48+ hours notice is provided</li>
              <li>Second reschedule: May incur additional fees at the artist's discretion</li>
              <li>Third reschedule: Will result in deposit forfeiture and require a new deposit</li>
            </ul>
            <p>Rescheduled appointments are subject to artist availability and may require longer wait times.</p>

            <h3 class="subsection-heading">Refund Policy</h3>
            <div class="important-notice">
              <p><strong>All deposits are non-refundable.</strong> This policy is strictly enforced to protect our artists' time and compensate for business expenses. Refunds are not provided for:</p>
              <ul class="legal-list">
                <li>Change of mind or personal circumstances</li>
                <li>Dissatisfaction with design during consultation</li>
                <li>Inability to complete the tattoo due to client health issues</li>
                <li>Weather conditions or transportation issues</li>
                <li>Emergency situations (deposits may be transferred to future appointments)</li>
              </ul>
            </div>
          </section>

          <section class="legal-section">
            <h2 class="section-heading">Tattoo Design and Consultation</h2>
            
            <h3 class="subsection-heading">Design Process</h3>
            <p>Our tattoo design process includes:</p>
            <ul class="legal-list">
              <li><strong>Initial Consultation:</strong> Discussion of your vision, placement, size, and style preferences</li>
              <li><strong>Design Creation:</strong> Artist creates custom design based on consultation</li>
              <li><strong>Design Review:</strong> Client reviews and approves final design before tattooing begins</li>
              <li><strong>Final Approval:</strong> Written consent and approval required before needle touches skin</li>
            </ul>

            <h3 class="subsection-heading">Design Revisions</h3>
            <p>Design revision policy:</p>
            <ul class="legal-list">
              <li>Minor adjustments during the design review are included in the service</li>
              <li>Major design changes may require additional consultation fees</li>
              <li>Extensive revisions may require rescheduling and additional deposits</li>
              <li>Last-minute design changes on appointment day may result in rescheduling</li>
            </ul>

            <h3 class="subsection-heading">Intellectual Property Rights</h3>
            <div class="important-notice">
              <p><strong>Tattoo designs created by our artists remain the intellectual property of the artist and Cursed Ink Society.</strong> By receiving a tattoo service, you receive a personal, non-transferable license to display the artwork on your body. This means:</p>
              <ul class="legal-list">
                <li>The artist retains all rights to the original design</li>
                <li>You may not reproduce, distribute, or sell the design</li>
                <li>The artist may use images of the tattoo for portfolio and promotional purposes</li>
                <li>You may not claim ownership of the artistic design</li>
              </ul>
            </div>
          </section>

          <section class="legal-section">
            <h2 class="section-heading">Pricing and Payment</h2>
            
            <h3 class="subsection-heading">Pricing Structure</h3>
            <p>Our services are priced based on multiple factors:</p>
            <ul class="legal-list">
              <li><strong>Hourly Rates:</strong> Most tattoos are priced by time spent tattooing</li>
              <li><strong>Flat Rates:</strong> Simple designs may have fixed pricing</li>
              <li><strong>Minimum Charges:</strong> All tattoo services have a studio minimum</li>
              <li><strong>Size and Complexity:</strong> Larger and more detailed tattoos cost more</li>
              <li><strong>Placement:</strong> Difficult-to-reach areas may incur additional charges</li>
              <li><strong>Artist Experience:</strong> Pricing may vary by artist skill level and demand</li>
            </ul>
            <p>Final pricing will be discussed and agreed upon during your consultation before any work begins.</p>

            <h3 class="subsection-heading">Payment Methods</h3>
            <p>We accept the following forms of payment:</p>
            <ul class="legal-list">
              <li>Cash (preferred)</li>
              <li>Credit cards (Visa, MasterCard, American Express, Discover)</li>
              <li>Debit cards</li>
              <li>Venmo, CashApp, or other approved digital payment methods</li>
            </ul>

            <h3 class="subsection-heading">Payment Timing</h3>
            <p>Payment is due upon completion of each tattoo session. For multi-session tattoos, payment is required at the end of each individual session.</p>
          </section>

          <section class="legal-section">
            <h2 class="section-heading">Client Responsibilities</h2>
            
            <h3 class="subsection-heading">Honest Disclosure</h3>
            <div class="important-notice">
              <p><strong>You are responsible for providing accurate and complete personal and health information.</strong> This includes:</p>
              <ul class="legal-list">
                <li>Complete medical history and current health conditions</li>
                <li>All medications, supplements, and substances you are taking</li>
                <li>Allergies and previous adverse reactions</li>
                <li>Pregnancy or breastfeeding status</li>
                <li>Recent medical procedures or surgeries</li>
                <li>Any changes in health status between booking and appointment</li>
              </ul>
              <p>Failure to provide accurate information may result in refusal of service, health complications, or adverse outcomes for which the Studio is not liable.</p>
            </div>

            <h3 class="subsection-heading">Aftercare Compliance</h3>
            <p>Proper aftercare is crucial for tattoo healing and longevity. You are responsible for:</p>
            <ul class="legal-list">
              <li>Following all written and verbal aftercare instructions provided by your artist</li>
              <li>Keeping the tattoo clean and properly moisturized</li>
              <li>Avoiding activities that may compromise healing (swimming, excessive sun exposure, etc.)</li>
              <li>Contacting the studio immediately if signs of infection or complications arise</li>
              <li>Attending any recommended follow-up appointments</li>
            </ul>
            <p>The Studio is not liable for complications arising from improper aftercare or failure to follow instructions.</p>

            <h3 class="subsection-heading">Appointment Conduct</h3>
            <p>During your appointment, you are expected to:</p>
            <ul class="legal-list">
              <li><strong>Arrive on time:</strong> Late arrivals may result in shortened sessions or rescheduling</li>
              <li><strong>Come prepared:</strong> Eat a meal beforehand and bring snacks/water for long sessions</li>
              <li><strong>Limit guests:</strong> Maximum of one support person unless pre-approved</li>
              <li><strong>Stay sober:</strong> No alcohol or drug use before or during appointments</li>
              <li><strong>Remain still:</strong> Follow artist instructions for positioning and movement</li>
              <li><strong>Communicate:</strong> Speak up about pain levels, breaks, or concerns</li>
              <li><strong>Respect boundaries:</strong> Maintain appropriate behavior toward staff and other clients</li>
            </ul>
          </section>

          <section class="legal-section">
            <h2 class="section-heading">Health and Safety</h2>
            
            <h3 class="subsection-heading">Studio Standards</h3>
            <p>Cursed Ink Society maintains the highest health and safety standards:</p>
            <ul class="legal-list">
              <li>All artists and the facility are registered with the Louisiana Department of Health</li>
              <li>We follow all Louisiana commercial body art regulations (Title 51, Part XXVIII)</li>
              <li>Hospital-grade sterilization and safety protocols are used</li>
              <li>All equipment is single-use or properly sterilized</li>
              <li>We maintain current health department certifications and inspections</li>
            </ul>

            <h3 class="subsection-heading">Consent Requirements</h3>
            <p>Before any tattoo service, you must:</p>
            <ul class="legal-list">
              <li>Complete and sign all required consent forms</li>
              <li>Provide valid government-issued photo identification</li>
              <li>Acknowledge understanding of the permanent nature of tattoos</li>
              <li>Confirm understanding of potential risks and complications</li>
              <li>Agree to follow all aftercare instructions</li>
            </ul>
          </section>

          <section class="legal-section">
            <h2 class="section-heading">Disclaimers and Limitations of Liability</h2>
            
            <h3 class="subsection-heading">No Guarantees</h3>
            <div class="important-notice">
              <p><strong>Tattoo results can vary based on individual factors.</strong> The Studio does not guarantee specific outcomes because:</p>
              <ul class="legal-list">
                <li>Skin type, texture, and healing vary among individuals</li>
                <li>Aftercare compliance affects final results</li>
                <li>Age, lifestyle, and health impact tattoo longevity</li>
                <li>Color retention depends on skin tone and individual factors</li>
                <li>Healing is an individual biological process</li>
              </ul>
            </div>

            <h3 class="subsection-heading">Acknowledged Health Risks</h3>
            <p>Tattooing involves inherent health risks that you acknowledge and assume, including but not limited to:</p>
            <ul class="legal-list">
              <li>Infection at the tattoo site</li>
              <li>Allergic reactions to inks or aftercare products</li>
              <li>Scarring or keloid formation</li>
              <li>Nerve damage or numbness</li>
              <li>Interference with medical imaging (MRI)</li>
              <li>Unpredictable healing or color changes</li>
              <li>Need for touch-ups or additional sessions</li>
            </ul>
            <p>By proceeding with tattoo services, you acknowledge these risks and agree to consult with a medical professional if you have any health concerns.</p>

            <h3 class="subsection-heading">Limitation of Liability</h3>
            <div class="important-notice">
              <p><strong>To the fullest extent permitted by Louisiana law, Cursed Ink Society's liability for any damages, injuries, or losses arising from our services is limited to the amount paid for the specific service.</strong> We are not liable for:</p>
              <ul class="legal-list">
                <li>Indirect, incidental, or consequential damages</li>
                <li>Lost wages or income due to healing time</li>
                <li>Medical expenses related to complications from improper aftercare</li>
                <li>Dissatisfaction with healed tattoo appearance</li>
                <li>Changes in personal taste or circumstances</li>
                <li>Complications arising from undisclosed health conditions</li>
              </ul>
            </div>
          </section>

          <section class="legal-section">
            <h2 class="section-heading">Website Usage</h2>
            
            <h3 class="subsection-heading">Acceptable Use</h3>
            <p>When using our website, you agree not to:</p>
            <ul class="legal-list">
              <li>Use the site for any unlawful purpose or activity</li>
              <li>Attempt to gain unauthorized access to our systems</li>
              <li>Interfere with the proper functioning of the website</li>
              <li>Post or transmit harmful, offensive, or inappropriate content</li>
              <li>Violate any applicable laws or regulations</li>
              <li>Infringe on the rights of others</li>
            </ul>

            <h3 class="subsection-heading">Intellectual Property</h3>
            <p>All content on our website, including text, images, logos, and designs, is the property of Cursed Ink Society and is protected by copyright and other intellectual property laws. You may not reproduce, distribute, or use our content without written permission.</p>
          </section>

          <section class="legal-section">
            <h2 class="section-heading">Governing Law and Dispute Resolution</h2>
            
            <h3 class="subsection-heading">Governing Law</h3>
            <p>These Terms of Service are governed by and construed in accordance with the laws of the State of Louisiana, without regard to conflict of law principles. Any legal action or proceeding arising from these Terms shall be brought exclusively in the courts of Terrebonne Parish, Louisiana.</p>

            <h3 class="subsection-heading">Dispute Resolution</h3>
            <p>In the event of any dispute arising from these Terms or our services, we encourage resolution through the following process:</p>
            <ol class="legal-list">
              <li><strong>Direct Communication:</strong> Contact us directly to discuss the issue</li>
              <li><strong>Informal Negotiation:</strong> Attempt to resolve the matter through good faith discussion</li>
              <li><strong>Mediation:</strong> If needed, pursue mediation through a neutral third party</li>
              <li><strong>Small Claims Court:</strong> For disputes under Louisiana small claims limits</li>
              <li><strong>Louisiana Courts:</strong> Final resolution through Louisiana state courts if necessary</li>
            </ol>
          </section>

          <section class="legal-section">
            <h2 class="section-heading">Changes to Terms of Service</h2>
            <p>We may update or modify these Terms periodically to reflect changes in our services, legal requirements, or business practices. When we make changes, we will:</p>
            <ul class="legal-list">
              <li>Post the revised Terms on our website with a new "Last Updated" date</li>
              <li>Notify users of significant changes via email or prominent website notice</li>
              <li>Maintain previous versions for reference when legally required</li>
            </ul>
            <p>Your continued use of our website or services after any changes constitutes acceptance of the revised Terms. We encourage you to review these Terms periodically to stay informed of any updates.</p>
          </section>

          <section class="legal-section">
            <h2 class="section-heading">Severability</h2>
            <p>If any provision of these Terms is found to be unenforceable or invalid by a court of competent jurisdiction, such provision shall be modified to the minimum extent necessary to make it enforceable, and the remainder of these Terms shall remain in full force and effect.</p>
          </section>

          <section class="legal-section">
            <h2 class="section-heading">Contact Information</h2>
            <p>If you have any questions, concerns, or disputes regarding these Terms of Service, please contact us:</p>
            <div class="contact-info">
              <p><strong>Cursed Ink Society LLC</strong></p>
              <p>488 Corporate Dr, STE 11<br>Houma, LA 70360</p>
              <p>Phone: <a href="tel:+19852082334" class="contact-link">(985) 208-2334</a></p>
              <p>Email: <a href="mailto:info@cursedinksociety.com" class="contact-link">info@cursedinksociety.com</a></p>
              <p>Hours: Mon-Thu 1PM-8PM, Fri-Sat 1PM-10PM, Sun by Appointment</p>
            </div>
            <p>We are committed to addressing your concerns promptly and professionally. Please allow up to 5 business days for a response to written inquiries.</p>
          </section>

          <section class="legal-section">
            <h2 class="section-heading">Louisiana Compliance Statement</h2>
            <p>Cursed Ink Society LLC operates in full compliance with Louisiana state laws and regulations, including:</p>
            <ul class="legal-list">
              <li><strong>Commercial Body Art Regulations:</strong> Louisiana Administrative Code Title 51, Part XXVIII</li>
              <li><strong>Age Restrictions:</strong> LSA R.S. 14:93.2 (18+ years required for tattoo services)</li>
              <li><strong>Health Department Registration:</strong> All artists and facility properly registered with Louisiana Department of Health</li>
              <li><strong>Consumer Protection Laws:</strong> Truth-in-advertising and fair business practices</li>
              <li><strong>Data Protection:</strong> Louisiana data breach notification requirements (R.S. 51:3074)</li>
            </ul>
            <p>Our registration and inspection records are available for review upon request and are maintained in accordance with state requirements.</p>
          </section>

          <div class="legal-acknowledgment">
            <p><strong>By using our services, you acknowledge that you have read, understood, and agree to be bound by these Terms of Service and our Privacy Policy.</strong></p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .legal-page {
    padding: 6rem 0 4rem;
    background: 
      radial-gradient(ellipse at 20% 30%, rgba(255, 60, 43, 0.08) 0%, transparent 50%),
      radial-gradient(ellipse at 80% 70%, rgba(255, 122, 24, 0.06) 0%, transparent 50%),
      linear-gradient(135deg, #0b0b0d 0%, #1a1a1f 50%, #0b0b0d 100%);
    min-height: 100vh;
  }

  .legal-content {
    max-width: 800px;
    margin: 0 auto;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 3rem;
    backdrop-filter: blur(10px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
  }

  .legal-header {
    text-align: center;
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .legal-title {
    font-family: 'Cinzel', serif;
    font-size: clamp(2.5rem, 4vw, 3.5rem);
    font-weight: 700;
    color: var(--ink);
    margin-bottom: 1rem;
    text-shadow: 0 0 20px rgba(220, 20, 60, 0.3);
  }

  .legal-subtitle {
    font-size: 1.1rem;
    color: var(--accent0);
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .legal-last-updated {
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.7);
    font-style: italic;
  }

  .legal-body {
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.9);
  }

  .legal-section {
    margin-bottom: 3rem;
  }

  .legal-section:last-child {
    margin-bottom: 0;
  }

  .section-heading {
    font-family: 'Cinzel', serif;
    font-size: 1.8rem;
    font-weight: 600;
    color: var(--accent0);
    margin-bottom: 1.5rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid rgba(220, 20, 60, 0.3);
  }

  .subsection-heading {
    font-family: 'Cinzel', serif;
    font-size: 1.3rem;
    font-weight: 600;
    color: var(--gold);
    margin: 2rem 0 1rem 0;
  }

  .legal-section p {
    margin-bottom: 1.2rem;
    font-size: 1rem;
    text-align: justify;
  }

  .legal-list {
    margin: 1.5rem 0;
    padding-left: 1.5rem;
  }

  .legal-list li {
    margin-bottom: 0.8rem;
    position: relative;
  }

  .legal-list li::marker {
    color: var(--accent0);
  }

  .legal-list li strong {
    color: var(--gold);
    font-weight: 600;
  }

  .important-notice {
    background: rgba(220, 20, 60, 0.1);
    border: 1px solid rgba(220, 20, 60, 0.3);
    border-left: 4px solid var(--accent0);
    border-radius: 8px;
    padding: 1.5rem;
    margin: 2rem 0;
  }

  .important-notice p {
    margin-bottom: 1rem;
  }

  .important-notice p:last-child {
    margin-bottom: 0;
  }

  .important-notice strong {
    color: var(--accent0);
  }

  .contact-info {
    background: rgba(220, 20, 60, 0.05);
    border: 1px solid rgba(220, 20, 60, 0.2);
    border-radius: 8px;
    padding: 1.5rem;
    margin: 1.5rem 0;
  }

  .contact-info p {
    margin-bottom: 0.5rem;
  }

  .contact-info p:last-child {
    margin-bottom: 0;
  }

  .legal-acknowledgment {
    background: rgba(212, 175, 55, 0.1);
    border: 1px solid rgba(212, 175, 55, 0.3);
    border-radius: 8px;
    padding: 2rem;
    margin-top: 3rem;
    text-align: center;
  }

  .legal-acknowledgment p {
    margin: 0;
    font-size: 1.1rem;
    color: var(--gold);
    font-weight: 600;
  }

  .legal-link,
  .contact-link {
    color: var(--accent0);
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .legal-link:hover,
  .legal-link:focus,
  .contact-link:hover,
  .contact-link:focus {
    color: var(--gold);
    text-decoration: underline;
  }

  /* Mobile Responsiveness */
  @media (max-width: 768px) {
    .legal-page {
      padding: 4rem 0 2rem;
    }

    .legal-content {
      padding: 2rem 1.5rem;
      margin: 0 1rem;
    }

    .legal-title {
      font-size: 2.2rem;
    }

    .section-heading {
      font-size: 1.5rem;
    }

    .subsection-heading {
