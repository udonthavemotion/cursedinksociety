  /* RPG Final CTA Bar */
  .rpg-cta-bar {
    padding: 4rem 0;
    background:
      linear-gradient(135deg, rgba(138, 43, 226, 0.08), rgba(75, 0, 130, 0.05)),
      linear-gradient(180deg, #0a0a0c, #000000);
    border-top: 2px solid rgba(138, 43, 226, 0.2);
    position: relative;
  }

  .cta-bar-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: rgba(0, 0, 0, 0.4);
    border: 2px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    padding: 2rem;
    backdrop-filter: blur(10px);
    box-shadow: 
      0 0 0 1px rgba(255, 255, 255, 0.06) inset,
      0 8px 24px rgba(0, 0, 0, 0.3);
  }

  .cta-left {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .cta-icon {
    font-size: 2.5rem;
    filter: drop-shadow(0 0 8px rgba(138, 43, 226, 0.5));
  }

  .cta-title {
    font-size: 1.3rem;
    font-weight: 700;
    color: #f5f5f5;
    margin-bottom: 0.25rem;
    text-shadow: 0 0 10px rgba(138, 43, 226, 0.3);
  }

  .cta-subtitle {
    font-size: 1rem;
    color: rgba(245, 245, 245, 0.7);
  }

  .cta-actions {
    display: flex;
    gap: 1rem;
  }

  .btn-instagram {
    background: linear-gradient(135deg, #833AB4, #C13584, #E1306C, #FD1D1D);
    color: white;
    border-color: rgba(255, 255, 255, 0.3);
    box-shadow: 
      0 4px 12px rgba(225, 48, 108, 0.4),
      0 0 0 1px rgba(255, 255, 255, 0.1) inset;
  }

  .btn-instagram:hover {
    transform: translateY(-2px);
    box-shadow: 
      0 6px 20px rgba(225, 48, 108, 0.6),
      0 0 0 1px rgba(255, 255, 255, 0.2) inset;
  }

  .btn-book {
    background: linear-gradient(135deg, #8a2be2, #4b0082);
    color: white;
    border-color: rgba(255, 255, 255, 0.3);
    box-shadow:
      0 4px 12px rgba(138, 43, 226, 0.4),
      0 0 0 1px rgba(255, 255, 255, 0.1) inset;
    position: relative;
    overflow: hidden;
  }

  .btn-book:hover {
    transform: translateY(-2px);
    box-shadow:
      0 6px 20px rgba(138, 43, 226, 0.5),
      0 0 0 1px rgba(255, 255, 255, 0.2) inset;
  }

  .btn-book::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
    transition: left 0.5s ease;
  }

  .btn-book:hover::before {
    left: 100%;
  }

  /* Mobile Optimizations for CTA Bar */
  @media (max-width: 768px) {
    .rpg-cta-bar {
      padding: 3rem 0;
    }

    .cta-bar-content {
      flex-direction: column;
      gap: 2rem;
      text-align: center;
      padding: 1.5rem;
    }

    .cta-left {
      flex-direction: column;
      gap: 1rem;
      text-align: center;
    }

    .cta-icon {
