---
// Homepage Hero - Different from coming-soon Hero3D
---

<section class="home-hero" id="hero">
  <div class="hero-content">
    <div class="container">
      <div class="hero-text">
        <h1 class="hero-title">
          <span class="cursed-text">Cursed</span>
          <span class="ink-text">Ink</span>
          <span class="society-text">Society</span>
        </h1>
        <p class="hero-subtitle">Premier tattoo artistry in Houma, Louisiana</p>
        <p class="hero-description">
          Where master artists create mystical ink that tells your story. 
          Custom designs, traditional work, and sacred artistry await.
        </p>
        <div class="hero-actions">
          <a href="/artists" class="btn btn--primary">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M19 3H5c-1.1 0-2 .9-2 2v14c1.1 0 2-.9 2-2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-5 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z"/>
            </svg>
            Meet Our Artists
          </a>
          <a href="/gallery" class="btn btn--secondary">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z"/>
            </svg>
            View Gallery
          </a>
        </div>
      </div>
      <div class="hero-visual">
        <div class="logo-showcase">
          <img 
            src="/brand/cursed-ink-logo.png" 
            alt="Cursed Ink Society Logo" 
            class="hero-logo"
            loading="eager"
          />
          <div class="logo-glow"></div>
        </div>
      </div>
    </div>
  </div>
  
  <!-- Scroll indicator -->
  <div class="scroll-indicator">
    <span>Explore Our Artists</span>
    <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
      <path d="M7.41 8.59L12 13.17l4.59-4.58L18 10l-6 6-6-6 1.41-1.41z"/>
    </svg>
  </div>
</section>

<style>
.home-hero {
  min-height: 100vh;
  background: linear-gradient(135deg, #0b0b0d 0%, #1a1a1f 100%);
  position: relative;
  display: flex;
  align-items: center;
  overflow: hidden;
}

.home-hero::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: radial-gradient(circle at 30% 50%, rgba(255, 60, 43, 0.1) 0%, transparent 50%),
              radial-gradient(circle at 70% 30%, rgba(255, 122, 24, 0.08) 0%, transparent 50%);
  pointer-events: none;
}

.hero-content {
  position: relative;
  z-index: 2;
  width: 100%;
  padding: 2rem 0;
}

.container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 2rem;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 4rem;
  align-items: center;
}

.hero-text {
  animation: fadeInUp 1s ease-out;
}

.hero-title {
  font-size: clamp(2.5rem, 5vw, 4rem);
  font-weight: 700;
  line-height: 1.1;
  margin-bottom: 1rem;
  font-family: 'Cinzel', serif;
}

.cursed-text {
  color: var(--accent0);
  text-shadow: 0 0 20px rgba(255, 60, 43, 0.5);
}

.ink-text {
  color: var(--accent1);
  text-shadow: 0 0 20px rgba(255, 122, 24, 0.5);
}

.society-text {
  color: var(--ink);
  text-shadow: 0 0 10px rgba(255, 255, 255, 0.3);
}

.hero-subtitle {
  font-size: 1.2rem;
  color: var(--accent1);
  font-weight: 500;
  margin-bottom: 1rem;
  opacity: 0.9;
}

.hero-description {
  font-size: 1.1rem;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 2.5rem;
  max-width: 500px;
}

.hero-actions {
  display: flex;
  gap: 1rem;
  flex-wrap: wrap;
}

.btn {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 1rem 2rem;
  border-radius: 50px;
  font-weight: 600;
  text-decoration: none;
  transition: all 0.3s ease;
  border: 2px solid transparent;
  font-size: 1rem;
}

.btn--primary {
  background: linear-gradient(135deg, var(--accent0), var(--accent1));
  color: white;
  box-shadow: 0 4px 20px rgba(255, 60, 43, 0.3);
}

.btn--primary:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 30px rgba(255, 60, 43, 0.4);
}

.btn--secondary {
  background: transparent;
  color: var(--ink);
  border-color: rgba(255, 255, 255, 0.3);
}

.btn--secondary:hover {
  background: rgba(255, 255, 255, 0.1);
  border-color: rgba(255, 255, 255, 0.5);
  transform: translateY(-2px);
}

.hero-visual {
  display: flex;
  justify-content: center;
  align-items: center;
  animation: fadeInRight 1s ease-out 0.3s both;
}

.logo-showcase {
  position: relative;
  display: flex;
  justify-content: center;
  align-items: center;
}

.hero-logo {
  width: 300px;
  height: auto;
  filter: drop-shadow(0 0 30px rgba(255, 60, 43, 0.6));
  transition: transform 0.3s ease;
}

.hero-logo:hover {
  transform: scale(1.05);
}

.logo-glow {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 400px;
  height: 400px;
  background: radial-gradient(circle, rgba(255, 60, 43, 0.1) 0%, transparent 70%);
  border-radius: 50%;
  animation: pulse 3s ease-in-out infinite;
}

.scroll-indicator {
  position: absolute;
  bottom: 2rem;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.5rem;
  color: rgba(255, 255, 255, 0.7);
  font-size: 0.9rem;
  animation: bounce 2s infinite;
  cursor: pointer;
}

.scroll-indicator:hover {
  color: var(--accent1);
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(30px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes fadeInRight {
  from {
    opacity: 0;
    transform: translateX(30px);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

@keyframes pulse {
  0%, 100% {
    opacity: 0.3;
    transform: translate(-50%, -50%) scale(1);
  }
  50% {
    opacity: 0.6;
    transform: translate(-50%, -50%) scale(1.1);
  }
}

@keyframes bounce {
  0%, 20%, 50%, 80%, 100% {
    transform: translateX(-50%) translateY(0);
  }
  40% {
    transform: translateX(-50%) translateY(-10px);
  }
  60% {
    transform: translateX(-50%) translateY(-5px);
  }
}

/* Mobile Responsive */
@media (max-width: 768px) {
  .container {
    grid-template-columns: 1fr;
    gap: 2rem;
    text-align: center;
  }
  
  .hero-actions {
    justify-content: center;
  }
  
  .btn {
    padding: 0.8rem 1.5rem;
    font-size: 0.9rem;
  }
  
  .hero-logo {
    width: 250px;
  }
  
  .logo-glow {
    width: 300px;
    height: 300px;
  }
}

@media (max-width: 480px) {
  .hero-actions {
    flex-direction: column;
    align-items: center;
  }
  
  .btn {
    width: 100%;
    max-width: 280px;
    justify-content: center;
  }
}
</style>

<script>
// Smooth scroll for scroll indicator
document.querySelector('.scroll-indicator')?.addEventListener('click', () => {
  document.querySelector('#artists')?.scrollIntoView({ 
    behavior: 'smooth' 
  });
});
</script>
