---
// Import research-informed portfolio data
import siteData from '../data/cis.json';
const { portfolio } = siteData;

// Sort categories by research-determined priority
const sortedCategories = [...portfolio.categories].sort((a, b) => a.priority - b.priority);
---

<section class="py-20 bg-gradient-to-b from-cursed-dark to-cursed-black">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <h2 class="text-4xl md:text-5xl font-display font-bold text-cursed-white mb-4">
        Our Portfolio
      </h2>
      <p class="text-xl text-cursed-muted max-w-3xl mx-auto">
        Explore our diverse range of styles and techniques. From traditional to contemporary, each piece tells a unique story.
      </p>
    </div>

    <!-- Filter Buttons -->
    <div class="flex flex-wrap justify-center gap-4 mb-12">
      <button
        class="filter-btn active px-6 py-3 bg-cursed-red text-cursed-white font-semibold rounded-full transition-all duration-300 hover:bg-cursed-red/90"
        data-filter="all"
      >
        All Work
      </button>
      {sortedCategories.map((category) => (
        <button
          class="filter-btn px-6 py-3 bg-cursed-black/50 border border-cursed-gold/30 text-cursed-gold font-semibold rounded-full transition-all duration-300 hover:bg-cursed-gold hover:text-cursed-dark"
          data-filter={category.slug}
        >
          {category.name}
        </button>
      ))}
    </div>

    <!-- Portfolio Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 portfolio-grid">
      {portfolio.featured.map((item, index) => (
        <article
          class={`portfolio-item group cursor-pointer ${item.category}`}
          data-category={item.category}
        >
          <div class="relative overflow-hidden rounded-xl bg-cursed-dark/50">
            <!-- Portfolio Image -->
            <img
              src={item.image}
              alt={item.alt}
              class="w-full h-64 object-cover group-hover:scale-110 transition-transform duration-500"
              loading={index < 6 ? "eager" : "lazy"}
              width="400"
              height="256"
            />

            <!-- Overlay -->
            <div class="absolute inset-0 bg-gradient-to-t from-cursed-dark/90 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>

            <!-- Content Overlay -->
            <div class="absolute bottom-0 left-0 right-0 p-6 text-cursed-white transform translate-y-full group-hover:translate-y-0 transition-transform duration-300">
              <h3 class="text-xl font-display font-bold mb-2">{item.title}</h3>
              <p class="text-cursed-gold text-sm mb-4 capitalize">{item.category.replace('-', ' ')}</p>
              <div class="flex items-center justify-between">
                <span class="text-sm text-cursed-muted">By {item.artist.replace('-', ' ').replace(/\b\w/g, l => l.toUpperCase())}</span>
                <svg class="w-5 h-5 text-cursed-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                </svg>
              </div>
            </div>

            <!-- Category Badge -->
            <div class="absolute top-4 right-4">
              <span class="px-3 py-1 bg-cursed-red/90 text-cursed-white text-xs font-medium rounded-full capitalize">
                {item.category.replace('-', ' ')}
              </span>
            </div>
          </div>
        </article>
      ))}

      <!-- Placeholder items for demo (would be populated with actual portfolio) -->
      {Array.from({ length: 9 }, (_, i) => (
        <article class={`portfolio-item group cursor-pointer ${sortedCategories[i % sortedCategories.length].slug}`}>
          <div class="relative overflow-hidden rounded-xl bg-cursed-dark/50">
            <div class="w-full h-64 bg-gradient-to-br from-cursed-black to-cursed-dark flex items-center justify-center">
              <div class="text-center text-cursed-muted">
                <svg class="w-12 h-12 mx-auto mb-2 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                </svg>
                <p class="text-sm">Portfolio Image</p>
                <p class="text-xs opacity-75">{sortedCategories[i % sortedCategories.length].name}</p>
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- Load More Button -->
    <div class="text-center mt-12">
      <button class="load-more-btn inline-flex items-center px-8 py-4 bg-cursed-gold hover:bg-cursed-gold/90 text-cursed-dark font-semibold rounded-lg transition-all duration-300 transform hover:scale-105 hover:shadow-2xl hover:shadow-cursed-gold/25">
        <span>Load More Work</span>
        <svg class="ml-2 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
        </svg>
      </button>
    </div>

    <!-- Call to Action -->
    <div class="text-center mt-16">
      <p class="text-cursed-muted mb-6">
        Inspired by our work? Let's create something extraordinary together.
      </p>
      <a
        href="#contact"
        class="inline-flex items-center px-8 py-4 bg-cursed-red hover:bg-cursed-red/90 text-cursed-white font-semibold rounded-lg transition-all duration-300 transform hover:scale-105 hover:shadow-2xl hover:shadow-cursed-red/25"
      >
        <span>Start Your Project</span>
        <svg class="ml-2 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
        </svg>
      </a>
    </div>
  </div>
</section>

<!-- Portfolio JavaScript -->
<script>
  // Portfolio filtering functionality
  document.addEventListener('DOMContentLoaded', function() {
    const filterButtons = document.querySelectorAll('.filter-btn');
    const portfolioItems = document.querySelectorAll('.portfolio-item');
    const loadMoreBtn = document.querySelector('.load-more-btn');

    // Filter functionality
    filterButtons.forEach(button => {
      button.addEventListener('click', function() {
        const filter = this.dataset.filter;

        // Update active button
        filterButtons.forEach(btn => btn.classList.remove('active'));
        this.classList.add('active');

        // Filter items
        portfolioItems.forEach(item => {
          if (filter === 'all' || item.classList.contains(filter)) {
            item.style.display = 'block';
            item.style.animation = 'fadeIn 0.5s ease-in-out';
          } else {
            item.style.display = 'none';
          }
        });
      });
    });

    // Load more functionality (placeholder)
    if (loadMoreBtn) {
      loadMoreBtn.addEventListener('click', function() {
        // In a real implementation, this would load more portfolio items
        this.textContent = 'Loading...';
        setTimeout(() => {
          this.textContent = 'No More Items to Load';
          this.disabled = true;
        }, 1000);
      });
    }

    // Lightbox functionality (basic implementation)
    portfolioItems.forEach(item => {
      item.addEventListener('click', function() {
        const img = this.querySelector('img');
        if (img && img.src) {
          // Create simple lightbox
          const lightbox = document.createElement('div');
          lightbox.className = 'fixed inset-0 z-50 flex items-center justify-center bg-black bg-opacity-90';
          lightbox.innerHTML = `
            <div class="relative max-w-4xl max-h-full p-4">
              <img src="${img.src}" alt="${img.alt}" class="max-w-full max-h-full object-contain">
              <button class="absolute top-4 right-4 text-white text-2xl hover:text-cursed-gold">&times;</button>
            </div>
          `;

          document.body.appendChild(lightbox);

          // Close lightbox
          lightbox.addEventListener('click', function(e) {
            if (e.target === this || e.target.textContent === '×') {
              this.remove();
            }
          });
        }
      });
    });
  });
</script>

<style>
  /* Performance optimization: Will-change for smooth animations */
  .portfolio-item {
    will-change: transform;
  }

  /* Research-aligned: Smooth filtering animations */
  .portfolio-grid {
    transition: all 0.3s ease-in-out;
  }

  /* Accessibility: Focus states for filter buttons */
  .filter-btn:focus {
    outline: 2px solid var(--cursed-gold);
    outline-offset: 2px;
  }

  /* Mobile responsiveness */
  @media (max-width: 640px) {
    .portfolio-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
