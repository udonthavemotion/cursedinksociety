---
import { slugify } from '../lib/slugify';
import type { Artist } from '../data/artists';

export interface Props {
  artist: Artist;
}

const { artist } = Astro.props;

// Get the first featured work image as hero background
// Seth uses his portfolio hero image, others use featured work
const heroImage = artist.slug === 'seth-wood' 
  ? '/assets/artists/seth-wood/image0 (2).jpeg'
  : artist.featuredWork?.[0] || artist.portfolio?.[0] || artist.avatar;
const additionalImages = artist.featuredWork?.slice(1, 3) || artist.portfolio?.slice(1, 3) || [];
---

<article class="artist-showcase-card" data-artist={artist.slug}>
  <a href={`/artists/${slugify(artist.slug ?? artist.name)}`} class="card-link">
    <!-- Hero Background Image/Video -->
    <div class="hero-background">
      {artist.slug === 'cody-crochet' ? (
        <>
          <video
            src="/assets/videos/codycrochettattoos_1755358341_3700536299216111968_62892567232.mp4"
            class="hero-video cody-video"
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
          />
          <img
            src={heroImage}
            alt={`${artist.name} featured work fallback`}
            class="hero-video-fallback"
            loading="lazy"
          />
        </>
      ) : artist.slug === 'ashley-wood' ? (
        <>
          <video
            src="/assets/videos/ashleyxxkarma_1753071396_3681351613176961709_181129474.mp4"
            class="hero-video ashley-video"
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
          />
          <img
            src={heroImage}
            alt={`${artist.name} featured work fallback`}
            class="hero-video-fallback"
            loading="lazy"
          />
        </>
      ) : artist.slug === 'luis-reymundo' ? (
        <>
          <video
            src="/assets/videos/ta2luis_1700763110_3242558304315509597_217025634.mp4"
            class="hero-video luis-video"
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
          />
          <img
            src={heroImage}
            alt={`${artist.name} featured work fallback`}
            class="hero-video-fallback"
            loading="lazy"
          />
        </>
      ) : artist.slug === 'trent' ? (
        <>
          <video
            src="/assets/videos/tattooz_by_trent_1754442474_3692853029963503882_65790929016.mp4"
            class="hero-video trent-video"
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
          />
          <img
            src={heroImage}
            alt={`${artist.name} featured work fallback`}
            class="hero-video-fallback"
            loading="lazy"
          />
        </>
      ) : artist.slug === 'anthony-boudreaux' ? (
        <>
          <video
            src="/assets/videos/buddha_ta2_1743703565_3602769004402930368_522395724 (1).mp4"
            class="hero-video anthony-video"
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
          />
          <img
            src={heroImage}
            alt={`${artist.name} featured work fallback`}
            class="hero-video-fallback"
            loading="lazy"
          />
        </>
      ) : (
        <img
          src={heroImage}
          alt={`${artist.name} featured work`}
          class="hero-image"
          loading="lazy"
        />
      )}
      <div class="hero-overlay"></div>
      <div class="decorative-corner"></div>
    </div>

    <!-- Content Overlay -->
    <div class="content-overlay">
      <!-- Artist Name & Title -->
      <div class="artist-header">
        <h3 class="artist-name">{artist.name}</h3>
        <p class="artist-title">{artist.title}</p>
        <p class="artist-experience">{artist.experience}</p>
      </div>

      <!-- Signature Styles -->
      <div class="signature-styles">
        {artist.styles.slice(0, 3).map(style => (
          <span class="style-tag">{style}</span>
        ))}
      </div>

      <!-- Additional Work Preview -->
      {additionalImages.length > 0 && (
        <div class="work-preview">
          {additionalImages.map((image, index) => (
            <div class="preview-thumb">
              <img
                src={image}
                alt={`${artist.name} work ${index + 2}`}
                loading="lazy"
              />
            </div>
          ))}
        </div>
      )}

      <!-- CTA -->
      <div class="card-cta">
        <span class="cta-text">View Portfolio</span>
        <svg class="cta-arrow" width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
          <path d="M8 0L6.59 1.41L12.17 7H0v2h12.17l-5.58 5.59L8 16l8-8z"/>
        </svg>
      </div>
    </div>

    <!-- Floating Avatar -->
    <div class="floating-avatar">
      <img
        src={artist.avatar}
        alt={`${artist.name} portrait`}
        loading="lazy"
      />
    </div>
  </a>
</article>

<style>
  .artist-showcase-card {
    position: relative;
    height: 400px;
    border-radius: 24px;
    overflow: hidden;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 
      0 8px 32px rgba(0, 0, 0, 0.3),
      0 4px 16px rgba(0, 0, 0, 0.2);
  }

  .artist-showcase-card:hover {
    transform: translateY(-8px) scale(1.02);
    box-shadow: 
      0 20px 40px rgba(0, 0, 0, 0.4),
      0 8px 24px rgba(0, 0, 0, 0.3);
  }

  .card-link {
    display: block;
    width: 100%;
    height: 100%;
    text-decoration: none;
    color: inherit;
    position: relative;
  }

  /* Hero Background */
  .hero-background {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .artist-showcase-card:hover .hero-image {
    transform: scale(1.1);
  }

  /* Video Background Styles */
  .hero-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
    opacity: 0.8;
  }

  .artist-showcase-card:hover .hero-video {
    transform: scale(1.1);
    opacity: 0.9;
  }

  /* Cody's anime/manga video styling */
  .hero-video.cody-video {
    opacity: 0.8;
    filter: saturate(1.1) contrast(1.05) brightness(1.05);
  }

  .artist-showcase-card:hover .hero-video.cody-video {
    opacity: 0.9;
    filter: saturate(1.2) contrast(1.1) brightness(1.1);
  }

  /* Ashley's watercolor video styling */
  .hero-video.ashley-video {
    opacity: 0.7;
    filter: saturate(1.2) contrast(1.1) hue-rotate(5deg);
  }

  .artist-showcase-card:hover .hero-video.ashley-video {
    opacity: 0.85;
    filter: saturate(1.3) contrast(1.15) hue-rotate(5deg);
  }

  /* Luis's traditional Japanese video styling */
  .hero-video.luis-video {
    opacity: 0.75;
    filter: contrast(1.2) saturate(0.9) sepia(0.1);
  }

  .artist-showcase-card:hover .hero-video.luis-video {
    opacity: 0.85;
    filter: contrast(1.25) saturate(1.0) sepia(0.15);
  }

  /* Trent's electric/modern video styling */
  .hero-video.trent-video {
    opacity: 0.8;
    filter: saturate(1.3) contrast(1.15) brightness(1.1) hue-rotate(-10deg);
  }

  .artist-showcase-card:hover .hero-video.trent-video {
    opacity: 0.9;
    filter: saturate(1.4) contrast(1.2) brightness(1.15) hue-rotate(-10deg);
  }

  /* Anthony's black & grey realism video styling */
  .hero-video.anthony-video {
    opacity: 0.75;
    filter: grayscale(0.2) contrast(1.3) brightness(0.9) saturate(0.8);
  }

  .artist-showcase-card:hover .hero-video.anthony-video {
    opacity: 0.85;
    filter: grayscale(0.1) contrast(1.35) brightness(0.95) saturate(0.9);
  }

  /* Seth's hero image styling (matches his portfolio) */
  .artist-showcase-card[data-artist="seth-wood"] .hero-image {
    filter: brightness(1.1) contrast(1.2) saturate(0.9);
  }

  .artist-showcase-card[data-artist="seth-wood"]:hover .hero-image {
    filter: brightness(1.2) contrast(1.25) saturate(1.0);
  }

  .hero-video-fallback {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: none;
    transition: transform 0.6s ease;
  }

  .artist-showcase-card:hover .hero-video-fallback {
    transform: scale(1.1);
  }

  .hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      135deg,
      rgba(0, 0, 0, 0.3) 0%,
      rgba(0, 0, 0, 0.1) 40%,
      rgba(0, 0, 0, 0.7) 100%
    );
    z-index: 2;
  }

  .decorative-corner {
    position: absolute;
    top: 0;
    right: 0;
    width: 0;
    height: 0;
    border-left: 60px solid transparent;
    border-top: 60px solid rgba(212, 175, 55, 0.15);
    z-index: 2;
    transition: all 0.3s ease;
  }

  .artist-showcase-card:hover .decorative-corner {
    border-top-color: rgba(212, 175, 55, 0.25);
    transform: scale(1.1);
  }

  /* Content Overlay */
  .content-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 2rem;
    z-index: 3;
  }

  /* Artist Header */
  .artist-header {
    color: white;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.6);
  }

  .artist-name {
    font-size: 1.75rem;
    font-weight: 800;
    margin: 0 0 0.5rem 0;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .artist-title {
    font-size: 1rem;
    font-weight: 600;
    margin: 0 0 0.25rem 0;
    opacity: 0.9;
    font-style: italic;
  }

  .artist-experience {
    font-size: 0.875rem;
    font-weight: 500;
    margin: 0;
    opacity: 0.8;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* Signature Styles */
  .signature-styles {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: auto;
    margin-bottom: 1rem;
  }

  .style-tag {
    background: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(10px);
    color: white;
    padding: 0.5rem 1rem;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border: 1px solid rgba(255, 255, 255, 0.2);
    transition: all 0.3s ease;
    white-space: nowrap;
  }

  .artist-showcase-card:hover .style-tag {
    background: rgba(255, 255, 255, 0.25);
    border-color: rgba(255, 255, 255, 0.4);
    transform: translateY(-2px);
  }

  /* Work Preview */
  .work-preview {
    display: flex;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .preview-thumb {
    width: 60px;
    height: 60px;
    border-radius: 12px;
    overflow: hidden;
    border: 2px solid rgba(255, 255, 255, 0.3);
    transition: all 0.3s ease;
  }

  .preview-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .artist-showcase-card:hover .preview-thumb {
    border-color: rgba(255, 255, 255, 0.6);
    transform: translateY(-4px);
  }

  .artist-showcase-card:hover .preview-thumb img {
    transform: scale(1.1);
  }

  /* CTA */
  .card-cta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: white;
    font-weight: 700;
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    transition: all 0.3s ease;
  }

  .cta-text {
    position: relative;
  }

  .cta-text::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 2px;
    background: white;
    transition: width 0.3s ease;
  }

  .artist-showcase-card:hover .cta-text::after {
    width: 100%;
  }

  .cta-arrow {
    transition: transform 0.3s ease;
  }

  .artist-showcase-card:hover .cta-arrow {
    transform: translateX(4px);
  }

  /* Floating Avatar */
  .floating-avatar {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    overflow: hidden;
    border: 3px solid rgba(255, 255, 255, 0.8);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);
    z-index: 4;
    transition: all 0.3s ease;
  }

  .floating-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .artist-showcase-card:hover .floating-avatar {
    transform: scale(1.1);
    border-color: white;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.4);
  }

  /* Responsive Design */
  @media (max-width: 768px) {
    .artist-showcase-card {
      height: 350px;
    }

    .content-overlay {
      padding: 1.5rem;
    }

    .artist-name {
      font-size: 1.5rem;
    }

    .artist-title {
      font-size: 0.9rem;
    }

    .artist-experience {
      font-size: 0.8rem;
    }

    .style-tag {
      font-size: 0.7rem;
      padding: 0.4rem 0.8rem;
    }

    .preview-thumb {
      width: 50px;
      height: 50px;
    }

    .floating-avatar {
      width: 50px;
      height: 50px;
      top: 1rem;
      right: 1rem;
    }
  }

  @media (max-width: 480px) {
    .artist-showcase-card {
      height: 320px;
    }

    .content-overlay {
      padding: 1.25rem;
    }

    .artist-name {
      font-size: 1.25rem;
    }

    .work-preview {
      gap: 0.5rem;
    }

    .preview-thumb {
      width: 40px;
      height: 40px;
    }

    .signature-styles {
      gap: 0.375rem;
    }

    .style-tag {
      font-size: 0.65rem;
      padding: 0.3rem 0.6rem;
    }
  }

  /* Accessibility */
  @media (prefers-reduced-motion: reduce) {
    .artist-showcase-card,
    .hero-image,
    .hero-video,
    .hero-video-fallback,
    .style-tag,
    .preview-thumb,
    .preview-thumb img,
    .floating-avatar,
    .cta-arrow {
      transition: none;
    }

    .artist-showcase-card:hover {
      transform: none;
    }

    .artist-showcase-card:hover .hero-image,
    .artist-showcase-card:hover .hero-video,
    .artist-showcase-card:hover .hero-video-fallback {
      transform: none;
    }
  }

  @media (prefers-contrast: high) {
    .hero-overlay {
      background: linear-gradient(
        135deg,
        rgba(0, 0, 0, 0.6) 0%,
        rgba(0, 0, 0, 0.4) 40%,
        rgba(0, 0, 0, 0.8) 100%
      );
    }

    .style-tag {
      background: rgba(0, 0, 0, 0.8);
      border-color: white;
    }

    .floating-avatar {
      border-width: 4px;
    }
  }

  /* Focus states for accessibility */
  .card-link:focus {
    outline: 3px solid #ffd700;
    outline-offset: 2px;
  }

  .card-link:focus .artist-showcase-card {
    transform: translateY(-4px) scale(1.01);
  }
</style>

<script>
  class ArtistVideoManager {
    videos: NodeListOf<HTMLVideoElement>;
    fallbacks: NodeListOf<HTMLImageElement>;
    observers: IntersectionObserver[];

    constructor() {
      this.videos = document.querySelectorAll('.hero-video') as NodeListOf<HTMLVideoElement>;
      this.fallbacks = document.querySelectorAll('.hero-video-fallback') as NodeListOf<HTMLImageElement>;
      this.observers = [];
      this.init();
    }

    init() {
      if (this.videos.length === 0) return;

      this.videos.forEach((video, index) => {
        const fallback = this.fallbacks[index];
        
        // Performance optimization for mobile
        if (this.isMobile()) {
          video.style.opacity = '0.6';
        }

        // Handle video loading and errors
        video.addEventListener('loadeddata', () => {
          if (fallback) {
            fallback.style.display = 'none';
          }
        });

        video.addEventListener('error', () => {
          let artistName = 'Artist';
          if (video.classList.contains('cody-video')) artistName = 'Cody';
          else if (video.classList.contains('ashley-video')) artistName = 'Ashley';
          else if (video.classList.contains('luis-video')) artistName = 'Luis';
          else if (video.classList.contains('trent-video')) artistName = 'Trent';
          else if (video.classList.contains('anthony-video')) artistName = 'Anthony';
          
          console.warn(`${artistName} video failed to load, using fallback image`);
          if (fallback) {
            fallback.style.display = 'block';
          }
        });

        // Intersection Observer for performance
        if ('IntersectionObserver' in window) {
          const observer = new IntersectionObserver((entries: IntersectionObserverEntry[]) => {
            entries.forEach(entry => {
              if (entry.isIntersecting) {
                video.play().catch(() => {
                  // Handle autoplay restrictions
                });
              } else {
                video.pause();
              }
            });
          }, { threshold: 0.1 });

          observer.observe(video);
          this.observers.push(observer);
        }
      });

      // Pause all videos when page becomes hidden to save resources
      document.addEventListener('visibilitychange', () => {
        this.videos.forEach(video => {
          if (document.hidden) {
            video.pause();
          } else {
            video.play().catch(() => {
              // Handle autoplay restrictions gracefully
            });
          }
        });
      });
    }

    isMobile(): boolean {
      return window.innerWidth < 768 || /Android|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);
    }
  }

  // Initialize video manager when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => new ArtistVideoManager());
  } else {
    new ArtistVideoManager();
  }
</script>
