---
import Layout from '../layouts/Layout.astro';

const title = "About Cursed Ink Society — Premier Tattoo Studio in Houma, LA";
const description = "Discover Cursed Ink Society's legacy of artistic excellence, our family of master artists, and unwavering commitment to tattoo artistry. Experience why we're Houma's premier destination for custom tattoos.";

// Studio information
const studioInfo = {
  founded: "2018",
  yearsActive: "Legacy",
  location: "Houma, Louisiana",
  philosophy: "A Legacy of Artistry and Community",
  mission: "At Cursed Ink Society, our story is one forged in passion, perseverance, and a shared commitment to the art of tattooing. Our collective of artists has honed their craft, grown together, and built a foundation rooted in mutual respect and a deep love for what we do. Through dedication and brotherhood, we've created something truly extraordinary.",
  story: "We are more than just a tattoo studio; we are a family of artists who have navigated the evolving landscape of this incredible industry side-by-side. From humble beginnings to becoming recognized as some of Houma's finest and most dedicated artists, every stroke of the needle, every shared laugh, and every challenge overcome has woven us closer together.",
  commitment: "Our commitment extends beyond the ink. We believe in fostering a welcoming and professional environment where creativity flourishes and every client feels valued and understood. Our studio is a sanctuary where your vision is brought to life with precision, care, and an artistic touch that is uniquely ours.",
  vision: "As we continue this exciting journey with Cursed Ink Society, we are filled with immense gratitude and enthusiasm. It is with great pleasure and a humble spirit that we serve the public, inviting you to experience the culmination of our artistic legacy. We eagerly anticipate welcoming new faces and continuing to serve our cherished community with the top-notch work and heartfelt dedication that has defined us from the very beginning.",
  values: [
    "Artistic Excellence",
    "Professional Integrity", 
    "Client Safety",
    "Community Connection",
    "Continuous Growth"
  ]
};

const certifications = [
  {
    title: "Louisiana Health Department Certified",
    description: "Current certification and regular health inspections",
    icon: "health"
  },
  {
    title: "Safety & Sterilization Standards",
    description: "Hospital-grade sterilization and safety protocols",
    icon: "safety"
  },
  {
    title: "First Aid & CPR Certified",
    description: "Emergency response training for all staff members",
    icon: "medical"
  }
];

const studioFeatures = [
  {
    title: "Private Consultation Spaces",
    description: "Comfortable, welcoming spaces to discuss your artistic vision",
    icon: "consultation"
  },
  {
    title: "Professional-Grade Equipment",
    description: "Premium tools and technology for precision artistry",
    icon: "equipment"
  },
  {
    title: "Clean & Safe Environment",
    description: "Pristine workspace with industry-leading safety standards",
    icon: "sterile"
  },
  {
    title: "Welcoming Atmosphere",
    description: "A sanctuary where creativity and comfort come together",
    icon: "comfort"
  }
];

const communityShowcase = [
  {
    title: "Local Art Community",
    description: "Supporting local artists and art education programs throughout Houma",
    icon: "art",
    background: "/assets/artists/seth-wood/image3 (1).jpeg",
    artist: "Seth Wood",
    style: "Neo-Traditional"
  },
  {
    title: "Charity & Fundraising",
    description: "Using our artistry to support meaningful causes in our community",
    icon: "charity",
    background: "/assets/artists/ashley-wood/tattoo-02.jpg",
    artist: "Ashley Wood",
    style: "Watercolor"
  },
  {
    title: "Cultural Education",
    description: "Teaching tattoo history, cultural significance, and artistic traditions",
    icon: "education",
    background: "/assets/artists/luis-reymundo/456455404_18445571008001635_6969315202827007293_n.jpg",
    artist: "Luis Reymundo",
    style: "Traditional Japanese"
  },
  {
    title: "Youth Mentorship",
    description: "Guiding the next generation of artists with proper techniques and ethics",
    icon: "mentorship",
    background: "/assets/artists/Anthony/buddha_ta2_1750266714_3657824772252347663_522395724.jpg",
    artist: "Anthony Boudreaux",
    style: "Black & Grey Realism"
  },
  {
    title: "Community Events",
    description: "Hosting art shows, open studios, and creative community gatherings",
    icon: "events",
    background: "/assets/artists/cody-crochet/madman.jpg",
    artist: "Cody Crochet",
    style: "Anime & Manga"
  },
  {
    title: "Artistic Legacy",
    description: "Building a lasting cultural impact through art, mentorship, and community connection",
    icon: "legacy",
    background: "/assets/artists/trent/r.jpg",
    artist: "Trent",
    style: "Neo-Traditional"
  }
];
---

<Layout title={title} description={description}>
  <!-- Hero Section with Enhanced Logo Display -->
  <section class="about-hero enhanced-hero">
    <!-- Three.js Canvas Background -->
    <canvas id="about-hero-canvas" aria-hidden="true" role="presentation"></canvas>

      <div class="hero-content">
      <div class="container">
        <!-- Main Hero Content -->
        <div class="hero-main">
          <div class="hero-text-section">
            <div class="hero-pretitle">
              <span class="pretitle-accent">✦</span>
              <span class="pretitle-text">OUR JOURNEY</span>
              <span class="pretitle-accent">✦</span>
            </div>

            <h1 class="hero-title">
              <span class="title-word">
                <span class="letter" data-letter="S">S</span>
                <span class="letter" data-letter="E">E</span>
                <span class="letter" data-letter="V">V</span>
                <span class="letter" data-letter="E">E</span>
                <span class="letter" data-letter="N">N</span>
              </span>
              <span class="title-word">
                <span class="letter" data-letter="Y">Y</span>
                <span class="letter" data-letter="E">E</span>
                <span class="letter" data-letter="A">A</span>
                <span class="letter" data-letter="R">R</span>
                <span class="letter" data-letter="S">S</span>
              </span>
              <span class="title-word">
                <span class="letter" data-letter="O">O</span>
                <span class="letter" data-letter="F">F</span>
              </span>
              <span class="title-word">
                <span class="letter" data-letter="A">A</span>
                <span class="letter" data-letter="R">R</span>
                <span class="letter" data-letter="T">T</span>
                <span class="letter" data-letter="I">I</span>
                <span class="letter" data-letter="S">S</span>
                <span class="letter" data-letter="T">T</span>
                <span class="letter" data-letter="R">R</span>
                <span class="letter" data-letter="Y">Y</span>
              </span>
              <span class="title-word">
                <span class="letter" data-letter="A">A</span>
                <span class="letter" data-letter="N">N</span>
                <span class="letter" data-letter="D">D</span>
              </span>
              <span class="title-word">
                <span class="letter" data-letter="C">C</span>
                <span class="letter" data-letter="O">O</span>
                <span class="letter" data-letter="M">M</span>
                <span class="letter" data-letter="M">M</span>
                <span class="letter" data-letter="U">U</span>
                <span class="letter" data-letter="N">N</span>
                <span class="letter" data-letter="I">I</span>
                <span class="letter" data-letter="T">T</span>
                <span class="letter" data-letter="Y">Y</span>
              </span>
            </h1>

            <p class="hero-subtitle">
              SIX MASTER ARTISTS. ONE EXTRAORDINARY VISION. OUR AWARD-WINNING COLLECTIVE BRINGS DECADES OF COMBINED EXPERTISE TO EVERY CUSTOM PIECE, SPECIALIZING IN TRADITIONAL ARTISTRY, CONTEMPORARY DESIGNS, AND SACRED INK THAT HONORS YOUR UNIQUE STORY.
            </p>

            <div class="hero-actions">
              <!-- Social Media Links -->
              <div class="social-links-container">
                <h3 class="social-heading">Follow Us on Socials</h3>
                <div class="social-links">
                  <a href="https://instagram.com/cursedinksociety" class="social-link instagram" target="_blank" rel="noopener noreferrer">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M7 2h10a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5V7a5 5 0 0 1 5-5zm5 5a5 5 0 1 0 .001 10.001A5 5 0 0 0 12 7zm0 2.2a2.8 2.8 0 1 1 0 5.6 2.8 2.8 0 0 1 0-5.6zM18 6.5a1 1 0 1 0 0 2 1 1 0 0 0 0-2z"/>
                    </svg>
                    Instagram
                  </a>
                  <a href="https://facebook.com/cursedinksociety" class="social-link facebook" target="_blank" rel="noopener noreferrer">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                    </svg>
                    Facebook
                  </a>
                </div>
              </div>
            </div>
          </div>

          <div class="hero-visual-section">
            <!-- 3D Interactive Logo -->
            <div class="logo-showcase">
              <div class="logo-container" id="about-logo-container">
                <img
                  src="/brand/cursed-ink-logo.png"
                  alt="Cursed Ink Society Logo"
                  class="hero-logo"
                  id="about-interactive-logo"
                  loading="eager"
                />

                <!-- Animated Glow Rings -->
                <div class="glow-ring ring-1"></div>
                <div class="glow-ring ring-2"></div>
                <div class="glow-ring ring-3"></div>

                <!-- Floating Particles -->
                <div class="floating-particles">
                  <div class="particle particle-1"></div>
                  <div class="particle particle-2"></div>
                  <div class="particle particle-3"></div>
                  <div class="particle particle-4"></div>
                  <div class="particle particle-5"></div>
            </div>
            </div>

              <!-- Holographic Effect Overlay -->
              <div class="holographic-overlay"></div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Our Story Section - Mystical Chronicle -->
  <section class="our-story mystical-chronicle">
    <div class="chronicle-atmosphere">
      <div class="floating-runes">
        <div class="rune rune-1">✦</div>
        <div class="rune rune-2">◆</div>
        <div class="rune rune-3">✧</div>
        <div class="rune rune-4">⬟</div>
        <div class="rune rune-5">✦</div>
      </div>
      
    <div class="container">
        <div class="story-content">
          <div class="mystical-story-header animate-on-scroll">
            <div class="chronicle-emblem">
              <img src="/brand/cursed-ink-logo.png" alt="Cursed Ink Society" class="cursed-logo">
              <div class="emblem-aura"></div>
            </div>
            <h2 class="chronicle-title">The Chronicles of Creation</h2>
            <div class="mystical-separator"></div>
          </div>

          <div class="story-scrolls">
            <div class="scroll-container animate-on-scroll">
              <div class="ancient-scroll">
                <div class="scroll-header">
                  <span class="scroll-chapter">Chapter I: The Calling</span>
            </div>
                <p class="scroll-text">{studioInfo.mission}</p>
            </div>
            </div>

            <div class="scroll-container animate-on-scroll">
              <div class="ancient-scroll">
                <div class="scroll-header">
                  <span class="scroll-chapter">Chapter II: The Brotherhood</span>
                </div>
                <p class="scroll-text">{studioInfo.story}</p>
          </div>
        </div>

            <div class="scroll-container animate-on-scroll">
              <div class="ancient-scroll">
                <div class="scroll-header">
                  <span class="scroll-chapter">Chapter III: The Sanctuary</span>
                </div>
                <p class="scroll-text">{studioInfo.commitment}</p>
              </div>
            </div>

            <div class="scroll-container animate-on-scroll">
              <div class="ancient-scroll">
                <div class="scroll-header">
                  <span class="scroll-chapter">Chapter IV: The Legacy</span>
                </div>
                <p class="scroll-text">{studioInfo.vision}</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Building Our Dream: The Studio Journey -->
  <section class="immersive-gallery">
    <div class="gallery-header">
      <h2 class="section-title text-center animate-on-scroll">Building Our Dream</h2>
      <p class="section-description text-center animate-on-scroll">
        From vision to reality - witness the monumental journey of unwavering dedication culminating in the creation of our studio sanctuary
      </p>
    </div>

    <div class="gallery-container">
      <!-- Chapter 1: The Foundation - Video Left -->
      <div class="gallery-item video-left" data-scroll-speed="0.8">
        <div class="video-side">
          <div class="video-container">
            <video autoplay muted loop playsinline class="gallery-video">
              <source src="/assets/about page/cursedinksociety_1754239289_3691147361746194847_75577231902.mp4" type="video/mp4">
            </video>
            <div class="video-overlay">
              <span class="video-label">Chapter 1: The Foundation</span>
            </div>
          </div>
        </div>
        <div class="content-side">
          <div class="value-content">
            <div class="value-icon">
              <img src="/brand/cursed-ink-logo.png" alt="Cursed Ink Society" class="cursed-logo">
            </div>
            <h3 class="value-title">Breaking Ground</h3>
            <p class="value-description">A legacy of dreaming led to this moment - our artists rolling up their sleeves to transform an empty space into something extraordinary. Every nail, every wall, every detail crafted with the same precision we bring to our art.</p>
          </div>
        </div>
      </div>

      <!-- Chapter 2: The Build - Video Right -->
      <div class="gallery-item video-right" data-scroll-speed="1.2">
        <div class="content-side">
          <div class="value-content">
            <div class="value-icon">
              <img src="/brand/cursed-ink-logo.png" alt="Cursed Ink Society" class="cursed-logo">
            </div>
            <h3 class="value-title">Hands-On Creation</h3>
            <p class="value-description">With tools in hand and vision in heart, our artists became builders. Every beam placed, every surface prepared with the same meticulous attention to detail that defines our tattoo artistry. This is craftsmanship beyond the needle.</p>
          </div>
        </div>
        <div class="video-side">
          <div class="video-container">
            <video autoplay muted loop playsinline class="gallery-video">
              <source src="/assets/videos/rosie_thorn25_1756162991_3707285503387765533_4133549009.mp4" type="video/mp4">
            </video>
            <div class="video-overlay">
              <span class="video-label">Chapter 2: The Build</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Chapter 3: The Dream Realized - Video Left -->
      <div class="gallery-item video-left" data-scroll-speed="0.9">
        <div class="video-side">
          <div class="video-container">
            <video autoplay muted loop playsinline class="gallery-video">
              <source src="/assets/about page/cursedinksociety_1753127772_3681823038048749143_75577231902.mp4" type="video/mp4">
            </video>
            <div class="video-overlay">
              <span class="video-label">Chapter 3: The Dream Realized</span>
            </div>
          </div>
        </div>
        <div class="content-side">
          <div class="value-content">
            <div class="value-icon">
              <img src="/brand/cursed-ink-logo.png" alt="Cursed Ink Society" class="cursed-logo">
            </div>
            <h3 class="value-title">Cursed Ink Society Lives</h3>
            <p class="value-description">From empty walls to a thriving sanctuary of art - our studio stands as a monument to perseverance, creativity, and the power of shared dreams. Unwavering dedication, countless hours of labor, and infinite passion culminated in this moment. Welcome to Cursed Ink Society.</p>
          </div>
        </div>
      </div>

    </div>

    <!-- Epic Conclusion -->
    <div class="journey-conclusion">
      <div class="container">
        <div class="conclusion-content animate-on-scroll">
          <div class="conclusion-icon">
            <img src="/brand/cursed-ink-logo.png" alt="Cursed Ink Society" class="cursed-logo">
          </div>
          <h3 class="conclusion-title">A Monument to Dreams</h3>
          <p class="conclusion-text">
            What you've witnessed is more than construction - it's the physical manifestation of artistic passion, brotherhood, and unwavering determination. Every beam raised, every wall painted, every detail perfected by the same hands that create masterpieces on skin. This is our legacy. This is Cursed Ink Society.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Studio Features -->
  <section class="studio-features">
    <div class="container">
        <h2 class="section-title text-center animate-on-scroll">Step Into Our Sanctuary</h2>
        <p class="section-description text-center animate-on-scroll">
          Where dreams became reality - a space meticulously crafted for comfort, creativity, and artistic excellence
        </p>
        
        <div class="features-showcase">
          {studioFeatures.map((feature, index) => (
            <div class="feature-experience animate-on-scroll floating" style={`animation-delay: ${index * 0.2}s`}>
              <div class="feature-visual">
                <div class="feature-icon-large" data-icon={feature.icon}>
                  <img src="/brand/cursed-ink-logo.png" alt="Cursed Ink Society" class="cursed-logo">
                </div>
                <div class="feature-glow"></div>
              </div>
              
              <div class="feature-content">
                <h3 class="feature-title-enhanced">{feature.title}</h3>
                <p class="feature-description-enhanced">{feature.description}</p>
                <div class="feature-accent"></div>
              </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Safety & Professionalism -->
  <section class="safety-certifications">
    <div class="safety-showcase">
    <div class="container">
        <h2 class="section-title text-center animate-on-scroll">Trust & Excellence</h2>
        <p class="section-description text-center animate-on-scroll">
          Built on a foundation of unwavering safety standards and professional integrity - your peace of mind is our sacred commitment
        </p>
        
        <div class="safety-experience">
          <div class="safety-visual animate-on-scroll">
            <div class="safety-icon-hero">
              <img src="/brand/cursed-ink-logo.png" alt="Cursed Ink Society" class="cursed-logo">
            </div>
            <div class="safety-text-hero">
              <h3 class="safety-promise">Your Safety, Our Sacred Promise</h3>
              <p class="safety-commitment">Building trust through unwavering standards, professional excellence, and genuine care for every client who enters our sanctuary.</p>
            </div>
            </div>

          <div class="safety-grid">
            <div class="safety-highlight-card animate-on-scroll">
              <div class="highlight-icon">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 3c1.93 0 3.5 1.57 3.5 3.5S13.93 13 12 13s-3.5-1.57-3.5-3.5S10.07 6 12 6zm7 13H5v-.23c0-.62.28-1.2.76-1.58C7.47 15.82 9.64 15 12 15s4.53.82 6.24 2.19c.48.38.76.97.76 1.58V19z"/>
                </svg>
          </div>
              <h4>Premium Sterilization</h4>
              <p>Professional-grade autoclaves ensure every tool meets hospital-level cleanliness standards.</p>
        </div>

            <div class="safety-highlight-card animate-on-scroll">
              <div class="highlight-icon">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                </svg>
              </div>
              <h4>Single-Use Excellence</h4>
              <p>Every needle, every tube - brand new for each client, properly disposed with environmental responsibility.</p>
            </div>

            <div class="safety-highlight-card animate-on-scroll">
              <div class="highlight-icon">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <h4>Pristine Sanctuary</h4>
              <p>Continuous sanitization throughout the day maintains our studio as a clean, comfortable haven for art.</p>
            </div>
          </div>

          <div class="certifications-showcase">
            {certifications.map((cert, index) => (
              <div class="certification-badge animate-on-scroll floating" style={`animation-delay: ${index * 0.15}s`}>
                <div class="badge-icon">
                {cert.icon === 'health' && (
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                  </svg>
                )}
                {cert.icon === 'safety' && (
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12,1L3,5V11C3,16.55 6.84,21.74 12,23C17.16,21.74 21,16.55 21,11V5L12,1M12,7C13.4,7 14.8,8.6 14.8,10V11.5C15.4,11.5 16,12.1 16,12.7V16.2C16,16.8 15.4,17.3 14.8,17.3H9.2C8.6,17.3 8,16.8 8,16.2V12.8C8,12.2 8.6,11.5 9.2,11.5V10C9.2,8.6 10.6,7 12,7M12,8.2C11.2,8.2 10.5,8.7 10.5,10V11.5H13.5V10C13.5,8.7 12.8,8.2 12,8.2Z"/>
                  </svg>
                )}
                {cert.icon === 'medical' && (
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M19 8h-2v3h-3v2h3v3h2v-3h3v-2h-3V8zM4 8h2v8H4V8zm4-2h2v12H8V6zm4 4h2v8h-2v-8z"/>
                  </svg>
                )}
              </div>
                <div class="badge-content">
                  <h5 class="badge-title">{cert.title}</h5>
                  <p class="badge-description">{cert.description}</p>
                </div>
            </div>
          ))}
          </div>
        </div>
      </div>
    </div>
  </section>


  <!-- Location & Contact -->
  <section class="location-contact">
    <div class="container">
      <div class="location-contact-grid">
        <div class="location-info">
          <h2 class="section-title animate-on-scroll">Visit Our Studio</h2>
          <div class="location-details">
            <div class="location-item animate-on-scroll">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
              </svg>
                <div>
                  <h4>Address</h4>
                  <p>488 Corporate Dr, STE 11<br />Houma, LA 70360</p>
                </div>
            </div>
            
            <div class="location-item animate-on-scroll">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                <path d="M6.62 10.79a15.05 15.05 0 006.59 6.59l2.2-2.2a1 1 0 011.11-.21 11.36 11.36 0 003.57.57 1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1 11.36 11.36 0 00.57 3.57 1 1 0 01-.21 1.11z"/>
              </svg>
              <div>
                <h4>Phone</h4>
                <p><a href="tel:+19852082334">(985) 208-2334</a></p>
              </div>
            </div>
            
            <div class="location-item animate-on-scroll">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
