      gap: 1.5rem;
      padding: 0 1rem;
    }

    .osrs-move-item {
      padding: 1.5rem;
    }

    .osrs-move-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }

    .osrs-move-stats {
      flex-direction: column;
      gap: 0.5rem;
    }

    .osrs-prompt-content {
      flex-direction: column;
      gap: 1rem;
      text-align: center;
    }

    .osrs-prompt-icon {
