    padding: 6rem 0;
  }

  .artist-gallery h2 {
    text-align: center;
    font-size: clamp(2rem, 4vw, 2.5rem);
    margin-bottom: 3rem;
    color: var(--ink);
    text-shadow: var(--glow-subtle);
