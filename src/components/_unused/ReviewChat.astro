---
import ArcanePanel from './ArcanePanel.astro';
import { guildStats, guildReviews, guildChat } from '../data/artists';

function renderStars(rating: number) {
  return '★'.repeat(rating) + '☆'.repeat(5 - rating);
}
---

<div class="review-chat-container">
  <!-- Guild Stats Panel -->
  <ArcanePanel title="Guild Status" variant="primary" className="guild-stats-panel">
    <div class="guild-level">
      <div class="level-display">
        <span class="level-label">Level</span>
        <span class="level-number">{guildStats.guildLevel}</span>
      </div>
      <div class="level-progress">
        <div class="level-bar" style={`width: ${(guildStats.guildLevel % 10) * 10}%`}></div>
      </div>
    </div>

    <div class="guild-stat">
      <div class="stat-icon">👥</div>
      <div class="stat-info">
        <div class="stat-number">{guildStats.activeMembers}</div>
        <div class="stat-label">Active Members</div>
      </div>
    </div>

    <div class="guild-stat">
      <div class="stat-icon">🎨</div>
      <div class="stat-info">
        <div class="stat-number">{guildStats.combinedExperience}+</div>
        <div class="stat-label">Years Experience</div>
      </div>
    </div>

    <div class="guild-stat">
      <div class="stat-icon">🏆</div>
      <div class="stat-info">
        <div class="stat-number">{guildStats.completedWorks}</div>
        <div class="stat-label">Works Completed</div>
      </div>
    </div>

    <div class="guild-stat">
      <div class="stat-icon">⚔️</div>
      <div class="stat-info">
        <div class="stat-number">{guildStats.stylesOffered}</div>
        <div class="stat-label">Art Styles</div>
      </div>
    </div>
  </ArcanePanel>

  <!-- Reviews Panel -->
  <ArcanePanel title="Recent Reviews" variant="secondary" className="reviews-panel">
    <div class="reviews-list">
      {guildReviews.map(review => (
        <div class="review-item">
          <div class="review-header">
            <div class="review-author">
              {review.author}
              {review.verified && <span class="verified-badge">✓</span>}
              <span class="review-type">{review.tattooType}</span>
            </div>
            <div class="review-rating">
              {renderStars(review.rating)}
            </div>
          </div>
          <div class="review-comment">
            "{review.comment}"
          </div>
          <div class="review-meta">
            <span class="review-artist">by {review.artist}</span>
            <span class="review-date">
              {new Date(review.date).toLocaleDateString('en-US', {
                month: 'short',
                day: 'numeric',
                year: 'numeric'
              })}
            </span>
          </div>
        </div>
      ))}
    </div>

    <div class="reviews-footer">
      <a href="/reviews" class="view-all-link">
        View All Reviews →
      </a>
    </div>
  </ArcanePanel>

  <!-- Chat Preview Panel -->
  <ArcanePanel title="Guild Chat" variant="accent" className="chat-panel">
    <div class="chat-preview">
      {guildChat.map(message => (
        <div class={`chat-message ${message.type === 'announcement' ? 'chat-announcement' : ''}`}>
          <div class="chat-avatar">{message.avatar}</div>
          <div class="chat-content">
            <div class="chat-author">{message.author}</div>
            <div class="chat-text">{message.message}</div>
            <div class="chat-time">{message.timestamp}</div>
          </div>
        </div>
      ))}
    </div>

    <div class="chat-input">
      <input
        type="text"
        placeholder="Share your thoughts..."
        class="chat-input-field"
        readonly
      />
      <button class="chat-send-btn" disabled>Send</button>
    </div>
  </ArcanePanel>
</div>

<style>
  .review-chat-container {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .guild-stats-panel,
  .reviews-panel,
  .chat-panel {
    width: 100%;
  }

  .guild-level {
    margin-bottom: 1.5rem;
    padding: 1rem;
    background: linear-gradient(135deg, rgba(212, 175, 55, 0.1), rgba(178, 34, 52, 0.1));
    border-radius: 8px;
    border: 1px solid rgba(212, 175, 55, 0.2);
  }

  .level-display {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
  }

  .level-label {
    color: var(--silver);
    font-size: 0.85rem;
    font-weight: 500;
  }

  .level-number {
    color: var(--gold);
    font-size: 1.5rem;
    font-weight: bold;
    text-shadow: 1px 1px 2px rgba(0,0,0,0.7);
  }

  .level-progress {
    background: #1a0f0f;
    height: 8px;
    border-radius: 4px;
    border: 1px solid rgba(212, 175, 55, 0.3);
    overflow: hidden;
  }

  .level-bar {
    height: 100%;
    background: linear-gradient(90deg, var(--accent0), var(--gold));
    border-radius: 3px;
    transition: width 1s ease-out;
  }

  .guild-stat {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 0;
    border-bottom: 1px solid rgba(212, 175, 55, 0.1);
  }

  .guild-stat:last-child {
    border-bottom: none;
  }

  .stat-icon {
    font-size: 1.5rem;
    width: 40px;
    text-align: center;
  }

  .stat-info {
    flex: 1;
  }

  .stat-number {
    color: var(--gold);
    font-size: 1.5rem;
    font-weight: bold;
    text-shadow: 1px 1px 2px rgba(0,0,0,0.7);
  }

  .stat-label {
    color: var(--ink);
    font-size: 0.8rem;
    opacity: 0.8;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .reviews-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .review-item {
    padding: 1rem 0;
    border-bottom: 1px solid rgba(212, 175, 55, 0.1);
  }

  .review-item:last-child {
    border-bottom: none;
  }

  .review-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
  }

  .review-author {
    color: var(--gold);
    font-weight: 600;
    font-size: 0.9rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.25rem;
  }

  .review-type {
    background: linear-gradient(45deg, rgba(212, 175, 55, 0.2), rgba(178, 34, 52, 0.2));
    color: var(--silver);
    padding: 0.2rem 0.5rem;
    border-radius: 8px;
    font-size: 0.7rem;
    font-weight: 500;
    border: 1px solid rgba(212, 175, 55, 0.3);
  }

  .verified-badge {
    color: var(--accent0);
    font-size: 0.7rem;
  }

  .review-rating {
    color: var(--gold);
    font-size: 0.8rem;
    letter-spacing: 0.1rem;
  }

  .review-comment {
    color: var(--ink);
    font-size: 0.85rem;
    line-height: 1.4;
    margin-bottom: 0.5rem;
    font-style: italic;
  }

  .review-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 0.5rem;
  }

  .review-artist {
    color: var(--accent0);
    font-size: 0.75rem;
    font-weight: 500;
  }

  .review-date {
    color: var(--silver);
    font-size: 0.7rem;
    opacity: 0.7;
  }

  .reviews-footer {
    margin-top: 1rem;
    text-align: center;
  }

  .view-all-link {
    color: var(--gold);
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 500;
    transition: all 0.3s ease;
  }

  .view-all-link:hover {
    color: var(--accent0);
    text-decoration: underline;
  }

  .chat-preview {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .chat-message {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
  }

  .chat-announcement {
    background: linear-gradient(135deg, rgba(212, 175, 55, 0.1), rgba(178, 34, 52, 0.1));
    border-radius: 8px;
    padding: 0.5rem;
    margin: 0.25rem 0;
    border-left: 3px solid var(--gold);
  }

  .chat-announcement .chat-author {
    color: var(--gold);
    font-weight: bold;
  }

  .chat-announcement .chat-text {
    color: var(--ink);
    font-style: italic;
  }

  .chat-avatar {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: linear-gradient(45deg, var(--gold), var(--accent0));
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.8rem;
    flex-shrink: 0;
  }

  .chat-content {
    flex: 1;
    min-width: 0;
  }

  .chat-author {
    color: var(--gold);
    font-size: 0.8rem;
    font-weight: 600;
    margin-bottom: 0.25rem;
  }

  .chat-text {
    color: var(--ink);
    font-size: 0.85rem;
    line-height: 1.3;
    margin-bottom: 0.25rem;
  }

  .chat-time {
    color: var(--silver);
    font-size: 0.7rem;
    opacity: 0.7;
  }

  .chat-input {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }

  .chat-input-field {
    flex: 1;
    padding: 0.5rem 0.75rem;
    background: rgba(0,0,0,0.2);
    border: 1px solid rgba(212, 175, 55, 0.3);
    border-radius: 6px;
    color: var(--ink);
    font-size: 0.8rem;
    outline: none;
    transition: border-color 0.3s ease;
  }

  .chat-input-field:focus {
    border-color: var(--gold);
  }

  .chat-input-field::placeholder {
    color: rgba(245, 245, 245, 0.5);
  }

  .chat-send-btn {
    padding: 0.5rem 1rem;
    background: linear-gradient(45deg, var(--accent0), var(--gold));
    color: white;
    border: none;
    border-radius: 6px;
    font-size: 0.8rem;
    font-weight: bold;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .chat-send-btn:hover:not(:disabled) {
    background: linear-gradient(45deg, var(--gold), #ffd700);
    transform: translateY(-1px);
  }

  .chat-send-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  /* Mobile adjustments */
  @media (max-width: 768px) {
    .review-chat-container {
      gap: 1rem;
    }

    .guild-stat {
      padding: 0.75rem 0;
    }

    .stat-icon {
      font-size: 1.2rem;
      width: 32px;
    }

    .stat-number {
      font-size: 1.2rem;
    }

    .chat-message {
      gap: 0.5rem;
    }

    .chat-avatar {
      width: 28px;
      height: 28px;
      font-size: 0.7rem;
    }
  }

  /* Reduced motion support */
  @media (prefers-reduced-motion: reduce) {
    .chat-send-btn {
      transition: none;
    }

    .view-all-link {
      transition: none;
    }
  }
</style>
