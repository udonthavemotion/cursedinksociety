---
import '../styles/global.css';
import pricingData from '../data/pricing.json';
import ScrollManager from '../components/ScrollManager.astro';
import OptimizedThreeLoader from '../components/OptimizedThreeLoader.astro';
import PerformanceMonitor from '../components/PerformanceMonitor.astro';

export interface Props {
  title: string;
  description: string;
  canonicalURL?: URL;
  ogImage?: URL;
  noIndex?: boolean;
}

const { 
  title, 
  description, 
  canonicalURL = new URL(Astro.url.pathname, Astro.site),
  ogImage = new URL('/og/og-image.jpg', Astro.url),
  noIndex = false
} = Astro.props;

const pricing = pricingData;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "TattooParlor",
  "name": "Cursed Ink Society",
  "description": "Premium tattoo collective in Houma, Louisiana featuring Anthony, Ashley, Cody, Seth, Luis, and Trent. Specializing in custom designs, traditional work, and mystical ink.",
  "url": canonicalURL.toString(),
  "logo": new URL('/brand/cursed-ink-logo.png', Astro.url).toString(),
  "telephone": "(985) 855-3826",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "488 Corporate Dr, STE 11",
    "addressLocality": "Houma",
    "addressRegion": "LA",
    "postalCode": "70360",
    "addressCountry": "US"
  },
  "openingHours": [
    "Mo-Th 13:00-20:00",
    "Fr-Sa 13:00-22:00",
    "Su 13:00-20:00"
  ],
  "sameAs": [
    "https://instagram.com/cursedinksociety",
    "https://facebook.com/cursedinksociety"
  ],
  "priceRange": "$$$",
  "areaServed": "Houma, Louisiana",
  "founder": [
    {"@type": "Person", "name": "Anthony Boudreaux"},
    {"@type": "Person", "name": "Ashley Wood"},
    {"@type": "Person", "name": "Cody Crochet"},
    {"@type": "Person", "name": "Seth Wood"},
    {"@type": "Person", "name": "Luis Reymundo"},
    {"@type": "Person", "name": "Trent"}
  ]
};
---

<!DOCTYPE html>
<html lang="en">
	<head>
    <!-- Essential Meta Tags -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, user-scalable=yes, minimum-scale=1.0, maximum-scale=5.0" />

    <!-- Mobile-specific performance optimizations -->
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Cursed Ink Society" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="msapplication-tap-highlight" content="no" />
    <meta name="theme-color" content="#dc143c" />
    <meta name="color-scheme" content="dark" />
    
    <!-- Additional theme colors for different platforms -->
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#dc143c" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0b0b0d" />
    
    <!-- Safari Pinned Tab -->
    <link rel="mask-icon" href="/favicon.svg" color="#dc143c" />
    
    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noIndex ? "noindex, nofollow" : "index, follow"} />
    <link rel="canonical" href={canonicalURL} />
    
    <!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Cursed Ink Society" />
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImage} />
    
    <!-- Comprehensive Favicon & Icon System -->
    <!-- Primary favicon with cache busting -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico?v=3" />
    <link rel="shortcut icon" type="image/x-icon" href="/favicon.ico?v=3" />
    
    <!-- Modern browsers (SVG favicon) -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=3" />
    
    <!-- PNG favicons for different sizes -->
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=3" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png?v=3" />
    
    <!-- Apple Touch Icons for iOS devices -->
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=3" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=3" />
    
    <!-- Android Chrome Icons -->
    <link rel="icon" type="image/png" sizes="192x192" href="/android-chrome-192x192.png?v=3" />
    <link rel="icon" type="image/png" sizes="512x512" href="/android-chrome-512x512.png?v=3" />
    
    <!-- Web App Manifest for PWA support -->
    <link rel="manifest" href="/site.webmanifest?v=3" />
    
    <!-- Microsoft Tiles for Windows -->
    <meta name="msapplication-TileColor" content="#dc143c" />
    <meta name="msapplication-TileImage" content="/android-chrome-192x192.png" />
    <meta name="msapplication-config" content="/browserconfig.xml" />
    
    <!-- Preload Critical Resources -->
    <link rel="preload" href="/brand/cursed-ink-logo.png?v=5" as="image" type="image/png" />
    
    <!-- Preload Critical Fonts with font-display swap for better performance -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;500;700;900&display=swap" as="style" onload="this.onload=null;this.rel='stylesheet'" />
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;500;700;900&display=swap" /></noscript>
    
    <!-- DNS Prefetch for External Resources -->
    <link rel="dns-prefetch" href="//formspree.io" />
    <link rel="dns-prefetch" href="//instagram.com" />
    
    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    
    <!-- Performance Hints -->
    <meta name="format-detection" content="telephone=no" />
    <meta name="msapplication-tap-highlight" content="no" />
  </head>
  
  <body>
    <!-- Scroll and Loading Manager -->
    <ScrollManager />
    <OptimizedThreeLoader />
    <PerformanceMonitor />
    
    <!-- Skip Link for Accessibility -->
    <a href="#main-content" class="skip-link">Skip to main content</a>
    
    <!-- Navigation -->
    <nav class="main-nav" role="navigation" aria-label="Main navigation">
      <!-- Screen reader announcements -->
      <div id="nav-announcements" aria-live="polite" aria-atomic="true" class="sr-only"></div>
      <div class="container nav-container">
        <a href="/homepage" class="nav-logo" aria-label="Cursed Ink Society Home">
          <img src="/brand/cursed-ink-logo.png?v=5" alt="Cursed Ink Society" width="60" height="60" />
        </a>
        
        <button class="nav-toggle" aria-expanded="false" aria-controls="nav-menu" aria-label="Toggle navigation">
          <span></span>
          <span></span>
          <span></span>
        </button>
        
        <div class="nav-menu" id="nav-menu" role="navigation" aria-label="Mobile navigation menu">
          <ul class="nav-links">
            <li><a href="/homepage" class="nav-link">Home</a></li>
            <li><a href="/artists" class="nav-link">Artists</a></li>
            <li><a href="/gallery" class="nav-link">Gallery</a></li>
            <li class="nav-item-with-dropdown">
              <a href="/services" class="nav-link nav-link-pricing" aria-expanded="false" aria-haspopup="true" aria-controls="pricing-dropdown">Pricing</a>
              <div class="pricing-dropdown" id="pricing-dropdown" role="menu" aria-labelledby="nav-link-pricing">
                <div class="pricing-dropdown-content">
                  <div class="pricing-essentials">
                    <div class="pricing-grid-mini">
                      <div class="pricing-item-mini">
                        <span class="pricing-label-mini">Deposit</span>
                        <span class="pricing-value-mini">{pricing.essentials.deposit.amount} {pricing.essentials.deposit.refundable ? 'refundable' : 'non-refundable'}</span>
                      </div>
                      <div class="pricing-item-mini">
                        <span class="pricing-label-mini">Minimum</span>
                        <span class="pricing-value-mini">{pricing.essentials.minimum.amount}</span>
                      </div>
                    </div>
                    <div class="pricing-features-mini">
                      <div class="feature-mini">✓ {pricing.essentials.styles}</div>
                      <div class="feature-mini">✓ {pricing.essentials.walkIns}</div>
                      <div class="feature-mini">✓ {pricing.essentials.contact}</div>
                      <div class="feature-mini">✓ {pricing.essentials.consultation.description}</div>
                    </div>
                  </div>
                  <div class="pricing-cta-mini">
                    <a href={pricing.cta.primary.href} class="btn btn--primary btn--mini">{pricing.cta.primary.text}</a>
                    <div class="pricing-contact-mini">
                      <a href={`tel:${pricing.cta.primary.phone.replace(/[^0-9+]/g, '')}`} class="contact-phone-mini">{pricing.cta.primary.phone}</a>
                      <a href={`https://instagram.com/${pricing.contact.instagram.replace('@', '')}`} target="_blank" class="contact-instagram-mini">{pricing.contact.instagram}</a>
                    </div>
                  </div>
                </div>
              </div>
            </li>
            <li><a href="/about" class="nav-link">About</a></li>
            <li><a href="/contact" class="nav-link">Contact</a></li>
          </ul>
          <div class="nav-cta">
            <a href="/contact" class="btn btn--primary">Start Your Journey</a>
          </div>
        </div>
      </div>
    </nav>

    <main id="main-content">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="main-footer">
      <div class="container">
        <!-- Main Footer Content - Centered -->
        <div class="footer-content">
          <!-- Brand Section - Centered -->
          <div class="footer-brand">
            <img src="/brand/cursed-ink-logo.png?v=5" alt="Cursed Ink Society" width="60" height="60" class="footer-logo" />
            <h3 class="footer-title">Cursed Ink Society</h3>
            <p class="footer-tagline">Where artistry meets the mystical</p>
          </div>
          
          <!-- Navigation Links - Horizontal -->
          <nav class="footer-nav" role="navigation" aria-label="Footer navigation">
            <a href="/artists" class="footer-link">Artists</a>
            <a href="/gallery" class="footer-link">Gallery</a>
            <a href="/about" class="footer-link">About</a>
            <a href="/contact" class="footer-link">Contact</a>
          </nav>
          
          <!-- Contact Info - Compact -->
          <div class="footer-contact">
            <p class="contact-location">488 Corporate Dr, STE 11, Houma, LA 70360</p>
            <p class="contact-hours">Mon-Thu: 1PM-8PM • Fri-Sat: 1PM-10PM • Sun: Appt Only</p>
            <p class="contact-phone"><a href="tel:+19858553826" class="contact-link">(985) 855-3826</a></p>
            <p class="contact-services">Tattoo • Piercing</p>
          </div>

          <!-- CTA Section -->
          <div class="footer-cta">
            <a href="/contact" class="btn btn--primary btn--footer">Contact Us</a>
          </div>

          <!-- Social Links -->
          <div class="footer-social">
            <a href="https://instagram.com/cursedinksociety" aria-label="Instagram" rel="noopener" target="_blank" class="social-link">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                <path d="M7 2h10a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5V7a5 5 0 0 1 5-5zm5 5a5 5 0 1 0 .001 10.001A5 5 0 0 0 12 7zm0 2.2a2.8 2.8 0 1 1 0 5.6 2.8 2.8 0 0 1 0-5.6zM18 6.5a1 1 0 1 0 0 2 1 1 0 0 0 0-2z"/>
              </svg>
            </a>
            <a href="https://facebook.com/cursedinksociety" aria-label="Facebook" rel="noopener" target="_blank" class="social-link">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
            </a>
            <a href="tel:+19858553826" aria-label="Phone: (985) 855-3826" class="social-link">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                <path d="M6.62 10.79a15.05 15.05 0 006.59 6.59l2.2-2.2a1 1 0 011.11-.21 11.36 11.36 0 003.57.57 1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1 11.36 11.36 0 00.57 3.57 1 1 0 01-.21 1.11z"/>
              </svg>
            </a>
          </div>
        </div>

        <!-- Footer Bottom - Copyright & Legal -->
        <div class="footer-bottom">
          <div class="footer-copyright">
            <small>© {new Date().getFullYear()} Cursed Ink Society LLC — forged in fire & pigment</small>
            <small class="footer-credit">Website Designed and Developed by Zero Motion Marketing</small>
          </div>
          <div class="footer-legal">
            <a href="/privacy" class="legal-link">Privacy</a>
            <span class="legal-separator">•</span>
            <a href="/terms" class="legal-link">Terms</a>
          </div>
        </div>
      </div>
    </footer>

    <!-- Navigation JavaScript -->
		<script>
      // Enhanced navigation with accessibility and pricing dropdown
      class Navigation {
        private navToggle: HTMLElement | null;
        private navMenu: HTMLElement | null;
        private navLinks: NodeListOf<HTMLElement>;
        private pricingDropdown: HTMLElement | null;
        private pricingTrigger: HTMLElement | null;
        private announcements: HTMLElement | null;
        private isOpen: boolean;
        private pricingOpen: boolean;
        private isMobile: boolean;
        private isSmallMobile: boolean;

        constructor() {
          this.navToggle = document.querySelector('.nav-toggle');
          this.navMenu = document.querySelector('.nav-menu');
          this.navLinks = document.querySelectorAll('.nav-link');
          this.pricingDropdown = document.querySelector('.pricing-dropdown');
          this.pricingTrigger = document.querySelector('.nav-link-pricing');
          this.announcements = document.querySelector('#nav-announcements');
          this.isOpen = false;
          this.pricingOpen = false;
          this.isMobile = window.innerWidth <= 768;
          this.isSmallMobile = window.innerWidth <= 480;
          
          this.init();
        }

        private announce(message: string): void {
          if (this.announcements) {
            this.announcements.textContent = message;
          }
        }

        init(): void {
          if (!this.navToggle || !this.navMenu) return;
          
          this.navToggle.addEventListener('click', this.toggleMenu.bind(this));
          
          // Close menu when clicking nav links (except pricing dropdown trigger)
          this.navLinks.forEach((link: HTMLElement) => {
            if (!link.classList.contains('nav-link-pricing')) {
              link.addEventListener('click', () => this.closeMenu());
            }
          });
          
          // Handle pricing dropdown
          this.initPricingDropdown();
          
          // Close menu when clicking outside
          document.addEventListener('click', (e: Event) => {
            const target = e.target as HTMLElement;
            
            // Close main mobile menu when clicking outside
            if (target && !target.closest('.main-nav') && this.isOpen) {
              this.closeMenu();
            }
            
            // Close pricing dropdown when clicking outside
            if (target && !target.closest('.nav-item-with-dropdown') && this.pricingOpen) {
              this.closePricingDropdown();
            }
            
            // Also close pricing dropdown when clicking on other nav links
            if (target && target.closest('.nav-link') && !target.closest('.nav-link-pricing') && this.pricingOpen) {
              this.closePricingDropdown();
            }
          });
          
          // Handle escape key and mobile menu navigation
          document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
              if (this.pricingOpen) {
                this.closePricingDropdown();
              } else if (this.isOpen) {
                this.closeMenu();
              }
            }

            // Enhanced mobile menu keyboard navigation
            if (this.isOpen && this.isMobile && this.navMenu) {
              const navLinks = Array.from(this.navMenu.querySelectorAll('.nav-link, .btn--mini, .contact-phone-mini, .contact-instagram-mini')) as HTMLElement[];
              const currentFocus = document.activeElement as HTMLElement;
              const currentIndex = navLinks.indexOf(currentFocus);

              if (currentIndex !== -1) {
                switch (e.key) {
                  case 'ArrowDown':
                    e.preventDefault();
                    const nextIndex = (currentIndex + 1) % navLinks.length;
                    navLinks[nextIndex].focus();
                    break;
                  case 'ArrowUp':
                    e.preventDefault();
                    const prevIndex = currentIndex === 0 ? navLinks.length - 1 : currentIndex - 1;
                    navLinks[prevIndex].focus();
                    break;
                  case 'Home':
                    e.preventDefault();
                    navLinks[0].focus();
                    break;
                  case 'End':
                    e.preventDefault();
                    navLinks[navLinks.length - 1].focus();
                    break;
                }
              }
            }
          });
          
          // Handle window resize
          window.addEventListener('resize', () => {
            const wasMobile = this.isMobile;
            this.isMobile = window.innerWidth <= 768;
            this.isSmallMobile = window.innerWidth <= 480;
            
            if (!this.isMobile && this.isOpen) {
              this.closeMenu();
            }
            
            // Reinitialize pricing dropdown if mobile state changed
            if (wasMobile !== this.isMobile) {
              this.closePricingDropdown();
            }
          });
          
          // Set active nav link
          this.setActiveLink();
          
          // Setup transparent navbar on scroll
          this.setupScrollTransparency();
        }

        setupScrollTransparency(): void {
          const nav = document.querySelector('.main-nav');
          let ticking = false;

          const updateNavTransparency = () => {
            const scrolled = window.pageYOffset;
            const threshold = 100; // Start transparency after 100px scroll
            
            if (scrolled > threshold) {
              nav?.classList.add('nav-transparent');
            } else {
              nav?.classList.remove('nav-transparent');
            }
            
            ticking = false;
          };

          const requestTick = () => {
            if (!ticking) {
              requestAnimationFrame(updateNavTransparency);
              ticking = true;
            }
          };

          window.addEventListener('scroll', requestTick, { passive: true });
        }

        toggleMenu(): void {
          this.isOpen ? this.closeMenu() : this.openMenu();
        }

        openMenu(): void {
          if (!this.navMenu || !this.navToggle) return;

          this.isOpen = true;
          this.navMenu.classList.add('nav-menu--open');
          this.navToggle.classList.add('nav-toggle--open');
          this.navToggle.setAttribute('aria-expanded', 'true');
          document.body.style.overflow = 'hidden';

          // Scroll to top when opening mobile menu for better UX
          if (this.isMobile && this.navMenu) {
            this.navMenu.scrollTop = 0;
          }

          // Focus management for accessibility
          if (this.isMobile) {
            // Announce menu opening
            this.announce('Mobile navigation menu opened');

            // Focus first nav link after menu opens
            const firstNavLink = this.navMenu.querySelector('.nav-link') as HTMLElement;
            if (firstNavLink) {
              setTimeout(() => firstNavLink.focus(), 300); // Wait for animation
            }
          }
        }

        closeMenu(): void {
          if (!this.navMenu || !this.navToggle) return;

          this.isOpen = false;
          this.navMenu.classList.remove('nav-menu--open');
          this.navToggle.classList.remove('nav-toggle--open');
          this.navToggle.setAttribute('aria-expanded', 'false');
          document.body.style.overflow = '';

          // Reset mobile menu scroll position after closing
          if (this.isMobile && this.navMenu) {
            this.navMenu.scrollTop = 0;
          }

          // Return focus to toggle button for accessibility
          if (this.navToggle) {
            this.navToggle.focus();
          }

          // Announce menu closing
          if (this.isMobile) {
            this.announce('Mobile navigation menu closed');
          }
        }

        initPricingDropdown(): void {
          if (!this.pricingTrigger || !this.pricingDropdown) return;

          // Click to toggle (both mobile and desktop)
          this.pricingTrigger.addEventListener('click', (e: Event) => {
            e.preventDefault();
            e.stopPropagation();
            // Update mobile detection on each click for accuracy
            this.isMobile = window.innerWidth <= 768;
            this.isSmallMobile = window.innerWidth <= 480;
            this.togglePricingDropdown();
          });

          if (!this.isMobile) {
            // Desktop: Hover to show, with delay for better UX
            let hoverTimeout: NodeJS.Timeout;
            
            const dropdownContainer = this.pricingTrigger.closest('.nav-item-with-dropdown');
            if (dropdownContainer) {
              dropdownContainer.addEventListener('mouseenter', () => {
                clearTimeout(hoverTimeout);
                this.openPricingDropdown();
              });

              dropdownContainer.addEventListener('mouseleave', () => {
                hoverTimeout = setTimeout(() => {
                  this.closePricingDropdown();
                }, 150); // Small delay to prevent flickering
              });
            }
          }

          // Close mobile menu when clicking CTA links inside dropdown
          const dropdownLinks = this.pricingDropdown.querySelectorAll('a');
          dropdownLinks.forEach((link: HTMLElement) => {
            link.addEventListener('click', () => {
              if (this.isMobile) {
                this.closeMenu();
              }
            });
          });

          // Keyboard accessibility
          this.pricingTrigger.addEventListener('keydown', (e: KeyboardEvent) => {
            if (e.key === 'Enter' || e.key === ' ') {
              e.preventDefault();
              this.togglePricingDropdown();
            }
          });
        }

        togglePricingDropdown(): void {
          this.pricingOpen ? this.closePricingDropdown() : this.openPricingDropdown();
        }

        openPricingDropdown(): void {
          if (!this.pricingDropdown) return;

          this.pricingOpen = true;
          this.pricingDropdown.classList.add('pricing-dropdown--open');

          // Add state class to parent for additional styling hooks
          const parent = this.pricingTrigger?.closest('.nav-item-with-dropdown');
          if (parent) {
            parent.classList.add('dropdown-open');
          }

          // Add ARIA attributes for accessibility
          if (this.pricingTrigger) {
            this.pricingTrigger.setAttribute('aria-expanded', 'true');
          }

          // Ensure proper centering on mobile
          if (this.isMobile && this.pricingDropdown) {
            // Force reflow to ensure proper positioning
            this.pricingDropdown.style.margin = '0.5rem auto';
            this.pricingDropdown.style.left = 'auto';
            this.pricingDropdown.style.right = 'auto';
            this.pricingDropdown.style.transform = 'none';
          }
        }

        closePricingDropdown(): void {
          if (!this.pricingDropdown) return;

          this.pricingOpen = false;
          this.pricingDropdown.classList.remove('pricing-dropdown--open');

          // Remove state class from parent
          const parent = this.pricingTrigger?.closest('.nav-item-with-dropdown');
          if (parent) {
            parent.classList.remove('dropdown-open');
          }

          // Update ARIA attributes
          if (this.pricingTrigger) {
            this.pricingTrigger.setAttribute('aria-expanded', 'false');
          }

          // Reset any inline styles that might have been applied
          if (this.pricingDropdown) {
            this.pricingDropdown.style.margin = '';
            this.pricingDropdown.style.left = '';
            this.pricingDropdown.style.right = '';
            this.pricingDropdown.style.transform = '';
          }

          // Announce dropdown closing for accessibility
          if (this.isMobile) {
            this.announce('Pricing menu closed');
          }
        }

        setActiveLink(): void {
          const currentPath = window.location.pathname;
          this.navLinks.forEach((link: HTMLElement) => {
            const href = link.getAttribute('href');
            if (href === currentPath || (currentPath === '/' && href === '/')) {
              link.classList.add('nav-link--active');
            }
          });
        }
      }

      // Initialize navigation when DOM is ready
