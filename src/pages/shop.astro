---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import content from '../data/content.json';

const title = "Shop — Cursed Ink Society";
const description = "Browse our premium aftercare products, studio merchandise, flash designs, and gift cards. Quality products for tattoo enthusiasts in Houma, LA.";

const products = content.products.items;
const categories = content.products.categories;

// Get unique tags for filtering
const allTags = [...new Set(products.flatMap(product => product.tags))].sort();
---

<Layout title={title} description={description}>
  <!-- Hero Section -->
  <section class="shop-hero">
    <div class="container">
      <div class="hero-content">
        <span class="badge">Premium Products</span>
        <h1 class="hero-title shine">Studio Shop</h1>
        <p class="hero-description">
          Discover our curated collection of premium aftercare products, official merchandise,
          digital flash designs, and gift cards for tattoo enthusiasts.
        </p>
      </div>
    </div>
  </section>

  <!-- Shop Interface -->
  <section class="shop-section">
    <div class="container">
      <div class="shop-layout">
        <!-- Filters Sidebar -->
        <aside class="shop-sidebar">
          <div class="filter-section">
            <h3 class="filter-title">Categories</h3>
            <div class="filter-options">
              <label class="filter-option">
                <input type="radio" name="category" value="all" checked />
                <span>All Products</span>
              </label>
              {Object.entries(categories).map(([key, category]) => (
                <label class="filter-option">
                  <input type="radio" name="category" value={key} />
                  <span>{category.name}</span>
                </label>
              ))}
            </div>
          </div>

          <div class="filter-section">
            <h3 class="filter-title">Price Range</h3>
            <div class="price-filter">
              <div class="price-inputs">
                <input type="number" id="minPrice" placeholder="Min" min="0" />
                <span>-</span>
                <input type="number" id="maxPrice" placeholder="Max" min="0" />
              </div>
              <button class="btn btn--small" id="applyPriceFilter">Apply</button>
            </div>
          </div>

          <div class="filter-section">
            <h3 class="filter-title">Tags</h3>
            <div class="tag-filters">
              {allTags.map(tag => (
                <label class="tag-filter">
                  <input type="checkbox" value={tag} />
                  <span>{tag.charAt(0).toUpperCase() + tag.slice(1)}</span>
                </label>
              ))}
            </div>
          </div>
        </aside>

        <!-- Products Grid -->
        <main class="shop-main">
          <div class="shop-header">
            <div class="results-count">
              <span id="productCount">{products.length}</span> products
            </div>
            <div class="sort-options">
              <select id="sortSelect">
                <option value="featured">Featured First</option>
                <option value="price-low">Price: Low to High</option>
                <option value="price-high">Price: High to Low</option>
                <option value="name">Name A-Z</option>
              </select>
            </div>
          </div>

          <div class="products-grid" id="productsGrid">
            {products.map(product => (
              <article class="product-card" data-category={product.category} data-price={product.price} data-tags={product.tags.join(',')}>
                <div class="product-image">
                  <img src={product.images[0]} alt={product.name} loading="lazy" />
                  {product.originalPrice && (
                    <div class="sale-badge">Sale</div>
                  )}
                  <div class="product-overlay">
                    <button class="btn btn--small quick-view-btn" data-product-id={product.id}>
                      Quick View
                    </button>
                  </div>
                </div>

                <div class="product-info">
                  <div class="product-category">{categories[product.category]?.name}</div>
                  <h3 class="product-title">
                    <a href={`/shop/${product.id}`}>{product.name}</a>
                  </h3>
                  <p class="product-description">{product.description}</p>

                  <div class="product-price">
                    {product.originalPrice ? (
                      <>
                        <span class="original-price">${product.originalPrice}</span>
                        <span class="sale-price">${product.price}</span>
                      </>
                    ) : (
                      <span class="current-price">${product.price}</span>
                    )}
                  </div>

                  <div class="product-tags">
                    {product.tags.slice(0, 3).map(tag => (
                      <span class="tag">{tag}</span>
                    ))}
                  </div>

                  <div class="product-actions">
                    <button class="btn btn--outline btn--small add-to-cart-btn" data-product-id={product.id}>
                      Add to Cart
                    </button>
                    <a href={`/shop/${product.id}`} class="btn btn--small">
                      View Details
                    </a>
                  </div>
                </div>
              </article>
            ))}
          </div>

          <!-- Load More Button -->
          <div class="load-more-container">
            <button class="btn btn--outline" id="loadMoreBtn" style="display: none;">
              Load More Products
            </button>
          </div>
        </main>
      </div>
    </div>
  </section>

  <!-- Quick View Modal -->
  <div class="modal" id="quickViewModal">
    <div class="modal-overlay" id="modalOverlay"></div>
    <div class="modal-content">
      <button class="modal-close" id="modalClose">&times;</button>
      <div id="modalContent"></div>
    </div>
  </div>
</Layout>

<script>
  class ShopManager {
    constructor() {
      this.products = {products};
      this.categories = {categories};
      this.filteredProducts = [...this.products];
      this.currentPage = 1;
      this.productsPerPage = 12;

      this.init();
    }

    init() {
      // Filter controls
      this.categoryFilters = document.querySelectorAll('input[name="category"]');
      this.tagFilters = document.querySelectorAll('.tag-filter input');
      this.minPriceInput = document.getElementById('minPrice');
      this.maxPriceInput = document.getElementById('maxPrice');
      this.applyPriceBtn = document.getElementById('applyPriceFilter');
      this.sortSelect = document.getElementById('sortSelect');
      this.productCount = document.getElementById('productCount');
      this.productsGrid = document.getElementById('productsGrid');
      this.loadMoreBtn = document.getElementById('loadMoreBtn');

      // Modal elements
      this.quickViewModal = document.getElementById('quickViewModal');
      this.modalOverlay = document.getElementById('modalOverlay');
      this.modalClose = document.getElementById('modalClose');
      this.modalContent = document.getElementById('modalContent');

      this.bindEvents();
      this.updateProductCount();
      this.renderProducts();
    }

    bindEvents() {
      // Category filters
      this.categoryFilters.forEach(filter => {
        filter.addEventListener('change', () => this.filterProducts());
      });

      // Tag filters
      this.tagFilters.forEach(filter => {
        filter.addEventListener('change', () => this.filterProducts());
      });

      // Price filter
      this.applyPriceBtn.addEventListener('click', () => this.filterProducts());

      // Sort
      this.sortSelect.addEventListener('change', () => this.sortProducts());

      // Quick view
      document.addEventListener('click', (e) => {
        if (e.target.classList.contains('quick-view-btn')) {
          const productId = e.target.dataset.productId;
          this.showQuickView(productId);
        }
      });

      // Modal close
      this.modalClose.addEventListener('click', () => this.closeModal());
      this.modalOverlay.addEventListener('click', () => this.closeModal());

      // Load more
      this.loadMoreBtn.addEventListener('click', () => this.loadMoreProducts());
    }

    filterProducts() {
      const selectedCategory = document.querySelector('input[name="category"]:checked').value;
      const selectedTags = Array.from(this.tagFilters)
        .filter(cb => cb.checked)
        .map(cb => cb.value);
      const minPrice = parseFloat(this.minPriceInput.value) || 0;
      const maxPrice = parseFloat(this.maxPriceInput.value) || Infinity;

      this.filteredProducts = this.products.filter(product => {
        // Category filter
        if (selectedCategory !== 'all' && product.category !== selectedCategory) {
          return false;
        }

        // Tag filter
        if (selectedTags.length > 0) {
          const hasMatchingTag = selectedTags.some(tag => product.tags.includes(tag));
          if (!hasMatchingTag) return false;
        }

        // Price filter
        if (product.price < minPrice || product.price > maxPrice) {
          return false;
        }

        return true;
      });

      this.currentPage = 1;
      this.updateProductCount();
      this.renderProducts();
    }

    sortProducts() {
      const sortBy = this.sortSelect.value;

      this.filteredProducts.sort((a, b) => {
        switch (sortBy) {
          case 'price-low':
            return a.price - b.price;
          case 'price-high':
            return b.price - a.price;
          case 'name':
            return a.name.localeCompare(b.name);
          case 'featured':
          default:
            return (b.featured ? 1 : 0) - (a.featured ? 1 : 0);
        }
      });

      this.renderProducts();
    }

    updateProductCount() {
      this.productCount.textContent = this.filteredProducts.length;
    }

    renderProducts() {
      const startIndex = 0;
      const endIndex = this.currentPage * this.productsPerPage;
      const productsToShow = this.filteredProducts.slice(startIndex, endIndex);

      this.productsGrid.innerHTML = productsToShow.map(product => this.createProductHTML(product)).join('');

      // Show/hide load more button
      this.loadMoreBtn.style.display = endIndex < this.filteredProducts.length ? 'block' : 'none';
    }

    createProductHTML(product) {
      const category = this.categories[product.category];
      const originalPriceHTML = product.originalPrice ?
        `<span class="original-price">$${product.originalPrice}</span>` : '';
      const priceHTML = product.originalPrice ?
        `<span class="sale-price">$${product.price}</span>` :
        `<span class="current-price">$${product.price}</span>`;

      return `
        <article class="product-card" data-category="${product.category}" data-price="${product.price}" data-tags="${product.tags.join(',')}">
          <div class="product-image">
            <img src="${product.images[0]}" alt="${product.name}" loading="lazy" />
            ${product.originalPrice ? '<div class="sale-badge">Sale</div>' : ''}
            <div class="product-overlay">
              <button class="btn btn--small quick-view-btn" data-product-id="${product.id}">
                Quick View
              </button>
            </div>
          </div>

          <div class="product-info">
            <div class="product-category">${category?.name}</div>
            <h3 class="product-title">
              <a href="/shop/${product.id}">${product.name}</a>
            </h3>
            <p class="product-description">${product.description}</p>

            <div class="product-price">
              ${originalPriceHTML}
              ${priceHTML}
            </div>

            <div class="product-tags">
              ${product.tags.slice(0, 3).map(tag => `<span class="tag">${tag}</span>`).join('')}
            </div>

            <div class="product-actions">
              <button class="btn btn--outline btn--small add-to-cart-btn" data-product-id="${product.id}">
                Add to Cart
              </button>
              <a href="/shop/${product.id}" class="btn btn--small">
                View Details
              </a>
            </div>
          </div>
        </article>
      `;
    }

    loadMoreProducts() {
      this.currentPage++;
      this.renderProducts();
    }

    showQuickView(productId) {
      const product = this.products.find(p => p.id === productId);
      if (!product) return;

      const category = this.categories[product.category];

      this.modalContent.innerHTML = `
        <div class="quick-view-content">
          <div class="quick-view-image">
            <img src="${product.images[0]}" alt="${product.name}" />
          </div>

          <div class="quick-view-details">
            <div class="product-category">${category?.name}</div>
            <h2 class="product-title">${product.name}</h2>
            <p class="product-description">${product.description}</p>

            <div class="product-price">
              ${product.originalPrice ? `<span class="original-price">$${product.originalPrice}</span>` : ''}
              <span class="${product.originalPrice ? 'sale-price' : 'current-price'}">$${product.price}</span>
            </div>

            <div class="product-features">
              <h4>Features:</h4>
              <ul>
                ${product.features.map(feature => `<li>${feature}</li>`).join('')}
              </ul>
            </div>

            <div class="product-tags">
              ${product.tags.map(tag => `<span class="tag">${tag}</span>`).join('')}
            </div>

            <div class="quick-view-actions">
              <button class="btn btn--outline add-to-cart-btn" data-product-id="${product.id}">
                Add to Cart
              </button>
              <a href="/shop/${product.id}" class="btn">
                View Full Details
              </a>
            </div>
          </div>
        </div>
      `;

      this.quickViewModal.classList.add('modal--active');
      document.body.style.overflow = 'hidden';
    }

    closeModal() {
      this.quickViewModal.classList.remove('modal--active');
      document.body.style.overflow = '';
    }
  }

  // Initialize shop when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => new ShopManager());
  } else {
    new ShopManager();
  }
</script>

<style>
  /* Shop Hero */
  .shop-hero {
    padding: 8rem 0 4rem;
    text-align: center;
    background:
      radial-gradient(1000px 600px at 50% 20%, rgba(255, 60, 43, 0.03) 0%, transparent 60%);
  }

  .shop-hero .hero-title {
    font-size: clamp(3rem, 6vw, 4.5rem);
    margin: 1rem 0 1.5rem;
    line-height: 1.1;
  }

  .shop-hero .hero-description {
    font-size: 1.2rem;
    line-height: 1.6;
    opacity: 0.9;
    margin: 0;
    max-width: 700px;
    margin: 0 auto;
  }

  /* Shop Layout */
  .shop-layout {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 3rem;
    align-items: start;
  }

  /* Sidebar */
  .shop-sidebar {
    background: var(--bg-glass);
    border: var(--border-glass);
    border-radius: 16px;
    padding: 2rem;
    backdrop-filter: blur(10px);
    position: sticky;
    top: 2rem;
  }

  .filter-section {
    margin-bottom: 2rem;
  }

  .filter-section:last-child {
    margin-bottom: 0;
  }

  .filter-title {
    font-size: 1.1rem;
    margin: 0 0 1rem;
    color: var(--accent0);
    text-shadow: var(--glow-subtle);
  }

  .filter-options {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .filter-option {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    cursor: pointer;
    padding: 0.5rem;
    border-radius: 8px;
    transition: var(--transition-smooth);
  }

  .filter-option:hover {
    background: rgba(255, 255, 255, 0.05);
  }

  .filter-option input[type="radio"] {
    margin: 0;
  }

  .filter-option span {
    font-size: 0.9rem;
    color: var(--ink);
  }

  .price-filter {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .price-inputs {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .price-inputs input {
    flex: 1;
    padding: 0.5rem;
    border: var(--border-glass);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.03);
    color: var(--ink);
    font-size: 0.9rem;
  }

  .tag-filters {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .tag-filter {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
    padding: 0.25rem 0;
  }

  .tag-filter input[type="checkbox"] {
    margin: 0;
  }

  .tag-filter span {
    font-size: 0.85rem;
    color: var(--ink);
    opacity: 0.8;
  }

  /* Main Content */
  .shop-main {
    min-height: 600px;
  }

  .shop-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: var(--border-glass);
  }

  .results-count {
    font-size: 1rem;
    color: var(--ink);
    opacity: 0.8;
  }

  .sort-options select {
    padding: 0.5rem 1rem;
    border: var(--border-glass);
    border-radius: 8px;
    background: var(--bg-glass);
    color: var(--ink);
    font-size: 0.9rem;
    backdrop-filter: blur(5px);
  }

  /* Products Grid */
  .products-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 2rem;
    margin-bottom: 3rem;
  }

  .product-card {
    background: var(--bg-glass);
    border: var(--border-glass);
    border-radius: 16px;
    overflow: hidden;
    backdrop-filter: blur(10px);
    transition: var(--transition-smooth);
  }

  .product-card:hover {
    transform: translateY(-4px);
    border-color: rgba(255, 60, 43, 0.3);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
  }

  .product-image {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
  }

  .product-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: var(--transition-smooth);
  }

  .product-card:hover .product-image img {
    transform: scale(1.05);
  }

  .sale-badge {
    position: absolute;
    top: 1rem;
    left: 1rem;
    background: var(--accent0);
    color: var(--bg0);
    padding: 0.25rem 0.75rem;
    border-radius: 20px;
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .product-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.7);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: var(--transition-smooth);
  }

  .product-card:hover .product-overlay {
    opacity: 1;
  }

  .product-info {
    padding: 1.5rem;
  }

  .product-category {
    font-size: 0.8rem;
    color: var(--accent0);
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 0.5rem;
    font-weight: 600;
  }

  .product-title {
    font-size: 1.1rem;
    margin: 0 0 0.75rem;
    line-height: 1.3;
  }

  .product-title a {
    color: var(--ink);
    text-decoration: none;
    text-shadow: var(--glow-subtle);
  }

  .product-title a:hover {
    color: var(--accent0);
  }

  .product-description {
    font-size: 0.9rem;
    opacity: 0.8;
    line-height: 1.4;
    margin: 0 0 1rem;
  }

  .product-price {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .current-price,
  .sale-price {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--accent0);
  }

  .original-price {
    font-size: 1rem;
    opacity: 0.6;
    text-decoration: line-through;
  }

  .product-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .tag {
    font-size: 0.75rem;
    background: rgba(255, 60, 43, 0.1);
    color: var(--accent0);
    padding: 0.25rem 0.5rem;
    border-radius: 12px;
    text-transform: lowercase;
  }

  .product-actions {
    display: flex;
    gap: 0.75rem;
  }

  .product-actions .btn {
    flex: 1;
    text-align: center;
  }

  /* Load More */
  .load-more-container {
    text-align: center;
  }

  /* Modal */
  .modal {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition: var(--transition-smooth);
  }

  .modal--active {
    opacity: 1;
    visibility: visible;
  }

  .modal-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.8);
    backdrop-filter: blur(5px);
  }

  .modal-content {
    position: relative;
    background: var(--bg-glass);
    border: var(--border-glass);
    border-radius: 20px;
    max-width: 800px;
    width: 90vw;
    max-height: 90vh;
    overflow-y: auto;
    backdrop-filter: blur(15px);
    margin: 2rem;
  }

  .modal-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: none;
    border: none;
    font-size: 2rem;
    color: var(--ink);
    cursor: pointer;
    z-index: 1;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.2);
  }

  .quick-view-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    padding: 3rem 2rem;
  }

  .quick-view-image {
    aspect-ratio: 1;
    border-radius: 12px;
    overflow: hidden;
  }

  .quick-view-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .quick-view-details .product-category {
    margin-bottom: 0.5rem;
  }

  .quick-view-details .product-title {
    font-size: 1.5rem;
    margin: 0 0 1rem;
  }

  .quick-view-details .product-price {
    margin: 1rem 0 1.5rem;
  }

  .product-features {
    margin: 1.5rem 0;
  }

  .product-features h4 {
    font-size: 1rem;
    margin: 0 0 0.75rem;
    color: var(--accent0);
  }

  .product-features ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .product-features li {
    font-size: 0.9rem;
    opacity: 0.9;
    margin-bottom: 0.5rem;
    padding-left: 1rem;
    position: relative;
  }

  .product-features li:before {
    content: "✓";
    position: absolute;
    left: 0;
    color: var(--accent0);
    font-weight: 600;
  }

  .quick-view-details .product-tags {
    margin: 1rem 0 2rem;
  }

  .quick-view-actions {
    display: flex;
    gap: 1rem;
  }

  .quick-view-actions .btn {
    flex: 1;
    text-align: center;
  }

  /* Mobile Optimizations */
  @media (max-width: 1024px) {
    .shop-layout {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .shop-sidebar {
      position: static;
      order: 2;
    }

    .products-grid {
      grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
      gap: 1.5rem;
    }
  }

  @media (max-width: 768px) {
    .shop-hero {
      padding: 6rem 0 3rem;
    }

    .shop-header {
      flex-direction: column;
      align-items: stretch;
      gap: 1rem;
    }

    .products-grid {
      grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    }

    .product-actions {
      flex-direction: column;
    }

    .quick-view-content {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      padding: 2rem 1.5rem;
    }

    .modal-content {
      margin: 1rem;
      width: calc(100vw - 2rem);
    }
  }

  /* Reduced motion support */
  @media (prefers-reduced-motion: reduce) {
    .product-card:hover,
    .product-card:hover .product-image img,
    .product-card:hover .product-overlay,
    .modal {
      transform: none;
      transition: none;
    }
  }
