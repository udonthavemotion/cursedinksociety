<!-- JavaScript for scroll animations -->
<script>
  // Initialize fade-up animations
  const fadeUpElements = document.querySelectorAll('.animate-fade-up');
  fadeUpElements.forEach((el, index) => {
    setTimeout(() => {
      (el as HTMLElement).style.animationDelay = `${index * 0.1}s`;
    }, 100);
  });

  // Intersection Observer for scroll animations
  const observerOptions = {
    threshold: 0.1,
    rootMargin: '0px 0px -50px 0px'
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
      }
    });
  }, observerOptions);

  // Observe all animate-on-scroll elements
  document.querySelectorAll('.animate-on-scroll').forEach(el => {
    observer.observe(el);
  });

  // Enhanced observer for gallery items with parallax effects
  const galleryObserver = new IntersectionObserver((entries) => {
    entries.forEach((entry, index) => {
      if (entry.isIntersecting) {
        setTimeout(() => {
          entry.target.classList.add('visible');
        }, index * 200);
      }
    });
  }, {
    threshold: 0.2,
    rootMargin: '0px 0px -100px 0px'
  });

  // Video Container Specific Observer for Consistent Animations
  const videoContainerObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      const videoContainer = entry.target;
      if (entry.isIntersecting) {
        // Add staggered delay based on container position
        const allContainers = Array.from(document.querySelectorAll('.video-container'));
        const delay = allContainers.indexOf(videoContainer) * 400;
        setTimeout(() => {
          videoContainer.classList.add('in-view');
        }, delay);
      }
    });
  }, {
    threshold: 0.3,
    rootMargin: '0px 0px -50px 0px'
  });

  // Observe gallery items separately for enhanced effect
  document.querySelectorAll('.gallery-item').forEach(el => {
    galleryObserver.observe(el);
  });

  // Observe video containers specifically for consistent animations
  document.querySelectorAll('.video-container').forEach(container => {
    videoContainerObserver.observe(container);
  });

  // Advanced Parallax Scrolling System
  let ticking = false;
  
  function updateParallax() {
    const scrollTop = window.pageYOffset;
    const windowHeight = window.innerHeight;
    
    document.querySelectorAll('.gallery-item[data-scroll-speed]').forEach(item => {
      const rect = item.getBoundingClientRect();
      const itemEl = item as HTMLElement;
      const speed = parseFloat(itemEl.dataset.scrollSpeed || '1');
      const yPos = rect.top + scrollTop;
      const diff = scrollTop - yPos + windowHeight;
      const rate = diff / windowHeight;
      
      // Only apply parallax when item is in viewport
      if (rect.bottom >= 0 && rect.top <= windowHeight) {
        const translateY = (rate * speed * 50) - 25; // Adjust multiplier for effect intensity
        
        // Apply different transforms based on scroll position
        const videoSide = item.querySelector('.video-side') as HTMLElement;
        const contentSide = item.querySelector('.content-side') as HTMLElement;
        
        if (videoSide && contentSide) {
          // Create subtle parallax movement
          videoSide.style.transform = `translateY(${translateY * 0.3}px)`;
          contentSide.style.transform = `translateY(${translateY * -0.2}px)`;
          
          // Add rotation effect based on scroll
          const rotationY = (rate - 0.5) * 2; // Range from -1 to 1
          const videoContainer = videoSide.querySelector('.video-container') as HTMLElement;
          if (videoContainer) {
            videoContainer.style.transform = `rotateY(${rotationY * 1}deg) scale(${1 + Math.abs(rotationY) * 0.02})`;
          }
        }
      }
    });
    
    ticking = false;
  }

  function requestTick() {
    if (!ticking) {
      requestAnimationFrame(updateParallax);
      ticking = true;
    }
  }

  // Throttled scroll listener for performance
  window.addEventListener('scroll', requestTick, { passive: true });

  // Mouse movement parallax effect
  document.addEventListener('mousemove', (e) => {
    const mouseX = e.clientX / window.innerWidth;
    const mouseY = e.clientY / window.innerHeight;
    
    document.querySelectorAll('.video-container').forEach(container => {
      const rect = container.getBoundingClientRect();
      if (rect.top < window.innerHeight && rect.bottom > 0) {
        const moveX = (mouseX - 0.5) * 10;
        const moveY = (mouseY - 0.5) * 10;
        
        const video = container.querySelector('.gallery-video, .gallery-image') as HTMLElement;
        if (video) {
          video.style.transform = `scale(1.05) translate(${moveX}px, ${moveY}px)`;
        }
      }
    });
  });

  // Enhanced video intersection observer for performance
  const videoObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      const video = entry.target as HTMLVideoElement;
      if (entry.isIntersecting) {
        video.play().catch(() => {
          // Autoplay failed, but that's okay
        });
      } else {
        video.pause();
      }
    });
  }, {
    threshold: 0.25
  });

  // Observe all videos for performance optimization
  document.querySelectorAll('.gallery-video').forEach(video => {
    videoObserver.observe(video);
  });

  // Video loading optimization
  const videos = document.querySelectorAll('video');
  videos.forEach(video => {
    video.addEventListener('loadstart', () => {
      (video as HTMLVideoElement).style.opacity = '0';
    });
    
    video.addEventListener('canplay', () => {
      const videoEl = video as HTMLVideoElement;
      videoEl.style.transition = 'opacity 0.5s ease';
      videoEl.style.opacity = '1';
    });
  });

  // Enhanced 3D Logo Interaction for About Page
  class AboutLogoInteraction {
    private logo: HTMLElement | null;
    private container: HTMLElement | null;
    private mouse: { x: number; y: number };
    private animationId: number | null;

    constructor() {
      this.logo = document.getElementById('about-interactive-logo');
      this.container = document.getElementById('about-logo-container');
      this.mouse = { x: 0, y: 0 };
      this.animationId = null;
      this.init();
    }

    init(): void {
      if (!this.logo || !this.container) return;

      window.addEventListener('mousemove', this.handleMouseMove.bind(this), { passive: true });
      window.addEventListener('touchmove', this.handleTouchMove.bind(this), { passive: true });

      // Add hover effects
      this.container.addEventListener('mouseenter', this.handleMouseEnter.bind(this));
      this.container.addEventListener('mouseleave', this.handleMouseLeave.bind(this));

      this.animate();
    }

    handleMouseMove(e: MouseEvent): void {
      this.updateMousePosition(e.clientX, e.clientY);
    }

    handleTouchMove(e: TouchEvent): void {
      if (e.touches.length > 0) {
        this.updateMousePosition(e.touches[0].clientX, e.touches[0].clientY);
      }
    }

    updateMousePosition(clientX: number, clientY: number): void {
      if (!this.container) return;

      const rect = this.container.getBoundingClientRect();
      const centerX = rect.left + rect.width / 2;
      const centerY = rect.top + rect.height / 2;

      this.mouse.x = (clientX - centerX) / (window.innerWidth / 2);
      this.mouse.y = (clientY - centerY) / (window.innerHeight / 2);
    }

    handleMouseEnter(): void {
      if (this.logo) {
        (this.logo as HTMLElement).style.filter = `
          drop-shadow(0 0 80px rgba(255, 60, 43, 1))
          drop-shadow(0 0 160px rgba(255, 60, 43, 0.7))
          drop-shadow(0 0 240px rgba(255, 60, 43, 0.4))
        `;
      }
    }

    handleMouseLeave(): void {
      if (this.logo) {
        (this.logo as HTMLElement).style.filter = `
          drop-shadow(0 0 50px rgba(255, 60, 43, 0.8))
          drop-shadow(0 0 100px rgba(255, 60, 43, 0.5))
          drop-shadow(0 0 150px rgba(255, 60, 43, 0.3))
        `;
      }
    }

    animate(): void {
      if (!this.logo) return;

      const rotationX = -this.mouse.y * 20;
      const rotationY = this.mouse.x * 20;
      const rotationZ = Math.sin(Date.now() * 0.001) * 3;
      const scale = 1 + Math.min(Math.sqrt(this.mouse.x * this.mouse.x + this.mouse.y * this.mouse.y) * 0.1, 0.2);

      (this.logo as HTMLElement).style.transform = `
        perspective(1200px)
        rotateX(${rotationX}deg)
        rotateY(${rotationY}deg)
        rotateZ(${rotationZ}deg)
        scale(${scale})
      `;

      this.animationId = requestAnimationFrame(() => this.animate());
    }
  }


  // Initialize About Page Hero Components
  function initAboutHeroComponents() {
    new AboutLogoInteraction();
  }

  // Three.js Background for About Hero
  async function initAboutHeroBackground(): Promise<void> {
    try {
      const canvas = document.getElementById('about-hero-canvas') as HTMLCanvasElement;
      if (!canvas) return;

      // Check for reduced motion preference
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const isMobile = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);
      
      // WebGL capability check
      const gl = canvas.getContext('webgl') || canvas.getContext('experimental-webgl');
      if (!gl) {
        canvas.style.display = 'none';
        return;
      }

      const THREE = await import('three');

      const renderer = new THREE.WebGLRenderer({
        canvas,
        antialias: !isMobile,
        alpha: true,
        powerPreference: isMobile ? 'low-power' : 'high-performance'
      });

      const scene = new THREE.Scene();
      const camera = new THREE.PerspectiveCamera(75, 2, 0.1, 100);
      camera.position.set(0, 0, 5);

      // Optimized resize handler
      function resize(): void {
        const { clientWidth: w, clientHeight: h } = canvas;
        if (canvas.width !== w || canvas.height !== h) {
          renderer.setSize(w, h, false);
          camera.aspect = w / h;
          camera.updateProjectionMatrix();
        }
      }

      resize();
      new ResizeObserver(resize).observe(canvas);
      renderer.setPixelRatio(Math.min(isMobile ? 1.5 : 2, window.devicePixelRatio || 1));

      // Create floating particles
      const particleCount = isMobile ? 400 : (prefersReducedMotion ? 200 : 800);
      const geometry = new THREE.BufferGeometry();
      const positions = new Float32Array(particleCount * 3);

      for (let i = 0; i < particleCount; i++) {
        const i3 = i * 3;
        positions[i3] = (Math.random() - 0.5) * 20;
        positions[i3 + 1] = (Math.random() - 0.5) * 12;
        positions[i3 + 2] = -(Math.random() * 8 + 2);
      }

      geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));

      const particleMaterial = new THREE.PointsMaterial({
        color: 0xffe7d0,
        size: isMobile ? 0.01 : 0.02,
        transparent: true,
        opacity: prefersReducedMotion ? 0.3 : 0.6,
        blending: THREE.AdditiveBlending,
        depthWrite: false
      });

      const particles = new THREE.Points(geometry, particleMaterial);
      scene.add(particles);

      // Mouse interaction
      const mouse = new THREE.Vector2();
      let mouseUpdateId = 0;

      const updateMouse = (e: PointerEvent): void => {
        cancelAnimationFrame(mouseUpdateId);
        mouseUpdateId = requestAnimationFrame(() => {
          mouse.x = (e.clientX / window.innerWidth) * 2 - 1;
          mouse.y = -(e.clientY / window.innerHeight) * 2 + 1;
        });
      };

      window.addEventListener('pointermove', updateMouse, { passive: true });

      // Animation loop
      const clock = new THREE.Clock();
      let animationId: number;

      function animate() {
        animationId = requestAnimationFrame(animate);
        const dt = clock.getDelta();

        // Smooth camera movement
        const cameraSpeed = prefersReducedMotion ? 0.01 : (isMobile ? 0.03 : 0.05);
        camera.position.x += (mouse.x * 0.5 - camera.position.x) * cameraSpeed;
        camera.position.y += (-mouse.y * 0.3 - camera.position.y) * cameraSpeed;
        camera.lookAt(0, 0, 0);

        // Particle rotation
        if (!prefersReducedMotion) {
          particles.rotation.y += dt * (isMobile ? 0.005 : 0.01);
          particles.rotation.x += dt * 0.002;
        }

        renderer.render(scene, camera);
      }

      animate();

      // Cleanup
      window.addEventListener('beforeunload', () => {
        cancelAnimationFrame(animationId);
        renderer.dispose();
        geometry.dispose();
        particleMaterial.dispose();
      });

    } catch (error) {
      console.warn('About hero background initialization failed:', error);
      const canvas = document.getElementById('about-hero-canvas');
      if (canvas) canvas.style.display = 'none';
    }
  }

  // Initialize About Hero with optimized loading
  function initializeAboutComponents() {
    // Initialize critical components first
    initAboutHeroComponents();
    
    // Queue Three.js initialization with optimized loader
    if ((window as any).threeLoader) {
      (window as any).threeLoader.queueThreeJSInit('about-hero-canvas', initAboutHeroBackground);
    } else {
      // Fallback if loader not available
      setTimeout(initAboutHeroBackground, 1000);
    }
  }

  // Initialize About Hero when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeAboutComponents);
  } else {
    initializeAboutComponents();
  }
</script>
