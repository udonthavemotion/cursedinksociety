  /* Original Artist Hero (for non-Cody pages) */
  .artist-hero {
    padding: 6rem 0 4rem;
    background:
      radial-gradient(1200px 800px at 30% 10%, rgba(255, 60, 43, 0.03) 0%, transparent 60%),
      linear-gradient(180deg, var(--bg0), var(--bg1));
  }

  /* Artist Bio Section */
  .artist-bio {
    padding: 6rem 0;
    background: var(--bg-glass);
    border-top: var(--border-glass);
    border-bottom: var(--border-glass);
  }

  .bio-content h2 {
    text-align: center;
    font-size: clamp(2rem, 4vw, 2.5rem);
    margin: 0 0 2rem;
    color: var(--ink);
    text-shadow: var(--glow-subtle);
  }

  .bio-text {
    font-size: 1.2rem;
    line-height: 1.7;
    opacity: 0.9;
    margin: 0 0 3rem;
    max-width: 800px;
    margin: 0 auto 3rem;
    text-align: center;
  }

  .artist-stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
    max-width: 400px;
    margin: 0 auto;
  }

  .stat-item {
    text-align: center;
  }

  .stat-number {
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--accent0);
    text-shadow: var(--glow-primary);
