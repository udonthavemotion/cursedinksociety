---
import Layout from '../layouts/Layout.astro';

const title = "Page Not Found";
const description = "Sorry, the page you're looking for doesn't exist.";
---

<Layout title={title} description={description}>
  <div class="min-h-screen flex items-center justify-center bg-gray-900 text-white">
    <div class="text-center">
      <h1 class="text-6xl font-bold mb-4 text-red-500">404</h1>
      <h2 class="text-2xl font-semibold mb-6">Page Not Found</h2>
      <p class="text-gray-400 mb-8">The page you're looking for doesn't exist or has been moved.</p>
      <a href="/" class="inline-block bg-red-600 hover:bg-red-700 text-white px-6 py-3 rounded-lg transition-colors">
        Return Home
      </a>
    </div>
  </div>
</Layout>
