# Environment Variables Template for Cursed Ink Society
# Copy this file to .env and fill in your actual values

# =============================================================================
# DEPLOYMENT CONFIGURATION
# =============================================================================

# Vercel deployment URL (automatically set by Vercel)
# VERCEL_URL=your-project-name.vercel.app

# =============================================================================
# ANALYTICS & TRACKING (Optional)
# =============================================================================

# Google Analytics
# GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# Facebook Pixel
# FACEBOOK_PIXEL_ID=123456789

# =============================================================================
# THIRD-PARTY INTEGRATIONS (Optional)
# =============================================================================

# Contact Form Service (e.g., Formspree, Netlify Forms)
# CONTACT_FORM_ENDPOINT=https://formspree.io/f/your-form-id

# Email Service (e.g., EmailJS)
# EMAILJS_SERVICE_ID=your_service_id
# EMAILJS_TEMPLATE_ID=your_template_id
# EMAILJS_PUBLIC_KEY=your_public_key

# =============================================================================
# CONTENT MANAGEMENT (Optional)
# =============================================================================

# If using a headless CMS like Strapi, Contentful, or Sanity
# CMS_API_URL=https://your-cms-api.com
# CMS_API_KEY=your_api_key

# =============================================================================
# SOCIAL MEDIA (Optional)
# =============================================================================

# Instagram API (for portfolio integration)
# INSTAGRAM_ACCESS_TOKEN=your_access_token

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================

# Development mode flag
# NODE_ENV=development

# Debug mode for additional logging
# DEBUG=true
