---
import Layout from '../layouts/Layout.astro';

const title = "Services & Pricing — Cursed Ink Society";
const description = "Explore our comprehensive tattoo services and transparent pricing. From custom designs to cover-ups, we offer premium artistry with competitive rates in Houma, LA.";

// Comprehensive services data
const services = [
  {
    id: 1,
    title: "Custom Tattoo Design",
    description: "Collaborate with our artists to create a unique piece that tells your story. From initial concept to final execution, we bring your vision to life with meticulous attention to detail.",
    features: [
      "Personal one-on-one consultation",
      "Custom design process with revisions",
      "Digital mockups and previews",
      "Comprehensive aftercare guidance",
      "Touch-up session included"
    ],
    pricing: {
      consultation: "Free",
      hourly: "$190-230/hour",
      minimum: "$150",
      deposit: "$100 or 25% of estimate"
    },
    duration: "2-6 hours per session",
    popular: true,
    image: "/assets/services/custom-design.jpg"
  },
  {
    id: 2,
    title: "Traditional & Neo-Traditional",
    description: "Bold lines, vibrant colors, and timeless American traditional style. Our artists honor classic techniques while adding modern flair to create pieces that stand the test of time.",
    features: [
      "Classic American traditional motifs",
      "Bold, clean line work",
      "Vibrant color saturation",
      "Modern neo-traditional elements",
      "Historical accuracy and respect"
    ],
    pricing: {
      consultation: "Free",
      hourly: "$190-230/hour",
      minimum: "$150",
      deposit: "$100 or 25% of estimate"
    },
    duration: "1-4 hours per session",
    popular: false,
    image: "/assets/services/traditional.jpg"
  },
  {
    id: 3,
    title: "Realism & Portrait Work",
    description: "Photorealistic tattoos that capture every detail with stunning accuracy. Perfect for memorial pieces, beloved pets, or any subject that demands lifelike representation.",
    features: [
      "Photorealistic detail and shading",
      "Portrait specialization",
      "Memorial and tribute pieces",
      "Nature and wildlife scenes",
      "Black & grey or full color options"
    ],
    pricing: {
      consultation: "Free",
      hourly: "$220-250/hour",
      minimum: "$200",
      deposit: "$150 or 25% of estimate"
    },
    duration: "3-8 hours per session",
    popular: false,
    image: "/assets/services/realism.jpg"
  },
  {
    id: 4,
    title: "Japanese Traditional (Irezumi)",
    description: "Authentic Japanese tattooing following traditional techniques and cultural respect. Our master specializes in large-scale pieces that honor the ancient art of Irezumi.",
    features: [
      "Authentic traditional techniques",
      "Cultural accuracy and respect",
      "Large-scale body suit planning",
      "Traditional motifs and symbolism",
      "Hand-poked (Tebori) options available"
    ],
    pricing: {
      consultation: "Free",
      hourly: "$200-280/hour",
      minimum: "$200",
      deposit: "$200 or 25% of estimate"
    },
    duration: "4-12 hours per session",
    popular: false,
    image: "/assets/services/japanese.jpg"
  },
  {
    id: 5,
    title: "Fine Line & Minimalist",
    description: "Delicate, precise linework for those who prefer subtle elegance. Perfect for first tattoos, small meaningful pieces, and botanical designs.",
    features: [
      "Ultra-fine precision linework",
      "Minimalist aesthetic approach",
      "Botanical and geometric designs",
      "Small to medium scale pieces",
      "Perfect for first-time clients"
    ],
    pricing: {
      consultation: "Free",
      hourly: "$150-200/hour",
      minimum: "$100",
      deposit: "$75 or 25% of estimate"
    },
    duration: "1-3 hours per session",
    popular: false,
    image: "/assets/services/fine-line.jpg"
  },
  {
    id: 6,
    title: "Cover-Up & Restoration",
    description: "Transform old or unwanted tattoos into beautiful new artwork. Our experts specialize in creative solutions for even the most challenging cover-up projects.",
    features: [
      "Free cover-up consultation",
      "Creative design solutions",
      "Color correction techniques",
      "Scar tissue integration",
      "Laser preparation recommendations"
    ],
    pricing: {
      consultation: "Free",
      hourly: "Quote based on complexity",
      minimum: "Varies by project",
      deposit: "$150 or 25% of estimate"
    },
    duration: "Varies by complexity",
    popular: false,
    image: "/assets/services/cover-up.jpg"
  }
];

const additionalServices = [
  {
    title: "Touch-Up Services",
    description: "Free touch-ups within 6 months for optimal healing",
    price: "Included with original work"
  },
  {
    title: "Consultation Only",
    description: "Design consultation without commitment",
    price: "Free"
  },
  {
    title: "Design Revision",
    description: "Additional revisions beyond initial concept",
    price: "$50 per major revision"
  },
  {
    title: "Rush Service",
    description: "Expedited scheduling (when available)",
    price: "25% surcharge"
  }
];

const pricingNotes = [
  "All prices are subject to complexity and artist availability",
  "Deposits are non-refundable but applied to final cost",
  "Payment plans available for large projects",
  "Group booking discounts available",
  "Military and first responder discounts: 10%",
  "Student discount: 5% (with valid ID)"
];
---

<Layout title={title} description={description}>
  <!-- Hero Section -->
  <section class="services-hero">
    <div class="container">
      <div class="hero-content">
        <span class="badge">Our Services</span>
        <h1 class="hero-title shine">Services & Pricing</h1>
        <p class="hero-description">
          Premium tattoo artistry with transparent pricing. Every service includes consultation, 
          custom design, and comprehensive aftercare to ensure your perfect tattoo experience.
        </p>
      </div>
    </div>
  </section>

  <!-- Main Services -->
  <section class="main-services">
    <div class="container">
      <div class="services-grid">
        {services.map((service) => (
          <article class="service-card" data-service-id={service.id}>
            {service.popular && <div class="popular-badge">Most Popular</div>}
            
            <div class="service-image-container">
              <img 
                src={service.image} 
                alt={service.title}
                class="service-image"
                loading="lazy"
                width="400"
                height="300"
              />
            </div>

            <div class="service-content">
              <h2 class="service-title">{service.title}</h2>
              <p class="service-description">{service.description}</p>

              <div class="service-features">
                <h3>What's Included</h3>
                <ul class="features-list">
                  {service.features.map((feature) => (
                    <li class="feature-item">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
                      </svg>
                      {feature}
                    </li>
                  ))}
                </ul>
              </div>

              <div class="service-pricing">
                <h3>Pricing</h3>
                <div class="pricing-details">
                  <div class="pricing-item">
                    <span class="pricing-label">Consultation:</span>
                    <span class="pricing-value">{service.pricing.consultation}</span>
                  </div>
                  <div class="pricing-item">
                    <span class="pricing-label">Hourly Rate:</span>
                    <span class="pricing-value">{service.pricing.hourly}</span>
                  </div>
                  <div class="pricing-item">
                    <span class="pricing-label">Minimum:</span>
                    <span class="pricing-value">{service.pricing.minimum}</span>
                  </div>
                  <div class="pricing-item">
                    <span class="pricing-label">Deposit:</span>
                    <span class="pricing-value">{service.pricing.deposit}</span>
                  </div>
                  <div class="pricing-item">
                    <span class="pricing-label">Duration:</span>
                    <span class="pricing-value">{service.duration}</span>
                  </div>
                </div>
              </div>

              <div class="service-actions">
                <a href="/consultation" class="btn btn--primary">Book Consultation</a>
                <a href="/gallery" class="btn btn--outline">View Examples</a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Additional Services -->
  <section class="additional-services">
    <div class="container">
      <h2 class="section-title">Additional Services</h2>
      <div class="additional-services-grid">
        {additionalServices.map((service) => (
          <div class="additional-service-card">
            <h3 class="additional-service-title">{service.title}</h3>
            <p class="additional-service-description">{service.description}</p>
            <span class="additional-service-price">{service.price}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Pricing Information -->
  <section class="pricing-info">
    <div class="container">
      <div class="pricing-info-content">
        <h2 class="section-title">Pricing Information</h2>
        <div class="pricing-notes">
          <h3>Important Notes</h3>
          <ul class="notes-list">
            {pricingNotes.map((note) => (
              <li class="note-item">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
                </svg>
                {note}
              </li>
            ))}
          </ul>
        </div>

        <div class="payment-methods">
          <h3>Payment Methods</h3>
          <div class="payment-options">
            <div class="payment-option">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                <path d="M20 4H4c-1.11 0-1.99.89-1.99 2L2 18c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V6c0-1.11-.89-2-2-2zm0 14H4v-6h16v6zm0-10H4V6h16v2z"/>
              </svg>
              <span>Credit & Debit Cards</span>
            </div>
            <div class="payment-option">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                <path d="M11.8 10.9c-2.27-.59-3-1.2-3-2.15 0-1.09 1.01-1.85 2.7-1.85 1.78 0 2.44.85 2.5 2.1h2.21c-.07-1.72-1.12-3.3-3.21-3.81V3h-3v2.16c-1.94.42-3.5 1.68-3.5 3.61 0 2.31 1.91 3.46 4.7 4.13 2.5.6 3 1.48 3 2.41 0 .69-.49 1.79-2.7 1.79-2.06 0-2.87-.92-2.98-2.1h-2.2c.12 2.19 1.76 3.42 3.68 3.83V21h3v-2.15c1.95-.37 3.5-1.5 3.5-3.55 0-2.84-2.43-3.81-4.7-4.4z"/>
              </svg>
              <span>Cash</span>
            </div>
            <div class="payment-option">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
              </svg>
              <span>Payment Plans Available</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="services-cta">
    <div class="container">
      <div class="cta-content">
        <h2>Ready to Get Started?</h2>
        <p>Book your free consultation today and let's bring your tattoo vision to life.</p>
        <div class="cta-actions">
          <a href="/consultation" class="btn btn--primary btn--large">Book Free Consultation</a>
          <a href="/contact" class="btn btn--outline btn--large">Ask Questions</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Services Hero */
  .services-hero {
    padding: 8rem 0 4rem;
    text-align: center;
    background: 
      radial-gradient(1000px 600px at 50% 20%, rgba(255, 60, 43, 0.03) 0%, transparent 60%);
  }

  .hero-content {
    max-width: 700px;
    margin: 0 auto;
  }

  .hero-title {
    font-size: clamp(3rem, 6vw, 4.5rem);
    margin: 1rem 0 1.5rem;
    line-height: 1.1;
  }

  .hero-description {
    font-size: 1.2rem;
    line-height: 1.6;
    opacity: 0.9;
    margin: 0;
  }

  /* Main Services */
  .main-services {
    padding: 4rem 0;
  }

  .services-grid {
    display: grid;
    gap: 3rem;
  }

  .service-card {
    display: grid;
    grid-template-columns: 400px 1fr;
    gap: 3rem;
    background: var(--bg-glass);
    border: var(--border-glass);
    border-radius: 24px;
    overflow: hidden;
    backdrop-filter: blur(10px);
    transition: var(--transition-smooth);
    position: relative;
    align-items: start;
  }

  .service-card:hover {
    transform: translateY(-4px);
    box-shadow: 
      0 20px 40px rgba(0, 0, 0, 0.2),
      0 0 30px rgba(255, 60, 43, 0.1);
    border-color: rgba(255, 60, 43, 0.2);
  }

  .popular-badge {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    background: linear-gradient(45deg, var(--accent0), var(--accent1));
    color: var(--bg0);
    padding: 0.5rem 1rem;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    z-index: 10;
    box-shadow: 0 4px 12px rgba(255, 60, 43, 0.3);
  }

  .service-image-container {
    position: relative;
    height: 100%;
    min-height: 300px;
  }

  .service-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .service-content {
    padding: 2.5rem 2.5rem 2.5rem 0;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .service-title {
    font-size: 1.8rem;
    margin: 0;
    color: var(--ink);
    text-shadow: var(--glow-subtle);
  }

  .service-description {
    font-size: 1rem;
    line-height: 1.6;
    opacity: 0.9;
    margin: 0;
  }

  .service-features h3,
  .service-pricing h3 {
    font-size: 1.2rem;
    margin: 0 0 1rem;
    color: var(--accent0);
    text-shadow: var(--glow-subtle);
  }

  .features-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .feature-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.95rem;
  }

  .feature-item svg {
    color: var(--accent0);
    flex-shrink: 0;
  }

  .pricing-details {
    display: grid;
    gap: 0.75rem;
  }

  .pricing-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.5rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .pricing-item:last-child {
    border-bottom: none;
  }

  .pricing-label {
    font-size: 0.9rem;
    opacity: 0.8;
  }

  .pricing-value {
    font-weight: 600;
    color: var(--accent0);
  }

  .service-actions {
    display: flex;
    gap: 1rem;
    margin-top: auto;
  }

  .service-actions .btn {
    flex: 1;
    text-align: center;
  }

  /* Additional Services */
  .additional-services {
    padding: 4rem 0;
    background: var(--bg-glass);
    border-top: var(--border-glass);
  }

  .section-title {
    text-align: center;
    font-size: clamp(2rem, 4vw, 2.5rem);
    margin: 0 0 3rem;
    color: var(--ink);
    text-shadow: var(--glow-subtle);
  }

  .additional-services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
  }

  .additional-service-card {
    background: rgba(255, 255, 255, 0.03);
    border: var(--border-glass);
    border-radius: 16px;
    padding: 2rem;
    text-align: center;
    backdrop-filter: blur(5px);
    transition: var(--transition-smooth);
  }

  .additional-service-card:hover {
    transform: translateY(-4px);
    border-color: rgba(255, 60, 43, 0.2);
  }

  .additional-service-title {
    font-size: 1.1rem;
    margin: 0 0 1rem;
    color: var(--ink);
    text-shadow: var(--glow-subtle);
  }

  .additional-service-description {
    font-size: 0.9rem;
    opacity: 0.8;
    margin: 0 0 1.5rem;
    line-height: 1.5;
  }

  .additional-service-price {
    font-weight: 600;
    color: var(--accent0);
    font-size: 0.95rem;
  }

  /* Pricing Information */
  .pricing-info {
    padding: 4rem 0;
  }

  .pricing-info-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    max-width: 1000px;
    margin: 0 auto;
  }

  .pricing-notes h3,
  .payment-methods h3 {
    font-size: 1.3rem;
    margin: 0 0 1.5rem;
    color: var(--accent0);
    text-shadow: var(--glow-subtle);
  }

  .notes-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .note-item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .note-item svg {
    color: var(--accent0);
    flex-shrink: 0;
    margin-top: 0.125rem;
  }

  .payment-options {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .payment-option {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem;
    background: var(--bg-glass);
    border: var(--border-glass);
    border-radius: 12px;
    backdrop-filter: blur(5px);
  }

  .payment-option svg {
    color: var(--accent0);
  }

  /* Services CTA */
  .services-cta {
    padding: 6rem 0;
    background: 
      radial-gradient(1000px 600px at 50% 50%, rgba(255, 60, 43, 0.05) 0%, transparent 60%);
    text-align: center;
  }

  .services-cta .cta-content h2 {
    font-size: clamp(2rem, 4vw, 2.5rem);
    margin: 0 0 1rem;
    color: var(--ink);
    text-shadow: var(--glow-subtle);
  }

  .services-cta .cta-content p {
    font-size: 1.2rem;
    opacity: 0.9;
    margin: 0 0 2.5rem;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .cta-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn--large {
    padding: 1rem 2rem;
    font-size: 1rem;
    min-height: 56px;
  }

  /* Mobile Optimizations */
  @media (max-width: 768px) {
    .services-hero {
      padding: 6rem 0 3rem;
    }

    .main-services {
      padding: 3rem 0;
    }

    .service-card {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .service-image-container {
      min-height: 250px;
    }

    .service-content {
      padding: 2rem;
    }

    .service-actions {
      flex-direction: column;
    }

    .additional-services-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .pricing-info-content {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .cta-actions {
      flex-direction: column;
      align-items: center;
    }

    .cta-actions .btn {
      width: 100%;
      max-width: 300px;
    }
  }

  /* Reduced motion support */
  @media (prefers-reduced-motion: reduce) {
    .service-card:hover,
    .additional-service-card:hover {
      transform: none;
    }
  }
</style>
