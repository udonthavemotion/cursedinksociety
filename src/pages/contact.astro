---
import Layout from '../layouts/Layout.astro';

const title = "Contact Us — Cursed Ink Society LLC";
const description = "Get in touch with Cursed Ink Society LLC. Book tattoo consultations, ask about our piercing services, or visit our Houma, LA studio. Contact Alyssa Robichaux to bring your tattoo vision to life.";

// Contact information
const contactInfo = {
  phone: "(985) 208-2334",
  phoneLink: "tel:+19852082334",
  email: "cursedinksociety@gmail.com",
  emailLink: "mailto:cursedinksociety@gmail.com",
  contactName: "",
  services: "Tattoo • Piercing",
  address: {
    street: "488 Corporate Dr, STE 11",
    city: "Houma",
    state: "LA",
    zip: "70360",
    full: "488 Corporate Dr, STE 11, Houma, LA 70360"
  },
  hours: [
    { days: "Monday - Thursday", time: "1:00 PM - 9:00 PM" },
    { days: "Friday - Saturday", time: "1:00 PM - 10:00 PM" },
    { days: "Sunday", time: "CLOSED" }
  ],
  socialMedia: {
    instagram: "https://instagram.com/cursedinksociety",
    facebook: "https://facebook.com/cursedinksociety"
  }
};

// FAQ data
const faqs = [
  {
    question: "How do I schedule a consultation?",
    answer: "You can schedule a free consultation by calling us, filling out our online form, or visiting us during business hours. We recommend contacting us in advance to ensure availability with your preferred artist."
  },
  {
    question: "What should I bring to my consultation?",
    answer: "Bring reference images, ideas, and any questions you have. We'll discuss placement, sizing, pricing, and timeline. Don't worry if your ideas aren't fully formed - we're here to help develop your concept."
  },
  {
    question: "How much do tattoos cost?",
    answer: "Our shop minimum is $80, and we require a $50 non-refundable deposit for all appointments. Full pricing is discussed between artists and clients during consultation based on your specific design, complexity, and artist selection."
  },
  {
    question: "Do you require deposits?",
    answer: "Yes, we require a $50 non-refundable deposit to secure your appointment. This deposit is applied to your final tattoo cost. Deposits can be transferred to a new appointment if you need to reschedule."
  },
  {
    question: "What's your cancellation policy?",
    answer: "We require 48 hours notice for cancellations or rescheduling. Last-minute cancellations may result in deposit forfeiture. We understand emergencies happen and will work with you when possible."
  },
  {
    question: "Do you do walk-ins?",
    answer: "We welcome walk-ins based on artist availability, but appointments are recommended to guarantee your preferred time and artist. Call ahead or check our social media for daily availability updates."
  }
];
---

<Layout title={title} description={description}>
  <!-- Hero Section -->
  <section class="contact-hero">
    <div class="container">
      <div class="hero-content">
        <span class="badge">Get in Touch</span>
        <h1 class="hero-title shine">Contact Us</h1>
        <p class="hero-description">
          Ready to start your tattoo journey? We're here to answer questions, 
          provide consultations, and help bring your vision to life.
        </p>
      </div>
    </div>
  </section>

  <!-- Contact Information -->
  <section class="contact-info">
    <div class="container">
      <div class="contact-info-grid">
        <!-- Contact Methods -->
        <div class="contact-methods">
          <h2 class="section-title">Get in Touch</h2>
          
          <div class="contact-method">
            <div class="contact-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                <path d="M6.62 10.79a15.05 15.05 0 006.59 6.59l2.2-2.2a1 1 0 011.11-.21 11.36 11.36 0 003.57.57 1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1 11.36 11.36 0 00.57 3.57 1 1 0 01-.21 1.11z"/>
              </svg>
            </div>
            <div class="contact-details">
              <h3>Phone</h3>
              <p><a href={contactInfo.phoneLink}>{contactInfo.phone}</a></p>
              <small>Call us directly for consultations</small>
            </div>
          </div>

          <div class="contact-method">
            <div class="contact-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
              </svg>
            </div>
            <div class="contact-details">
              <h3>Email</h3>
              <p><a href={contactInfo.emailLink}>{contactInfo.email}</a></p>
              <small>Send detailed inquiries and reference images</small>
            </div>
          </div>

          <div class="contact-method">
            <div class="contact-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
              </svg>
            </div>
            <div class="contact-details">
              <h3>Location</h3>
              <p>{contactInfo.address.full}</p>
              <small>Visit us for walk-ins and consultations</small>
            </div>
          </div>

          <div class="contact-method">
            <div class="contact-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
              </svg>
            </div>
            <div class="contact-details">
              <h3>Services</h3>
              <p>{contactInfo.services}</p>
              <small>Custom tattoos and professional piercing</small>
            </div>
          </div>

          <div class="contact-method">
            <div class="contact-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                <path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8z"/>
                <path d="M12.5 7H11v6l5.25 3.15.75-1.23-4.5-2.67z"/>
              </svg>
            </div>
            <div class="contact-details">
              <h3>Hours</h3>
              <div class="hours-list">
                {contactInfo.hours.map((hour) => (
                  <div class="hour-item">
                    <span class="hour-days">{hour.days}</span>
                    <span class="hour-time">{hour.time}</span>
                  </div>
                ))}
              </div>
              <small>Walk-ins welcome during business hours</small>
            </div>
          </div>
        </div>

        <!-- Contact Form Temporarily Removed -->
        <div class="contact-form-section">
          <h2 class="section-title">Get in Touch</h2>
          <div class="contact-alternative">
            <p class="alternative-message">
              We're currently updating our contact form. In the meantime, please reach out to us directly:
            </p>
            <div class="alternative-methods">
              <div class="alternative-method">
                <h3>Call Us</h3>
                <p><a href={contactInfo.phoneLink}>{contactInfo.phone}</a></p>
                <small>Speak directly with our team</small>
              </div>
              <div class="alternative-method">
                <h3>Email Us</h3>
                <p><a href={contactInfo.emailLink}>{contactInfo.email}</a></p>
                <small>Send us your detailed inquiries and reference images</small>
              </div>
              <div class="alternative-method">
                <h3>Visit Our Studio</h3>
                <p>{contactInfo.address.full}</p>
                <small>Walk-ins welcome during business hours</small>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Map Section -->
  <section class="map-section">
    <div class="container">
      <h2 class="section-title">Find Our Studio</h2>
      <div class="map-container">
        <!-- Placeholder for Google Maps -->
        <div class="map-placeholder">
          <div class="map-content">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
            </svg>
            <h3>Cursed Ink Society</h3>
            <p>{contactInfo.address.full}</p>
            <a href={`https://maps.google.com/?q=${encodeURIComponent(contactInfo.address.full)}`} 
               target="_blank" 
               rel="noopener" 
               class="btn btn--outline">
              Get Directions
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="faq-section">
    <div class="container">
      <h2 class="section-title">Frequently Asked Questions</h2>
      <div class="faq-grid">
        {faqs.map((faq, index) => (
          <div class="faq-item">
            <button class="faq-question" data-faq-toggle={index}>
              <span>{faq.question}</span>
              <svg class="faq-icon" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                <path d="M7.41 8.59L12 13.17l4.59-4.58L18 10l-6 6-6-6 1.41-1.41z"/>
              </svg>
            </button>
            <div class="faq-answer" data-faq-content={index}>
              <p>{faq.answer}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Social Media -->
  <section class="social-section">
    <div class="container">
      <div class="social-content">
        <h2 class="section-title">Follow Our Work</h2>
        <p class="social-description">
          Stay connected with our latest work, behind-the-scenes content, and studio updates.
        </p>
        <div class="social-links">
          <a href={contactInfo.socialMedia.instagram} target="_blank" rel="noopener" class="social-link">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
              <path d="M7 2h10a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5V7a5 5 0 0 1 5-5zm5 5a5 5 0 1 0 .001 10.001A5 5 0 0 0 12 7zm0 2.2a2.8 2.8 0 1 1 0 5.6 2.8 2.8 0 0 1 0-5.6zM18 6.5a1 1 0 1 0 0 2 1 1 0 0 0 0-2z"/>
            </svg>
            <span>Follow on Instagram</span>
          </a>
          <a href={contactInfo.socialMedia.facebook} target="_blank" rel="noopener" class="social-link">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
            <span>Follow on Facebook</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  // FAQ Accordion functionality
  class FAQManager {
    constructor() {
      this.faqButtons = document.querySelectorAll('.faq-question');
      this.init();
    }

    init() {
      this.faqButtons.forEach((button) => {
        button.addEventListener('click', (e) => this.toggleFAQ(e));
      });
    }

    toggleFAQ(e) {
      const button = e.currentTarget;
      const index = button.dataset.faqToggle;
      const content = document.querySelector(`[data-faq-content="${index}"]`);
      const icon = button.querySelector('.faq-icon');
      const faqItem = button.closest('.faq-item');

      if (!content || !icon || !faqItem) return;

      // Close other open FAQs
      this.faqButtons.forEach((otherButton, otherIndex) => {
        if (otherIndex.toString() !== index) {
          const otherContent = document.querySelector(`[data-faq-content="${otherIndex}"]`);
          const otherIcon = otherButton.querySelector('.faq-icon');
          const otherItem = otherButton.closest('.faq-item');
          
          if (otherItem) otherItem.classList.remove('faq-item--open');
          if (otherContent) (otherContent).style.maxHeight = null;
          if (otherIcon) (otherIcon).style.transform = 'rotate(0deg)';
        }
      });

      // Toggle current FAQ
      const isOpen = faqItem.classList.contains('faq-item--open');
      
      if (isOpen) {
        faqItem.classList.remove('faq-item--open');
        (content).style.maxHeight = null;
        (icon).style.transform = 'rotate(0deg)';
      } else {
        faqItem.classList.add('faq-item--open');
        (content).style.maxHeight = content.scrollHeight + 'px';
        (icon).style.transform = 'rotate(180deg)';
      }
    }
  }

  // Contact form temporarily removed - no form handling needed

  // Initialize with optimized loading
  function initializeContactComponents() {
    // Initialize critical components first
    new FAQManager();
    
    // Ensure scroll manager is working
    if ((window as any).scrollManager) {
      (window as any).scrollManager.forceScrollFix();
    }
  }

  // Initialize when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeContactComponents);
  } else {
    initializeContactComponents();
  }
</script>

<style>
  /* Global Mobile Overflow Prevention */
  * {
    box-sizing: border-box;
  }
  
  html, body {
    overflow-x: hidden;
    width: 100%;
    max-width: 100%;
  }
  
  .container {
    width: 100%;
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1.2rem;
    box-sizing: border-box;
  }

  /* Contact Hero */
  .contact-hero {
    padding: 8rem 0 4rem;
    text-align: center;
    background: 
      radial-gradient(1000px 600px at 50% 20%, rgba(255, 60, 43, 0.03) 0%, transparent 60%);
    overflow-x: hidden;
    width: 100%;
  }

  .hero-content {
    max-width: 700px;
    margin: 0 auto;
  }

  .hero-title {
    font-size: clamp(3rem, 6vw, 4.5rem);
    margin: 1rem 0 1.5rem;
    line-height: 1.1;
  }

  .hero-description {
    font-size: 1.2rem;
    line-height: 1.6;
    opacity: 0.9;
    margin: 0;
  }

  /* Contact Info */
  .contact-info {
    padding: 6rem 0;
    overflow-x: hidden;
    width: 100%;
  }

  .contact-info-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    width: 100%;
    max-width: 100%;
  }

  .section-title {
    font-size: clamp(2rem, 4vw, 2.5rem);
    margin: 0 0 3rem;
    color: var(--ink);
    text-shadow: var(--glow-subtle);
  }

  .contact-methods {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .contact-method {
    display: flex;
    align-items: flex-start;
    gap: 1.5rem;
    padding: 2rem;
    background: var(--bg-glass);
    border: var(--border-glass);
    border-radius: 20px;
    backdrop-filter: blur(10px);
    transition: var(--transition-smooth);
  }

  .contact-method:hover {
    transform: translateY(-4px);
    border-color: rgba(255, 60, 43, 0.2);
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.2);
  }

  .contact-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 60px;
    height: 60px;
    background: rgba(255, 60, 43, 0.1);
    border: 1px solid rgba(255, 60, 43, 0.2);
    border-radius: 50%;
    color: var(--accent0);
    flex-shrink: 0;
  }

  .contact-details h3 {
    font-size: 1.2rem;
    margin: 0 0 0.5rem;
    color: var(--ink);
    text-shadow: var(--glow-subtle);
  }

  .contact-details p {
    font-size: 1rem;
    margin: 0 0 0.5rem;
  }

  .contact-details a {
    color: var(--accent0);
    text-decoration: none;
    font-weight: 600;
    transition: var(--transition-smooth);
  }

  .contact-details a:hover {
    text-shadow: var(--glow-subtle);
  }

  .contact-details small {
    font-size: 0.85rem;
    opacity: 0.7;
  }

  .hours-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .hour-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .hour-days {
    font-weight: 600;
  }

  .hour-time {
    opacity: 0.8;
  }

  /* Contact Form Section (Alternative) */
  .contact-form-section {
    background: var(--bg-glass);
    border: var(--border-glass);
    border-radius: 24px;
    padding: 3rem;
    backdrop-filter: blur(10px);
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
  }

  .contact-alternative {
    text-align: center;
  }

  .alternative-message {
    font-size: 1.1rem;
    line-height: 1.6;
    opacity: 0.9;
    margin: 0 0 2.5rem;
    color: var(--ink);
  }

  .alternative-methods {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
    margin-top: 2rem;
  }

  .alternative-method {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 16px;
    padding: 2rem 1.5rem;
    text-align: center;
    transition: var(--transition-smooth);
  }

  .alternative-method:hover {
    transform: translateY(-4px);
    border-color: rgba(255, 60, 43, 0.2);
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.2);
  }

  .alternative-method h3 {
    font-size: 1.2rem;
    margin: 0 0 1rem;
    color: var(--accent0);
    text-shadow: var(--glow-subtle);
  }

  .alternative-method p {
    font-size: 1rem;
    margin: 0 0 0.5rem;
  }

  .alternative-method a {
    color: var(--ink);
    text-decoration: none;
    font-weight: 600;
    transition: var(--transition-smooth);
  }

  .alternative-method a:hover {
    color: var(--accent0);
    text-shadow: var(--glow-subtle);
  }

  .alternative-method small {
    font-size: 0.85rem;
    opacity: 0.7;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .form-group label {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--ink);
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    padding: 1rem;
    border: var(--border-glass);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.03);
    color: var(--ink);
    font-size: 1rem;
    backdrop-filter: blur(5px);
    transition: var(--transition-smooth);
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: rgba(255, 60, 43, 0.5);
    box-shadow: 0 0 0 2px rgba(255, 60, 43, 0.2);
  }

  .form-group textarea {
    resize: vertical;
    min-height: 120px;
  }

  .checkbox-group {
    flex-direction: row;
    align-items: center;
    gap: 0.75rem;
  }

  .checkbox-group input[type="checkbox"] {
    width: auto;
    margin: 0;
  }

  .checkbox-group label {
    font-size: 0.9rem;
    font-weight: 400;
    margin: 0;
  }

  .form-submit {
    align-self: flex-start;
    padding: 1rem 2rem;
    font-size: 1rem;
    min-height: 56px;
  }

  .form-message {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem;
    border-radius: 8px;
    font-size: 0.9rem;
    margin-bottom: 1rem;
  }

  .form-message--success {
    background: rgba(34, 197, 94, 0.1);
    border: 1px solid rgba(34, 197, 94, 0.3);
    color: #22c55e;
  }

  .form-message--error {
    background: rgba(239, 68, 68, 0.1);
    border: 1px solid rgba(239, 68, 68, 0.3);
    color: #ef4444;
  }

  /* Map Section */
  .map-section {
    padding: 6rem 0;
    background: var(--bg-glass);
    border-top: var(--border-glass);
  }

  .map-container {
    border-radius: 20px;
    overflow: hidden;
    border: var(--border-glass);
    height: 400px;
  }

  .map-placeholder {
    width: 100%;
    height: 100%;
    background: 
      radial-gradient(circle at 30% 30%, rgba(255, 60, 43, 0.1) 0%, transparent 60%),
      var(--bg-glass);
    display: flex;
    align-items: center;
    justify-content: center;
    backdrop-filter: blur(10px);
