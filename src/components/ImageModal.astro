---
// Simple image modal for full-size viewing
---

<!-- Google Fonts for Manga Typography -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Reggae+One&family=Zen+Kaku+Gothic+New:wght@300;400;500;700&family=Bangers&display=swap" rel="stylesheet">

<!-- Modal backdrop and container -->
<div id="image-modal" class="image-modal" style="display: none;">
  <div class="modal-backdrop" data-close-modal></div>
  <div class="modal-content">
    <button class="modal-close" data-close-modal aria-label="Close modal">✕</button>
    <img id="modal-image" src="" alt="" class="modal-image">
    <div class="modal-info">
      <h3 id="modal-title" class="modal-title"></h3>
      <p id="modal-description" class="modal-description"></p>
    </div>
  </div>
</div>

<style>
  .image-modal {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }

  .modal-backdrop {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.9);
    backdrop-filter: blur(4px);
  }

  .modal-content {
    position: relative;
    max-width: 90vw;
    max-height: 90vh;
    background: linear-gradient(145deg, #2a2a2a, #1a1a1a);
    border: 2px solid #d4af37;
    border-radius: 16px;
    padding: 1rem;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.8);
  }

  .modal-close {
    position: absolute;
    top: -0.5rem;
    right: -0.5rem;
    width: 2.5rem;
    height: 2.5rem;
    background: #d4af37;
    color: #2c3e50;
    border: none;
    border-radius: 50%;
    font-size: 1.25rem;
    font-weight: bold;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
    z-index: 1001;
  }

  .modal-close:hover {
    background: #ffd700;
    transform: scale(1.1);
  }

  .modal-image {
    width: 100%;
    height: auto;
    max-height: 70vh;
    object-fit: contain;
    border-radius: 8px;
    margin-bottom: 1rem;
  }

  .modal-info {
    text-align: center;
    color: white;
  }

  .modal-title {
    font-size: 1.25rem;
    color: #d4af37;
    margin: 0 0 0.5rem 0;
    font-weight: bold;
  }

  .modal-description {
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.8);
    margin: 0;
  }

  /* Manga Modal Styling */
  .manga-modal .modal-content {
    border: 4px solid #1a1a1a;
    border-radius: 0;
    background: white;
    box-shadow: 12px 12px 0 rgba(0,0,0,0.3);
    position: relative;
  }

  .manga-modal .modal-content::before {
    content: '';
    position: absolute;
    top: -4px;
    left: -4px;
    right: -4px;
    bottom: -4px;
    border: 2px solid rgba(26, 26, 26, 0.3);
    pointer-events: none;
  }

  .manga-modal .modal-close {
    background: #1a1a1a;
    color: white;
    border: 3px solid white;
    font-family: 'Courier New', monospace;
    font-weight: bold;
    width: 3rem;
    height: 3rem;
    font-size: 1.5rem;
  }

  .manga-modal .modal-close:hover {
    background: white;
    color: #1a1a1a;
    border-color: #1a1a1a;
    transform: scale(1.1);
  }

  .manga-modal .modal-title {
    font-family: 'Bangers', cursive;
    font-size: 1.5rem;
    color: #1a1a1a;
    text-shadow: 2px 2px 0 #fff, -1px -1px 0 #1a1a1a, 1px -1px 0 #1a1a1a, -1px 1px 0 #1a1a1a, 1px 1px 0 #1a1a1a;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .manga-modal .modal-description {
    color: #666;
    font-family: 'Zen Kaku Gothic New', sans-serif;
    font-weight: 500;
  }

  .manga-modal .modal-image {
    border: 3px solid #1a1a1a;
    border-radius: 0;
    filter: grayscale(0.1) contrast(1.1);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .modal-content {
      max-width: 95vw;
      max-height: 95vh;
      padding: 0.75rem;
    }

    .modal-image {
      max-height: 60vh;
    }

    .modal-title {
      font-size: 1rem;
    }

    .modal-description {
      font-size: 0.8125rem;
    }

    .manga-modal .modal-content {
      box-shadow: 8px 8px 0 rgba(0,0,0,0.3);
    }
    
    .manga-modal .modal-title {
      font-size: 1.25rem;
    }
  }
</style>

<script>
  // Enhanced modal functionality with better error handling
  function initImageModal() {
    const modal = document.getElementById('image-modal');
    const modalImage = document.getElementById('modal-image');
    const modalTitle = document.getElementById('modal-title');
    const modalDescription = document.getElementById('modal-description');
    
    if (!modal || !modalImage || !modalTitle || !modalDescription) {
      console.warn('ImageModal: Required elements not found');
      return;
    }

    // Open modal when clicking on gallery images
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const triggerElement = target.closest('[data-modal-trigger]') as HTMLElement;
      
      if (triggerElement) {
        e.preventDefault();
        
        const src = triggerElement.getAttribute('data-modal-src') || '';
        const title = triggerElement.getAttribute('data-modal-title') || '';
        const description = triggerElement.getAttribute('data-modal-description') || '';
        
        if (src) {
          (modalImage as HTMLImageElement).src = src;
          (modalImage as HTMLImageElement).alt = title;
          modalTitle.textContent = title;
          modalDescription.textContent = description;
          
          modal.style.display = 'flex';
          document.body.style.overflow = 'hidden';
          
          // Add manga-specific styling if it's a manga panel
          if (triggerElement.classList.contains('manga-panel')) {
            modal.classList.add('manga-modal');
          } else {
            modal.classList.remove('manga-modal');
          }
        }
      }
    });

    // Close modal
    function closeModal() {
      if (modal) {
        modal.style.display = 'none';
        modal.classList.remove('manga-modal');
      }
      document.body.style.overflow = '';
    }

    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target.matches('[data-close-modal]')) {
        closeModal();
      }
    });

    // Close on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal && modal.style.display === 'flex') {
        closeModal();
      }
    });
  }

  // Initialize when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initImageModal);
  } else {
    initImageModal();
  }
</script>
