---
// Simplified RPG-style work card component
import WorkTypeLabel from './WorkTypeLabel.astro';

interface Props {
  image: string;
  title?: string;
  description?: string;
  tags?: string[];
  rarity?: 'common' | 'rare' | 'epic' | 'legendary';
  index: number;
  workNumber?: number;
}

const { image, title, description, tags = [], rarity = 'rare', index, workNumber } = Astro.props;

// Rarity styling
const rarityStyles = {
  common: { 
    borderColor: '#95a5a6', 
    glowColor: 'rgba(149, 165, 166, 0.3)',
    bgGradient: 'linear-gradient(145deg, #2c3e50 0%, #34495e 100%)'
  },
  rare: { 
    borderColor: '#3498db', 
    glowColor: 'rgba(52, 152, 219, 0.4)',
    bgGradient: 'linear-gradient(145deg, #2980b9 0%, #3498db 100%)'
  },
  epic: { 
    borderColor: '#9b59b6', 
    glowColor: 'rgba(155, 89, 182, 0.5)',
    bgGradient: 'linear-gradient(145deg, #8e44ad 0%, #9b59b6 100%)'
  },
  legendary: { 
    borderColor: '#f39c12', 
    glowColor: 'rgba(243, 156, 18, 0.6)',
    bgGradient: 'linear-gradient(145deg, #e67e22 0%, #f39c12 100%)'
  }
};

const rarityStyle = rarityStyles[rarity];
const animationDelay = index * 0.1;
const displayTitle = title || `Epic Work #${workNumber || index + 1}`;
const displayDescription = description || "Legendary tattoo masterpiece";
---

<article 
  class="rpg-work-card" 
  style={`
    --border-color: ${rarityStyle.borderColor};
    --glow-color: ${rarityStyle.glowColor};
    --bg-gradient: ${rarityStyle.bgGradient};
    animation-delay: ${animationDelay}s;
  `}
  data-rarity={rarity}
  data-modal-trigger
  data-modal-src={image}
  data-modal-title={displayTitle}
  data-modal-description={displayDescription}
  tabindex="0"
  role="button"
  aria-label={`View ${displayTitle} - Click to enlarge`}
>
  <!-- Card Header -->
  <header class="card-header">
    <div class="work-number">#{(workNumber || index + 1).toString().padStart(3, '0')}</div>
    <div class="rarity-badge" data-rarity={rarity}>
      <span class="rarity-icon">{rarity === 'legendary' ? '🌟' : rarity === 'epic' ? '💎' : rarity === 'rare' ? '💠' : '⚪'}</span>
      <span class="rarity-text">{rarity.toUpperCase()}</span>
    </div>
  </header>

  <!-- Work Image -->
  <div class="work-image-container">
    <div class="image-frame">
      <img 
        src={image} 
        alt={displayTitle}
        class="work-image"
        loading="lazy"
        decoding="async"
        width="300"
        height="300"
      />
      <div class="image-overlay">
        <div class="overlay-content">
          <div class="zoom-hint">👁️ View Details</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Work Info -->
  <div class="work-info">
    <h3 class="work-title">{displayTitle}</h3>
    <p class="work-description">{displayDescription}</p>
    
    <!-- Tags -->
    {tags.length > 0 && (
      <div class="work-tags">
        {tags.map(tag => (
          <WorkTypeLabel type={tag} size="small" />
        ))}
      </div>
    )}
  </div>
</article>

<style>
  .rpg-work-card {
    background: var(--bg-gradient);
    border: 2px solid var(--border-color);
    border-radius: 16px;
    padding: 1.25rem;
    transform: translateY(20px);
    opacity: 0;
    animation: slideInUp 0.8s ease-out forwards;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    cursor: pointer;
    position: relative;
    overflow: hidden;
    backdrop-filter: blur(10px);
    box-shadow: 
      0 8px 32px rgba(0, 0, 0, 0.3),
      inset 0 1px 0 rgba(255, 255, 255, 0.1);
  }

  .rpg-work-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(45deg, transparent 30%, rgba(255, 255, 255, 0.05) 50%, transparent 70%);
    transform: translateX(-100%);
    transition: transform 0.6s ease;
    pointer-events: none;
  }

  .rpg-work-card:hover::before {
    transform: translateX(100%);
  }

  .rpg-work-card:hover,
  .rpg-work-card:focus-visible {
    transform: translateY(-8px) scale(1.02);
    box-shadow: 
      0 16px 48px var(--glow-color),
      0 8px 32px rgba(0, 0, 0, 0.4),
      inset 0 1px 0 rgba(255, 255, 255, 0.2);
    border-color: var(--border-color);
  }

  .rpg-work-card:focus-visible {
    outline: 2px solid var(--border-color);
    outline-offset: 2px;
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }

  .work-number {
    font-family: 'Courier New', monospace;
    font-weight: bold;
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.875rem;
    background: rgba(0, 0, 0, 0.3);
    padding: 0.25rem 0.5rem;
    border-radius: 0.5rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .rarity-badge {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.25rem 0.75rem;
    border-radius: 1rem;
    font-size: 0.75rem;
    font-weight: bold;
    background: rgba(0, 0, 0, 0.4);
    border: 1px solid var(--border-color);
    color: white;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.5);
  }

  .work-image-container {
    margin-bottom: 1rem;
  }

  .image-frame {
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    background: linear-gradient(145deg, #1a1a1a, #2a2a2a);
    border: 2px solid rgba(255, 255, 255, 0.1);
  }

  .work-image {
    width: 100%;
    height: 200px;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }

  .image-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(to bottom, transparent 0%, rgba(0, 0, 0, 0.8) 100%);
    opacity: 0;
    transition: opacity 0.3s ease;
    display: flex;
    align-items: flex-end;
    padding: 1rem;
  }

  .rpg-work-card:hover .image-overlay {
    opacity: 1;
  }

  .rpg-work-card:hover .work-image {
    transform: scale(1.05);
  }

  .overlay-content {
    color: white;
    text-align: center;
    width: 100%;
  }

  .zoom-hint {
    font-size: 0.875rem;
    font-weight: bold;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8);
  }

  .work-info {
    color: white;
  }

  .work-title {
    font-size: 1.125rem;
    font-weight: bold;
    margin: 0 0 0.5rem 0;
    color: #d4af37;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.5);
  }

  .work-description {
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.8);
    margin: 0 0 1rem 0;
    line-height: 1.4;
  }

  .work-meta {
    display: flex;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .meta-item {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.7);
  }

  .work-stats {
    margin-bottom: 1rem;
  }

  .stat-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.375rem;
    font-size: 0.75rem;
  }

  .stat-label {
    flex: 0 0 60px;
    color: rgba(255, 255, 255, 0.8);
    font-weight: 500;
  }

  .stat-progress {
    flex: 1;
    height: 6px;
    background: rgba(0, 0, 0, 0.3);
    border-radius: 3px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .stat-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--border-color), rgba(212, 175, 55, 0.8));
    border-radius: 3px;
    transition: width 0.8s ease;
  }

  .stat-value {
    flex: 0 0 24px;
    text-align: right;
    color: #d4af37;
    font-weight: bold;
  }

  .work-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
  }

  @keyframes slideInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Responsive */
  @media (max-width: 640px) {
    .rpg-work-card {
      padding: 1rem;
    }

    .work-image {
      height: 160px;
    }

    .work-title {
      font-size: 1rem;
    }

    .work-description {
      font-size: 0.8125rem;
    }
  }
</style>
