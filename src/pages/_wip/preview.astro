---
import Layout from '../layouts/Layout.astro';
import OptimizedEnhancedHomeHero from '../components/OptimizedEnhancedHomeHero.astro';
import OptimizedBlobGallery from '../components/OptimizedBlobGallery.astro';

const title = "Cursed Ink Society — Premier Tattoo Artists in Houma, LA";
const description = "Experience the finest tattoo artistry in Houma, Louisiana. Our collective of master artists specializes in custom designs, traditional work, and mystical ink. Start your artistic journey today.";
---

<Layout title={title} description={description}>
  <!-- Performance-Optimized Homepage Hero Section -->
  <OptimizedEnhancedHomeHero />

  <!-- Performance-Optimized Featured Artists Section -->
  <OptimizedBlobGallery />
</Layout>

