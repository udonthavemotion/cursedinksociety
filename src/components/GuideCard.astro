---
/**
 * GuideCard Component
 * Individual piercing guide card with anatomy diagram, pricing, and details
 */
import type { PiercingGuide } from '../data/piercingGuides';

interface Props {
  guide: PiercingGuide;
  index: number;
}

const { guide, index } = Astro.props;

// Pain level indicators
const painIndicators = '●'.repeat(guide.painLevel) + '○'.repeat(5 - guide.painLevel);
---

<details class="guide-card" data-category={guide.category} style={`animation-delay: ${index * 100}ms;`}>
  <summary class="guide-header">
    <h3 class="guide-title">{guide.title}</h3>
    <span class="expand-icon" aria-hidden="true">›</span>
  </summary>
  
  <div class="guide-content">
    <!-- Main Info Grid -->
    <div class="guide-grid">
      <!-- Anatomy Image Section -->
      <div class="anatomy-section">
        <div class="anatomy-viewer">
          <img
            src={guide.anatomyImage}
            alt={`${guide.title} anatomy diagram showing piercing locations`}
            width="600"
            height="800"
            loading="lazy"
            decoding="async"
            class="anatomy-image"
          />
        </div>
        {guide.exampleImages.length > 0 && (
          <div class="example-photos">
            <p class="section-label">Real Examples:</p>
            <div class="photo-grid">
              {guide.exampleImages.map((img, idx) => (
                <img
                  src={img}
                  alt={`${guide.title} example ${idx + 1}`}
                  width="400"
                  height="400"
                  loading="lazy"
                  decoding="async"
                  class="example-image"
                />
              ))}
            </div>
          </div>
        )}
      </div>
      
      <!-- Info Section -->
      <div class="info-section">
        <p class="guide-description">{guide.description}</p>
        
        <!-- Quick Stats -->
        <div class="quick-stats">
          <div class="stat-item">
            <span class="stat-label">Healing Time</span>
            <span class="stat-value">{guide.healingTime}</span>
          </div>
          <div class="stat-item">
            <span class="stat-label">Pain Level</span>
            <span class="stat-value pain-level" title={`${guide.painLevel} out of 5`}>
              {painIndicators}
            </span>
          </div>
          <div class="stat-item">
            <span class="stat-label">Age Requirement</span>
            <span class="stat-value">{guide.ageRequirement}</span>
          </div>
        </div>
        
        <!-- Piercing Types -->
        <div class="piercing-types">
          <p class="section-label">Available Types:</p>
          <div class="type-chips">
            {guide.piercingTypes.map(type => (
              <span class="type-chip">{type}</span>
            ))}
          </div>
        </div>
        
        <!-- Aftercare Highlights -->
        <div class="aftercare-preview">
          <p class="section-label">Aftercare Essentials:</p>
          <ul class="aftercare-list">
            {guide.aftercareHighlights.map(highlight => (
              <li>{highlight}</li>
            ))}
          </ul>
        </div>
        
        <!-- CTA Button -->
        <div class="guide-cta">
          <a 
            href="https://www.facebook.com/harley.halford" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="book-button"
          >
            Message Harley to Book
          </a>
        </div>
      </div>
    </div>
  </div>
</details>

<style>
  @import "../styles/tattoo-theme.css";


  .guide-card {
    background: var(--bgcard);
    border: 1px solid var(--line);
    border-radius: 4px;
    overflow: hidden;
    transition: all 0.15s ease-out;
    opacity: 0;
    animation: fadeInUp 0.6s ease-out forwards;
  }
  
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  .guide-card[open] {
    border-color: var(--line);
  }
  
  /* Header */
  .guide-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.5rem 2rem;
    cursor: pointer;
    list-style: none;
    transition: background 0.15s ease-out;
    gap: 1rem;
    background: rgba(255, 255, 255, 0.01);
  }
  
  .guide-header::-webkit-details-marker {
    display: none;
  }
  
  .guide-header:hover {
    background: rgba(255, 255, 255, 0.04);
  }
  
  .guide-title {
    margin: 0;
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    font-weight: 700;
    color: var(--text);
    letter-spacing: 0.02em;
  }
  
  .expand-icon {
    font-size: 1.5rem;
    color: var(--muted);
    transition: transform 0.3s ease;
    flex-shrink: 0;
    line-height: 1;
    font-weight: 300;
  }
  
  .guide-card[open] .expand-icon {
    transform: rotate(90deg);
  }
  
  /* Content */
  .guide-content {
    padding: 0 2rem 2rem;
    background: rgba(255, 255, 255, 0.005);
  }
  
  .guide-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  
  @media (min-width: 768px) {
    .guide-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2.5rem;
    }
  }
  
  /* Anatomy Section */
  .anatomy-section {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  
  .anatomy-viewer {
    background: #000;
    border-radius: 4px;
    overflow: hidden;
    border: 1px solid var(--line);
  }
  
  .anatomy-image {
    width: 100%;
    height: auto;
    display: block;
  }
  
  .example-photos {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  
  .photo-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    gap: 0.5rem;
  }
  
  .example-image {
    width: 100%;
    height: auto;
    border-radius: 4px;
    border: 1px solid var(--line);
    transition: transform 0.15s ease-out;
  }
  
  .example-image:hover {
    transform: scale(1.03);
  }
  
  /* Info Section */
  .info-section {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  
  .guide-description {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--text);
    margin: 0;
  }
  
  .section-label {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
    margin: 0 0 0.5rem;
  }
  
  /* Quick Stats */
  .quick-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    gap: 0.75rem;
    padding: 1rem;
    background: rgba(255, 255, 255, 0.02);
    border-radius: 4px;
    border: 1px solid var(--line);
  }
  
  .stat-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  
  .stat-label {
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
    font-weight: 600;
  }
  
  .stat-value {
    font-size: 0.9375rem;
    color: var(--text);
    font-weight: 600;
  }
  
  .pain-level {
    font-size: 1.125rem;
    letter-spacing: 0.1em;
    color: var(--accent);
  }
  
  /* Piercing Types */
  .piercing-types {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  
  .type-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  
  .type-chip {
    display: inline-block;
    padding: 0.375rem 0.75rem;
    background: transparent;
    border: 1px solid var(--line);
    border-radius: 4px;
    font-size: 0.8125rem;
    color: var(--muted);
    transition: all 0.15s ease-out;
  }
  
  .type-chip:hover {
    border-color: var(--accent);
    color: var(--text);
  }
  
  /* Aftercare */
  .aftercare-preview {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  
  .aftercare-list {
    margin: 0;
    padding-left: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  
  .aftercare-list li {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--muted);
  }
  
  .aftercare-list li::marker {
    color: var(--accent);
  }
  
  /* CTA */
  .guide-cta {
    margin-top: 0.5rem;
  }
  
  .book-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 0 1.25rem;
    height: 44px;
    background: transparent;
    border: 1px solid var(--text);
    color: var(--text);
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
    border-radius: 4px;
    transition: all 0.15s ease-out;
  }
  
  .book-button:hover,
  .book-button:focus-visible {
    background: var(--accent);
    border-color: var(--accent);
    color: #000;
  }
  
  .book-button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  
  /* Responsive */
  @media (max-width: 767px) {
    .guide-header {
      padding: 1.25rem 1.5rem;
    }
    
    .guide-content {
      padding: 0 1.5rem 1.5rem;
    }
    
    .guide-title {
      font-size: 1.125rem;
    }
    
    .quick-stats {
      grid-template-columns: 1fr;
    }
  }
  
  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .guide-card,
    .expand-icon,
    .anatomy-image,
    .example-image,
    .type-chip,
    .book-button {
      animation: none;
      transition: none;
    }
  }
</style>

