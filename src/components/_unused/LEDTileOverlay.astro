---
// LED Tile Overlay Component - Inspired by shop hexagonal lighting system
export interface Props {
  intensity?: 'subtle' | 'medium' | 'bright';
  pattern?: 'hex' | 'scattered' | 'grid';
}

const { 
  intensity = 'medium',
  pattern = 'hex' 
} = Astro.props;
---

<div class={`led-overlay led-overlay--${intensity} led-overlay--${pattern}`}>
  <div class="led-tiles"></div>
  <div class="led-highlights"></div>
</div>

<style>
  .led-overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
    overflow: hidden;
  }

  /* LED Tile Base Pattern */
  .led-tiles {
    position: absolute;
    inset: 0;
    background-image: 
      /* Primary hex tiles with bright rim lighting */
      repeating-conic-gradient(
        from 30deg at 50% 50%,
        transparent 0deg 57deg,
        rgba(255, 255, 255, 0.9) 57deg 59deg,
        rgba(255, 255, 255, 0.4) 59deg 61deg,
        rgba(255, 255, 255, 0.9) 61deg 63deg,
        transparent 63deg 117deg,
        rgba(255, 255, 255, 0.9) 117deg 119deg,
        rgba(255, 255, 255, 0.4) 119deg 121deg,
        rgba(255, 255, 255, 0.9) 121deg 123deg,
        transparent 123deg 177deg,
        rgba(255, 255, 255, 0.9) 177deg 179deg,
        rgba(255, 255, 255, 0.4) 179deg 181deg,
        rgba(255, 255, 255, 0.9) 181deg 183deg,
        transparent 183deg 237deg,
        rgba(255, 255, 255, 0.9) 237deg 239deg,
        rgba(255, 255, 255, 0.4) 239deg 241deg,
        rgba(255, 255, 255, 0.9) 241deg 243deg,
        transparent 243deg 297deg,
        rgba(255, 255, 255, 0.9) 297deg 299deg,
        rgba(255, 255, 255, 0.4) 299deg 301deg,
        rgba(255, 255, 255, 0.9) 301deg 303deg,
        transparent 303deg 357deg,
        rgba(255, 255, 255, 0.9) 357deg 359deg,
        rgba(255, 255, 255, 0.4) 359deg 361deg,
        rgba(255, 255, 255, 0.9) 361deg 363deg
      );
    background-size: 100px 100px;
    animation: ledTileFlow 12s ease-in-out infinite;
  }

  /* Bright LED Highlights - Mimicking Shop Lighting */
  .led-highlights {
    position: absolute;
    inset: 0;
    background-image:
      /* Scattered bright spots */
      radial-gradient(circle 3px at 15% 20%, rgba(255, 255, 255, 0.9) 0%, transparent 70%),
      radial-gradient(circle 2px at 85% 15%, rgba(255, 255, 255, 0.7) 0%, transparent 70%),
      radial-gradient(circle 4px at 25% 80%, rgba(255, 255, 255, 0.8) 0%, transparent 70%),
      radial-gradient(circle 2px at 75% 85%, rgba(255, 255, 255, 0.6) 0%, transparent 70%),
      radial-gradient(circle 3px at 45% 40%, rgba(255, 255, 255, 0.5) 0%, transparent 70%),
      radial-gradient(circle 2px at 65% 60%, rgba(255, 255, 255, 0.7) 0%, transparent 70%);
    animation: ledSparkle 6s ease-in-out infinite;
  }

  /* Intensity Variations */
  .led-overlay--subtle .led-tiles {
    opacity: 0.1;
  }

  .led-overlay--medium .led-tiles {
    opacity: 0.2;
  }

  .led-overlay--bright .led-tiles {
    opacity: 0.4;
  }

  .led-overlay--subtle .led-highlights {
    opacity: 0.3;
  }

  .led-overlay--medium .led-highlights {
    opacity: 0.5;
  }

  .led-overlay--bright .led-highlights {
    opacity: 0.8;
  }

  /* Pattern Variations */
  .led-overlay--scattered .led-tiles {
    background-size: 80px 80px, 120px 120px, 160px 160px;
    background-position: 0 0, 40px 40px, 80px 80px;
  }

  .led-overlay--grid .led-tiles {
    background-size: 60px 60px;
    background-position: 0 0;
  }

  /* Animations */
  @keyframes ledTileFlow {
    0%, 100% { 
      opacity: 0.2;
      transform: translateX(0) translateY(0);
      filter: brightness(1);
    }
    25% { 
      opacity: 0.4;
      transform: translateX(2px) translateY(-1px);
      filter: brightness(1.3);
    }
    50% { 
      opacity: 0.6;
      transform: translateX(-1px) translateY(2px);
      filter: brightness(1.6);
    }
    75% { 
      opacity: 0.4;
      transform: translateX(1px) translateY(-2px);
      filter: brightness(1.3);
    }
  }

  @keyframes ledSparkle {
    0%, 100% { 
      opacity: 0.3;
      filter: brightness(1);
    }
    20% { 
      opacity: 0.8;
      filter: brightness(2);
    }
    40% { 
      opacity: 0.4;
      filter: brightness(1.2);
    }
    60% { 
      opacity: 0.9;
      filter: brightness(2.2);
    }
    80% { 
      opacity: 0.5;
      filter: brightness(1.4);
    }
  }

  /* Reduced Motion */
  @media (prefers-reduced-motion: reduce) {
    .led-overlay .led-tiles,
    .led-overlay .led-highlights {
      animation: none;
      opacity: 0.2;
    }
  }
</style>
