  .artist-specialties {
    padding: 6rem 0;
    background: var(--bg-glass);
  }

  .artist-specialties h2 {
    text-align: center;
    font-size: clamp(2rem, 4vw, 2.5rem);
    margin-bottom: 3rem;
    color: var(--ink);
    text-shadow: var(--glow-subtle);
  }

  .specialties-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
  }

  .specialty-card {
    background: rgba(255, 255, 255, 0.02);
