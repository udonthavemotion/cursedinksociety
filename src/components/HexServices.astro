---
import servicesData from '../data/services.json';
const { services } = servicesData;
---

<section class="services-section">
  <div class="container mx-auto max-w-6xl px-4 md:px-6 py-16">
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-semibold tracking-wide mb-3">Sacred Artistry</h2>
      <p class="text-gray-400 text-sm uppercase tracking-[0.2em]">Each service crafted with mystical precision and artistic mastery</p>
    </div>

    <div class="grid md:grid-cols-2 gap-12">
      {services.slice(0, 6).map((service, index) => (
        <div class="space-y-4">
          <div class="flex items-center justify-between">
            <h3 class="text-xl font-medium text-white">{service.title}</h3>
            {service.popular && <span class="text-red-600 text-xs uppercase tracking-wide">Most Sought</span>}
          </div>

          <p class="text-gray-300 leading-relaxed">{service.description}</p>

          <div class="space-y-2">
            {service.features.slice(0, 3).map(feature => (
              <div class="flex items-center gap-2 text-sm text-gray-400">
                <span class="text-red-600">•</span>
                <span>{feature}</span>
              </div>
            ))}
          </div>

          <div class="border-t border-white/10 pt-4">
            {service.pricing.hourly && (
              <div class="text-lg font-medium text-white">{service.pricing.hourly}/hr</div>
            )}
            {service.pricing.starting && (
              <div class="text-lg font-medium text-white">From {service.pricing.starting}</div>
            )}
            {service.pricing.minimum && (
              <div class="text-gray-400 text-sm">{service.pricing.minimum} minimum</div>
            )}
          </div>

          {service.artists && (
            <div class="text-sm text-gray-400">
              <span class="text-gray-300">Artists: </span>
              {service.artists.join(", ")}
            </div>
          )}

          <div class="pt-4">
            <a href="/consultation" class="btn">
              Begin Journey
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                <path d="M5 12h14m-7-7l7 7-7 7"/>
              </svg>
            </a>
          </div>
        </div>
      ))}
    </div>

    <div class="text-center mt-16">
      <a href="/services" class="btn btn--outline">
        Explore All Sacred Services
      </a>
    </div>
  </div>
</section>

