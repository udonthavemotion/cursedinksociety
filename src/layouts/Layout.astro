        overflow: hidden;
      }

      .pricing-dropdown::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 2px;
        background: linear-gradient(90deg, transparent, rgba(255, 60, 43, 0.6), transparent);
      }

      .pricing-dropdown--open,
      .nav-item-with-dropdown:hover .pricing-dropdown {
        opacity: 1;
        visibility: visible;
        transform: translateX(-50%) translateY(0);
        pointer-events: auto;
      }

      /* Smart positioning to prevent overflow */
      .pricing-dropdown {
        /* Prevent dropdown from going off-screen on small screens */
        left: clamp(10px, 50%, calc(100vw - 430px));
        transform: translateX(clamp(-90%, -50%, -10%)) translateY(-10px);
      }

      .pricing-dropdown--open,
      .nav-item-with-dropdown:hover .pricing-dropdown {
        transform: translateX(clamp(-90%, -50%, -10%)) translateY(0);
      }

      .pricing-dropdown-content {
        padding: 2.5rem;
        contain: layout style paint;
        position: relative;
      }

      /* Performance optimizations */
      .pricing-dropdown {
        will-change: transform, opacity;
        contain: layout;
      }

      .nav-item-with-dropdown:hover .pricing-dropdown,
      .pricing-dropdown--open {
        will-change: auto;
      }

      .pricing-grid-mini {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
        margin-bottom: 1.5rem;
      }

      .pricing-item-mini {
        background: linear-gradient(135deg, rgba(255, 255, 255, 0.04) 0%, rgba(255, 255, 255, 0.02) 100%);
        border: 1px solid rgba(255, 60, 43, 0.15);
        border-radius: 16px;
        padding: 1.25rem;
        text-align: center;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
        overflow: hidden;
      }

      .pricing-item-mini::before {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(135deg, rgba(255, 60, 43, 0.1) 0%, rgba(255, 60, 43, 0.05) 100%);
        opacity: 0;
        transition: opacity 0.3s ease;
        border-radius: 16px;
      }

      .pricing-item-mini:hover::before {
        opacity: 1;
      }

      .pricing-item-mini:hover {
        border-color: rgba(255, 60, 43, 0.4);
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(255, 60, 43, 0.15);
      }

      .pricing-label-mini {
        display: block;
        font-size: 0.85rem;
        opacity: 0.8;
        margin-bottom: 0.5rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--ink);
        font-weight: 600;
        position: relative;
        z-index: 1;
      }

      .pricing-value-mini {
        display: block;
        font-size: 1.1rem;
        font-weight: 800;
        color: var(--accent0);
        text-shadow: 0 0 12px rgba(255, 60, 43, 0.6);
        position: relative;
        z-index: 1;
      }

      .pricing-features-mini {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        margin-bottom: 1.5rem;
      }

      .feature-mini {
        font-size: 0.85rem;
        color: var(--ink);
        opacity: 0.9;
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }

      .feature-mini::before {
        content: '●';
        color: var(--accent0);
        font-weight: bold;
        font-size: 0.8rem;
        text-shadow: 0 0 8px rgba(255, 60, 43, 0.6);
      }

      .pricing-cta-mini {
        text-align: center;
        border-top: 1px solid rgba(255, 60, 43, 0.15);
        padding-top: 2rem;
        margin-top: 1rem;
      }

      .btn--mini {
        font-size: 0.9rem;
        padding: 0.75rem 1.5rem;
        margin-bottom: 1rem;
        display: inline-block;
        width: auto;
      }

      .pricing-contact-mini {
        display: flex;
        justify-content: center;
        gap: 1rem;
        font-size: 0.85rem;
      }

      .contact-phone-mini,
      .contact-instagram-mini {
        color: var(--ink);
        text-decoration: none;
        opacity: 0.8;
        transition: var(--transition-smooth);
        font-weight: 500;
      }

      .contact-phone-mini:hover,
      .contact-instagram-mini:hover {
        opacity: 1;
        color: var(--accent0);
        text-shadow: var(--glow-subtle);
      }

      .nav-link-pricing {
        position: relative;
      }

      /* Remove arrow/emoji indicators for cleaner look */

      /* Enhanced focus styles for accessibility */
      .nav-link-pricing:focus {
        outline: 2px solid var(--accent0);
        outline-offset: 2px;
        border-radius: 4px;
      }

      .pricing-dropdown a:focus {
        outline: 2px solid var(--accent0);
        outline-offset: 2px;
        border-radius: 4px;
      }

      /* Add top padding to body to account for fixed nav */
      body {
        padding-top: 80px;
      }

    /* Skip link styles */
    .skip-link {
      position: absolute;
      top: -40px;
      left: 6px;
      background: var(--accent0);
      color: white;
      padding: 8px;
      text-decoration: none;
      border-radius: 4px;
      z-index: 1000;
      font-weight: 600;
      transition: top 0.2s;
    }

    .skip-link:focus {
      top: 6px;
    }

    /* Screen reader only content */
    .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }
