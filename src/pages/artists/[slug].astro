  /* ===========================================
     ASHLEY WOOD WATERCOLOR PORTFOLIO STYLES
     =========================================== */

  /* Subtle Black & Pink Gothic Background Overlay */
  .watercolor-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background:
      radial-gradient(circle at 15% 20%, rgba(255, 20, 147, 0.03) 0%, transparent 70%),
      radial-gradient(circle at 85% 80%, rgba(220, 20, 60, 0.02) 0%, transparent 60%),
      radial-gradient(circle at 70% 40%, rgba(138, 43, 226, 0.015) 0%, transparent 50%),
      linear-gradient(135deg,
        rgba(10, 10, 12, 0.1),
        rgba(15, 10, 16, 0.08),
        rgba(10, 10, 12, 0.1)
      );
    pointer-events: none;
    z-index: -1;
  }

  /* Hero Section */
  .ashley-hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    background: linear-gradient(135deg,
      rgba(251, 207, 232, 0.9) 0%,    /* Soft lavender */
      rgba(255, 182, 193, 0.85) 25%,   /* Light pink */
      rgba(255, 240, 245, 0.9) 50%,    /* Misty rose */
      rgba(230, 230, 250, 0.85) 75%,   /* Lavender */
      rgba(255, 218, 185, 0.9) 100%    /* Peach */
    );
    padding: 6rem 0;
    overflow: hidden;
  }

  .ashley-hero::before {
    content: '';
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background:
      radial-gradient(circle at 30% 20%, rgba(255, 182, 193, 0.3) 0%, transparent 70%),
      radial-gradient(circle at 70% 80%, rgba(221, 160, 221, 0.25) 0%, transparent 60%),
      radial-gradient(circle at 50% 50%, rgba(173, 216, 230, 0.2) 0%, transparent 50%),
      radial-gradient(circle at 20% 60%, rgba(255, 218, 185, 0.3) 0%, transparent 65%);
    animation: sparkle-float 30s ease-in-out infinite;
    pointer-events: none;
  }

  @keyframes sparkle-float {
    0%, 100% { transform: translate(0, 0) rotate(0deg) scale(1); }
    20% { transform: translate(-10px, -5px) rotate(1deg) scale(1.02); }
    40% { transform: translate(8px, -12px) rotate(-1.5deg) scale(0.98); }
    60% { transform: translate(-8px, 8px) rotate(2deg) scale(1.01); }
    80% { transform: translate(5px, -4px) rotate(-0.5deg) scale(0.99); }
  }

  .ashley-hero-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
    position: relative;
    z-index: 3;
  }

  /* Video Background Styles */
  .ashley-hero-video {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
    opacity: 0.7;
    filter: contrast(1.05) brightness(0.95) saturate(1.1);
    transform: scale(1.02);
    transition: opacity 0.3s ease;
    will-change: transform;
  }

  /* Fallback image for video */
  .ashley-hero-fallback {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
    opacity: 0.3;
    filter: blur(1px) contrast(0.9);
  }

  /* Gradient overlays for text readability */
  .ashley-video-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg,
      rgba(10, 10, 12, 0.2) 0%,
      rgba(15, 10, 16, 0.15) 30%,
      rgba(20, 15, 18, 0.1) 60%,
      rgba(10, 10, 12, 0.25) 100%
    );
    z-index: 2;
  }

  .ashley-gothic-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background:
      radial-gradient(circle at 20% 30%, rgba(255, 20, 147, 0.15) 0%, transparent 60%),
      radial-gradient(circle at 80% 70%, rgba(220, 20, 60, 0.12) 0%, transparent 50%),
      radial-gradient(circle at 50% 50%, rgba(138, 43, 226, 0.08) 0%, transparent 45%);
    z-index: 2;
    animation: gothic-float 40s ease-in-out infinite;
  }

  /* Avatar Frame */
  .watercolor-frame {
    position: relative;
    border-radius: 50%;
    padding: 6px;
    background: linear-gradient(135deg,
      rgba(255, 20, 147, 0.8),
      rgba(220, 20, 60, 0.6),
      rgba(138, 43, 226, 0.4),
      rgba(10, 10, 12, 0.9)
    );
    box-shadow:
      0 0 30px rgba(255, 20, 147, 0.4),
      0 0 60px rgba(220, 20, 60, 0.2),
      inset 0 2px 0 rgba(255, 255, 255, 0.1);
    border: 2px solid rgba(255, 20, 147, 0.3);
  }

  .ashley-avatar {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid rgba(255, 20, 147, 0.6);
    transition: all 0.4s ease;
  }

  .ashley-avatar:hover {
    transform: scale(1.05);
    box-shadow: 0 0 40px rgba(255, 20, 147, 0.6), 0 0 80px rgba(220, 20, 60, 0.3);
    border-color: rgba(255, 20, 147, 0.9);
  }

  /* Badge */
  .watercolor-badge {
    background: linear-gradient(135deg,
      rgba(255, 20, 147, 0.9),
      rgba(220, 20, 60, 0.7),
      rgba(138, 43, 226, 0.5),
      rgba(10, 10, 12, 0.8)
    );
    color: #fff;
    padding: 0.75rem 1.5rem;
    border-radius: 25px;
    font-family: 'Cinzel', serif;
    font-weight: 700;
    font-size: 0.9rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    box-shadow:
      0 0 20px rgba(255, 20, 147, 0.5),
      0 0 40px rgba(220, 20, 60, 0.3),
      inset 0 1px 0 rgba(255, 255, 255, 0.2);
    border: 2px solid rgba(255, 20, 147, 0.6);
    margin-bottom: 1.5rem;
    display: inline-block;
    text-shadow: 0 0 8px rgba(255, 20, 147, 0.8);
  }

  /* Girly Typography */
  .ashley-name {
    font-family: 'Great Vibes', 'Sacramento', cursive;
    font-size: 4.5rem;
    font-weight: 400;
    color: #d63384;  /* Hot pink */
    margin-bottom: 1rem;
    text-shadow:
      0 0 20px rgba(255, 182, 193, 0.8),
      0 0 30px rgba(221, 160, 221, 0.6),
      2px 2px 8px rgba(255, 255, 255, 0.4);
    line-height: 1.2;
    text-align: center;
  }

  .ashley-title {
    font-family: 'Poppins', sans-serif;
    font-size: 1.6rem;
    color: rgba(221, 160, 221, 0.95);  /* Soft plum */
    font-weight: 300;
    margin-bottom: 1rem;
    font-style: normal;
    text-shadow: 0 0 15px rgba(255, 182, 193, 0.6);
    text-align: center;
    letter-spacing: 0.5px;
  }

  .ashley-creed {
    font-size: 1.1rem;
    color: rgba(255, 182, 193, 0.9);
    font-weight: 400;
    margin-bottom: 1.5rem;
    font-style: italic;
    font-family: 'Cinzel', serif;
    text-shadow: 0 0 6px rgba(255, 182, 193, 0.5);
  }

  .ashley-location,
  .ashley-experience {
    color: rgba(255, 20, 147, 0.8);
    font-size: 1rem;
    margin-bottom: 0.5rem;
    font-weight: 500;
    text-shadow: 0 0 4px rgba(255, 20, 147, 0.4);
  }

  /* Chroma Stats */
  .chroma-stats {
    margin: 2rem 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .chroma-bar {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .chroma-label {
    font-family: 'Cinzel', serif;
    font-size: 0.85rem;
    font-weight: 600;
    color: rgba(255, 182, 193, 0.9);
    min-width: 120px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    text-shadow: 0 0 4px rgba(255, 182, 193, 0.5);
  }

  .chroma-fill {
    flex: 1;
    height: 10px;
    background: rgba(10, 10, 12, 0.6);
    border-radius: 5px;
    overflow: hidden;
    box-shadow:
      inset 0 1px 2px rgba(0, 0, 0, 0.5),
      0 0 8px rgba(255, 20, 147, 0.2);
    border: 1px solid rgba(255, 20, 147, 0.3);
  }

  .chroma-value {
    height: 100%;
    background: linear-gradient(90deg,
      rgba(255, 20, 147, 0.9),
      rgba(220, 20, 60, 0.7),
      rgba(138, 43, 226, 0.5)
    );
    border-radius: 4px;
    transition: width 1.5s ease-out;
    box-shadow:
      0 0 12px rgba(255, 20, 147, 0.8),
      0 0 24px rgba(220, 20, 60, 0.5);
    position: relative;
  }

  .chroma-value::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(90deg,
      transparent,
      rgba(255, 255, 255, 0.3),
      transparent
    );
    border-radius: 4px;
  }

  .chroma-number {
    font-family: 'Cinzel', serif;
    font-size: 0.85rem;
    font-weight: 700;
    color: rgba(255, 20, 147, 0.9);
    min-width: 45px;
    text-shadow: 0 0 4px rgba(255, 20, 147, 0.6);
    text-align: right;
  }

  /* CTA Buttons */
  .ashley-ctas {
    display: flex;
    gap: 1rem;
    margin-top: 2rem;
  }

  .ashley-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 2.5rem;
    border-radius: 50px;  /* Full pill shape */
    font-family: 'Poppins', sans-serif;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.3s ease;
    box-shadow:
      0 8px 24px rgba(255, 182, 193, 0.3),
      0 4px 12px rgba(221, 160, 221, 0.2);
    position: relative;
    overflow: hidden;
    text-transform: none;
    letter-spacing: 0.5px;
    font-size: 1.1rem;
  }

  .ashley-btn.primary {
    background: linear-gradient(135deg,
      rgba(255, 182, 193, 0.95) 0%,    /* Light pink */
      rgba(255, 20, 147, 0.9) 25%,     /* Hot pink */
      rgba(138, 43, 226, 0.85) 50%,    /* Purple */
      rgba(221, 160, 221, 0.9) 75%,    /* Plum */
      rgba(255, 182, 193, 0.95) 100%   /* Back to light pink */
    );
    color: #fff;
    border: 2px solid rgba(255, 182, 193, 0.6);
    text-shadow: 0 0 8px rgba(255, 255, 255, 0.5);
  }

  .ashley-btn.secondary {
    background: linear-gradient(135deg,
      rgba(255, 240, 245, 0.95) 0%,    /* Misty rose */
      rgba(230, 230, 250, 0.9) 50%,    /* Lavender */
      rgba(255, 218, 185, 0.95) 100%   /* Peach */
    );
    color: rgba(138, 43, 226, 0.9);  /* Purple text */
    border: 2px solid rgba(221, 160, 221, 0.5);
    text-shadow: 0 0 4px rgba(255, 255, 255, 0.6);
  }

  .ashley-btn:hover {
    transform: translateY(-2px) scale(1.02);
    box-shadow:
      0 12px 32px rgba(255, 182, 193, 0.4),
      0 6px 16px rgba(221, 160, 221, 0.3),
      0 4px 12px rgba(173, 216, 230, 0.2);
  }

  .ashley-btn::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg,
      transparent,
      rgba(255, 255, 255, 0.4),
      rgba(255, 20, 147, 0.6),
      rgba(255, 255, 255, 0.4),
      transparent
    );
    transition: left 0.8s ease;
  }

  .ashley-btn:hover::before {
    left: 100%;
  }

  /* Floating Particles & Sparkle Effects */
  .ashley-hero::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-image: 
      radial-gradient(circle at 20% 30%, rgba(255, 255, 255, 0.8) 2px, transparent 3px),
      radial-gradient(circle at 60% 20%, rgba(255, 182, 193, 0.6) 1px, transparent 2px),
      radial-gradient(circle at 80% 60%, rgba(221, 160, 221, 0.5) 1.5px, transparent 2.5px),
      radial-gradient(circle at 30% 80%, rgba(173, 216, 230, 0.4) 1px, transparent 2px),
      radial-gradient(circle at 90% 40%, rgba(255, 255, 255, 0.7) 1px, transparent 2px),
      radial-gradient(circle at 10% 70%, rgba(255, 218, 185, 0.5) 1px, transparent 2px);
    background-size: 400px 400px, 300px 300px, 500px 500px, 350px 350px, 450px 450px, 250px 250px;
    animation: twinkle 8s ease-in-out infinite;
    pointer-events: none;
    opacity: 0.6;
  }

  @keyframes twinkle {
    0%, 100% { opacity: 0.6; transform: scale(1); }
    25% { opacity: 0.8; transform: scale(1.05); }
    50% { opacity: 0.4; transform: scale(0.95); }
    75% { opacity: 0.9; transform: scale(1.02); }
  }

  /* Emojis removed for cleaner design */

  /* Hero section emojis removed - keeping only portfolio section emojis */

  /* Glitter overlay for portfolio items */
  .portfolio-item::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-image: 
      radial-gradient(circle at 25% 25%, rgba(255, 255, 255, 0.8) 1px, transparent 2px),
      radial-gradient(circle at 75% 25%, rgba(255, 182, 193, 0.6) 1px, transparent 2px),
      radial-gradient(circle at 25% 75%, rgba(221, 160, 221, 0.5) 1px, transparent 2px),
      radial-gradient(circle at 75% 75%, rgba(173, 216, 230, 0.4) 1px, transparent 2px);
    background-size: 80px 80px, 120px 120px, 100px 100px, 90px 90px;
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
    z-index: 1;
  }

  .portfolio-item:hover::before {
    opacity: 0.7;
    animation: sparkle-dance 2s ease-in-out infinite;
  }

  @keyframes sparkle-dance {
    0%, 100% { transform: scale(1) rotate(0deg); }
    25% { transform: scale(1.02) rotate(1deg); }
    50% { transform: scale(0.98) rotate(-1deg); }
    75% { transform: scale(1.01) rotate(0.5deg); }
  }

  /* Girly Portfolio Section */
  .ashley-portfolio {
    padding: 6rem 0;
    background: linear-gradient(180deg,
      rgba(255, 240, 245, 0.95) 0%,    /* Misty rose */
      rgba(230, 230, 250, 0.9) 25%,    /* Lavender */
      rgba(255, 218, 185, 0.85) 50%,   /* Peach */
      rgba(251, 207, 232, 0.9) 75%,    /* Light pink */
      rgba(255, 240, 245, 0.95) 100%   /* Back to misty rose */
    );
    position: relative;
  }

  .ashley-portfolio::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background:
      radial-gradient(circle at 20% 30%, rgba(255, 182, 193, 0.15) 0%, transparent 60%),
      radial-gradient(circle at 80% 70%, rgba(221, 160, 221, 0.12) 0%, transparent 55%),
      radial-gradient(circle at 50% 20%, rgba(173, 216, 230, 0.1) 0%, transparent 50%),
      radial-gradient(circle at 30% 80%, rgba(255, 218, 185, 0.08) 0%, transparent 45%);
    pointer-events: none;
  }

  .portfolio-header {
    text-align: center;
    margin-bottom: 4rem;
    position: relative;
    z-index: 1;
  }

  .portfolio-title {
    font-family: 'Sacramento', 'Great Vibes', cursive;
    font-size: 3.5rem;
    font-weight: 400;
    color: #d63384;  /* Hot pink */
    margin-bottom: 1rem;
    text-shadow:
      0 0 20px rgba(255, 182, 193, 0.8),
      0 0 30px rgba(221, 160, 221, 0.6),
      2px 2px 8px rgba(255, 255, 255, 0.4);
    text-align: center;
  }

  .portfolio-subtitle {
    font-size: 1.2rem;
    color: rgba(255, 182, 193, 0.9);
    font-style: italic;
    font-family: 'Cinzel', serif;
    text-shadow: 0 0 6px rgba(255, 182, 193, 0.5);
  }

  /* Girly Portfolio Grid */
  .portfolio-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2.5rem;
    margin-top: 3rem;
  }

  .portfolio-item {
    position: relative;
    border-radius: 32px;  /* Extra soft rounded corners */
    overflow: hidden;
    transition: all 0.3s ease-out;
    box-shadow:
      0 8px 32px rgba(255, 182, 193, 0.3),
      0 4px 16px rgba(221, 160, 221, 0.2),
      0 2px 8px rgba(173, 216, 230, 0.15);
    border: 4px solid transparent;
    background: linear-gradient(white, white) padding-box,
                linear-gradient(135deg, 
                  rgba(255, 182, 193, 0.6) 0%,
                  rgba(221, 160, 221, 0.5) 25%,
                  rgba(173, 216, 230, 0.4) 50%,
                  rgba(255, 218, 185, 0.5) 75%,
                  rgba(255, 182, 193, 0.6) 100%) border-box;
  }

  .portfolio-item:hover {
    transform: translateY(-6px) scale(1.02);
    box-shadow:
      0 12px 48px rgba(255, 182, 193, 0.4),
      0 8px 24px rgba(221, 160, 221, 0.3),
      0 4px 12px rgba(173, 216, 230, 0.2);
    /* Add sparkle overlay on hover */
  }

  .portfolio-item::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: 
      radial-gradient(circle at 20% 30%, rgba(255, 255, 255, 0.6) 1px, transparent 2px),
      radial-gradient(circle at 70% 20%, rgba(255, 255, 255, 0.4) 1px, transparent 2px),
      radial-gradient(circle at 40% 80%, rgba(255, 255, 255, 0.5) 1px, transparent 2px),
      radial-gradient(circle at 80% 70%, rgba(255, 255, 255, 0.3) 1px, transparent 2px);
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }

  .portfolio-item:hover::after {
    opacity: 1;
  }

  .watercolor-border {
    position: relative;
    border-radius: 20px;
    padding: 4px;
    background: linear-gradient(135deg,
      rgba(255, 20, 147, 0.8),
      rgba(220, 20, 60, 0.6),
      rgba(138, 43, 226, 0.4),
      rgba(10, 10, 12, 0.9)
    );
    box-shadow:
      0 0 20px rgba(255, 20, 147, 0.4),
      0 0 40px rgba(220, 20, 60, 0.2);
    overflow: hidden;
  }

  .portfolio-image {
    width: 100%;
    height: 300px;
    object-fit: cover;
    border-radius: 28px;  /* Softer corners to match container */
    transition: all 0.3s ease-out;
    filter: brightness(1.05) saturate(1.1);
  }

  .portfolio-item:hover .portfolio-image {
    transform: scale(1.03);  /* Gentler scale */
    filter: brightness(1.1) saturate(1.15) contrast(1.05);
  }

  /* Mobile Responsive */
  @media (max-width: 1024px) {
    .ashley-hero-content {
      grid-template-columns: 1fr;
      gap: 3rem;
      text-align: center;
    }

    .ashley-name {
      font-size: 2.5rem;
    }

    .portfolio-grid {
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 1.5rem;
    }
  }

  @media (max-width: 768px) {
    .ashley-hero {
      padding: 4rem 0;
    }

    .ashley-name {
      font-size: 2rem;
    }

    .ashley-title {
      font-size: 1.2rem;
    }

    .portfolio-title {
      font-size: 2rem;
    }

    .portfolio-grid {
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 1rem;
    }

    .portfolio-image {
      height: 250px;
    }

    .ashley-ctas {
      flex-direction: column;
      gap: 0.75rem;
    }

    .ashley-btn {
      justify-content: center;
      padding: 0.875rem 1.5rem;
    }
  }

  @media (max-width: 768px) {
    .ashley-hero {
      min-height: 90vh;
      padding: 4rem 0;
    }

    .ashley-hero-video {
      opacity: 0.5;
      filter: contrast(1.1) brightness(0.9) saturate(1.2);
      transform: scale(1.01);
    }

    .ashley-video-overlay {
      background: linear-gradient(135deg,
        rgba(10, 10, 12, 0.35) 0%,
        rgba(15, 10, 16, 0.25) 40%,
        rgba(20, 15, 18, 0.15) 70%,
        rgba(10, 10, 12, 0.4) 100%
      );
    }

    .ashley-gothic-overlay {
      background:
        radial-gradient(circle at 20% 30%, rgba(255, 20, 147, 0.2) 0%, transparent 55%),
        radial-gradient(circle at 80% 70%, rgba(220, 20, 60, 0.18) 0%, transparent 45%),
        radial-gradient(circle at 50% 50%, rgba(138, 43, 226, 0.12) 0%, transparent 40%);
    }
  }

  @media (max-width: 480px) {
    .ashley-hero {
      padding: 3rem 0;
      min-height: 80vh;
    }

    .ashley-name {
      font-size: 1.75rem;
    }

    .portfolio-title {
      font-size: 1.75rem;
    }

    .portfolio-grid {
      grid-template-columns: 1fr;
    }

    .portfolio-image {
      height: 200px;
    }

    .chroma-bar {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }

    .chroma-label {
      min-width: auto;
    }

    .ashley-hero-video {
      opacity: 0.4;
      filter: contrast(1.2) brightness(0.85) saturate(1.3);
    }

    .ashley-video-overlay {
      background: linear-gradient(135deg,
        rgba(10, 10, 12, 0.45) 0%,
        rgba(15, 10, 16, 0.35) 40%,
        rgba(20, 15, 18, 0.25) 70%,
        rgba(10, 10, 12, 0.5) 100%
      );
    }

    .ashley-gothic-overlay {
      background:
        radial-gradient(circle at 20% 30%, rgba(255, 20, 147, 0.25) 0%, transparent 50%),
        radial-gradient(circle at 80% 70%, rgba(220, 20, 60, 0.22) 0%, transparent 40%),
        radial-gradient(circle at 50% 50%, rgba(138, 43, 226, 0.15) 0%, transparent 35%);
    }
  }

  /* Accessibility */
  @media (prefers-reduced-motion: reduce) {
    .ashley-hero::before,
    .ashley-gothic-overlay,
    .chroma-value,
    .ashley-btn::before,
    .portfolio-item,
    .portfolio-image,
    .ashley-hero-video {
      animation: none;
      transition: none;
    }

    .ashley-avatar:hover,
    .portfolio-item:hover {
      transform: none;
    }
  }

  @media (prefers-contrast: high) {
    .watercolor-overlay,
    .ashley-hero::before {
      display: none;
    }

    .ashley-hero {
      background: rgba(255, 247, 245, 0.95);
    }

    .ashley-btn {
      border-width: 3px;
    }

    .watercolor-frame {
      border: 3px solid rgba(251, 207, 232, 0.8);
    }
  }

  /* ===========================================
     TRENT ELECTRIC APPRENTICE THEME STYLES
     =========================================== */

  /* Electric Background Overlay */
  .background-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(135deg, rgba(10, 10, 15, 0.95) 0%, rgba(15, 15, 20, 0.9) 100%);
    pointer-events: none;
    z-index: -1;
  }



  /* Trent Hero Section */
  .trent-hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    position: relative;
    z-index: 2;
    background: linear-gradient(135deg,
      rgba(10, 10, 15, 0.95) 0%,
      rgba(15, 15, 20, 0.9) 50%,
      rgba(20, 20, 25, 0.8) 100%);
  }

  .trent-hero-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
    max-width: 1400px;
    margin: 0 auto;
  }

  .trent-hero-image {
    position: relative;
    z-index: 3;
  }

  .professional-frame {
    position: relative;
    border-radius: 0px;
    overflow: hidden;
    clip-path: polygon(0 0, 100% 0, 100% 90%, 90% 100%, 0 100%);
    box-shadow:
      0 0 40px rgba(0, 0, 0, 0.3),
      0 0 80px rgba(0, 0, 0, 0.1),
      inset 0 0 40px rgba(255, 255, 255, 0.05);
    width: 350px;
    height: 350px;
    border: 3px solid rgba(255, 255, 255, 0.2);
  }

  .trent-avatar {
    width: 100%;
    height: 100%;
    border-radius: 0px;
    border: 4px solid rgba(255, 255, 255, 0.3);
    object-fit: cover;
    object-position: center;
    transition: all 0.6s ease;
    position: relative;
    z-index: 2;
    filter: grayscale(0.1) contrast(1.1);
  }

  .trent-avatar:hover {
    transform: scale(1.05) translate(10px, -10px);
    border-color: rgba(255, 255, 255, 0.6);
    filter: grayscale(0) contrast(1.2);
    box-shadow:
      0 0 60px rgba(0, 0, 0, 0.4),
      0 0 120px rgba(0, 0, 0, 0.2);
  }

  /* Trent Hero Info */
  .trent-hero-info {
    position: relative;
    z-index: 3;
  }

  .trent-badge {
    margin-bottom: 2rem;
  }

  .professional-badge {
    background: linear-gradient(135deg,
      rgba(0, 0, 0, 0.8),
      rgba(20, 20, 20, 0.6));
    color: #ffffff;
    padding: 1rem 2rem;
    border-radius: 0px;
    font-family: 'JetBrains Mono', monospace;
    font-weight: 700;
    font-size: 1.2rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    clip-path: polygon(0 0, 100% 0, 100% 85%, 85% 100%, 0 100%);
    border: 2px solid rgba(255, 255, 255, 0.3);
    box-shadow:
      0 0 20px rgba(0, 0, 0, 0.5),
      inset 0 2px 0 rgba(255, 255, 255, 0.1);
  }

  .trent-name {
    font-family: 'JetBrains Mono', monospace;
    font-size: 4rem;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 1rem;
    text-shadow:
      0 0 20px rgba(0, 0, 0, 0.5),
      0 0 40px rgba(0, 0, 0, 0.3),
      3px 3px 6px rgba(0, 0, 0, 0.8);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    line-height: 1;
  }

  .trent-title {
    font-family: 'JetBrains Mono', monospace;
    font-size: 1.5rem;
    color: rgba(255, 255, 255, 0.9);
    margin-bottom: 1rem;
    text-shadow: 0 0 15px rgba(0, 0, 0, 0.4);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    font-weight: 600;
  }

  .trent-creed {
    font-family: 'JetBrains Mono', monospace;
    font-size: 1.2rem;
    color: rgba(255, 255, 255, 0.8);
    margin-bottom: 2rem;
    text-shadow: 0 0 15px rgba(0, 0, 0, 0.3);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 500;
  }

  .trent-location {
    font-family: 'JetBrains Mono', monospace;
    color: rgba(255, 255, 255, 0.8);
    font-size: 1rem;
    margin-bottom: 2rem;
    letter-spacing: 0.05em;
  }


  /* Trent Badges */
  .trent-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 2rem;
  }

  .trent-badge-item {
    background: linear-gradient(135deg,
      rgba(0, 0, 0, 0.3),
      rgba(20, 20, 20, 0.2));
    color: rgba(255, 255, 255, 0.9);
    padding: 0.5rem 1rem;
    border-radius: 0px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border: 1px solid rgba(255, 255, 255, 0.3);
    clip-path: polygon(0 0, 100% 0, 100% 80%, 80% 100%, 0 100%);
    transition: all 0.3s ease;
  }

  .trent-badge-item:hover {
    background: linear-gradient(135deg,
      rgba(0, 0, 0, 0.5),
      rgba(30, 30, 30, 0.4));
    border-color: rgba(255, 255, 255, 0.6);
    transform: translate(2px, -2px);
  }

  /* Trent CTA Section */
  .trent-cta-section {
    margin-top: 2rem;
  }

  .trent-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    background: linear-gradient(135deg,
      rgba(56, 189, 248, 0.9),
      rgba(139, 92, 246, 0.7),
      rgba(253, 224, 71, 0.5));
    color: #0a0a0f;
    padding: 1.5rem 3rem;
    border-radius: 0px;
    font-family: 'JetBrains Mono', monospace;
    font-weight: 700;
    font-size: 1.2rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    text-decoration: none;
    clip-path: polygon(0 0, 100% 0, 100% 85%, 85% 100%, 0 100%);
    box-shadow:
      0 8px 24px rgba(56, 189, 248, 0.5),
      0 4px 12px rgba(139, 92, 246, 0.4);
    transition: all 0.4s ease;
    position: relative;
    overflow: hidden;
  }

  .trent-cta-btn::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg,
      transparent,
      rgba(253, 224, 71, 0.6),
      transparent);
