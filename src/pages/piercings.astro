---
import Layout from '../layouts/Layout.astro';
import AgeGateModal from '../components/AgeGateModal.astro';
import OptimizedImage from '../components/OptimizedImage.astro';

// Import piercing data
import piercingsData from '../content/piercings.json';

const pageTitle = "Piercings - Cursed Ink Society (18+)";
const pageDescription = "Professional body piercing services at Cursed Ink Society. Expert artists, premium jewelry, and safe practices. Age verification required - 18+ only.";

const { piercings, categories, artists } = piercingsData;
---

<Layout title={pageTitle} description={pageDescription} noIndex={true}>
  <!-- Age Gate Modal -->
  <AgeGateModal />

  <!-- Hero Section -->
  <section class="piercings-hero">
    <div class="container">
      <div class="hero-content">
        <div class="age-badge">18+ ONLY</div>
        <h1 class="hero-title">Professional Piercings</h1>
        <p class="hero-subtitle">Expert body modification with premium jewelry and safe practices</p>
        <div class="hero-stats">
          <div class="stat">
            <span class="stat-number">{piercings.length}</span>
            <span class="stat-label">Services</span>
          </div>
          <div class="stat">
            <span class="stat-number">{categories.length}</span>
            <span class="stat-label">Categories</span>
          </div>
          <div class="stat">
            <span class="stat-number">{artists.length}</span>
            <span class="stat-label">Artists</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Gallery Header -->
  <section class="gallery-header">
    <div class="container">
      <h2 class="gallery-title">Professional Piercing Portfolio</h2>
      <p class="gallery-subtitle">Browse our comprehensive collection of professional piercing work</p>
    </div>
  </section>

  <!-- Piercings Gallery -->
  <section class="piercings-gallery">
    <div class="container">
      <div class="gallery-grid" id="piercings-grid">
        {piercings.map((piercing) => (
          <div class="gallery-item">
            <div class="image-container">
              <OptimizedImage
                src={piercing.thumbnail.src}
                alt={piercing.thumbnail.alt}
                width={piercing.thumbnail.width}
                height={piercing.thumbnail.height}
                class="gallery-image blurred-content"
              />
              <div class="image-overlay">
                <button class="view-btn" onclick={`openModal('${piercing.id}')`} disabled>
                  <span class="view-icon">👁️</span>
                  View
                </button>
              </div>
            </div>
            <div class="image-info">
              <h3 class="image-title">{piercing.title}</h3>
              <span class="image-artist">by {piercing.artist}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Modal for detailed view -->
  <div id="piercing-modal" class="modal-overlay" onclick="closeModal()">
    <div class="modal-content" onclick="event.stopPropagation()">
      <button class="modal-close" onclick="closeModal()" aria-label="Close modal">×</button>
      <div id="modal-body">
        <!-- Dynamic content will be inserted here -->
      </div>
    </div>
  </div>

  <!-- Compliance Section -->
  <section class="compliance-section">
    <div class="container">
      <div class="compliance-content">
        <h2>Age Verification & Safety</h2>
        <p>All piercing services require valid ID and are restricted to clients 18 years and older. We maintain the highest standards of safety and hygiene.</p>
        <a href="/policies/age-verification" class="policy-link">View our Age Verification Policy</a>
      </div>
    </div>
  </section>
</Layout>

<script define:vars={{ piercings }}>
  // Age verification and modal functionality
  class PiercingsPage {
    constructor(piercingsData) {
      this.isAgeVerified = false;
      this.piercingsData = piercingsData;
      this.init();
    }

    init() {
      this.checkAgeVerification();
      this.setupModalFunctionality();
    }

    checkAgeVerification() {
      // Check if age is verified via cookie or localStorage
      const cookies = document.cookie.split(';');
      const ageCookie = cookies.find(cookie => 
        cookie.trim().startsWith('cis_age_ok=')
      );
      
      const stored = localStorage.getItem('cis_age_ok');
      
      if ((ageCookie && ageCookie.includes('1')) || stored === '1') {
        this.isAgeVerified = true;
        this.enableContent();
      }

      // Listen for age verification events
      document.addEventListener('ageVerified', () => {
        this.isAgeVerified = true;
        this.enableContent();
      });
    }

    enableContent() {
      // Remove blur from content
      document.documentElement.setAttribute('data-age-ok', 'true');
      
      // Enable view buttons
      const viewButtons = document.querySelectorAll('.view-btn');
      viewButtons.forEach(btn => {
        btn.disabled = false;
      });

      // Enable thumbnail clicks
      const thumbnails = document.querySelectorAll('.gallery-image');
      thumbnails.forEach(thumb => {
        thumb.style.cursor = 'pointer';
      });
    }

    setupModalFunctionality() {
      // Modal functionality will be handled by global functions
      // due to Astro's scoping requirements
    }
  }

  // Global modal functions (required for onclick handlers)
  function openModal(piercingId) {
    if (!document.documentElement.hasAttribute('data-age-ok')) {
      return; // Don't open if not age verified
    }

    const piercing = piercings.find((p) => p.id === piercingId);
    if (!piercing) return;

    const modal = document.getElementById('piercing-modal');
    const modalBody = document.getElementById('modal-body');
    
    if (!modal || !modalBody) return;

    modalBody.innerHTML = `
      <div class="modal-image">
        <img 
          src="${piercing.image.src}" 
          alt="${piercing.image.alt}"
          width="${piercing.image.width}"
          height="${piercing.image.height}"
          loading="lazy"
        />
      </div>
      <div class="modal-details">
        <h2>${piercing.title}</h2>
        <p class="modal-description">${piercing.description}</p>
        
        <div class="detail-grid">
          <div class="detail-item">
            <strong>Artist:</strong> ${piercing.artist}
          </div>
          <div class="detail-item">
            <strong>Category:</strong> ${piercing.category}
          </div>
          <div class="detail-item">
            <strong>Healing Time:</strong> ${piercing.details.healingTime}
          </div>
          <div class="detail-item">
            <strong>Pain Level:</strong> ${piercing.details.painLevel}
          </div>
          <div class="detail-item">
            <strong>Jewelry:</strong> ${piercing.details.jewelry}
          </div>
          <div class="detail-item">
            <strong>Price Range:</strong> ${piercing.price}
          </div>
        </div>
        
        <div class="aftercare-section">
          <h3>Aftercare Instructions</h3>
          <p>${piercing.details.aftercare}</p>
        </div>
        
        <div class="modal-actions">
          <a href="/contact" class="btn btn--primary">Book Consultation</a>
        </div>
      </div>
    `;

    modal.style.display = 'flex';
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    const modal = document.getElementById('piercing-modal');
    if (modal) {
      modal.style.display = 'none';
      document.body.style.overflow = '';
    }
  }

  // Handle escape key for modal
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeModal();
    }
  });

  // Make functions global
  window.openModal = openModal;
  window.closeModal = closeModal;

  // Initialize page
  new PiercingsPage(piercings);
</script>

<style>
  /* Age-gated blur effect */
  .blurred-content {
    filter: blur(20px);
    transition: filter 0.3s ease;
  }

  html[data-age-ok="true"] .blurred-content {
    filter: none;
  }

  /* Hero Section */
  .piercings-hero {
    padding: 6rem 0 4rem;
    background: 
      radial-gradient(ellipse at 30% 20%, rgba(220, 20, 60, 0.15) 0%, transparent 50%),
      radial-gradient(ellipse at 70% 80%, rgba(255, 60, 43, 0.1) 0%, transparent 50%),
      linear-gradient(135deg, #0b0b0d 0%, #1a1a1f 100%);
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .hero-content {
    position: relative;
    z-index: 2;
  }

  .age-badge {
    display: inline-block;
    background: linear-gradient(135deg, var(--accent0), var(--accent1));
    color: var(--ink);
    padding: 0.5rem 1rem;
    border-radius: 20px;
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 1rem;
    box-shadow: 0 4px 12px rgba(220, 20, 60, 0.3);
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .hero-title {
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 900;
    color: var(--ink);
    text-shadow: var(--glow-primary);
    margin-bottom: 1rem;
    line-height: 1.1;
  }

  .hero-subtitle {
    font-size: clamp(1.1rem, 2.5vw, 1.3rem);
    color: rgba(245, 245, 245, 0.8);
    margin-bottom: 2rem;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
    text-shadow: var(--glow-subtle);
  }

  .hero-stats {
    display: flex;
    justify-content: center;
    gap: 3rem;
    flex-wrap: wrap;
  }

  .stat {
    text-align: center;
  }

  .stat-number {
    display: block;
    font-size: 2.5rem;
    font-weight: 900;
    color: var(--accent0);
    text-shadow: var(--glow-primary);
    line-height: 1;
  }

  .stat-label {
    display: block;
    font-size: 0.9rem;
    color: rgba(245, 245, 245, 0.7);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-top: 0.5rem;
  }

  /* Gallery Header */
  .gallery-header {
    padding: 3rem 0 2rem;
    text-align: center;
    background: rgba(255, 255, 255, 0.02);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .gallery-title {
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    font-weight: 700;
    color: var(--ink);
    text-shadow: var(--glow-subtle);
    margin-bottom: 0.75rem;
  }

  .gallery-subtitle {
    font-size: 1.1rem;
    color: rgba(245, 245, 245, 0.8);
    text-shadow: var(--glow-subtle);
    max-width: 600px;
    margin: 0 auto;
  }

  /* Gallery Section */
  .piercings-gallery {
    padding: 4rem 0;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
    max-width: 1400px;
    margin: 0 auto;
  }

  .gallery-item {
    background: 
      radial-gradient(ellipse at 50% 20%, rgba(255, 60, 43, 0.05) 0%, transparent 60%),
      linear-gradient(135deg, rgba(255, 255, 255, 0.08) 0%, rgba(255, 255, 255, 0.02) 100%);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 15px;
    overflow: hidden;
    transition: var(--transition-smooth);
    backdrop-filter: blur(10px);
  }

  .gallery-item:hover {
    transform: translateY(-3px);
    box-shadow: 0 15px 30px rgba(0, 0, 0, 0.3);
    border-color: rgba(255, 255, 255, 0.2);
  }

  .image-container {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
  }

  .gallery-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: var(--transition-smooth);
  }

  .image-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: var(--transition-smooth);
  }

  .image-container:hover .image-overlay {
    opacity: 1;
  }

  .view-btn {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.6rem 1.2rem;
    background: var(--accent0);
    color: var(--ink);
    border: none;
    border-radius: 20px;
    font-weight: 600;
    cursor: pointer;
    transition: var(--transition-smooth);
    font-size: 0.9rem;
  }

  .view-btn:disabled {
    background: rgba(128, 128, 128, 0.3);
    color: rgba(245, 245, 245, 0.5);
    cursor: not-allowed;
  }

  .view-btn:not(:disabled):hover {
    background: var(--accent1);
    transform: scale(1.05);
  }

  .view-icon {
    font-size: 1rem;
  }

  .image-info {
    padding: 1rem;
    text-align: center;
  }

  .image-title {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--ink);
    margin-bottom: 0.4rem;
    text-shadow: var(--glow-subtle);
    line-height: 1.3;
  }

  .image-artist {
    font-size: 0.85rem;
    color: rgba(245, 245, 245, 0.7);
    font-style: italic;
  }

  /* Modal Styles */
  .modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.9);
    backdrop-filter: blur(10px);
    z-index: 10000;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }

  .modal-content {
    background: 
      radial-gradient(ellipse at 50% 20%, rgba(255, 60, 43, 0.1) 0%, transparent 60%),
      linear-gradient(135deg, #0f0f11 0%, #1a1a1f 100%);
    border: 2px solid rgba(255, 255, 255, 0.12);
    border-radius: 20px;
    max-width: 800px;
    width: 100%;
    max-height: 90vh;
    overflow-y: auto;
    position: relative;
  }

  .modal-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: rgba(0, 0, 0, 0.5);
    color: var(--ink);
    border: none;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    font-size: 1.5rem;
    cursor: pointer;
    z-index: 10001;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: var(--transition-smooth);
  }

  .modal-close:hover {
    background: var(--accent0);
  }

  #modal-body {
    padding: 2rem;
  }

  .modal-image img {
    width: 100%;
    height: auto;
    border-radius: 15px;
    margin-bottom: 1.5rem;
  }

  .modal-details h2 {
    font-size: 2rem;
    color: var(--ink);
    text-shadow: var(--glow-subtle);
    margin-bottom: 1rem;
  }

  .modal-description {
    color: rgba(245, 245, 245, 0.8);
    line-height: 1.6;
    margin-bottom: 1.5rem;
    font-size: 1.1rem;
  }

  .detail-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .detail-item {
    padding: 0.75rem;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 10px;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .detail-item strong {
    color: var(--accent0);
    display: block;
    margin-bottom: 0.25rem;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .aftercare-section {
    background: rgba(255, 255, 255, 0.05);
    padding: 1.5rem;
    border-radius: 15px;
    margin-bottom: 1.5rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .aftercare-section h3 {
    color: var(--accent0);
    margin-bottom: 0.75rem;
    font-size: 1.2rem;
  }

  .aftercare-section p {
    color: rgba(245, 245, 245, 0.8);
    line-height: 1.6;
  }

  .modal-actions {
    text-align: center;
  }

  /* Compliance Section */
  .compliance-section {
    padding: 3rem 0;
    background: rgba(255, 255, 255, 0.02);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .compliance-content {
    text-align: center;
    max-width: 600px;
    margin: 0 auto;
  }

  .compliance-content h2 {
    font-size: 1.8rem;
    color: var(--ink);
    text-shadow: var(--glow-subtle);
    margin-bottom: 1rem;
  }

  .compliance-content p {
    color: rgba(245, 245, 245, 0.8);
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .policy-link {
    color: var(--accent0);
    text-decoration: none;
    font-weight: 600;
    transition: var(--transition-smooth);
    border-bottom: 1px solid transparent;
  }

  .policy-link:hover {
    color: var(--accent0);
    text-shadow: var(--glow-subtle);
    border-bottom-color: var(--accent0);
  }

  /* Mobile Responsiveness */
  @media (max-width: 768px) {
    .hero-stats {
      gap: 2rem;
    }

    .gallery-header {
      padding: 2rem 0 1.5rem;
    }

    .gallery-grid {
      grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
      gap: 1rem;
    }

    .gallery-item {
      max-width: 350px;
      margin: 0 auto;
    }

    .image-info {
      padding: 0.8rem;
    }

    .image-title {
      font-size: 1rem;
    }

    .detail-grid {
      grid-template-columns: 1fr;
    }

    .modal-content {
      margin: 1rem;
      max-width: calc(100vw - 2rem);
    }

    #modal-body {
      padding: 1.5rem;
    }
  }

  @media (max-width: 480px) {
    .gallery-grid {
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: 0.8rem;
    }

    .view-btn {
      padding: 0.5rem 1rem;
      font-size: 0.8rem;
    }

    .image-title {
      font-size: 0.95rem;
    }

    .image-artist {
      font-size: 0.8rem;
    }
  }

  /* High contrast mode */
  @media (prefers-contrast: high) {
    .gallery-item,
    .modal-content {
      border-width: 2px;
    }
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .gallery-item,
    .view-btn,
    .blurred-content {
      transition: none;
    }
    
    .gallery-item:hover {
      transform: none;
    }
  }
</style>
