---
import '../styles/global.css';
import Cart from '../components/Cart.astro';
import MysticalEnhancements from '../components/MysticalEnhancements.astro';
import LEDTileOverlay from '../components/LEDTileOverlay.astro';

export interface Props {
  title: string;
  description: string;
  canonicalURL?: URL;
  ogImage?: URL;
  noIndex?: boolean;
}

const { 
  title, 
  description, 
  canonicalURL = new URL(Astro.url.pathname, Astro.site),
  ogImage = new URL('/og/og-image.jpg', Astro.url),
  noIndex = false
} = Astro.props;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "TattooParlor",
  "name": "Cursed Ink Society",
  "description": "Premium tattoo collective in Houma, Louisiana featuring Anthony, Ashley, Cody, Seth, Luis, and Trent. Specializing in custom designs, traditional work, and mystical ink.",
  "url": canonicalURL.toString(),
  "logo": new URL('/brand/cursed-ink-logo.png', Astro.url).toString(),
  "telephone": "(985) 555-2873",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "123 Main Street",
    "addressLocality": "Houma",
    "addressRegion": "LA",
    "postalCode": "70360",
    "addressCountry": "US"
  },
  "openingHours": [
    "Tu-Th 12:00-20:00",
    "Fr-Sa 12:00-22:00"
  ],
  "sameAs": [
    "https://instagram.com/cursedinksociety",
    "https://facebook.com/cursedinksociety"
  ],
  "priceRange": "$$$",
  "areaServed": "Houma, Louisiana",
  "founder": [
    {"@type": "Person", "name": "Anthony Boudreaux"},
    {"@type": "Person", "name": "Ashley Wood"},
    {"@type": "Person", "name": "Cody Crochet"},
    {"@type": "Person", "name": "Seth Wood"},
    {"@type": "Person", "name": "Luis Reymundo"},
    {"@type": "Person", "name": "Trent"}
  ]
};
---

<!DOCTYPE html>
<html lang="en">
	<head>
    <!-- Essential Meta Tags -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0b0b0d" />
    <meta name="color-scheme" content="dark" />
    
    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noIndex ? "noindex, nofollow" : "index, follow"} />
    <link rel="canonical" href={canonicalURL} />
    
    <!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Cursed Ink Society" />
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImage} />
    
    <!-- Icons and Manifest -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/brand/favicon-375.png" />
    <link rel="apple-touch-icon" href="/brand/favicon-375.png" />
    
    <!-- Preload Critical Resources -->
    <link rel="preload" href="/brand/cursed-ink-logo.png" as="image" type="image/png" />
    
    <!-- DNS Prefetch for External Resources -->
    <link rel="dns-prefetch" href="//formspree.io" />
		<link rel="dns-prefetch" href="//fonts.googleapis.com" />
    <link rel="dns-prefetch" href="//instagram.com" />
    
    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    
    <!-- Performance Hints -->
    <meta name="format-detection" content="telephone=no" />
    <meta name="msapplication-tap-highlight" content="no" />
  </head>
  
  <body>
    <!-- LED Tile Overlay - Shop Lighting System -->
    <LEDTileOverlay intensity="subtle" pattern="hex" />
    
    <!-- Skip Link for Accessibility -->
    <a href="#main-content" class="skip-link">Skip to main content</a>
    
    <!-- Navigation -->
    <nav class="main-nav" role="navigation" aria-label="Main navigation">
      <div class="container nav-container">
        <a href="/" class="nav-logo" aria-label="Cursed Ink Society Home">
          <img src="/brand/cursed-ink-logo.png" alt="Cursed Ink Society" width="60" height="60" />
        </a>
        
        <button class="nav-toggle" aria-expanded="false" aria-controls="nav-menu" aria-label="Toggle navigation">
          <span></span>
          <span></span>
          <span></span>
        </button>
        
        <div class="nav-menu" id="nav-menu">
          <ul class="nav-links">
            <li><a href="/" class="nav-link">Home</a></li>
            <li><a href="/artists" class="nav-link">Artists</a></li>
            <li><a href="/gallery" class="nav-link">Gallery</a></li>
            <li><a href="/services" class="nav-link">Services</a></li>
            <li><a href="/shop" class="nav-link">Shop</a></li>
            <li><a href="/about" class="nav-link">About</a></li>
            <li><a href="/contact" class="nav-link">Contact</a></li>
          </ul>
          <div class="nav-actions">
            <Cart />
            <div class="nav-cta">
              <a href="/contact" class="btn btn--primary">Start Your Journey</a>
            </div>
          </div>
        </div>
      </div>
    </nav>

    <main id="main-content">
      <slot />
    </main>

    <!-- Mystical Interactive Enhancements -->
    <MysticalEnhancements />

    <!-- Footer -->
    <footer class="main-footer">
      <div class="container">
        <div class="footer-content">
          <div class="footer-section footer-brand">
            <img src="/brand/cursed-ink-logo.png" alt="Cursed Ink Society" width="80" height="80" class="footer-logo" />
            <h3 class="footer-title">Cursed Ink Society</h3>
            <p class="footer-tagline">Where artistry meets the mystical</p>
          </div>
          
          <div class="footer-section">
            <h4>Quick Links</h4>
            <ul class="footer-links">
              <li><a href="/artists">Our Artists</a></li>
              <li><a href="/gallery">Gallery</a></li>
              <li><a href="/services">Services & Pricing</a></li>
              <li><a href="/contact">Get In Touch</a></li>
            </ul>
          </div>
          
          <div class="footer-section">
            <h4>Studio Info</h4>
            <ul class="footer-links">
              <li><a href="/about">About Us</a></li>
              <li><a href="/aftercare">Aftercare Guide</a></li>
              <li><a href="/faq">FAQ</a></li>
              <li><a href="/contact">Contact</a></li>
            </ul>
          </div>
          
          <div class="footer-section">
            <h4>Connect</h4>
            <div class="social-links">
              <a href="https://instagram.com/cursedinksociety" aria-label="Instagram" rel="noopener" target="_blank">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M7 2h10a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5V7a5 5 0 0 1 5-5zm5 5a5 5 0 1 0 .001 10.001A5 5 0 0 0 12 7zm0 2.2a2.8 2.8 0 1 1 0 5.6 2.8 2.8 0 0 1 0-5.6zM18 6.5a1 1 0 1 0 0 2 1 1 0 0 0 0-2z"/>
                </svg>
              </a>
              <a href="https://facebook.com/cursedinksociety" aria-label="Facebook" rel="noopener" target="_blank">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                </svg>
              </a>
              <a href="tel:+19855552873" aria-label="Phone">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M6.62 10.79a15.05 15.05 0 006.59 6.59l2.2-2.2a1 1 0 011.11-.21 11.36 11.36 0 003.57.57 1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1 11.36 11.36 0 00.57 3.57 1 1 0 01-.21 1.11z"/>
                </svg>
              </a>
            </div>
            <div class="contact-info">
              <p>123 Main Street<br />Houma, LA 70360</p>
              <p>(985) 555-CURSE</p>
              <p>Tue-Thu: 12PM-8PM<br />Fri-Sat: 12PM-10PM</p>
            </div>
          </div>
		</div>

        <div class="footer-bottom">
          <small>© {new Date().getFullYear()} Cursed Ink Society — forged in fire & pigment.</small>
          <div class="footer-legal">
            <a href="/privacy">Privacy Policy</a>
            <a href="/terms">Terms of Service</a>
          </div>
        </div>
      </div>
    </footer>

    <!-- Navigation JavaScript -->
		<script>
      // Enhanced navigation with accessibility
      class Navigation {
        constructor() {
          this.navToggle = document.querySelector('.nav-toggle');
          this.navMenu = document.querySelector('.nav-menu');
          this.navLinks = document.querySelectorAll('.nav-link');
          this.isOpen = false;
          
          this.init();
        }

        init() {
          if (!this.navToggle || !this.navMenu) return;
          
          this.navToggle.addEventListener('click', this.toggleMenu.bind(this));
          
          // Close menu when clicking nav links
          this.navLinks.forEach(link => {
            link.addEventListener('click', () => this.closeMenu());
          });
          
          // Close menu when clicking outside
          document.addEventListener('click', (e) => {
            if (!e.target.closest('.main-nav') && this.isOpen) {
              this.closeMenu();
            }
          });
          
          // Handle escape key
          document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && this.isOpen) {
              this.closeMenu();
            }
          });
          
          // Set active nav link
          this.setActiveLink();
        }

        toggleMenu() {
          this.isOpen ? this.closeMenu() : this.openMenu();
        }

        openMenu() {
          this.isOpen = true;
          this.navMenu.classList.add('nav-menu--open');
          this.navToggle.classList.add('nav-toggle--open');
          this.navToggle.setAttribute('aria-expanded', 'true');
          document.body.style.overflow = 'hidden';
        }

        closeMenu() {
          this.isOpen = false;
          this.navMenu.classList.remove('nav-menu--open');
          this.navToggle.classList.remove('nav-toggle--open');
          this.navToggle.setAttribute('aria-expanded', 'false');
          document.body.style.overflow = '';
        }

        setActiveLink() {
          const currentPath = window.location.pathname;
          this.navLinks.forEach(link => {
            const href = link.getAttribute('href');
            if (href === currentPath || (currentPath === '/' && href === '/')) {
              link.classList.add('nav-link--active');
            }
          });
        }
      }

      // Initialize navigation when DOM is ready
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', () => new Navigation());
      } else {
        new Navigation();
      }
		</script>

    <style>
      /* Navigation Styles */
      .main-nav {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 1000;
        background: rgba(11, 11, 13, 0.95);
        backdrop-filter: blur(10px);
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        transition: var(--transition-smooth);
      }

      .nav-container {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1rem 1.2rem;
        position: relative;
      }

      .nav-logo img {
        height: 50px;
        width: auto;
        filter: drop-shadow(0 0 15px rgba(220, 20, 60, 0.4));
        transition: var(--transition-smooth);
      }

      .nav-logo:hover img {
        filter: drop-shadow(0 0 25px rgba(220, 20, 60, 0.7));
        transform: scale(1.05);
      }

      .nav-toggle {
        display: none;
        flex-direction: column;
        background: none;
        border: none;
        cursor: pointer;
        padding: 0.5rem;
        position: relative;
        z-index: 1001;
      }

      .nav-toggle span {
        display: block;
        width: 25px;
        height: 2px;
        background: var(--ink);
        margin: 3px 0;
        transition: var(--transition-smooth);
        border-radius: 2px;
      }

      .nav-toggle--open span:nth-child(1) {
        transform: rotate(45deg) translate(6px, 6px);
      }

      .nav-toggle--open span:nth-child(2) {
        opacity: 0;
      }

      .nav-toggle--open span:nth-child(3) {
        transform: rotate(-45deg) translate(6px, -6px);
      }

      .nav-menu {
        display: flex;
        align-items: center;
        gap: 2rem;
      }

      .nav-links {
        display: flex;
        align-items: center;
        gap: 2rem;
        list-style: none;
        margin: 0;
        padding: 0;
      }

      .nav-link {
        color: var(--ink);
        text-decoration: none;
        font-weight: 500;
        font-size: 0.95rem;
        letter-spacing: 0.02em;
        transition: var(--transition-smooth);
        position: relative;
        padding: 0.5rem 0;
      }

      .nav-link::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 0;
        width: 0;
        height: 2px;
        background: var(--crimson-primary);
        transition: width 0.3s ease;
      }

      .nav-link:hover::after,
      .nav-link--active::after {
        width: 100%;
      }

      .nav-link:hover,
      .nav-link--active {
        color: var(--crimson-primary);
        text-shadow: var(--crimson-glow);
      }

      .nav-actions {
        display: flex;
        align-items: center;
        gap: 1rem;
      }

      .nav-cta .btn {
        font-size: 0.9rem;
        padding: 0.7rem 1.2rem;
      }

      /* Footer Styles - Architectural Foundation */
      .main-footer {
        background: 
          var(--marble-base),
          linear-gradient(180deg, var(--charcoal), var(--deep-charcoal));
        border-top: 2px solid rgba(255, 255, 255, 0.2);
        padding: 4rem 0 2rem;
        margin-top: 4rem;
        position: relative;
        box-shadow: 0 -20px 40px rgba(0, 0, 0, 0.5);
      }

      .footer-content {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 3rem;
        margin-bottom: 3rem;
      }

      .footer-brand {
        text-align: center;
      }

      .footer-logo {
        filter: drop-shadow(0 0 20px rgba(255, 255, 255, 0.4));
        margin-bottom: 1rem;
      }

      .footer-title {
        font-size: 1.5rem;
        margin: 0.5rem 0;
        color: var(--ink);
        text-shadow: var(--glow-subtle);
      }

      .footer-tagline {
        font-size: 1rem;
        opacity: 0.8;
        margin: 0;
      }

      .footer-section h4 {
        color: var(--crimson-primary);
        font-size: 1.1rem;
        margin-bottom: 1rem;
        text-shadow: var(--crimson-glow);
      }

      .footer-links {
        list-style: none;
        padding: 0;
        margin: 0;
      }

      .footer-links li {
        margin-bottom: 0.5rem;
      }

      .footer-links a {
        color: var(--ink);
        text-decoration: none;
        opacity: 0.8;
        transition: var(--transition-smooth);
      }

      .footer-links a:hover {
        opacity: 1;
        color: var(--crimson-primary);
        text-shadow: var(--crimson-glow);
      }

      .social-links {
        display: flex;
        gap: 1rem;
        margin-bottom: 1.5rem;
      }

      .social-links a {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 44px;
        height: 44px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: var(--ink);
        transition: var(--transition-smooth);
      }

      .social-links a:hover {
        background: rgba(220, 20, 60, 0.15);
        border-color: var(--crimson-primary);
        color: var(--crimson-primary);
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(220, 20, 60, 0.3);
      }

      .contact-info {
        font-size: 0.9rem;
        opacity: 0.8;
        line-height: 1.6;
      }

      .footer-bottom {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-top: 2rem;
        border-top: 1px solid rgba(255, 255, 255, 0.1);
        flex-wrap: wrap;
        gap: 1rem;
      }

      .footer-legal {
        display: flex;
        gap: 1.5rem;
      }

      .footer-legal a {
        color: var(--ink);
        text-decoration: none;
        opacity: 0.7;
        font-size: 0.85rem;
        transition: var(--transition-smooth);
      }

      .footer-legal a:hover {
        opacity: 1;
        color: var(--crimson-primary);
      }

      /* Mobile Navigation */
      @media (max-width: 768px) {
        .nav-toggle {
          display: flex;
        }

        .nav-menu {
          position: fixed;
          top: 0;
          left: 0;
          width: 100%;
          height: 100vh;
          background: rgba(11, 11, 13, 0.98);
          backdrop-filter: blur(20px);
          flex-direction: column;
          justify-content: center;
          align-items: center;
          gap: 2rem;
          transform: translateX(-100%);
          transition: transform 0.3s ease;
        }

        .nav-menu--open {
          transform: translateX(0);
        }

        .nav-links {
          flex-direction: column;
          gap: 2.5rem;
          margin-bottom: 3rem;
        }

        .nav-link {
          font-size: 1.2rem;
          text-align: center;
        }

        .footer-content {
          grid-template-columns: 1fr;
          gap: 2rem;
          text-align: center;
        }

        .footer-bottom {
          flex-direction: column;
          text-align: center;
        }

        .social-links {
          justify-content: center;
        }

        .nav-actions {
          flex-direction: column;
          gap: 1.5rem;
        }

        .nav-cta {
          width: 100%;
          text-align: center;
        }

        .nav-cta .btn {
          width: 100%;
          max-width: 280px;
        }
      }

      /* Add top padding to body to account for fixed nav */
      body {
        padding-top: 80px;
      }

      /* Skip link styles */
      .skip-link {
        position: absolute;
        top: -40px;
        left: 6px;
        background: var(--crimson-primary);
        color: white;
        padding: 8px;
        text-decoration: none;
        border-radius: 4px;
        z-index: 1000;
        font-weight: 600;
        transition: top 0.2s;
      }

      .skip-link:focus {
        top: 6px;
      }
    </style>
	</body>
</html>