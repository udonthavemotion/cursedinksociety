  /* Organic Specialties Flow */
  .specialties-organic {
    display: flex;
    flex-direction: column;
    gap: 0;
    position: relative;
  }

  .specialty-flow-item {
    display: flex;
    flex-direction: column;
    padding: 1.5rem 0;
    position: relative;
    transition: all 0.4s ease;
  }

  .specialty-flow-item:hover {
    transform: translateX(8px);
  }

  .specialty-flow-item:hover .specialty-emphasis {
    color: #ffffff;
  }

  .specialty-emphasis {
    font-family: 'Inter', sans-serif;
    font-size: 1.1rem;
    font-weight: 600;
    color: #c9a96e;
    margin-bottom: 0.25rem;
    letter-spacing: 0.02em;
    transition: color 0.3s ease;
    position: relative;
  }

  .specialty-detail {
    font-family: 'Inter', sans-serif;
    font-size: 0.9rem;
    font-weight: 400;
    color: rgba(255, 255, 255, 0.65);
    line-height: 1.4;
    letter-spacing: 0.01em;
    margin-left: 0.5rem;
    font-style: italic;
  }

  .specialty-connector {
    width: 2px;
    height: 1.5rem;
    background: linear-gradient(180deg, 
      rgba(201, 169, 110, 0.6) 0%, 
      rgba(201, 169, 110, 0.3) 50%,
      rgba(201, 169, 110, 0.6) 100%);
    margin-left: 0.5rem;
    position: relative;
  }

  .specialty-connector::before {
    content: '';
    position: absolute;
    left: -2px;
    top: 50%;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: rgba(201, 169, 110, 0.8);
    transform: translateY(-50%);
  }

  /* Focus variations for visual hierarchy */
  .primary-focus .specialty-emphasis {
    font-size: 1.2rem;
    font-weight: 700;
  }

  .secondary-focus .specialty-emphasis {
    font-size: 1.1rem;
    font-weight: 600;
  }

  .tertiary-focus .specialty-emphasis {
    font-size: 1rem;
    font-weight: 500;
  }

  /* Seth Social Media Links - Organic Style */
  .seth-social-links {
    display: flex;
    gap: 1.5rem;
    margin-top: 2.5rem;
    justify-content: flex-start;
    align-items: center;
