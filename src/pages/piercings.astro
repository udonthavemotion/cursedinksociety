---
import Layout from '../layouts/Layout.astro';
import AgeGateModal from '../components/AgeGateModal.astro';
import OptimizedImage from '../components/OptimizedImage.astro';

// Import piercing data
import piercingsData from '../content/piercings.json';

const pageTitle = "Piercings - Cursed Ink Society (18+)";
const pageDescription = "Professional body piercing services at Cursed Ink Society. Expert artists, premium jewelry, and safe practices. Age verification required - 18+ only.";

const { piercings, categories, artists } = piercingsData;
---

<Layout title={pageTitle} description={pageDescription} noIndex={true}>
  <!-- Age Gate Modal -->
  <AgeGateModal />

  <!-- Hero Section -->
  <section class="piercings-hero">
    <div class="container">
      <div class="hero-content">
        <div class="age-badge">18+ ONLY</div>
        <h1 class="hero-title">Professional Piercings</h1>
        <p class="hero-subtitle">Expert body modification with premium jewelry and safe practices</p>
        <div class="hero-stats">
          <div class="stat">
            <span class="stat-number">{piercings.length}</span>
            <span class="stat-label">Services</span>
          </div>
          <div class="stat">
            <span class="stat-number">{artists.length}</span>
            <span class="stat-label">Artists</span>
          </div>
          <div class="stat">
            <span class="stat-number">18+</span>
            <span class="stat-label">Age Required</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Categories Filter -->
  <section class="categories-section">
    <div class="container">
      <div class="categories-grid">
        <button class="category-btn active" data-category="all">
          All Piercings ({piercings.length})
        </button>
      </div>
    </div>
  </section>

  <!-- Piercings Gallery -->
  <section class="piercings-gallery">
    <div class="container">
      <div class="gallery-grid" id="piercings-grid">
        {piercings.map((piercing, index) => (
          <article class="piercing-card" data-category="general" data-index={index}>
            <div class="card-image-container">
              <!-- Optimized lazy loading with intersection observer -->
              <div class="image-placeholder" data-src={piercing.thumbnail.src}>
                <div class="skeleton-loader"></div>
                <img 
                  class="piercing-thumbnail blurred-content lazy-image"
                  data-src={piercing.thumbnail.src}
                  alt={piercing.thumbnail.alt}
                  width={piercing.thumbnail.width}
                  height={piercing.thumbnail.height}
                  loading="lazy"
                  decoding="async"
                  style="opacity: 0; transition: opacity 0.3s ease;"
                />
              </div>
              <div class="image-overlay">
                <button class="view-btn" onclick={`openModal('${piercing.id}')`} disabled>
                  <span class="view-icon">👁️</span>
                  View Details
                </button>
              </div>
              <div class="price-tag">{piercing.price}</div>
            </div>
            
            <div class="card-content">
              <h3 class="piercing-title">{piercing.title}</h3>
              <p class="piercing-description">{piercing.description}</p>
              
              <div class="piercing-meta">
                <div class="meta-item">
                  <span class="meta-label">Artist:</span>
                  <span class="meta-value">{piercing.artist}</span>
                </div>
                <div class="meta-item">
                  <span class="meta-label">Healing:</span>
                  <span class="meta-value">{piercing.details.healingTime}</span>
                </div>
                <div class="meta-item">
                  <span class="meta-label">Pain Level:</span>
                  <span class="meta-value pain-level">{piercing.details.painLevel}</span>
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Modal for detailed view -->
  <div id="piercing-modal" class="modal-overlay" onclick="closeModal()">
    <div class="modal-content" onclick="event.stopPropagation()">
      <button class="modal-close" onclick="closeModal()" aria-label="Close modal">×</button>
      <div id="modal-body">
        <!-- Dynamic content will be inserted here -->
      </div>
    </div>
  </div>

  <!-- Compliance Section -->
  <section class="compliance-section">
    <div class="container">
      <div class="compliance-content">
        <h2>Age Verification & Safety</h2>
        <p>All piercing services require valid ID and are restricted to clients 18 years and older. We maintain the highest standards of safety and hygiene.</p>
        <a href="/policies/age-verification" class="policy-link">View our Age Verification Policy</a>
      </div>
    </div>
  </section>
</Layout>

<script define:vars={{ piercings }}>
  // Age verification and modal functionality
  class PiercingsPage {
    constructor(piercingsData) {
      this.isAgeVerified = false;
      this.piercingsData = piercingsData;
      this.init();
    }

    init() {
      this.checkAgeVerification();
      this.setupCategoryFilters();
      this.setupModalFunctionality();
      this.setupProgressiveImageLoading();
      this.setupBatchImagePreloading();
    }

    checkAgeVerification() {
      // Check if age is verified via cookie or localStorage
      const cookies = document.cookie.split(';');
      const ageCookie = cookies.find(cookie => 
        cookie.trim().startsWith('cis_age_ok=')
      );
      
      const stored = localStorage.getItem('cis_age_ok');
      
      if ((ageCookie && ageCookie.includes('1')) || stored === '1') {
        this.isAgeVerified = true;
        this.enableContent();
      }

      // Listen for age verification events
      document.addEventListener('ageVerified', () => {
        this.isAgeVerified = true;
        this.enableContent();
      });
    }

    enableContent() {
      // Remove blur from content
      document.documentElement.setAttribute('data-age-ok', 'true');
      
      // Enable view buttons
      const viewButtons = document.querySelectorAll('.view-btn');
      viewButtons.forEach(btn => {
        btn.disabled = false;
      });

      // Enable thumbnail clicks
      const thumbnails = document.querySelectorAll('.piercing-thumbnail');
      thumbnails.forEach(thumb => {
        thumb.style.cursor = 'pointer';
      });
    }

    setupCategoryFilters() {
      // Simplified - all piercings are shown by default
      // This can be expanded later when categories are needed
      const categoryButtons = document.querySelectorAll('.category-btn');
      
      categoryButtons.forEach(button => {
        button.addEventListener('click', (e) => {
          // Keep button active state for UI consistency
          categoryButtons.forEach(btn => btn.classList.remove('active'));
          e.target.classList.add('active');
        });
      });
    }

    setupModalFunctionality() {
      // Modal functionality will be handled by global functions
      // due to Astro's scoping requirements
    }

    setupProgressiveImageLoading() {
      // Advanced intersection observer for progressive image loading
      const imageObserver = new IntersectionObserver((entries, observer) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const img = entry.target;
            const placeholder = img.closest('.image-placeholder');
            const skeleton = placeholder?.querySelector('.skeleton-loader');
            
            // Load the actual image
            const actualSrc = img.getAttribute('data-src');
            if (actualSrc && !img.src) {
              // Create a new image to preload
              const tempImg = new Image();
              tempImg.onload = () => {
                // Image loaded successfully
                img.src = actualSrc;
                img.style.opacity = '1';
                
                // Hide skeleton loader
                if (skeleton) {
                  skeleton.style.opacity = '0';
                  setTimeout(() => skeleton.remove(), 300);
                }
                
                // Add loaded class for additional styling
                img.classList.add('image-loaded');
                placeholder?.classList.add('loaded');
              };
              
              tempImg.onerror = () => {
                // Handle load error gracefully
                img.style.opacity = '1';
                img.classList.add('image-error');
                if (skeleton) {
                  skeleton.innerHTML = '<div class="error-icon">⚠️</div>';
                }
              };
              
              // Start loading
              tempImg.src = actualSrc;
            }
            
            // Stop observing this image
            observer.unobserve(img);
          }
        });
      }, {
        root: null,
        rootMargin: '50px', // Start loading 50px before entering viewport
        threshold: 0.1
      });

      // Observe all lazy images
      document.querySelectorAll('.lazy-image').forEach(img => {
        imageObserver.observe(img);
      });
    }

    setupBatchImagePreloading() {
      // Preload next batch of images when user scrolls
      let preloadedBatch = 0;
      const batchSize = 3;
      
      const preloadBatch = () => {
        const startIndex = preloadedBatch * batchSize;
        const endIndex = startIndex + batchSize;
        const images = document.querySelectorAll('.lazy-image');
        
        for (let i = startIndex; i < Math.min(endIndex, images.length); i++) {
          const img = images[i];
          const src = img.getAttribute('data-src');
          if (src && !img.src) {
            // Preload in background
            const preloadImg = new Image();
            preloadImg.src = src;
          }
        }
        preloadedBatch++;
      };

      // Throttled scroll handler for batch preloading
      let scrollTimeout;
      window.addEventListener('scroll', () => {
        if (scrollTimeout) clearTimeout(scrollTimeout);
        scrollTimeout = setTimeout(() => {
          const scrollPercent = (window.scrollY / (document.body.scrollHeight - window.innerHeight)) * 100;
          if (scrollPercent > 30 && preloadedBatch === 0) {
            preloadBatch(); // Preload second batch
          } else if (scrollPercent > 60 && preloadedBatch === 1) {
            preloadBatch(); // Preload third batch
          }
        }, 100);
      }, { passive: true });
    }
  }

  // Global modal functions (required for onclick handlers)
  function openModal(piercingId) {
    if (!document.documentElement.hasAttribute('data-age-ok')) {
      return; // Don't open if not age verified
    }

    const piercing = piercings.find((p) => p.id === piercingId);
    if (!piercing) return;

    const modal = document.getElementById('piercing-modal');
    const modalBody = document.getElementById('modal-body');
    
    if (!modal || !modalBody) return;

    modalBody.innerHTML = `
      <div class="modal-image">
        <div class="modal-image-loader">
          <div class="modal-skeleton"></div>
          <img 
            src="${piercing.image.src}" 
            alt="${piercing.image.alt}"
            width="${piercing.image.width}"
            height="${piercing.image.height}"
            loading="eager"
            decoding="async"
            onload="this.style.opacity='1'; this.previousElementSibling.style.opacity='0';"
            onerror="this.style.opacity='1'; this.previousElementSibling.innerHTML='⚠️ Image failed to load';"
            style="opacity: 0; transition: opacity 0.3s ease;"
          />
        </div>
      </div>
      <div class="modal-details">
        <h2>${piercing.title}</h2>
        <p class="modal-description">${piercing.description}</p>
        
        <div class="detail-grid">
          <div class="detail-item">
            <strong>Artist:</strong> ${piercing.artist}
          </div>
          <div class="detail-item">
            <strong>Category:</strong> ${piercing.category}
          </div>
          <div class="detail-item">
            <strong>Healing Time:</strong> ${piercing.details.healingTime}
          </div>
          <div class="detail-item">
            <strong>Pain Level:</strong> ${piercing.details.painLevel}
          </div>
          <div class="detail-item">
            <strong>Jewelry:</strong> ${piercing.details.jewelry}
          </div>
          <div class="detail-item">
            <strong>Price Range:</strong> ${piercing.price}
          </div>
        </div>
        
        <div class="aftercare-section">
          <h3>Aftercare Instructions</h3>
          <p>${piercing.details.aftercare}</p>
        </div>
        
        <div class="modal-actions">
          <a href="/contact" class="btn btn--primary">Book Consultation</a>
        </div>
      </div>
    `;

    modal.style.display = 'flex';
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    const modal = document.getElementById('piercing-modal');
    if (modal) {
      modal.style.display = 'none';
      document.body.style.overflow = '';
    }
  }

  // Handle escape key for modal
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeModal();
    }
  });

  // Make functions global
  window.openModal = openModal;
  window.closeModal = closeModal;

  // Initialize page
  new PiercingsPage(piercings);
</script>

<style>
  /* Age-gated blur effect */
  .blurred-content {
    filter: blur(20px);
    transition: filter 0.3s ease;
  }

  html[data-age-ok="true"] .blurred-content {
    filter: none;
  }

  /* Hero Section */
  .piercings-hero {
    padding: 6rem 0 4rem;
    background: 
      radial-gradient(ellipse at 30% 20%, rgba(220, 20, 60, 0.15) 0%, transparent 50%),
      radial-gradient(ellipse at 70% 80%, rgba(255, 60, 43, 0.1) 0%, transparent 50%),
      linear-gradient(135deg, #0b0b0d 0%, #1a1a1f 100%);
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .hero-content {
    position: relative;
    z-index: 2;
  }

  .age-badge {
    display: inline-block;
    background: linear-gradient(135deg, var(--accent0), var(--accent1));
    color: var(--ink);
    padding: 0.5rem 1rem;
    border-radius: 20px;
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 1rem;
    box-shadow: 0 4px 12px rgba(220, 20, 60, 0.3);
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .hero-title {
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 900;
    color: var(--ink);
    text-shadow: var(--glow-primary);
    margin-bottom: 1rem;
    line-height: 1.1;
  }

  .hero-subtitle {
    font-size: clamp(1.1rem, 2.5vw, 1.3rem);
    color: rgba(245, 245, 245, 0.8);
    margin-bottom: 2rem;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
    text-shadow: var(--glow-subtle);
  }

  .hero-stats {
    display: flex;
    justify-content: center;
    gap: 3rem;
    flex-wrap: wrap;
  }

  .stat {
    text-align: center;
  }

  .stat-number {
    display: block;
    font-size: 2.5rem;
    font-weight: 900;
    color: var(--accent0);
    text-shadow: var(--glow-primary);
    line-height: 1;
  }

  .stat-label {
    display: block;
    font-size: 0.9rem;
    color: rgba(245, 245, 245, 0.7);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-top: 0.5rem;
  }

  /* Categories Section */
  .categories-section {
    padding: 2rem 0;
    background: rgba(255, 255, 255, 0.02);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .categories-grid {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .category-btn {
    padding: 0.75rem 1.5rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 25px;
    color: var(--ink);
    font-weight: 500;
    cursor: pointer;
    transition: var(--transition-smooth);
    text-transform: uppercase;
    font-size: 0.85rem;
    letter-spacing: 0.05em;
  }

  .category-btn:hover,
  .category-btn.active {
    background: var(--accent0);
    border-color: var(--accent0);
    color: var(--ink);
    box-shadow: 0 4px 12px rgba(220, 20, 60, 0.3);
    transform: translateY(-1px);
  }

  /* Gallery Section */
  .piercings-gallery {
    padding: 4rem 0;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: 2rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .piercing-card {
    background: 
      radial-gradient(ellipse at 50% 20%, rgba(255, 60, 43, 0.05) 0%, transparent 60%),
      linear-gradient(135deg, rgba(255, 255, 255, 0.08) 0%, rgba(255, 255, 255, 0.02) 100%);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 20px;
    overflow: hidden;
    transition: var(--transition-smooth);
    backdrop-filter: blur(10px);
  }

  .piercing-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
    border-color: rgba(255, 255, 255, 0.2);
  }

  .card-image-container {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
  }

  .image-placeholder {
    position: relative;
    width: 100%;
    height: 100%;
    background: rgba(255, 255, 255, 0.02);
    border-radius: 15px;
    overflow: hidden;
  }

  .skeleton-loader {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgba(255, 255, 255, 0.05) 25%,
      rgba(255, 255, 255, 0.1) 50%,
      rgba(255, 255, 255, 0.05) 75%
    );
    background-size: 200% 100%;
    animation: skeleton-shimmer 1.5s infinite ease-in-out;
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(245, 245, 245, 0.3);
    font-size: 2rem;
    transition: opacity 0.3s ease;
  }

  @keyframes skeleton-shimmer {
    0% {
      background-position: -200% 0;
    }
    100% {
      background-position: 200% 0;
    }
  }

  .skeleton-loader::before {
    content: '🖼️';
    opacity: 0.3;
  }

  .error-icon {
    color: rgba(255, 193, 7, 0.7);
    font-size: 1.5rem;
  }

  .piercing-thumbnail {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.3s ease, transform 0.3s ease;
    will-change: opacity, transform;
  }

  .piercing-thumbnail.image-loaded {
    transform: scale(1);
  }

  .piercing-thumbnail.image-error {
    background: rgba(255, 255, 255, 0.05);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .piercing-thumbnail.image-error::after {
    content: '⚠️ Image unavailable';
    color: rgba(245, 245, 245, 0.5);
    font-size: 0.9rem;
    text-align: center;
  }

  .image-placeholder.loaded .skeleton-loader {
    opacity: 0;
    pointer-events: none;
  }

  .image-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: var(--transition-smooth);
  }

  .card-image-container:hover .image-overlay {
    opacity: 1;
  }

  .view-btn {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    background: var(--accent0);
    color: var(--ink);
    border: none;
    border-radius: 25px;
    font-weight: 600;
    cursor: pointer;
    transition: var(--transition-smooth);
    text-transform: uppercase;
    font-size: 0.85rem;
    letter-spacing: 0.05em;
  }

  .view-btn:disabled {
    background: rgba(128, 128, 128, 0.3);
    color: rgba(245, 245, 245, 0.5);
    cursor: not-allowed;
  }

  .view-btn:not(:disabled):hover {
    background: var(--accent1);
    transform: scale(1.05);
  }

  .view-icon {
    font-size: 1.1rem;
  }

  .price-tag {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: rgba(0, 0, 0, 0.8);
    color: var(--accent0);
    padding: 0.5rem 1rem;
    border-radius: 15px;
    font-weight: 700;
    font-size: 0.9rem;
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .card-content {
    padding: 1.5rem;
  }

  .piercing-title {
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--ink);
    margin-bottom: 0.75rem;
    text-shadow: var(--glow-subtle);
  }

  .piercing-description {
    color: rgba(245, 245, 245, 0.8);
    line-height: 1.6;
    margin-bottom: 1rem;
    font-size: 0.95rem;
  }

  .piercing-meta {
    display: grid;
    gap: 0.5rem;
  }

  .meta-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.9rem;
  }

  .meta-label {
    color: rgba(245, 245, 245, 0.7);
    font-weight: 500;
  }

  .meta-value {
    color: var(--ink);
    font-weight: 600;
  }

  .pain-level {
    color: var(--accent0);
    font-weight: 700;
  }

  /* Modal Styles */
  .modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.9);
    backdrop-filter: blur(10px);
    z-index: 10000;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }

  .modal-content {
    background: 
      radial-gradient(ellipse at 50% 20%, rgba(255, 60, 43, 0.1) 0%, transparent 60%),
      linear-gradient(135deg, #0f0f11 0%, #1a1a1f 100%);
    border: 2px solid rgba(255, 255, 255, 0.12);
    border-radius: 20px;
    max-width: 800px;
    width: 100%;
    max-height: 90vh;
    overflow-y: auto;
    position: relative;
  }

  .modal-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: rgba(0, 0, 0, 0.5);
    color: var(--ink);
    border: none;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    font-size: 1.5rem;
    cursor: pointer;
    z-index: 10001;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: var(--transition-smooth);
  }

  .modal-close:hover {
    background: var(--accent0);
  }

  #modal-body {
    padding: 2rem;
  }

  .modal-image-loader {
    position: relative;
    width: 100%;
    margin-bottom: 1.5rem;
  }

  .modal-skeleton {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgba(255, 255, 255, 0.05) 25%,
      rgba(255, 255, 255, 0.1) 50%,
      rgba(255, 255, 255, 0.05) 75%
    );
    background-size: 200% 100%;
    animation: skeleton-shimmer 1.5s infinite ease-in-out;
    border-radius: 15px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(245, 245, 245, 0.3);
    font-size: 3rem;
    min-height: 400px;
    transition: opacity 0.3s ease;
  }

  .modal-skeleton::before {
    content: '🖼️';
    opacity: 0.3;
  }

  .modal-image img {
    width: 100%;
    height: auto;
    border-radius: 15px;
    display: block;
    max-height: 70vh;
    object-fit: contain;
  }

  .modal-details h2 {
    font-size: 2rem;
    color: var(--ink);
    text-shadow: var(--glow-subtle);
    margin-bottom: 1rem;
  }

  .modal-description {
    color: rgba(245, 245, 245, 0.8);
    line-height: 1.6;
    margin-bottom: 1.5rem;
    font-size: 1.1rem;
  }

  .detail-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1rem;
    margin-bottom: 1.5rem;
