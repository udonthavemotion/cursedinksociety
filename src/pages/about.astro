    display: grid;
    grid-template-columns: 1fr 1.2fr; /* Give content side slightly more space */
    gap: 4rem;
    align-items: center;
    margin-bottom: 8rem;
    min-height: 70vh; /* Increase min height for vertical videos */
    opacity: 0;
    transform: translateY(50px);
    transition: all 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    will-change: transform, opacity;
  }

  .gallery-item.video-right {
    grid-template-columns: 1.2fr 1fr; /* Reverse for right-aligned videos */
  }

  .gallery-item.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .gallery-item:last-child {
    margin-bottom: 0;
  }

  /* Parallax Animation System */
  .gallery-item.video-left .video-side {
    order: 1;
    transform: translateX(-100px);
    transition: transform 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .gallery-item.video-left .content-side {
    order: 2;
    transform: translateX(100px);
    transition: transform 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .gallery-item.video-right .video-side {
    order: 2;
    transform: translateX(100px);
    transition: transform 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .gallery-item.video-right .content-side {
    order: 1;
    transform: translateX(-100px);
    transition: transform 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .gallery-item.visible .video-side,
  .gallery-item.visible .content-side {
    transform: translateX(0);
  }

