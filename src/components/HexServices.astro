---
import servicesData from '../data/services.json';
const { services } = servicesData;
---

<section class="hex-services">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title shine">Sacred Artistry</h2>
      <p class="section-subtitle">Each service crafted with mystical precision and artistic mastery</p>
    </div>
    
    <div class="hex-grid">
      {services.slice(0, 6).map((service, index) => (
        <div class="hex-card" data-popular={service.popular}>
          <div class="hex-card-inner">
            <div class="hex-card-glow"></div>
            <div class="hex-card-content">
              <div class="service-header">
                <h3 class="service-title">{service.title}</h3>
                {service.popular && <span class="popular-badge">Most Sought</span>}
              </div>
              
              <p class="service-description">{service.description}</p>
              
              <div class="service-features">
                {service.features.slice(0, 3).map(feature => (
                  <div class="feature-item">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                    </svg>
                    <span>{feature}</span>
                  </div>
                ))}
              </div>
              
              <div class="service-pricing">
                {service.pricing.hourly && (
                  <div class="price-main">{service.pricing.hourly}/hr</div>
                )}
                {service.pricing.starting && (
                  <div class="price-main">From {service.pricing.starting}</div>
                )}
                {service.pricing.minimum && (
                  <div class="price-note">{service.pricing.minimum} minimum</div>
                )}
              </div>
              
              <div class="service-artists">
                {service.artists && (
                  <div class="artists-list">
                    <span class="artists-label">Artists:</span>
                    <span class="artists-names">{service.artists.join(", ")}</span>
                  </div>
                )}
              </div>
              
              <div class="hex-card-action">
                <a href="/artists" class="btn btn--hex">
                  Meet Artists
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M5 12h14m-7-7l7 7-7 7"/>
                  </svg>
                </a>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
    
    <div class="services-cta">
      <a href="/services" class="btn btn--electric">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
        </svg>
        Explore All Sacred Services
      </a>
    </div>
  </div>
</section>

<style>
  .hex-services {
    padding: 6rem 0;
    position: relative;
    overflow: hidden;
  }

  .section-header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .section-title {
    font-size: clamp(2.5rem, 5vw, 4rem);
    margin-bottom: 1rem;
  }

  .section-subtitle {
    font-size: 1.2rem;
    opacity: 0.8;
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.6;
    text-shadow: var(--glow-warm);
  }

  /* Hexagonal Grid Layout */
  .hex-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: 2rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  /* Architectural Card Design - Modern Professional */
  .hex-card {
    position: relative;
    background: 
      var(--marble-base),
      var(--glass-light);
    border: var(--glass-border);
    border-radius: 24px;
    padding: 2.5rem;
    transition: var(--transition-material);
    cursor: pointer;
    overflow: hidden;
    backdrop-filter: blur(20px);
    box-shadow: var(--shadow-soft);
  }

  .hex-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: 
      conic-gradient(from 0deg at 50% 50%, 
        transparent 0deg, 
        rgba(255, 255, 255, 0.06) 60deg, 
        transparent 120deg, 
        rgba(255, 255, 255, 0.03) 180deg, 
        transparent 240deg, 
        rgba(255, 255, 255, 0.06) 300deg, 
        transparent 360deg);
    border-radius: 24px;
    opacity: 0;
    transition: opacity 0.4s ease;
    z-index: 1;
  }

  .hex-card:hover::before {
    opacity: 1;
  }

  .hex-card-inner {
    position: relative;
    z-index: 2;
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .hex-card-glow {
    position: absolute;
    top: -2px;
    left: -2px;
    right: -2px;
    bottom: -2px;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.2), rgba(255, 255, 255, 0.1));
    border-radius: 26px;
    opacity: 0;
    transition: opacity 0.3s ease;
    z-index: -1;
    filter: blur(12px);
  }

  .hex-card:hover {
    transform: translateY(-10px);
    border-color: var(--glass-border-bright);
    box-shadow: var(--rim-glow), var(--shadow-dramatic);
    background: 
      var(--marble-base),
      var(--glass-medium);
  }

  .hex-card:hover .hex-card-glow {
    opacity: 0.8;
  }

  .hex-card[data-popular="true"] {
    border-color: var(--glass-border-bright);
    background: 
      var(--marble-base),
      linear-gradient(135deg, var(--glass-medium), var(--glass-light));
    box-shadow: var(--soft-glow), var(--shadow-soft);
  }

  .hex-card[data-popular="true"] .hex-card-glow {
    opacity: 0.4;
  }

  /* Card Content */
  .hex-card-content {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .service-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .service-title {
    font-size: 1.4rem;
    font-weight: 600;
    margin: 0;
    text-shadow: var(--glow-inferno-subtle);
  }

  .popular-badge {
    background: var(--inferno-gradient);
    color: #000;
    padding: 0.3rem 0.8rem;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    box-shadow: var(--glow-inferno-subtle);
  }

  .service-description {
    font-size: 0.95rem;
    line-height: 1.5;
    opacity: 0.9;
    margin-bottom: 1.5rem;
    flex-grow: 1;
  }

  .service-features {
    margin-bottom: 1.5rem;
  }

  .feature-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
    font-size: 0.9rem;
    color: rgba(234, 234, 234, 0.8);
  }

  .feature-item svg {
    color: var(--inferno-start);
    filter: drop-shadow(0 0 4px rgba(255, 51, 0, 0.4));
  }

  .service-pricing {
    margin-bottom: 1rem;
    padding: 1rem;
    background: rgba(255, 51, 0, 0.05);
    border-radius: 10px;
    border: 1px solid rgba(255, 51, 0, 0.2);
  }

  .price-main {
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--inferno-start);
    text-shadow: var(--glow-inferno-subtle);
  }

  .price-note {
    font-size: 0.85rem;
    opacity: 0.7;
    margin-top: 0.3rem;
  }

  .service-artists {
    margin-bottom: 1.5rem;
    font-size: 0.9rem;
  }

  .artists-label {
    color: var(--electric-blue);
    font-weight: 600;
  }

  .artists-names {
    opacity: 0.8;
  }

  /* Hex Button */
  .btn--hex {
    background: rgba(255, 51, 0, 0.1);
    border: 2px solid rgba(255, 51, 0, 0.3);
    color: var(--inferno-start);
    font-weight: 600;
    text-shadow: var(--glow-inferno-subtle);
    justify-self: flex-end;
    margin-top: auto;
  }

  .btn--hex:hover {
    background: rgba(255, 51, 0, 0.2);
    border-color: var(--inferno-start);
    box-shadow: var(--glow-inferno-subtle);
    transform: translateY(-2px);
  }

  /* Services CTA */
  .services-cta {
    text-align: center;
    margin-top: 4rem;
  }

  /* Responsive Design */
  @media (max-width: 768px) {
    .hex-services {
      padding: 4rem 0;
    }

    .hex-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .hex-card {
      padding: 1.5rem;
    }

    .section-header {
      margin-bottom: 3rem;
    }

    .service-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.8rem;
    }
  }

  /* Reduced Motion */
  @media (prefers-reduced-motion: reduce) {
    .hex-card {
      transition: none;
    }
    
    .hex-card:hover {
      transform: none;
    }
    
    .hex-card-glow {
      transition: none;
    }
  }
</style>
