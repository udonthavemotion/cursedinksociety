---
// Optimized Artist gallery with progressive loading
import { slugify } from '../lib/slugify';
import cisData from '../data/cis.json';

const galleryItems = cisData.artists.map((artist, index) => ({
  id: index + 1,
  image: artist.avatar,
  title: artist.name,
  artist: artist.name,
  slug: artist.slug,
  positioning: artist.positioning,
  specialties: artist.specialties,
  category: artist.specialties[0] || "Traditional"
}));
---

<section class="blob-gallery">
  <div class="container">
    <div class="gallery-header">
      <h2 class="gallery-title shine">Meet Our Master Artists</h2>
      <p class="gallery-subtitle">Discover the talented artists behind our extraordinary work</p>
      
      <!-- Artist Counter with Animation -->
      <div class="artist-counter">
        <div class="counter-content">
          <span class="counter-number" data-count="6">0</span>
          <span class="counter-label">Master Artists</span>
        </div>
        <div class="counter-glow"></div>
      </div>
    </div>
    
    <div class="blob-grid">
      {galleryItems.map((item, index) => (
        <div 
          class="blob-item" 
          data-category={item.category.toLowerCase()}
          data-artist={item.slug}
          style={`--delay: ${index * 0.1}s`}
        >
          <div class="blob-shape">
            <div class="blob-inner">
              <img 
                src={item.image} 
                alt={`${item.title} - Tattoo Artist`}
                loading="lazy"
                decoding="async"
              />
              <div class="blob-overlay">
                <div class="spotlight-reveal">
                  <div class="item-info">
                    <h3 class="item-title">{item.title}</h3>
                    <p class="item-artist">{item.positioning.split(' - ')[0]}</p>
                    <div class="item-specialties">
                      {item.specialties.slice(0, 2).map(specialty => (
                        <span class="specialty-tag">{specialty}</span>
                      ))}
                    </div>
                  </div>
                  <div class="item-actions">
                    <a href={`/artists/${slugify(item.slug ?? item.title)}`} class="btn btn--ghost">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/>
                      </svg>
                      View Portfolio
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
    
    <div class="gallery-cta">
      <a href="/artists" class="btn btn--primary">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
          <path d="M16 4c0-1.11.89-2 2-2s2 .89 2 2-.89 2-2 2-2-.89-2-2zm4 18v-6h2.5l-2.54-7.63A1.5 1.5 0 0 0 18.5 7.5h-1c-.83 0-1.5.67-1.5 1.5s.67 1.5 1.5 1.5H18l1.8 5.4H16V21h4zM12.5 11.5c.83 0 1.5-.67 1.5-1.5s-.67-1.5-1.5-1.5S11 9.17 11 10s.67 1.5 1.5 1.5zM5.5 6c1.11 0 2-.89 2-2s-.89-2-2-2-2 .89-2 2 .89 2 2 2zm2 16v-7H9V9.5C9 8.67 8.33 8 7.5 8S6 8.67 6 9.5V15H4v7h3.5z"/>
        </svg>
        Meet All Our Artists
      </a>
    </div>
  </div>
</section>

<style>
  .blob-gallery {
    padding: 6rem 0;
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(ellipse at 20% 30%, rgba(255, 60, 43, 0.15) 0%, transparent 50%),
      radial-gradient(ellipse at 80% 70%, rgba(255, 122, 24, 0.1) 0%, transparent 50%),
      linear-gradient(135deg, #0b0b0d 0%, #1a1a1f 50%, #0b0b0d 100%);
  }

  .gallery-header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .gallery-title {
    font-size: clamp(2.5rem, 5vw, 4rem);
    margin-bottom: 1rem;
    position: relative;
  }

  .gallery-title::before {
    content: '';
    position: absolute;
    top: -20px;
    left: 50%;
    transform: translateX(-50%);
    width: 100px;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--accent0), transparent);
    opacity: 0.7;
  }

  .gallery-title::after {
    content: '✦';
    position: absolute;
    top: -30px;
    left: 50%;
    transform: translateX(-50%);
    color: var(--accent0);
    font-size: 1rem;
    animation: titleSparkle 3s ease-in-out infinite;
  }

  @keyframes titleSparkle {
    0%, 100% { opacity: 0.7; transform: translateX(-50%) scale(1); }
    50% { opacity: 1; transform: translateX(-50%) scale(1.2); }
  }

  .gallery-subtitle {
    font-size: 1.2rem;
    opacity: 0.8;
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.6;
    text-shadow: var(--glow-warm);
  }

  /* Simplified Grid for Performance */
  .blob-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  /* Blob Item Container - Simplified Initial State */
  .blob-item {
    position: relative;
    aspect-ratio: 1;
    opacity: 0;
    animation: blobFadeIn 0.6s ease-out forwards;
    animation-delay: var(--delay);
    cursor: pointer;
    transition: transform 0.2s ease;
  }

  .blob-item:hover {
    z-index: 10;
    transform: scale(1.02);
  }

  @keyframes blobFadeIn {
    from {
      opacity: 0;
      transform: translateY(20px) scale(0.95);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  /* Simplified Blob Shape - Initially Static */
  .blob-shape {
    width: 100%;
    height: 100%;
    border-radius: 45% 55% 35% 65% / 55% 35% 65% 45%;
    overflow: hidden;
    position: relative;
    transition: all 0.3s ease;
    background: 
      linear-gradient(135deg, rgba(255, 255, 255, 0.9) 0%, rgba(255, 255, 255, 0.7) 100%),
      rgba(255, 255, 255, 0.1);
    border: 3px solid rgba(255, 255, 255, 0.4);
    box-shadow: 
      0 8px 32px rgba(0, 0, 0, 0.1),
      inset 0 1px 0 rgba(255, 255, 255, 0.6);
    backdrop-filter: blur(10px);
    /* Ensure consistent shape */
    will-change: transform;
    transform: translateZ(0);
  }

  /* Progressive enhancement for morphing */
  .morphing-enabled .blob-shape {
    animation: blobMorph 8s ease-in-out infinite;
  }

  @keyframes blobMorph {
    0%, 100% {
      border-radius: 45% 55% 35% 65% / 55% 35% 65% 45%;
    }
    25% {
      border-radius: 35% 65% 55% 45% / 50% 60% 30% 60%;
    }
    50% {
      border-radius: 50% 50% 40% 60% / 60% 30% 60% 40%;
    }
    75% {
      border-radius: 60% 40% 50% 50% / 40% 60% 40% 60%;
    }
  }

  .blob-item:hover .blob-shape {
    border-color: rgba(255, 255, 255, 0.8);
    box-shadow: 
      0 0 40px rgba(255, 255, 255, 0.6),
      0 0 80px rgba(255, 255, 255, 0.4),
      0 12px 48px rgba(0, 0, 0, 0.2),
      inset 0 1px 0 rgba(255, 255, 255, 0.8);
    transform: translateZ(0) scale(1.03);
    background: 
      linear-gradient(135deg, rgba(255, 255, 255, 1) 0%, rgba(255, 255, 255, 0.9) 100%),
      rgba(255, 255, 255, 0.2);
  }

  /* Inner Content */
  .blob-inner {
    width: 100%;
    height: 100%;
    position: relative;
    overflow: hidden;
  }

  .blob-inner img {
    width: 120%;
    height: 120%;
    object-fit: cover;
    position: absolute;
    top: -10%;
    left: -10%;
    transition: transform 0.3s ease;
    transform-origin: center;
    border-radius: inherit;
    mask: radial-gradient(ellipse 50% 60% at 50% 50%, black 70%, transparent 100%);
    will-change: transform;
    transform: translateZ(0);
  }

  .blob-item:hover .blob-inner img {
    transform: translateZ(0) scale(1.05);
  }

  /* Spotlight Overlay */
  .blob-overlay {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, transparent 30%, rgba(0, 0, 0, 0.8) 70%);
    opacity: 0;
    transition: opacity 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: inherit;
    overflow: hidden;
  }

  .blob-item:hover .blob-overlay {
    opacity: 1;
  }

  /* Spotlight Reveal Effect */
  .spotlight-reveal {
    text-align: center;
    transform: translateY(20px);
    transition: transform 0.3s ease;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    width: 100%;
  }

  .blob-item:hover .spotlight-reveal {
    transform: translateY(0);
  }

  .item-info {
    margin-bottom: 1.5rem;
    text-align: center;
    width: 100%;
  }

  .item-title {
    font-size: clamp(1.1rem, 4vw, 1.4rem);
    font-weight: 700;
    margin-bottom: 0.5rem;
    text-shadow: 
      2px 2px 4px rgba(0, 0, 0, 0.8),
      0 0 10px rgba(255, 255, 255, 0.3);
    color: #ffffff;
    line-height: 1.2;
    letter-spacing: 0.02em;
  }

  .item-artist {
    font-size: clamp(0.9rem, 3.5vw, 1.1rem);
    opacity: 1;
    margin-bottom: 1rem;
    color: var(--accent0);
    font-weight: 600;
    text-shadow: 
      1px 1px 3px rgba(0, 0, 0, 0.9),
      0 0 8px rgba(255, 60, 43, 0.4);
    line-height: 1.3;
  }

  .item-specialties {
    display: flex;
    gap: 0.4rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 1rem;
    width: 100%;
  }

  .specialty-tag {
    display: inline-block;
    background: rgba(0, 0, 0, 0.7);
    color: var(--accent0);
    padding: 0.3rem 0.8rem;
    border-radius: 15px;
    font-size: clamp(0.65rem, 2.5vw, 0.8rem);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border: 1px solid rgba(255, 60, 43, 0.5);
    transition: all 0.3s ease;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8);
    backdrop-filter: blur(5px);
  }

  /* Action Buttons */
  .item-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    width: 100%;
  }

  .btn--ghost {
    background: rgba(0, 0, 0, 0.8);
    border: 2px solid rgba(255, 255, 255, 0.4);
    color: #ffffff;
    padding: 0.8rem 1.2rem;
    font-size: clamp(0.85rem, 3vw, 1rem);
    font-weight: 600;
    backdrop-filter: blur(15px);
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8);
    border-radius: 25px;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    position: relative;
    z-index: 10;
    pointer-events: auto;
    text-decoration: none;
  }

  .btn--ghost:hover {
    background: rgba(255, 60, 43, 0.3);
    border-color: var(--accent0);
    color: #ffffff;
    box-shadow: 
      0 0 20px rgba(255, 60, 43, 0.4),
      0 4px 15px rgba(0, 0, 0, 0.3);
    transform: translateY(-2px);
  }

  /* Gallery CTA */
  .gallery-cta {
    text-align: center;
    margin-top: 4rem;
  }

  /* Artist Counter Styles */
  .artist-counter {
    display: flex;
    justify-content: center;
    margin: 2rem 0 0;
    position: relative;
  }

  .counter-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    background: rgba(0, 0, 0, 0.3);
    border: 2px solid rgba(255, 60, 43, 0.3);
    border-radius: 20px;
    padding: 1.5rem 2.5rem;
    backdrop-filter: blur(15px);
    position: relative;
    overflow: hidden;
  }

  .counter-number {
    font-size: 3rem;
    font-weight: 900;
    color: var(--accent0);
    text-shadow: 
      0 0 20px rgba(255, 60, 43, 0.8),
      0 0 40px rgba(255, 60, 43, 0.4);
    line-height: 1;
    margin-bottom: 0.5rem;
  }

  .counter-label {
    font-size: 0.9rem;
    color: rgba(245, 245, 245, 0.8);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 600;
  }

  .counter-glow {
    position: absolute;
    top: -2px;
    left: -2px;
    right: -2px;
    bottom: -2px;
    background: linear-gradient(45deg, var(--accent0), var(--accent1), var(--accent0));
    border-radius: 20px;
    opacity: 0;
    transition: opacity 0.3s ease;
    z-index: -1;
  }

  /* Progressive enhancement for counter rotation */
  .enhanced-loaded .counter-glow {
    animation: counterRotate 4s linear infinite;
  }

  .counter-content:hover .counter-glow {
    opacity: 0.3;
  }

  @keyframes counterRotate {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  /* Artist-Specific Colors - Only on Enhanced Load */
  .enhanced-loaded .blob-item[data-artist="seth-wood"]:hover .specialty-tag {
    background: rgba(138, 43, 226, 0.3);
    border-color: rgba(138, 43, 226, 0.5);
    color: rgba(138, 43, 226, 1);
    text-shadow: 0 0 8px rgba(138, 43, 226, 0.6);
  }

  .enhanced-loaded .blob-item[data-artist="ashley-wood"]:hover .specialty-tag {
    background: rgba(255, 105, 180, 0.3);
    border-color: rgba(255, 105, 180, 0.5);
    color: rgba(255, 105, 180, 1);
    text-shadow: 0 0 8px rgba(255, 105, 180, 0.6);
  }

  .enhanced-loaded .blob-item[data-artist="trent"]:hover .specialty-tag {
    background: rgba(30, 144, 255, 0.3);
    border-color: rgba(30, 144, 255, 0.5);
    color: rgba(30, 144, 255, 1);
    text-shadow: 0 0 8px rgba(30, 144, 255, 0.6);
  }

  .enhanced-loaded .blob-item[data-artist="cody-crochet"]:hover .specialty-tag {
    background: rgba(50, 205, 50, 0.3);
    border-color: rgba(50, 205, 50, 0.5);
    color: rgba(50, 205, 50, 1);
    text-shadow: 0 0 8px rgba(50, 205, 50, 0.6);
  }

  .enhanced-loaded .blob-item[data-artist="luis-reymundo"]:hover .specialty-tag {
    background: rgba(255, 140, 0, 0.3);
    border-color: rgba(255, 140, 0, 0.5);
    color: rgba(255, 140, 0, 1);
    text-shadow: 0 0 8px rgba(255, 140, 0, 0.6);
  }

  .enhanced-loaded .blob-item[data-artist="anthony-boudreaux"]:hover .specialty-tag {
    background: rgba(255, 60, 43, 0.3);
    border-color: rgba(255, 60, 43, 0.5);
    color: rgba(255, 60, 43, 1);
    text-shadow: 0 0 8px rgba(255, 60, 43, 0.6);
  }

  /* Artist-Specific Glow Effects - Only on Enhanced Load */
  .enhanced-loaded .blob-item[data-artist="seth-wood"]:hover .blob-shape {
    border-color: rgba(138, 43, 226, 0.8);
    box-shadow: 
      0 0 40px rgba(138, 43, 226, 0.6),
      0 0 80px rgba(138, 43, 226, 0.4),
      0 12px 48px rgba(0, 0, 0, 0.2),
      inset 0 1px 0 rgba(255, 255, 255, 0.8);
  }

  .enhanced-loaded .blob-item[data-artist="ashley-wood"]:hover .blob-shape {
    border-color: rgba(255, 105, 180, 0.8);
    box-shadow: 
      0 0 40px rgba(255, 105, 180, 0.6),
      0 0 80px rgba(255, 105, 180, 0.4),
      0 12px 48px rgba(0, 0, 0, 0.2),
      inset 0 1px 0 rgba(255, 255, 255, 0.8);
  }

  .enhanced-loaded .blob-item[data-artist="trent"]:hover .blob-shape {
    border-color: rgba(30, 144, 255, 0.8);
    box-shadow: 
      0 0 40px rgba(30, 144, 255, 0.6),
      0 0 80px rgba(30, 144, 255, 0.4),
      0 12px 48px rgba(0, 0, 0, 0.2),
      inset 0 1px 0 rgba(255, 255, 255, 0.8);
  }

  .enhanced-loaded .blob-item[data-artist="cody-crochet"]:hover .blob-shape {
    border-color: rgba(50, 205, 50, 0.8);
    box-shadow: 
      0 0 40px rgba(50, 205, 50, 0.6),
      0 0 80px rgba(50, 205, 50, 0.4),
      0 12px 48px rgba(0, 0, 0, 0.2),
      inset 0 1px 0 rgba(255, 255, 255, 0.8);
  }

  .enhanced-loaded .blob-item[data-artist="luis-reymundo"]:hover .blob-shape {
    border-color: rgba(255, 140, 0, 0.8);
    box-shadow: 
      0 0 40px rgba(255, 140, 0, 0.6),
      0 0 80px rgba(255, 140, 0, 0.4),
      0 12px 48px rgba(0, 0, 0, 0.2),
      inset 0 1px 0 rgba(255, 255, 255, 0.8);
  }

  .enhanced-loaded .blob-item[data-artist="anthony-boudreaux"]:hover .blob-shape {
    border-color: rgba(255, 60, 43, 0.8);
    box-shadow: 
      0 0 40px rgba(255, 60, 43, 0.6),
      0 0 80px rgba(255, 60, 43, 0.4),
      0 12px 48px rgba(0, 0, 0, 0.2),
      inset 0 1px 0 rgba(255, 255, 255, 0.8);
  }

  /* Responsive Design */
  @media (max-width: 768px) {
    .blob-gallery {
      padding: 3rem 0;
    }

    .blob-grid {
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 1rem;
      padding: 0 1rem;
    }

    .gallery-header {
      margin-bottom: 2.5rem;
    }

    .spotlight-reveal {
      padding: 1rem;
    }

    .item-title {
      font-size: clamp(1.2rem, 5vw, 1.5rem);
      font-weight: 800;
      text-shadow: 
        2px 2px 6px rgba(0, 0, 0, 0.9),
        0 0 15px rgba(255, 255, 255, 0.4);
      margin-bottom: 0.4rem;
    }

    .item-artist {
      font-size: clamp(1rem, 4vw, 1.2rem);
      font-weight: 700;
      text-shadow: 
        2px 2px 4px rgba(0, 0, 0, 0.9),
        0 0 12px rgba(255, 60, 43, 0.5);
      margin-bottom: 0.8rem;
    }

    .specialty-tag {
      font-size: clamp(0.7rem, 3vw, 0.85rem);
      padding: 0.4rem 0.9rem;
      font-weight: 700;
      text-shadow: 2px 2px 3px rgba(0, 0, 0, 0.9);
      background: rgba(0, 0, 0, 0.8);
      border: 2px solid rgba(255, 60, 43, 0.6);
    }

    .item-actions {
      flex-direction: column;
      gap: 0.8rem;
      margin-top: 1rem;
      align-items: center;
      justify-content: center;
      width: 100%;
    }

    .btn--ghost {
      width: auto;
      min-width: 160px;
      max-width: 200px;
      padding: 1rem 1.5rem;
      font-size: clamp(0.9rem, 3.5vw, 1.1rem);
      font-weight: 700;
      text-shadow: 2px 2px 3px rgba(0, 0, 0, 0.8);
      background: rgba(0, 0, 0, 0.9);
      border: 2px solid rgba(255, 255, 255, 0.6);
      margin: 0 auto;
      text-align: center;
      justify-content: center;
    }

    .blob-overlay {
      background: radial-gradient(circle at center, transparent 20%, rgba(0, 0, 0, 0.85) 60%);
    }

    /* Touch states for mobile */
    .blob-item:active .blob-overlay {
      opacity: 1;
      background: radial-gradient(circle at center, transparent 15%, rgba(0, 0, 0, 0.9) 55%);
    }

    .blob-item:active .spotlight-reveal {
      transform: translateY(0);
    }

    .blob-item:active .blob-shape {
      transform: translateZ(0) scale(1.02);
    }

    /* Touch-active state */
    .blob-item.touch-active .blob-overlay {
      opacity: 1;
      background: radial-gradient(circle at center, transparent 15%, rgba(0, 0, 0, 0.9) 55%);
    }

    .blob-item.touch-active .spotlight-reveal {
      transform: translateY(0);
    }

    .blob-item.touch-active .blob-shape {
      transform: translateZ(0) scale(1.02);
    }

    .btn--ghost:active {
      transform: scale(0.98);
      background: rgba(255, 60, 43, 0.4);
      border-color: var(--accent0);
    }
  }

  /* Extra Small Mobile Devices - More Compact */
  @media (max-width: 480px) {
    .blob-gallery {
      padding: 2.5rem 0;
    }

    .blob-grid {
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 0.8rem;
      padding: 0 0.8rem;
    }

    .gallery-header {
      margin-bottom: 2rem;
    }

    .gallery-title {
      font-size: clamp(2rem, 6vw, 3rem);
      margin-bottom: 0.8rem;
    }

    .gallery-subtitle {
      font-size: 1rem;
      padding: 0 1rem;
    }

    .artist-counter {
      margin: 1.5rem 0 0;
    }

    .counter-content {
      padding: 1rem 2rem;
    }

    .counter-number {
      font-size: 2.5rem;
    }

    .counter-label {
      font-size: 0.8rem;
    }

    .spotlight-reveal {
      padding: 0.8rem;
    }

    .item-info {
      margin-bottom: 1rem;
    }

    .item-title {
      font-size: clamp(1rem, 4.5vw, 1.3rem);
      margin-bottom: 0.3rem;
    }

    .item-artist {
      font-size: clamp(0.9rem, 3.8vw, 1.1rem);
      margin-bottom: 0.6rem;
    }

    .specialty-tag {
      font-size: clamp(0.65rem, 2.8vw, 0.8rem);
      padding: 0.3rem 0.7rem;
    }

    .item-actions {
      gap: 0.6rem;
      margin-top: 0.8rem;
    }

    .btn--ghost {
      min-width: 140px;
      max-width: 180px;
      padding: 0.8rem 1.2rem;
      font-size: clamp(0.85rem, 3.2vw, 1rem);
    }

    .gallery-cta {
      margin-top: 3rem;
    }
  }

  /* Ultra Small Mobile Devices (iPhone SE, etc.) - Ultra Compact */
  @media (max-width: 360px) {
    .blob-gallery {
      padding: 2rem 0;
    }

    .blob-grid {
      grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
      gap: 0.6rem;
      padding: 0 0.6rem;
    }

    .gallery-header {
      margin-bottom: 1.5rem;
    }

    .gallery-title {
      font-size: clamp(1.8rem, 5.5vw, 2.5rem);
      margin-bottom: 0.6rem;
    }

    .gallery-subtitle {
      font-size: 0.9rem;
      padding: 0 0.8rem;
    }

    .counter-content {
      padding: 0.8rem 1.5rem;
    }

    .counter-number {
      font-size: 2rem;
    }

    .spotlight-reveal {
      padding: 0.6rem;
    }

    .item-title {
      font-size: clamp(0.95rem, 4vw, 1.2rem);
    }

    .item-artist {
      font-size: clamp(0.85rem, 3.5vw, 1rem);
      margin-bottom: 0.5rem;
    }

    .specialty-tag {
      font-size: clamp(0.6rem, 2.5vw, 0.75rem);
      padding: 0.25rem 0.6rem;
    }

    .btn--ghost {
      min-width: 120px;
      max-width: 160px;
      padding: 0.7rem 1rem;
      font-size: clamp(0.8rem, 3vw, 0.95rem);
    }

    .gallery-cta {
      margin-top: 2.5rem;
    }
  }

  /* Reduced Motion */
  @media (prefers-reduced-motion: reduce) {
    .gallery-title::after {
      animation: none !important;
    }
    
    .blob-item {
      animation: none;
      opacity: 1;
    }
    
    .blob-item:hover {
      transform: scale(1.01);
    }
    
    .blob-item:hover .blob-inner img {
      transform: scale(1.02);
    }

    .blob-shape {
      animation: none !important;
    }

    .counter-glow {
      animation: none !important;
    }
  }
</style>

<script>
  // Optimized gallery interactions with progressive enhancement
  class OptimizedBlobGallery {
    private isEnhanced: boolean = false;
    private observer: IntersectionObserver | null = null;
    
    constructor() {
      this.init();
    }

    private init(): void {
      this.setupBasicInteractions();
      this.scheduleEnhancements();
    }

    private setupBasicInteractions(): void {
      // Basic intersection observer for fade-in
      this.setupIntersectionObserver();
      
      // Basic touch/click handlers
      this.setupActionHandlers();
      
      // Counter animation
      this.animateCounter();
    }

    private scheduleEnhancements(): void {
      // Check for reduced motion preference
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const isMobile = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);
      
      if (prefersReducedMotion) {
        return; // Skip enhancements
      }

      // Progressive loading - delay enhancements
      setTimeout(() => {
        this.loadEnhancements();
      }, isMobile ? 2000 : 1500);

      // Also load on user interaction with gallery
      const galleryElement = document.querySelector('.blob-gallery');
      if (galleryElement) {
        const interactionEvents = ['mouseenter', 'touchstart'];
        const handleFirstInteraction = () => {
          if (!this.isEnhanced) {
            this.loadEnhancements();
          }
          interactionEvents.forEach(event => {
            galleryElement.removeEventListener(event, handleFirstInteraction);
          });
        };

        interactionEvents.forEach(event => {
          galleryElement.addEventListener(event, handleFirstInteraction, { once: true, passive: true });
        });
      }
    }

    private loadEnhancements(): void {
      if (this.isEnhanced) return;
      
      this.isEnhanced = true;
      document.body.classList.add('enhanced-loaded');
      
      // Enable morphing animations
      document.querySelectorAll('.blob-shape').forEach(shape => {
        shape.parentElement?.classList.add('morphing-enabled');
      });

      // Enhanced hover effects
      this.setupEnhancedHoverEffects();
    }

    private setupIntersectionObserver(): void {
      const options = {
        threshold: 0.2,
        rootMargin: '0px 0px -50px 0px'
      };

      this.observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            (entry.target as HTMLElement).style.animationPlayState = 'running';
          }
        });
      }, options);

      document.querySelectorAll('.blob-item').forEach(item => {
        this.observer?.observe(item);
      });
    }

    private setupActionHandlers(): void {
      document.querySelectorAll('.blob-item').forEach(item => {
        // Basic hover for desktop
        item.addEventListener('mouseenter', () => {
          this.addBasicHover(item as HTMLElement);
        });
        
        item.addEventListener('mouseleave', () => {
          this.removeBasicHover(item as HTMLElement);
        });

        // Touch events for mobile
        item.addEventListener('touchstart', (e) => {
          const target = e.target as HTMLElement;
          const isButton = target.closest('.btn--ghost');
          if (!isButton) {
            e.preventDefault();
          }
          this.addBasicHover(item as HTMLElement);
          item.classList.add('touch-active');
        }, { passive: false });

        item.addEventListener('touchend', () => {
          setTimeout(() => {
            this.removeBasicHover(item as HTMLElement);
            item.classList.remove('touch-active');
          }, 300);
        });

        // Click navigation
        item.addEventListener('click', (e) => {
          const target = e.target as HTMLElement;
          const isButton = target.closest('.btn--ghost');
          
          if (isButton) {
            return; // Let button handle navigation
          }
          
          const link = item.querySelector('.btn--ghost') as HTMLAnchorElement;
          if (link && !e.defaultPrevented) {
            e.preventDefault();
            window.location.href = link.href;
          }
        });
      });
    }

    private setupEnhancedHoverEffects(): void {
      if (!this.isEnhanced) return;

      document.querySelectorAll('.blob-item').forEach(item => {
        const artistSlug = item.getAttribute('data-artist');
        const blob = item.querySelector('.blob-shape') as HTMLElement;
        
        if (!blob || !artistSlug) return;

        item.addEventListener('mouseenter', () => {
          this.addArtistGlow(item as HTMLElement, artistSlug);
        });

        item.addEventListener('mouseleave', () => {
          this.removeArtistGlow(item as HTMLElement);
        });
      });
    }

    private addBasicHover(item: HTMLElement): void {
      const blob = item.querySelector('.blob-shape') as HTMLElement;
      if (blob) {
        blob.style.filter = 'brightness(1.05) drop-shadow(0 0 20px rgba(255, 255, 255, 0.6))';
      }
    }

    private removeBasicHover(item: HTMLElement): void {
      const blob = item.querySelector('.blob-shape') as HTMLElement;
      if (blob) {
        blob.style.filter = '';
      }
    }

    private addArtistGlow(item: HTMLElement, artistSlug: string): void {
      const blob = item.querySelector('.blob-shape') as HTMLElement;
      if (!blob) return;

      const glowColors = {
        'seth-wood': 'rgba(138, 43, 226, 0.8)',
        'ashley-wood': 'rgba(255, 105, 180, 0.8)', 
        'trent': 'rgba(30, 144, 255, 0.8)',
        'cody-crochet': 'rgba(50, 205, 50, 0.8)',
        'luis-reymundo': 'rgba(255, 140, 0, 0.8)',
        'anthony-boudreaux': 'rgba(255, 60, 43, 0.8)'
      };
      
      const glowColor = glowColors[artistSlug as keyof typeof glowColors] || 'rgba(255, 255, 255, 0.8)';
      blob.style.filter = `brightness(1.1) drop-shadow(0 0 25px ${glowColor})`;
    }

    private removeArtistGlow(item: HTMLElement): void {
      const blob = item.querySelector('.blob-shape') as HTMLElement;
      if (blob) {
        blob.style.filter = '';
      }
    }

    private animateCounter(): void {
      const counter = document.querySelector('.counter-number') as HTMLElement;
      if (!counter) return;

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            this.countUp(counter);
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.5 });

      observer.observe(counter);
    }

    private countUp(element: HTMLElement): void {
      const target = parseInt(element.getAttribute('data-count') || '6');
      let current = 0;
      const increment = target / 40; // Faster animation
      
      const timer = setInterval(() => {
        current += increment;
        if (current >= target) {
          element.textContent = target.toString();
          clearInterval(timer);
        } else {
          element.textContent = Math.floor(current).toString();
        }
      }, 20); // ~50fps for smoother animation
    }
  }

  // Initialize when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => new OptimizedBlobGallery());
  } else {
    new OptimizedBlobGallery();
  }
</script>
