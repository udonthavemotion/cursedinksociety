      rgba(251, 207, 232, 0.1),
      rgba(233, 213, 255, 0.1),
      rgba(255, 247, 245, 0.1)
    );
    border-radius: 24px;
    overflow: hidden;
  }

  .ashley-watercolor-wrapper::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background:
      radial-gradient(circle at 20% 30%, rgba(251, 207, 232, 0.15) 0%, transparent 50%),
      radial-gradient(circle at 80% 70%, rgba(233, 213, 255, 0.15) 0%, transparent 50%),
      radial-gradient(circle at 60% 20%, rgba(255, 247, 245, 0.1) 0%, transparent 40%);
    pointer-events: none;
    z-index: 0;
  }

  /* Main card with watercolor aesthetic */
  .ashley-watercolor-card {
    background: linear-gradient(145deg,
      rgba(251, 207, 232, 0.08),
      rgba(233, 213, 255, 0.06),
      rgba(255, 247, 245, 0.1),
      rgba(251, 207, 232, 0.04)
    );
    border: 2px solid rgba(251, 207, 232, 0.3);
    border-radius: 24px !important;
    backdrop-filter: blur(12px);
    box-shadow:
      0 8px 24px rgba(251, 207, 232, 0.2),
      0 4px 12px rgba(233, 213, 255, 0.15),
      inset 0 1px 0 rgba(255, 255, 255, 0.3);
    position: relative;
    z-index: 1;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .ashley-watercolor-card:hover {
    border-color: rgba(251, 207, 232, 0.5);
    transform: translateY(-6px) scale(1.02);
    box-shadow:
      0 12px 36px rgba(251, 207, 232, 0.3),
      0 6px 18px rgba(233, 213, 255, 0.25),
      inset 0 1px 0 rgba(255, 255, 255, 0.4);
  }

  /* Header with elegant typography */
  .ashley-watercolor-card .artist-header {
    margin-bottom: 2rem;
  }

  .ashley-watercolor-card .artist-name {
    color: #7c2d12 !important; /* Warm brown for contrast */
    font-family: 'Playfair Display', 'Times New Roman', serif !important;
    font-size: 1.75rem !important;
    font-weight: 700 !important;
    margin-bottom: 0.75rem;
    text-shadow: none !important;
    letter-spacing: 0.02em;
    line-height: 1.2;
  }

  .ashley-watercolor-card .artist-title {
    color: #be185d !important; /* Pink accent */
    font-size: 1.1rem !important;
    font-weight: 500 !important;
    margin-bottom: 0.5rem;
    font-style: italic;
  }

  .ashley-watercolor-card .artist-experience {
    color: rgba(124, 45, 18, 0.8) !important;
    font-size: 0.95rem !important;
    font-weight: 400 !important;
    font-style: italic;
  }

  /* Circular avatar with watercolor border */
  .ashley-watercolor-card .artist-avatar img {
    border-radius: 50% !important;
    border: 4px solid transparent !important;
    background: linear-gradient(135deg,
      rgba(251, 207, 232, 0.8),
      rgba(233, 213, 255, 0.6),
      rgba(255, 247, 245, 0.7)
    ) !important;
    box-shadow:
      0 4px 12px rgba(251, 207, 232, 0.3),
      0 2px 6px rgba(233, 213, 255, 0.2),
      inset 0 2px 0 rgba(255, 255, 255, 0.3);
