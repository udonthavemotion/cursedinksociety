---
import Layout from '../layouts/Layout.astro';

const title = "Gallery — Cursed Ink Society Portfolio";
const description = "Browse our extensive portfolio of tattoo artwork. See examples of traditional, realism, fine line, Japanese, and custom tattoo designs by our master artists.";

// Import portfolio data from structured data source
import cisData from '../data/cis.json';

const portfolioData = cisData.portfolio;

// Create enhanced data structures for advanced filtering
const categories = [
  { id: 'all', name: 'All Work', count: portfolioData.featured.length },
  ...portfolioData.categories.map(cat => ({
    id: cat.slug,
    name: cat.name,
    count: portfolioData.featured.filter(item => item.category === cat.slug).length
  }))
];

// Create artist filter options
const artists = cisData.artists.map(artist => ({
  id: artist.slug,
  name: artist.name,
  count: portfolioData.featured.filter(item => item.artist === artist.slug).length
}));

// Define body placement options (this would be enhanced with actual data)
const placements = [
  { id: 'all', name: 'All Placements', count: portfolioData.featured.length },
  { id: 'arm', name: 'Arm', count: portfolioData.featured.filter(item => item.placement === 'arm').length },
  { id: 'leg', name: 'Leg', count: portfolioData.featured.filter(item => item.placement === 'leg').length },
  { id: 'back', name: 'Back', count: portfolioData.featured.filter(item => item.placement === 'back').length },
  { id: 'chest', name: 'Chest', count: portfolioData.featured.filter(item => item.placement === 'chest').length },
  { id: 'shoulder', name: 'Shoulder', count: portfolioData.featured.filter(item => item.placement === 'shoulder').length },
  { id: 'neck', name: 'Neck', count: portfolioData.featured.filter(item => item.placement === 'neck').length }
];

// Enhanced portfolio items with additional metadata
const allPortfolioItems = portfolioData.featured.map((item, index) => ({
  id: index + 1,
  image: item.image,
  title: item.title,
  artist: cisData.artists.find(artist => artist.slug === item.artist)?.name || 'Cursed Ink Society',
  artistSlug: item.artist,
  category: item.category,
  placement: item.placement || 'various',
  style: item.style || [],
  year: item.year || new Date().getFullYear(),
  alt: item.alt,
  tags: item.tags || []
}));
---

<Layout title={title} description={description}>
  <!-- Hero Section -->
  <section class="gallery-hero">
    <div class="container">
      <div class="hero-content">
        <span class="badge">Our Work</span>
        <h1 class="hero-title shine">Portfolio Gallery</h1>
        <p class="hero-description">
          Explore our extensive collection of tattoo artistry. Each piece represents hours of 
          collaboration, creativity, and craftsmanship between our artists and clients.
        </p>
      </div>
    </div>
  </section>

  <!-- Advanced Filter System -->
  <section class="gallery-filters">
    <div class="container">
      <!-- Primary Category Filters -->
      <div class="filter-nav">
        {categories.map((category) => (
          <button
            class={`filter-btn ${category.id === 'all' ? 'filter-btn--active' : ''}`}
            data-filter={category.id}
          >
            {category.name}
            <span class="filter-count">({category.count})</span>
          </button>
        ))}
      </div>

      <!-- Advanced Filters Panel -->
      <div class="advanced-filters">
        <div class="filter-section">
          <!-- Search Bar -->
          <div class="filter-group">
            <label for="gallery-search" class="filter-label">Search</label>
            <div class="search-input-wrapper">
              <input
                type="text"
                id="gallery-search"
                class="search-input"
                placeholder="Search by title or artist..."
              />
              <svg class="search-icon" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                <path d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>
              </svg>
            </div>
          </div>

          <!-- Artist Filter -->
          <div class="filter-group">
            <label for="artist-select" class="filter-label">Artist</label>
            <select id="artist-select" class="filter-select">
              <option value="all">All Artists</option>
              {artists.map((artist) => (
                <option value={artist.id}>
                  {artist.name} ({artist.count})
                </option>
              ))}
            </select>
          </div>

          <!-- Placement Filter -->
          <div class="filter-group">
            <label for="placement-select" class="filter-label">Placement</label>
            <select id="placement-select" class="filter-select">
              {placements.map((placement) => (
                <option value={placement.id}>
                  {placement.name} ({placement.count})
                </option>
              ))}
            </select>
          </div>
        </div>

        <!-- Active Filters Summary -->
        <div class="active-filters">
          <div class="active-filters-list" id="active-filters-list"></div>
          <button class="clear-filters-btn" id="clear-filters-btn" style="display: none;">
            Clear All Filters
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- Gallery Grid -->
  <section class="gallery-section">
    <div class="container">
      <div class="gallery-grid" id="gallery-grid">
        {allPortfolioItems.map((item) => (
          <article
            class="gallery-item"
            data-category={item.category}
            data-placement={item.placement}
            data-artist={item.artistSlug}
            data-item-id={item.id}
          >
            <div class="gallery-image-container">
              <img
                data-src={item.image}
                alt={item.alt || `${item.title} by ${item.artist}`}
                class="gallery-image"
                loading="lazy"
                width="300"
                height="400"
              />
              <div class="image-placeholder">
                <div class="placeholder-shimmer"></div>
              </div>
              <div class="gallery-overlay">
                <div class="gallery-info">
                  <h3 class="gallery-title">{item.title}</h3>
                  <p class="gallery-artist">by {item.artist}</p>
                  <span class="gallery-category">{categories.find(c => c.id === item.category)?.name}</span>
                </div>
                <button class="gallery-view-btn" data-lightbox={item.id}>
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/>
                  </svg>
                  View
                </button>
              </div>
            </div>
          </article>
        ))}
      </div>
      
      <!-- Load More Button -->
      <div class="gallery-load-more">
        <button class="btn btn--outline btn--large" id="load-more-btn">
          Load More Work
        </button>
      </div>
    </div>
  </section>

  <!-- Artist Showcase -->
  <section class="artist-showcase">
    <div class="container">
      <h2 class="section-title">Meet the Artists Behind the Work</h2>
      <div class="artist-preview-grid">
        {cisData.artists.map((artist) => (
          <div class="artist-preview">
            <img src={artist.avatar} alt={`${artist.name} - Professional tattoo artist`} class="artist-avatar" />
            <div class="artist-preview-info">
              <h3>{artist.name}</h3>
              <p>{artist.positioning}</p>
              <a href={`/artists/${artist.slug}`} class="artist-link">View Profile →</a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="gallery-cta">
    <div class="container">
      <div class="cta-content">
        <h2>Ready to Create Your Own Masterpiece?</h2>
        <p>Book a consultation with one of our artists and bring your vision to life.</p>
        <div class="cta-actions">
          <a href="/consultation" class="btn btn--primary btn--large">Book Consultation</a>
          <a href="/artists" class="btn btn--outline btn--large">Meet Our Artists</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Lightbox Modal -->
  <div class="lightbox" id="lightbox">
    <div class="lightbox-backdrop"></div>
    <div class="lightbox-content">
      <button class="lightbox-close" id="lightbox-close">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
          <path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
        </svg>
      </button>
      <img class="lightbox-image" id="lightbox-image" alt="" />
      <div class="lightbox-info" id="lightbox-info">
        <h3 class="lightbox-title"></h3>
        <p class="lightbox-artist"></p>
        <span class="lightbox-category"></span>
      </div>
    </div>
  </div>
</Layout>

<script>
  // Gallery filtering and lightbox functionality
  class GalleryManager {
    constructor() {
      // Basic filter elements
      this.filterButtons = document.querySelectorAll('.filter-btn');
      this.galleryItems = document.querySelectorAll('.gallery-item');
      this.viewButtons = document.querySelectorAll('.gallery-view-btn');
      this.lightbox = document.getElementById('lightbox');
      this.lightboxImage = document.getElementById('lightbox-image');
      this.lightboxInfo = document.getElementById('lightbox-info');
      this.lightboxClose = document.getElementById('lightbox-close');
      this.loadMoreBtn = document.getElementById('load-more-btn');

      // Advanced filter elements
      this.searchInput = document.getElementById('gallery-search');
      this.artistSelect = document.getElementById('artist-select');
      this.placementSelect = document.getElementById('placement-select');
      this.activeFiltersList = document.getElementById('active-filters-list');
      this.clearFiltersBtn = document.getElementById('clear-filters-btn');

      // Filter state
      this.filters = {
        category: 'all',
        search: '',
        artist: 'all',
        placement: 'all'
      };

      this.visibleItems = 12; // Initially show 12 items
      this.allItems = Array.from(this.galleryItems);

      this.init();
    }

    init() {
      // Category filter functionality
      this.filterButtons.forEach(btn => {
        btn.addEventListener('click', (e) => this.handleCategoryFilter(e));
      });

      // Advanced filter functionality
      if (this.searchInput) {
        this.searchInput.addEventListener('input', (e) => this.handleSearchFilter(e));
        this.searchInput.addEventListener('keydown', (e) => {
          if (e.key === 'Enter') {
            e.preventDefault();
            this.searchInput.blur();
          }
        });
      }

      if (this.artistSelect) {
        this.artistSelect.addEventListener('change', (e) => this.handleArtistFilter(e));
      }

      if (this.placementSelect) {
        this.placementSelect.addEventListener('change', (e) => this.handlePlacementFilter(e));
      }

      if (this.clearFiltersBtn) {
        this.clearFiltersBtn.addEventListener('click', () => this.clearAllFilters());
      }

      // Lightbox functionality
      this.viewButtons.forEach(btn => {
        btn.addEventListener('click', (e) => this.openLightbox(e));
      });

      if (this.lightboxClose) {
        this.lightboxClose.addEventListener('click', () => this.closeLightbox());
      }

      if (this.lightbox) {
        this.lightbox.addEventListener('click', (e) => {
          if (e.target === this.lightbox || e.target.classList.contains('lightbox-backdrop')) {
            this.closeLightbox();
          }
        });
      }

      // Load more functionality
      if (this.loadMoreBtn) {
        this.loadMoreBtn.addEventListener('click', () => this.loadMoreItems());
      }

      // Keyboard navigation
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && this.lightbox.classList.contains('lightbox--open')) {
          this.closeLightbox();
        }
      });

      // Initial load
      this.updateGalleryDisplay();
      this.updateActiveFiltersDisplay();
    }

    // Handle category filter (existing buttons)
    handleCategoryFilter(e) {
      const filter = e.target.dataset.filter;
      if (!filter) return;

      // Update active button
      this.filterButtons.forEach(btn => btn.classList.remove('filter-btn--active'));
      e.target.classList.add('filter-btn--active');

      // Update filter state
      this.filters.category = filter;
      this.visibleItems = 12; // Reset visible items

      // Update display and active filters
      this.updateGalleryDisplay();
      this.updateActiveFiltersDisplay();
    }

    // Handle search filter
    handleSearchFilter(e) {
      this.filters.search = e.target.value.toLowerCase().trim();
      this.visibleItems = 12; // Reset visible items
      this.updateGalleryDisplay();
      this.updateActiveFiltersDisplay();
    }

    // Handle artist filter
    handleArtistFilter(e) {
      this.filters.artist = e.target.value;
      this.visibleItems = 12; // Reset visible items
      this.updateGalleryDisplay();
      this.updateActiveFiltersDisplay();
    }

    // Handle placement filter
    handlePlacementFilter(e) {
      this.filters.placement = e.target.value;
      this.visibleItems = 12; // Reset visible items
      this.updateGalleryDisplay();
      this.updateActiveFiltersDisplay();
    }

    // Clear all filters
    clearAllFilters() {
      // Reset filter state
      this.filters = {
        category: 'all',
        search: '',
        artist: 'all',
        placement: 'all'
      };

      // Reset UI elements
      this.filterButtons.forEach(btn => {
        btn.classList.toggle('filter-btn--active', btn.dataset.filter === 'all');
      });

      if (this.searchInput) this.searchInput.value = '';
      if (this.artistSelect) this.artistSelect.value = 'all';
      if (this.placementSelect) this.placementSelect.value = 'all';

      this.visibleItems = 12; // Reset visible items
      this.updateGalleryDisplay();
      this.updateActiveFiltersDisplay();
    }

    // Enhanced gallery display with multiple filters
    updateGalleryDisplay() {
      const filteredItems = this.allItems.filter(item => {
        // Category filter
        const categoryMatch = this.filters.category === 'all' || item.dataset.category === this.filters.category;

        // Artist filter
        const artistMatch = this.filters.artist === 'all' || item.dataset.artist === this.filters.artist;

        // Placement filter
        const placementMatch = this.filters.placement === 'all' || item.dataset.placement === this.filters.placement;

        // Search filter
        const title = item.querySelector('.gallery-title')?.textContent?.toLowerCase() || '';
        const artist = item.querySelector('.gallery-artist')?.textContent?.toLowerCase() || '';
        const searchMatch = this.filters.search === '' ||
          title.includes(this.filters.search) ||
          artist.includes(this.filters.search);

        return categoryMatch && artistMatch && placementMatch && searchMatch;
      });

      // Hide all items first
      this.galleryItems.forEach(item => {
        item.style.display = 'none';
        item.classList.remove('gallery-item--visible');
      });

      // Show filtered items up to visible limit
      filteredItems.slice(0, this.visibleItems).forEach(item => {
        item.style.display = 'block';
        setTimeout(() => item.classList.add('gallery-item--visible'), 50);
      });

      // Update load more button
      if (this.loadMoreBtn) {
        if (filteredItems.length > this.visibleItems) {
          this.loadMoreBtn.style.display = 'block';
        } else {
          this.loadMoreBtn.style.display = 'none';
        }
      }
    }

    // Update active filters display
    updateActiveFiltersDisplay() {
      const activeFilters = [];

      if (this.filters.category !== 'all') {
        const categoryName = Array.from(this.filterButtons)
          .find(btn => btn.dataset.filter === this.filters.category)
          ?.textContent?.split(' (')[0];
        if (categoryName) activeFilters.push({ type: 'category', value: categoryName, key: 'category' });
      }

      if (this.filters.search) {
        activeFilters.push({ type: 'search', value: `"${this.filters.search}"`, key: 'search' });
      }

      if (this.filters.artist !== 'all') {
        const artistName = this.artistSelect?.querySelector(`option[value="${this.filters.artist}"]`)?.textContent?.split(' (')[0];
        if (artistName) activeFilters.push({ type: 'artist', value: artistName, key: 'artist' });
      }

      if (this.filters.placement !== 'all') {
        const placementName = this.placementSelect?.querySelector(`option[value="${this.filters.placement}"]`)?.textContent?.split(' (')[0];
        if (placementName) activeFilters.push({ type: 'placement', value: placementName, key: 'placement' });
      }

      // Update active filters list
      if (this.activeFiltersList) {
        this.activeFiltersList.innerHTML = activeFilters.map(filter => `
          <span class="active-filter-tag" data-filter-type="${filter.key}">
            ${filter.type}: ${filter.value}
            <button class="remove-filter" data-filter-type="${filter.key}" aria-label="Remove ${filter.type} filter">×</button>
          </span>
        `).join('');

        // Add event listeners to remove buttons
        this.activeFiltersList.querySelectorAll('.remove-filter').forEach(btn => {
          btn.addEventListener('click', (e) => {
            const filterType = e.target.dataset.filterType;
            this.removeFilter(filterType);
          });
        });
      }

      // Show/hide clear all button
      if (this.clearFiltersBtn) {
        this.clearFiltersBtn.style.display = activeFilters.length > 0 ? 'block' : 'none';
      }
    }

    // Remove individual filter
    removeFilter(filterType) {
      switch (filterType) {
        case 'category':
          this.filters.category = 'all';
          this.filterButtons.forEach(btn => {
            btn.classList.toggle('filter-btn--active', btn.dataset.filter === 'all');
          });
          break;
        case 'search':
          this.filters.search = '';
          if (this.searchInput) this.searchInput.value = '';
          break;
        case 'artist':
          this.filters.artist = 'all';
          if (this.artistSelect) this.artistSelect.value = 'all';
          break;
        case 'placement':
          this.filters.placement = 'all';
          if (this.placementSelect) this.placementSelect.value = 'all';
          break;
      }

      this.visibleItems = 12; // Reset visible items
      this.updateGalleryDisplay();
      this.updateActiveFiltersDisplay();
    }

    loadMoreItems() {
      this.visibleItems += 12;
      this.updateGalleryDisplay();
    }

    openLightbox(e) {
      e.preventDefault();
      const button = e.currentTarget;
      const galleryItem = button.closest('.gallery-item');
      const image = galleryItem.querySelector('.gallery-image');
      const title = galleryItem.querySelector('.gallery-title').textContent;
      const artist = galleryItem.querySelector('.gallery-artist').textContent;
      const category = galleryItem.querySelector('.gallery-category').textContent;

      // Update lightbox content
      this.lightboxImage.src = image.src;
      this.lightboxImage.alt = image.alt;
      this.lightboxInfo.querySelector('.lightbox-title').textContent = title;
      this.lightboxInfo.querySelector('.lightbox-artist').textContent = artist;
      this.lightboxInfo.querySelector('.lightbox-category').textContent = category;

      // Show lightbox
      this.lightbox.classList.add('lightbox--open');
      document.body.style.overflow = 'hidden';
    }

    closeLightbox() {
      this.lightbox.classList.remove('lightbox--open');
      document.body.style.overflow = '';
    }
  }

    // Enhanced Lazy Loading Manager
  class LazyImageLoader {
    constructor() {
      this.imageObserver = null;
      this.init();
    }

    init() {
      // Use Intersection Observer for better lazy loading
      if ('IntersectionObserver' in window) {
        this.imageObserver = new IntersectionObserver((entries, observer) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              const img = entry.target;
              this.loadImage(img);
              observer.unobserve(img);
            }
          });
        }, {
          rootMargin: '50px 0px',
          threshold: 0.1
        });

        // Observe all gallery images
        document.querySelectorAll('.gallery-image[data-src]').forEach(img => {
          this.imageObserver.observe(img);
        });
      }
    }

    loadImage(img) {
      const src = img.getAttribute('data-src');
      if (src) {
        img.src = src;
        img.classList.add('loaded');
        img.removeAttribute('data-src');
      }
    }
  }

  // Initialize gallery when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      new GalleryManager();
      new LazyImageLoader();
    });
  } else {
    new GalleryManager();
    new LazyImageLoader();
  }
</script>

<style>
  /* Gallery Hero */
  .gallery-hero {
    padding: 8rem 0 4rem;
    text-align: center;
    background: 
      radial-gradient(1000px 600px at 50% 20%, rgba(255, 60, 43, 0.03) 0%, transparent 60%);
  }

  .hero-content {
    max-width: 700px;
    margin: 0 auto;
  }

  .hero-title {
    font-size: clamp(3rem, 6vw, 4.5rem);
    margin: 1rem 0 1.5rem;
    line-height: 1.1;
  }

  .hero-description {
    font-size: 1.2rem;
    line-height: 1.6;
    opacity: 0.9;
    margin: 0;
  }

  /* Gallery Filters */
  .gallery-filters {
    padding: 2rem 0;
    background: var(--bg-glass);
    border-top: var(--border-glass);
    position: sticky;
    top: 80px;
    z-index: 100;
    backdrop-filter: blur(10px);
  }

  .filter-nav {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .filter-btn {
    background: transparent;
    border: var(--border-glass);
    color: var(--ink);
    padding: 0.75rem 1.5rem;
    border-radius: 25px;
    font-size: 0.9rem;
    font-weight: 500;
    cursor: pointer;
    transition: var(--transition-smooth);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    backdrop-filter: blur(5px);
  }

  .filter-btn:hover,
  .filter-btn--active {
    background: var(--accent0);
    border-color: var(--accent0);
    color: var(--bg0);
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(255, 60, 43, 0.3);
  }

  .filter-count {
    font-size: 0.8rem;
    opacity: 0.8;
  }

  /* Advanced Filters Panel */
  .advanced-filters {
    margin-top: 2rem;
    padding: 2rem;
    background: rgba(255, 255, 255, 0.02);
    border: var(--border-glass);
    border-radius: 16px;
    backdrop-filter: blur(10px);
  }

  .filter-section {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
    margin-bottom: 2rem;
  }

  .filter-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .filter-label {
    color: var(--accent0);
    font-size: 0.9rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0;
  }

  /* Search Input */
  .search-input-wrapper {
    position: relative;
    display: flex;
    align-items: center;
  }

  .search-input {
    width: 100%;
    padding: 0.875rem 3rem 0.875rem 1rem;
    background: rgba(255, 255, 255, 0.05);
    border: var(--border-glass);
    border-radius: 12px;
    color: var(--ink);
    font-size: 0.95rem;
    backdrop-filter: blur(5px);
    transition: var(--transition-smooth);
  }

  .search-input:focus {
    outline: none;
    border-color: var(--accent0);
    background: rgba(255, 60, 43, 0.05);
    box-shadow: 0 0 0 3px rgba(255, 60, 43, 0.1);
  }

  .search-input::placeholder {
    color: var(--ink);
    opacity: 0.5;
  }

  .search-icon {
    position: absolute;
    right: 1rem;
    color: var(--ink);
    opacity: 0.5;
    pointer-events: none;
  }

  /* Filter Select */
  .filter-select {
    width: 100%;
    padding: 0.875rem 3rem 0.875rem 1rem;
    background: rgba(255, 255, 255, 0.05);
    border: var(--border-glass);
    border-radius: 12px;
    color: var(--ink);
    font-size: 0.95rem;
    backdrop-filter: blur(5px);
    transition: var(--transition-smooth);
