---
// Services data
const services = [
  {
    id: 1,
    title: "Custom Tattoo Design",
    description: "Collaborate with our artists to create a unique piece that tells your story. From concept to completion, we bring your vision to life.",
    features: ["Personal consultation", "Custom design process", "Multiple revision rounds", "Aftercare guidance"],
    price: "Starting at $200",
    duration: "2-6 hours",
    icon: "design",
    popular: true
  },
  {
    id: 2,
    title: "Traditional & Neo-Traditional",
    description: "Classic American traditional and modern neo-traditional styles with bold lines, vibrant colors, and timeless appeal.",
    features: ["Bold, clean lines", "Vibrant color work", "Classic motifs", "Modern interpretations"],
    price: "$190-230/hour",
    duration: "1-4 hours",
    icon: "traditional",
    popular: false
  },
  {
    id: 3,
    title: "Realism & Portraits",
    description: "Photorealistic tattoos that capture every detail. Perfect for memorials, portraits, and nature scenes that demand precision.",
    features: ["Photorealistic detail", "Portrait specialization", "Nature & wildlife", "Black & grey mastery"],
    price: "$220-250/hour",
    duration: "3-8 hours",
    icon: "realism",
    popular: false
  },
  {
    id: 4,
    title: "Cover-Up & Restoration",
    description: "Transform old or unwanted tattoos into beautiful new artwork. Our experts specialize in creative solutions for challenging pieces.",
    features: ["Free consultation", "Creative solutions", "Color correction", "Scar integration"],
    price: "Quote on consultation",
    duration: "Varies",
    icon: "coverup",
    popular: false
  },
  {
    id: 5,
    title: "Fine Line & Minimalist",
    description: "Delicate, precise linework for those who prefer subtle elegance. Perfect for first tattoos and meaningful small pieces.",
    features: ["Precision linework", "Minimalist designs", "Small to medium pieces", "Subtle elegance"],
    price: "$150-200/hour",
    duration: "1-3 hours",
    icon: "fineline",
    popular: false
  },
  {
    id: 6,
    title: "Japanese Traditional",
    description: "Authentic Irezumi and Japanese-inspired work following traditional techniques and cultural respect for the art form.",
    features: ["Traditional techniques", "Cultural authenticity", "Large scale pieces", "Full body planning"],
    price: "$200-280/hour",
    duration: "4-12 hours",
    icon: "japanese",
    popular: false
  }
];
---

<section class="services-preview" id="services">
  <div class="container">
    <div class="section-header">
      <span class="badge">Our Craft</span>
      <h2 class="section-title shine">Services & Specialties</h2>
      <p class="section-description">
        From intimate fine line work to bold traditional pieces, our artists master every style. 
        Discover the perfect approach for your vision.
      </p>
    </div>

    <div class="services-grid">
      {services.map((service) => (
        <article class="service-card" data-service-id={service.id}>
          {service.popular && <div class="popular-badge">Most Popular</div>}
          
          <div class="service-header">
            <div class="service-icon" data-icon={service.icon}>
              {service.icon === 'design' && (
                <svg width="32" height="32" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                </svg>
              )}
              {service.icon === 'traditional' && (
                <svg width="32" height="32" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
                </svg>
              )}
              {service.icon === 'realism' && (
                <svg width="32" height="32" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 2l.09.06c.69.33 1.33.78 1.91 1.36l.84.84c.58.58 1.03 1.22 1.36 1.91L16.26 6c.33-.69.78-1.33 1.36-1.91l.84-.84c.58-.58 1.22-1.03 1.91-1.36L20.43 2c.69.33 1.33.78 1.91 1.36l.84.84c.58.58 1.03 1.22 1.36 1.91L24 6.17c-.33.69-.78 1.33-1.36 1.91l-.84.84c-.58.58-1.22 1.03-1.91 1.36L20.43 10c-.69-.33-1.33-.78-1.91-1.36l-.84-.84c-.58-.58-1.03-1.22-1.36-1.91L16.26 6c-.33.69-.78 1.33-1.36 1.91l-.84.84c-.58.58-1.22 1.03-1.91 1.36L12 10.06c-.69-.33-1.33-.78-1.91-1.36l-.84-.84c-.58-.58-1.03-1.22-1.36-1.91L7.74 6c-.33.69-.78 1.33-1.36 1.91l-.84.84c-.58.58-1.22 1.03-1.91 1.36L3.57 10c-.69-.33-1.33-.78-1.91-1.36l-.84-.84C.24 7.22-.21 6.58-.54 5.89L0 5.83c.33-.69.78-1.33 1.36-1.91l.84-.84C2.78 2.5 3.42 2.05 4.11 1.72L3.57 2c.69.33 1.33.78 1.91 1.36l.84.84c.58.58 1.03 1.22 1.36 1.91L7.74 6c.33-.69.78-1.33 1.36-1.91l.84-.84C10.52 2.67 11.16 2.22 11.85 1.89L12 2z"/>
                </svg>
              )}
              {service.icon === 'coverup' && (
                <svg width="32" height="32" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm5 11H7v-2h10v2z"/>
                </svg>
              )}
              {service.icon === 'fineline' && (
                <svg width="32" height="32" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/>
                </svg>
              )}
              {service.icon === 'japanese' && (
                <svg width="32" height="32" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.94-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"/>
                </svg>
              )}
            </div>
            <h3 class="service-title">{service.title}</h3>
          </div>

          <p class="service-description">{service.description}</p>

          <ul class="service-features">
            {service.features.map((feature) => (
              <li class="service-feature">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
                </svg>
                {feature}
              </li>
            ))}
          </ul>

          <div class="service-meta">
            <div class="service-pricing">
              <span class="price">{service.price}</span>
              <span class="duration">{service.duration}</span>
            </div>
            <a href="/book" class="btn btn--primary service-book-btn">
              Book Consultation
            </a>
          </div>
        </article>
      ))}
    </div>

    <div class="services-cta">
      <div class="cta-content">
        <h3>Not sure which service is right for you?</h3>
        <p>Book a free consultation and let our experts guide you to the perfect tattoo experience.</p>
        <div class="cta-actions">
          <a href="/consultation" class="btn btn--primary">Free Consultation</a>
          <a href="/services" class="btn btn--outline">View All Services</a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
// Add staggered animation indices to service cards
document.addEventListener('DOMContentLoaded', () => {
  const serviceCards = document.querySelectorAll('.service-card');
  serviceCards.forEach((card, index) => {
    card.style.setProperty('--service-index', index.toString());
  });

  // Add intersection observer for enhanced scroll animations
  const observerOptions = {
    threshold: 0.1,
    rootMargin: '0px 0px -50px 0px'
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('animate-in');
      }
    });
  }, observerOptions);

  // Observe elements for enhanced animations
  document.querySelectorAll('.service-card, .services-cta').forEach(el => {
    observer.observe(el);
  });
});
</script>

<style>
  .services-preview {
    padding: 6rem 0;
    background: 
      radial-gradient(1200px 800px at 80% 20%, rgba(255, 122, 24, 0.02) 0%, transparent 60%),
      radial-gradient(800px 600px at 20% 80%, rgba(255, 60, 43, 0.03) 0%, transparent 60%);
  }

  .section-header {
    text-align: center;
    margin-bottom: 4rem;
    max-width: 700px;
    margin-left: auto;
    margin-right: auto;
    opacity: 0;
    animation: fadeInUp 1s ease-out 0.2s forwards;
  }

  .section-title {
    position: relative;
    display: inline-block;
  }

  .section-title::after {
    content: '';
    position: absolute;
    bottom: -10px;
    left: 50%;
    transform: translateX(-50%);
    width: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--accent0), var(--accent1));
    border-radius: 2px;
    animation: expandWidth 1.5s ease-out 0.8s forwards;
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: 2rem;
    margin-bottom: 4rem;
  }

  .service-card {
    background: var(--bg-glass);
    border: var(--border-glass);
    border-radius: 20px;
    padding: 2rem;
    backdrop-filter: blur(10px);
    transition: var(--transition-smooth);
    position: relative;
    display: flex;
    flex-direction: column;
    opacity: 0;
    transform: translateY(30px);
    animation: fadeInUp 0.8s ease-out forwards;
    animation-delay: calc(var(--service-index) * 0.15s + 0.3s);
  }

  .service-card:hover {
    transform: translateY(-4px) scale(1.02);
    box-shadow:
      0 16px 32px rgba(0, 0, 0, 0.2),
      0 0 20px rgba(255, 60, 43, 0.1),
      0 0 30px rgba(255, 122, 24, 0.05);
    border-color: rgba(255, 60, 43, 0.2);
  }

  .service-card:hover::before {
    content: '';
    position: absolute;
    inset: -2px;
    background: linear-gradient(45deg, var(--accent0), var(--accent1), var(--accent0));
    border-radius: 22px;
    z-index: -1;
    animation: rotateGlow 3s linear infinite;
  }

  .popular-badge {
    position: absolute;
    top: -10px;
    right: 1.5rem;
    background: linear-gradient(45deg, var(--accent0), var(--accent1));
    color: var(--bg0);
    padding: 0.4rem 1rem;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    box-shadow: 0 4px 12px rgba(255, 60, 43, 0.3);
  }

  .service-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .service-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 60px;
    height: 60px;
    background: rgba(255, 60, 43, 0.1);
    border: 1px solid rgba(255, 60, 43, 0.2);
    border-radius: 50%;
    color: var(--accent0);
    flex-shrink: 0;
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
  }

  .service-icon::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(45deg, rgba(255, 60, 43, 0.2), rgba(255, 122, 24, 0.2));
    border-radius: 50%;
    opacity: 0;
    transform: scale(0);
    transition: all 0.3s ease;
  }

  .service-card:hover .service-icon {
    background: rgba(255, 60, 43, 0.2);
    border-color: rgba(255, 60, 43, 0.4);
    transform: scale(1.1);
    box-shadow: 0 0 20px rgba(255, 60, 43, 0.3);
  }

  .service-card:hover .service-icon::before {
    opacity: 1;
    transform: scale(1);
  }

  .service-card:hover .service-icon svg {
    transform: scale(1.1);
    filter: drop-shadow(0 0 5px rgba(255, 60, 43, 0.5));
  }

  .service-title {
    font-size: 1.3rem;
    margin: 0;
    color: var(--ink);
    text-shadow: var(--glow-subtle);
  }

  .service-description {
    font-size: 0.95rem;
    line-height: 1.6;
    opacity: 0.9;
    margin: 0 0 1.5rem;
    flex-grow: 1;
  }

  .service-features {
    list-style: none;
    padding: 0;
    margin: 0 0 2rem;
  }

  .service-feature {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
    font-size: 0.9rem;
  }

  .service-feature svg {
    color: var(--accent0);
    flex-shrink: 0;
  }

  .service-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: auto;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .service-pricing {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .price {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--accent0);
    text-shadow: var(--glow-subtle);
  }

  .duration {
    font-size: 0.85rem;
    opacity: 0.7;
  }

  .service-book-btn {
    font-size: 0.9rem;
    padding: 0.7rem 1.2rem;
    white-space: nowrap;
  }

  .services-cta {
    background: var(--bg-glass);
    border: var(--border-glass);
    border-radius: 20px;
    padding: 3rem 2rem;
    backdrop-filter: blur(10px);
    text-align: center;
  }

  .cta-content h3 {
    font-size: 1.5rem;
    margin: 0 0 1rem;
    color: var(--ink);
    text-shadow: var(--glow-subtle);
  }

  .cta-content p {
    font-size: 1.1rem;
    opacity: 0.9;
    margin: 0 0 2rem;
    max-width: 500px;
    margin-left: auto;
    margin-right: auto;
  }

  .cta-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  /* Mobile Optimizations */
  @media (max-width: 768px) {
    .services-preview {
      padding: 4rem 0;
    }

    .services-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .service-card {
      padding: 1.5rem;
    }

    .service-meta {
      flex-direction: column;
      align-items: stretch;
      gap: 1rem;
    }

    .service-pricing {
      text-align: center;
    }

    .service-book-btn {
      width: 100%;
      text-align: center;
    }

    .services-cta {
      padding: 2rem 1rem;
    }

    .cta-actions {
      flex-direction: column;
      align-items: center;
    }

    .cta-actions .btn {
      width: 100%;
      max-width: 280px;
    }
  }

  /* New Animations */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes expandWidth {
    from {
      width: 0;
    }
    to {
      width: 100px;
    }
  }

  @keyframes rotateGlow {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  /* Enhanced button animations */
  .btn--primary::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(45deg, transparent, rgba(255, 255, 255, 0.1), transparent);
    transform: translateX(-100%);
    transition: transform 0.6s ease;
  }

  .btn--primary:hover::before {
    transform: translateX(100%);
  }

  /* Reduced motion support */
  @media (prefers-reduced-motion: reduce) {
    .service-card,
    .section-header,
    .section-title::after,
    .service-card:hover::before {
      animation: none;
    }

    .service-card:hover {
      transform: none;
    }

    .service-card:hover .service-icon {
      transform: none;
    }

    .service-card:hover .service-icon svg {
      transform: none;
    }

    .btn--primary::before {
      display: none;
    }
  }
</style>
