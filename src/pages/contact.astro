  .map-content {
    text-align: center;
    padding: 2rem;
  }

  .map-content svg {
    color: var(--accent0);
    margin-bottom: 1rem;
  }

  .map-content h3 {
    font-size: 1.3rem;
    margin: 0 0 0.5rem;
    color: var(--ink);
  }

  .map-content p {
    margin: 0 0 1.5rem;
    opacity: 0.8;
