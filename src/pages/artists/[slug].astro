  .seth-name {
    /* Font stack with fallbacks */
    font-family: 'DragonCapes', 'EGDragonCaps', 'Cinzel', 'Trajan Pro', 'Times New Roman', serif !important;
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    font-weight: normal;
    
    /* Strong color declaration for readability */
    color: #f4e4bc !important;
    
    /* Better spacing and layout */
    margin: 0;
    line-height: 1.2;
    letter-spacing: 0.15em;
    word-spacing: 0.3em;
    text-transform: uppercase;
    position: relative;
    display: block;
    text-align: center;
    
    /* Custom Layer Style for Easy Readability */
    text-shadow:
      /* Dark outline for contrast */
      -2px -2px 0 #000000,
      2px -2px 0 #000000,
      -2px 2px 0 #000000,
      2px 2px 0 #000000,
      /* Inner shadow for depth */
      0 0 8px rgba(0, 0, 0, 0.8),
      /* Warm glow */
      0 0 16px rgba(244, 228, 188, 0.4),
      /* Subtle red accent */
      0 0 24px rgba(139, 0, 0, 0.2);
    
    /* Force color visibility */
    -webkit-text-fill-color: #f4e4bc !important;
    text-fill-color: #f4e4bc !important;
    
    /* Ensure crisp rendering */
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    
    /* Subtle background for better contrast */
    background: rgba(0, 0, 0, 0.3);
    padding: 1rem 2rem;
    border-radius: 8px;
    backdrop-filter: blur(2px);
    border: 1px solid rgba(244, 228, 188, 0.2);
  }

  /* Enhanced hover effect */
  .seth-name:hover {
    color: #ffffff !important;
    -webkit-text-fill-color: #ffffff !important;
    text-fill-color: #ffffff !important;
    
    /* Enhanced layer style on hover */
    text-shadow:
      /* Stronger dark outline */
      -2px -2px 0 #000000,
      2px -2px 0 #000000,
      -2px 2px 0 #000000,
      2px 2px 0 #000000,
      /* Enhanced glow */
      0 0 12px rgba(0, 0, 0, 0.9),
      0 0 20px rgba(255, 255, 255, 0.6),
      0 0 30px rgba(244, 228, 188, 0.4),
      0 0 40px rgba(139, 0, 0, 0.3);
    
    /* Enhanced background */
    background: rgba(0, 0, 0, 0.5);
    border-color: rgba(244, 228, 188, 0.4);
    transform: scale(1.02);
    transition: all 0.3s ease;
  }

  .seth-title {
    font-size: 1.4rem;
    color: #c9a96e;
    font-weight: 600;
    margin: 0 0 2rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    font-family: 'Cinzel', serif;
