  }

  /* Bio with elegant styling */
  .ashley-watercolor-card .artist-bio {
    margin-bottom: 2rem;
  }

  .ashley-watercolor-card .bio-text {
    color: rgba(124, 45, 18, 0.9) !important;
    font-size: 0.95rem !important;
    line-height: 1.6 !important;
    font-family: 'Inter', sans-serif !important;
    font-style: italic;
  }

  /* Gallery with rounded thumbnails */
  .ashley-watercolor-card .artist-work-gallery {
    margin-bottom: 2rem;
  }

  .ashley-watercolor-card .gallery-title {
    color: #7c2d12 !important;
    font-family: 'Playfair Display', serif !important;
    font-size: 1.1rem !important;
    font-weight: 600 !important;
    margin-bottom: 1.25rem;
    text-transform: none !important;
