---
import Layout from '../layouts/Layout.astro';

const title = "Services & Pricing — Louisiana Licensed Tattoo Studio | Cursed Ink Society LLC";
const description = "Louisiana Department of Health licensed tattoo and piercing studio in Houma, LA. Custom designs, professional piercings, and strict health & safety compliance. 18+ with valid ID required.";

// Comprehensive services data
const tattooServices = [
  {
    id: 1,
    title: "Custom Tattoo Design",
    description: "Work directly with our skilled artists to create a unique tattoo that tells your personal story. We specialize in bringing your vision to life with exceptional craftsmanship and attention to detail.",
    features: [
      "Free consultation to discuss your vision",
      "Custom design process with unlimited revisions",
      "Professional tattooing with premium equipment",
      "Comprehensive aftercare instructions",
      "Free touch-up within 6 months"
    ],
    pricing: {
      consultation: "Free",
      hourly: "$150-280/hour",
      minimum: "$100",
      deposit: "$75 or 25% of estimate"
    },
    duration: "1-8 hours per session",
    popular: true,
    image: "/assets/services/custom-design.jpg"
  },
  {
    id: 2,
    title: "Cover-Up Tattoos",
    description: "Transform old or unwanted tattoos into beautiful new artwork. Our experts specialize in creative solutions that effectively cover existing ink while creating stunning new designs.",
    features: [
      "Free cover-up consultation and assessment",
      "Custom design solutions for your specific needs",
      "Advanced techniques for maximum coverage",
      "Color correction and scar tissue work",
      "Multiple session planning when needed"
    ],
    pricing: {
      consultation: "Free",
      hourly: "$180-280/hour",
      minimum: "$150",
      deposit: "$150 or 25% of estimate"
    },
    duration: "2-6 hours per session",
    popular: false,
    image: "/assets/services/cover-up.jpg"
  },
  {
    id: 3,
    title: "Small Tattoos",
    description: "Perfect for first-time clients or meaningful small pieces. Our artists create detailed, professional work even in compact spaces with the same quality and care as larger pieces.",
    features: [
      "Ideal for first-time clients",
      "Detailed work in small spaces",
      "Quick session times",
      "Same professional quality",
      "Perfect for meaningful symbols or dates"
    ],
    pricing: {
      consultation: "Free",
      flatRate: "$100-300",
      minimum: "$100",
      deposit: "$50 or 50% of estimate"
    },
    duration: "30 minutes - 2 hours",
    popular: false,
    image: "/assets/services/small-tattoo.jpg"
  }
];

const piercingServices = [
  {
    id: 4,
    title: "Body Piercing",
    description: "Professional piercing services performed by experienced piercers using sterile techniques and high-quality jewelry. We offer a wide range of piercing options with proper aftercare guidance.",
    features: [
      "Sterile, professional environment",
      "High-quality, hypoallergenic jewelry",
      "Comprehensive aftercare instructions",
      "Piercing consultations and recommendations",
      "Follow-up care and jewelry changes"
    ],
    pricing: {
      consultation: "Free",
      basicPiercing: "$30-80",
      specialtyPiercing: "$50-120",
      jewelry: "Additional cost"
    },
    duration: "15-30 minutes per piercing",
    popular: false,
    image: "/assets/services/piercing.jpg"
  }
];

const additionalServices = [
  {
    title: "Touch-Up Services",
    description: "Free touch-ups within 6 months for optimal healing",
    price: "Included with tattoo work"
  },
  {
    title: "Piercing Aftercare",
    description: "Professional piercing aftercare and jewelry changes",
    price: "Free for 6 months"
  },
  {
    title: "Consultation Only",
    description: "Design consultation without commitment",
    price: "Free"
  },
  {
    title: "Jewelry Sales",
    description: "High-quality piercing jewelry and replacement parts",
    price: "Starting at $10"
  }
];

const pricingNotes = [
  "Must be 18+ with valid government-issued photo ID (no exceptions)",
  "All artists are Louisiana Department of Health licensed and certified",
  "We follow strict Louisiana health and safety regulations",
  "Comprehensive consent form required before any procedure",
  "All equipment is sterilized per Louisiana state requirements",
  "Deposits are non-refundable but applied to final cost",
  "Prices subject to complexity and artist availability"
];
---

<Layout title={title} description={description}>
  <!-- Hero Section -->
  <section class="services-hero">
    <div class="container">
      <div class="hero-content">
        <span class="badge">Our Services</span>
        <h1 class="hero-title shine">Services & Pricing</h1>
        <p class="hero-description">
          Premium tattoo and piercing services with transparent pricing. Custom designs, professional piercings,
          and comprehensive aftercare to ensure your perfect experience at Cursed Ink Society LLC.
        </p>
      </div>
    </div>
  </section>

  <!-- Tattoo Services -->
  <section class="main-services">
    <div class="container">
      <h2 class="section-title">Tattoo Services</h2>
      <div class="services-grid">
        {tattooServices.map((service) => (
          <article class="service-card" data-service-id={service.id}>
            {service.popular && <div class="popular-badge">Most Popular</div>}

            <div class="service-image-container">
              <img
                src={service.image}
                alt={service.title}
                class="service-image"
                loading="lazy"
                width="400"
                height="300"
              />
            </div>

            <div class="service-content">
              <h2 class="service-title">{service.title}</h2>
              <p class="service-description">{service.description}</p>

              <div class="service-features">
                <h3>What's Included</h3>
                <ul class="features-list">
                  {service.features.map((feature) => (
                    <li class="feature-item">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
                      </svg>
                      {feature}
                    </li>
                  ))}
                </ul>
              </div>

              <div class="service-pricing">
                <h3>Pricing</h3>
                <div class="pricing-details">
                  <div class="pricing-item">
                    <span class="pricing-label">Consultation:</span>
                    <span class="pricing-value">{service.pricing.consultation}</span>
                  </div>
                  {service.pricing.hourly && (
                    <div class="pricing-item">
                      <span class="pricing-label">Hourly Rate:</span>
                      <span class="pricing-value">{service.pricing.hourly}</span>
                    </div>
                  )}
                  {service.pricing.flatRate && (
                    <div class="pricing-item">
                      <span class="pricing-label">Flat Rate:</span>
                      <span class="pricing-value">{service.pricing.flatRate}</span>
                    </div>
                  )}
                  <div class="pricing-item">
                    <span class="pricing-label">Minimum:</span>
                    <span class="pricing-value">{service.pricing.minimum}</span>
                  </div>
                  <div class="pricing-item">
                    <span class="pricing-label">Deposit:</span>
                    <span class="pricing-value">{service.pricing.deposit}</span>
                  </div>
                  <div class="pricing-item">
                    <span class="pricing-label">Duration:</span>
                    <span class="pricing-value">{service.duration}</span>
                  </div>
                </div>
              </div>

              <div class="service-actions">
                <a href="/contact" class="btn btn--primary">Get Quote</a>
                <a href="/gallery" class="btn btn--outline">View Examples</a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Piercing Services -->
  <section class="piercing-services">
    <div class="container">
      <h2 class="section-title">Piercing Services</h2>
      <div class="services-grid">
        {piercingServices.map((service) => (
          <article class="service-card" data-service-id={service.id}>
            {service.popular && <div class="popular-badge">Most Popular</div>}

            <div class="service-image-container">
              <img
                src={service.image}
                alt={service.title}
                class="service-image"
                loading="lazy"
                width="400"
                height="300"
              />
            </div>

            <div class="service-content">
              <h2 class="service-title">{service.title}</h2>
              <p class="service-description">{service.description}</p>

              <div class="service-features">
                <h3>What's Included</h3>
                <ul class="features-list">
                  {service.features.map((feature) => (
                    <li class="feature-item">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
                      </svg>
                      {feature}
                    </li>
                  ))}
                </ul>
              </div>

              <div class="service-pricing">
                <h3>Pricing</h3>
                <div class="pricing-details">
                  <div class="pricing-item">
                    <span class="pricing-label">Consultation:</span>
                    <span class="pricing-value">{service.pricing.consultation}</span>
                  </div>
                  <div class="pricing-item">
                    <span class="pricing-label">Basic Piercing:</span>
                    <span class="pricing-value">{service.pricing.basicPiercing}</span>
                  </div>
                  <div class="pricing-item">
                    <span class="pricing-label">Specialty Piercing:</span>
                    <span class="pricing-value">{service.pricing.specialtyPiercing}</span>
                  </div>
                  <div class="pricing-item">
                    <span class="pricing-label">Jewelry:</span>
                    <span class="pricing-value">{service.pricing.jewelry}</span>
                  </div>
                  <div class="pricing-item">
                    <span class="pricing-label">Duration:</span>
                    <span class="pricing-value">{service.duration}</span>
                  </div>
                </div>
              </div>

              <div class="service-actions">
                <a href="/contact" class="btn btn--primary">Get Quote</a>
                <a href="/contact" class="btn btn--outline">Learn More</a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Additional Services -->
  <section class="additional-services">
    <div class="container">
      <h2 class="section-title">Additional Services</h2>
      <div class="additional-services-grid">
        {additionalServices.map((service) => (
          <div class="additional-service-card">
            <h3 class="additional-service-title">{service.title}</h3>
            <p class="additional-service-description">{service.description}</p>
            <span class="additional-service-price">{service.price}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Pricing Information - Redesigned -->
  <section class="pricing-info">
    <div class="container">
      <div class="pricing-showcase">
        <div class="pricing-header">
          <h2 class="section-title">Investment & Terms</h2>
          <p class="pricing-subtitle">Transparent pricing for exceptional artistry</p>
        </div>

        <div class="pricing-grid">
          <!-- Pricing Philosophy Card -->
          <div class="pricing-philosophy-card">
            <div class="philosophy-icon">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
              </svg>
            </div>
            <h3>Quality First</h3>
            <p>We believe in transparent, value-based pricing that reflects the skill, time, and artistry that goes into every piece.</p>
          </div>

          <!-- Payment Methods -->
          <div class="payment-methods-card">
            <div class="card-header">
              <div class="payment-icon">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M20 4H4c-1.11 0-1.99.89-1.99 2L2 18c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V6c0-1.11-.89-2-2-2z"/>
                </svg>
              </div>
              <h3>Payment Options</h3>
            </div>
            <div class="payment-grid">
              <div class="payment-item">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M11.8 10.9c-2.27-.59-3-1.2-3-2.15 0-1.09 1.01-1.85 2.7-1.85 1.78 0 2.44.85 2.5 2.1h2.21c-.07-1.72-1.12-3.3-3.21-3.81V3h-3v2.16c-1.94.42-3.5 1.68-3.5 3.61 0 2.31 1.91 3.46 4.7 4.13 2.5.6 3 1.48 3 2.41 0 .69-.49 1.79-2.7 1.79-2.06 0-2.87-.92-2.98-2.1h-2.2c.12 2.19 1.76 3.42 3.68 3.83V21h3v-2.15c1.95-.37 3.5-1.5 3.5-3.55 0-2.84-2.43-3.81-4.7-4.4z"/>
                </svg>
                <span>Cash Only</span>
              </div>
              <div class="payment-item">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M20 4H4c-1.11 0-1.99.89-1.99 2L2 18c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V6c0-1.11-.89-2-2-2z"/>
                </svg>
                <span>Major Credit Cards</span>
              </div>
            </div>
          </div>

          <!-- Important Notes -->
          <div class="pricing-notes-card">
            <div class="card-header">
              <div class="notes-icon">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"/>
                </svg>
              </div>
              <h3>Important Details</h3>
            </div>
            <div class="notes-list">
              {pricingNotes.map((note, index) => (
                <div class="note-item" style={`animation-delay: ${index * 0.1}s`}>
                  <div class="note-bullet"></div>
                  <span>{note}</span>
                </div>
              ))}
            </div>
          </div>
        </div>

        <!-- Pricing Summary Banner -->
        <div class="pricing-summary-banner">
          <div class="summary-content">
            <div class="summary-text">
              <h3>Starting Investments</h3>
              <div class="price-ranges">
                <div class="price-range">
                  <span class="service-type">Tattoos</span>
                  <span class="price">$100 - $280/hr</span>
                </div>
                <div class="price-range">
                  <span class="service-type">Piercings</span>
                  <span class="price">$30 - $120</span>
                </div>
              </div>
            </div>
            <div class="summary-cta">
              <p>Ready to discuss your vision?</p>
              <a href="/contact" class="btn btn--accent">Get In Touch</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Legal Compliance Section -->
  <section class="legal-compliance">
    <div class="container">
      <div class="compliance-content">
        <div class="compliance-header">
          <div class="compliance-badge">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12,1L3,5V11C3,16.55 6.84,21.74 12,23C17.16,21.74 21,16.55 21,11V5L12,1M10,17L6,13L7.41,11.59L10,14.17L16.59,7.58L18,9L10,17Z"/>
            </svg>
            <span>Louisiana State Licensed</span>
          </div>
          <h2 class="section-title">Health & Safety Compliance</h2>
          <p class="compliance-subtitle">
            Cursed Ink Society LLC operates in full compliance with Louisiana Department of Health regulations 
            and maintains the highest standards of safety and professionalism.
          </p>
        </div>

        <div class="compliance-grid">
          <div class="compliance-card">
            <div class="compliance-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                <path d="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20Z"/>
              </svg>
            </div>
            <h3>Licensed & Certified</h3>
            <ul class="compliance-list">
              <li>Louisiana Department of Health establishment permit</li>
              <li>Individual artist permits for all tattooers</li>
              <li>Annual bloodborne pathogen certification</li>
              <li>Regular health department inspections</li>
            </ul>
          </div>

          <div class="compliance-card">
            <div class="compliance-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12,2A3,3 0 0,1 15,5V7H19A2,2 0 0,1 21,9V19A2,2 0 0,1 19,21H5A2,2 0 0,1 3,19V9A2,2 0 0,1 5,7H9V5A3,3 0 0,1 12,2M12,4A1,1 0 0,0 11,5V7H13V5A1,1 0 0,0 12,4Z"/>
              </svg>
            </div>
            <h3>Strict Age Requirements</h3>
            <ul class="compliance-list">
              <li>Must be 18+ years old (no exceptions)</li>
              <li>Valid government-issued photo ID required</li>
              <li>No parental consent accepted for minors</li>
              <li>ID verification before all procedures</li>
            </ul>
          </div>

          <div class="compliance-card">
            <div class="compliance-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                <path d="M19,3H14.82C14.4,1.84 13.3,1 12,1C10.7,1 9.6,1.84 9.18,3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5A2,2 0 0,0 19,3M12,3A1,1 0 0,1 13,4A1,1 0 0,1 12,5A1,1 0 0,1 11,4A1,1 0 0,1 12,3Z"/>
              </svg>
            </div>
            <h3>Comprehensive Documentation</h3>
            <ul class="compliance-list">
              <li>Detailed consent forms for all clients</li>
              <li>Medical history and risk assessment</li>
              <li>Aftercare instructions provided</li>
              <li>Records maintained per state requirements</li>
            </ul>
          </div>

          <div class="compliance-card">
            <div class="compliance-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M11,16.5L6.5,12L7.91,10.59L11,13.67L16.59,8.09L18,9.5L11,16.5Z"/>
              </svg>
            </div>
            <h3>Sterilization Standards</h3>
            <ul class="compliance-list">
              <li>Autoclave sterilization for all reusable equipment</li>
              <li>Monthly spore testing by independent laboratory</li>
              <li>Single-use needles and sterile supplies only</li>
              <li>Hospital-grade disinfectants and cleaning protocols</li>
            </ul>
          </div>
        </div>

        <div class="compliance-footer">
          <div class="compliance-statement">
            <p>
              <strong>Legal Disclaimer:</strong> Cursed Ink Society LLC is a Louisiana Department of Health 
              licensed body art establishment operating under Louisiana Administrative Code (LAC) Title 48, 
              Part V, Chapter 85. All artists maintain current individual permits and bloodborne pathogen 
              certifications. We strictly adhere to all state health and safety regulations to ensure the 
              highest level of client protection and service quality.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="services-cta">
    <div class="container">
      <div class="cta-content">
        <h2>Let's Create Something Amazing</h2>
        <p>Ready to transform your vision into reality? Get in touch with our team to discuss your next tattoo or piercing project.</p>
        <div class="cta-actions">
          <a href="/contact" class="btn btn--primary btn--large">Contact Our Team</a>
          <a href="/gallery" class="btn btn--outline btn--large">View Our Work</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Services Hero */
  .services-hero {
    padding: 8rem 0 4rem;
    text-align: center;
    background: 
      radial-gradient(1000px 600px at 50% 20%, rgba(255, 60, 43, 0.03) 0%, transparent 60%);
  }

  .hero-content {
    max-width: 700px;
    margin: 0 auto;
  }

  .hero-title {
    font-size: clamp(3rem, 6vw, 4.5rem);
    margin: 1rem 0 1.5rem;
    line-height: 1.1;
  }

  .hero-description {
    font-size: 1.2rem;
    line-height: 1.6;
    opacity: 0.9;
    margin: 0;
  }

  /* Main Services */
  .main-services {
    padding: 4rem 0;
  }

  /* Piercing Services */
  .piercing-services {
    padding: 4rem 0;
    background: var(--bg-glass);
    border-top: var(--border-glass);
  }

  .services-grid {
    display: grid;
    gap: 3rem;
  }

  .service-card {
    display: grid;
    grid-template-columns: 400px 1fr;
    gap: 3rem;
    background: var(--bg-glass);
    border: var(--border-glass);
    border-radius: 24px;
    overflow: hidden;
    backdrop-filter: blur(10px);
    transition: var(--transition-smooth);
    position: relative;
    align-items: start;
  }

  .service-card:hover {
    transform: translateY(-4px);
    box-shadow: 
      0 20px 40px rgba(0, 0, 0, 0.2),
      0 0 30px rgba(255, 60, 43, 0.1);
    border-color: rgba(255, 60, 43, 0.2);
  }

  .popular-badge {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    background: linear-gradient(45deg, var(--accent0), var(--accent1));
    color: var(--bg0);
    padding: 0.5rem 1rem;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    z-index: 10;
    box-shadow: 0 4px 12px rgba(255, 60, 43, 0.3);
  }

  .service-image-container {
    position: relative;
    height: 100%;
    min-height: 300px;
  }

  .service-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .service-content {
    padding: 2.5rem 2.5rem 2.5rem 0;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .service-title {
    font-size: 1.8rem;
    margin: 0;
    color: var(--ink);
    text-shadow: var(--glow-subtle);
  }

  .service-description {
    font-size: 1rem;
    line-height: 1.6;
    opacity: 0.9;
    margin: 0;
  }

  .service-features h3,
  .service-pricing h3 {
    font-size: 1.2rem;
    margin: 0 0 1rem;
    color: var(--accent0);
    text-shadow: var(--glow-subtle);
  }

  .features-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .feature-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.95rem;
  }

  .feature-item svg {
    color: var(--accent0);
    flex-shrink: 0;
  }

  .pricing-details {
    display: grid;
    gap: 0.75rem;
  }

  .pricing-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.5rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .pricing-item:last-child {
    border-bottom: none;
  }

  .pricing-label {
    font-size: 0.9rem;
    opacity: 0.8;
  }

  .pricing-value {
    font-weight: 600;
    color: var(--accent0);
  }

  .service-actions {
    display: flex;
    gap: 1rem;
    margin-top: auto;
  }

  .service-actions .btn {
    flex: 1;
    text-align: center;
  }

  /* Additional Services */
  .additional-services {
    padding: 4rem 0;
    background: var(--bg-glass);
    border-top: var(--border-glass);
  }

  .section-title {
