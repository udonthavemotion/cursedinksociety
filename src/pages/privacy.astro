---
import Layout from '../layouts/Layout.astro';

const title = "Privacy Policy — Cursed Ink Society";
const description = "Privacy policy for Cursed Ink Society tattoo studio in Houma, Louisiana. Learn how we collect, use, and protect your personal and health information in compliance with Louisiana state laws.";
---

<Layout title={title} description={description}>
  <section class="legal-page">
    <div class="container">
      <div class="legal-content">
        <header class="legal-header">
          <h1 class="legal-title">Privacy Policy</h1>
          <p class="legal-subtitle">Effective Date: January 1, 2025</p>
          <p class="legal-last-updated">Last Updated: January 1, 2025</p>
        </header>

        <div class="legal-body">
          <section class="legal-section">
            <h2 class="section-heading">Introduction</h2>
            <p>This Privacy Policy outlines how Cursed Ink Society LLC ("we," "us," "our," or "Studio") collects, uses, maintains, and discloses information collected from users ("you," "your," or "User") of our website located at cursedinksociety.com (the "Site") and all services provided by Cursed Ink Society. This policy applies to the Site and all products and services offered by Cursed Ink Society. We are committed to protecting your privacy and handling your data in an open and transparent manner.</p>
            <p>By using our website or services, you agree to the collection and use of information in accordance with this Privacy Policy.</p>
          </section>

          <section class="legal-section">
            <h2 class="section-heading">Information We Collect</h2>
            
            <h3 class="subsection-heading">Personal Information</h3>
            <p>We may collect the following types of personal information when you interact with our website or services:</p>
            <ul class="legal-list">
              <li><strong>Contact Information:</strong> Name, email address, phone number, and physical address</li>
              <li><strong>Appointment Information:</strong> Preferred appointment dates and times, tattoo consultation details</li>
              <li><strong>Design Preferences:</strong> Tattoo style preferences, size specifications, body placement preferences</li>
              <li><strong>Health Information:</strong> Medical history, allergies, medications, pregnancy status, and other health-related information necessary for safe tattoo services</li>
              <li><strong>Payment Information:</strong> Credit card details, billing address, and payment history (processed securely through third-party payment processors)</li>
              <li><strong>Age Verification:</strong> Date of birth to verify you are 18 years or older, as required by Louisiana law</li>
            </ul>

            <h3 class="subsection-heading">Non-Personal Information</h3>
            <p>We may collect non-identifiable information whenever you interact with our Site, including:</p>
            <ul class="legal-list">
              <li>IP addresses and browser types</li>
              <li>Operating system and device information</li>
              <li>Referring URLs and website usage patterns</li>
              <li>Pages viewed and time spent on our Site</li>
              <li>Search terms used to find our Site</li>
            </ul>
            <p>We use analytics tools like Google Analytics to collect this information for website improvement and statistical analysis. This data does not personally identify individual users.</p>

            <h3 class="subsection-heading">How Information is Collected</h3>
            <p>We collect information through various methods:</p>
            <ul class="legal-list">
              <li><strong>Website Forms:</strong> Contact forms, booking forms, consultation request forms</li>
              <li><strong>Direct Communication:</strong> Email correspondence, phone conversations, in-person consultations</li>
              <li><strong>Automated Technologies:</strong> Cookies, web beacons, and similar tracking technologies</li>
              <li><strong>Consent Forms:</strong> Required health and consent documentation for tattoo services</li>
            </ul>
          </section>

          <section class="legal-section">
            <h2 class="section-heading">How We Use Your Information</h2>
            <p>We use the collected information for the following purposes:</p>
            <ul class="legal-list">
              <li>To schedule and manage tattoo appointments and consultations</li>
              <li>To provide safe and professional tattoo services</li>
              <li>To respond to your inquiries and customer service requests</li>
              <li>To process payments and manage financial transactions</li>
              <li>To send appointment reminders, confirmations, and aftercare instructions</li>
              <li>To assess suitability for tattoo services based on health information</li>
              <li>To comply with Louisiana health department regulations for commercial body art</li>
              <li>To personalize your experience and improve our services</li>
              <li>To maintain client records as required by state regulations</li>
              <li>For internal record-keeping and administrative purposes</li>
            </ul>
            <p>If you choose to receive marketing communications, you will always have the option to opt-out by following the unsubscribe instructions in our emails or contacting us directly.</p>
          </section>

          <section class="legal-section">
            <h2 class="section-heading">How We Share Your Information</h2>
            
            <h3 class="subsection-heading">Third-Party Service Providers</h3>
            <p>We may share your information with trusted third-party vendors who assist us in operating our business, including:</p>
            <ul class="legal-list">
              <li><strong>Payment Processors:</strong> To securely process credit card and payment transactions</li>
              <li><strong>Website Hosting Services:</strong> To maintain and operate our website</li>
              <li><strong>Email Marketing Providers:</strong> To send appointment reminders and communications (if you opt-in)</li>
              <li><strong>Analytics Services:</strong> To analyze website usage and improve our services</li>
              <li><strong>Appointment Scheduling Platforms:</strong> To manage bookings and consultations</li>
            </ul>
            <p>These third parties are contractually obligated to protect the confidentiality and security of your data and may only use it for the specific purposes we authorize.</p>

            <h3 class="subsection-heading">Legal Requirements</h3>
            <p>We may disclose your personal information if required by law, including:</p>
            <ul class="legal-list">
              <li>In response to a subpoena, court order, or other legal process</li>
              <li>To comply with Louisiana health department regulations and inspections</li>
              <li>To protect the rights, property, or safety of our business, clients, or the public</li>
              <li>To respond to emergency situations or medical emergencies</li>
            </ul>

            <h3 class="subsection-heading">Business Transfers</h3>
            <p>In the event of a merger, acquisition, or sale of our business assets, your information may be transferred to the new owner, subject to the same privacy protections outlined in this policy.</p>

            <h3 class="subsection-heading">We Do Not Sell Your Information</h3>
            <p>We do not sell, lease, rent, or otherwise distribute your personal information to third parties for their marketing purposes.</p>
          </section>

          <section class="legal-section">
            <h2 class="section-heading">Data Security</h2>
            <p>We implement appropriate security measures to protect your personal information against unauthorized access, alteration, disclosure, or destruction:</p>
            <ul class="legal-list">
              <li><strong>Secure Servers:</strong> Our website uses SSL/TLS encryption to protect data transmission</li>
              <li><strong>Access Controls:</strong> Limited access to personal information on a need-to-know basis</li>
              <li><strong>Physical Security:</strong> Secure storage of physical client records and consent forms</li>
              <li><strong>Regular Security Reviews:</strong> Periodic assessment of our security practices and procedures</li>
              <li><strong>Staff Training:</strong> All team members are trained on privacy and data protection practices</li>
            </ul>
            <p>While we strive to protect your personal information, no method of transmission over the internet or electronic storage is 100% secure. We cannot guarantee absolute security but are committed to implementing industry-standard protections.</p>
          </section>

          <section class="legal-section">
            <h2 class="section-heading">Health Information and Consent</h2>
            <p>As a professional tattoo studio, we collect sensitive health information to ensure your safety and provide appropriate services:</p>
            <ul class="legal-list">
              <li><strong>Explicit Consent:</strong> Health information is collected only with your explicit written consent through our intake forms</li>
              <li><strong>Purpose Limitation:</strong> Health data is used solely for tattoo safety assessments, preventing adverse reactions, and emergency response</li>
              <li><strong>Secure Storage:</strong> Health information is stored securely and accessed only by authorized personnel</li>
              <li><strong>Retention Period:</strong> Health records are maintained for a minimum of 7 years as required by Louisiana regulations</li>
              <li><strong>Emergency Access:</strong> Health information may be shared with medical professionals in case of emergency</li>
            </ul>
            <p>Before any tattoo service, you will be required to complete a comprehensive health questionnaire and consent form. This information helps us provide safe services and comply with Louisiana Department of Health regulations for commercial body art facilities.</p>
          </section>

          <section class="legal-section">
            <h2 class="section-heading">Your Rights and Choices</h2>
            <p>You have the following rights regarding your personal information:</p>
            <ul class="legal-list">
              <li><strong>Access:</strong> You may request to review the personal information we have collected about you</li>
              <li><strong>Correction:</strong> You may request corrections to inaccurate or incomplete personal information</li>
              <li><strong>Deletion:</strong> You may request deletion of your personal information, subject to legal retention requirements</li>
              <li><strong>Opt-Out:</strong> You may opt-out of marketing communications at any time</li>
              <li><strong>Cookie Management:</strong> You can control cookie settings through your browser preferences</li>
            </ul>
            <p>To exercise these rights, please contact us using the information provided in the "Contact Us" section below. We will respond to your request within 30 days.</p>
          </section>

          <section class="legal-section">
            <h2 class="section-heading">Children's Privacy</h2>
            <p>Our website and services are not intended for individuals under the age of 18. In accordance with Louisiana law (LSA R.S. 14:93.2), tattoo services are restricted to adults 18 years of age or older. We do not knowingly collect personal information from minors under 18.</p>
            <p>If we discover that we have inadvertently collected personal information from someone under 18, we will promptly delete that information from our records. If you believe we have collected information from a minor, please contact us immediately.</p>
          </section>

          <section class="legal-section">
            <h2 class="section-heading">Data Breach Notification</h2>
            <p>In accordance with Louisiana Revised Statute 51:3074, if we experience a data breach that compromises your personal information, we will:</p>
            <ul class="legal-list">
              <li>Notify affected Louisiana residents without unreasonable delay</li>
              <li>Provide details about the nature of the breach and information involved</li>
              <li>Explain steps being taken to address the breach and prevent future incidents</li>
              <li>Offer guidance on steps you can take to protect yourself</li>
              <li>Provide contact information for questions and assistance</li>
            </ul>
            <p>Notifications will be made through the most expedient means possible, which may include email, postal mail, telephone, or prominent website posting, depending on the circumstances.</p>
          </section>

          <section class="legal-section">
            <h2 class="section-heading">Links to Other Websites</h2>
            <p>Our website may contain links to third-party websites, including social media platforms, supplier websites, or other resources. This Privacy Policy applies only to information collected by our website.</p>
            <p>We are not responsible for the privacy practices or content of external websites. We encourage you to review the privacy policies of any third-party sites you visit, as their data handling practices may differ from ours.</p>
          </section>

          <section class="legal-section">
            <h2 class="section-heading">Changes to This Privacy Policy</h2>
            <p>We may update this Privacy Policy periodically to reflect changes in our practices, services, legal requirements, or for other operational, legal, or regulatory reasons. When we make changes, we will:</p>
            <ul class="legal-list">
              <li>Post the updated policy on our website with a revised "Last Updated" date</li>
              <li>Notify users of significant changes via email or prominent website notice</li>
              <li>Maintain previous versions for reference when legally required</li>
            </ul>
            <p>Your continued use of our website and services after any changes constitutes your acceptance of the updated Privacy Policy. We encourage you to review this policy periodically to stay informed about how we protect your information.</p>
          </section>

          <section class="legal-section">
            <h2 class="section-heading">Contact Us</h2>
            <p>If you have any questions, concerns, or requests regarding this Privacy Policy or our data practices, please contact us:</p>
            <div class="contact-info">
              <p><strong>Cursed Ink Society LLC</strong></p>
              <p>488 Corporate Dr, STE 11<br>Houma, LA 70360</p>
              <p>Phone: <a href="tel:+19852082334" class="contact-link">(985) 208-2334</a></p>
              <p>Email: <a href="mailto:info@cursedinksociety.com" class="contact-link">info@cursedinksociety.com</a></p>
              <p>Hours: Mon-Thu 1PM-8PM, Fri-Sat 1PM-10PM, Sun by Appointment</p>
            </div>
            <p>We are committed to addressing your privacy concerns promptly and will respond to your inquiries within 30 business days.</p>
          </section>

          <section class="legal-section">
            <h2 class="section-heading">Louisiana-Specific Information</h2>
            <p>As a Louisiana-based business, we comply with all applicable state laws and regulations, including:</p>
            <ul class="legal-list">
              <li>Louisiana Revised Statute 51:3074 (Data Breach Notification Law)</li>
              <li>Louisiana Revised Statutes 51:1951-1955 (Personal Online Account Privacy Protection Act)</li>
              <li>Louisiana Department of Health regulations for commercial body art (Title 51, Part XXVIII)</li>
              <li>Louisiana age verification requirements for tattoo services (LSA R.S. 14:93.2)</li>
            </ul>
            <p>Our facility and all artists are properly registered and permitted with the Louisiana Department of Health as required by state law. We maintain all required client records and consent documentation in accordance with state regulations.</p>
          </section>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .legal-page {
    padding: 6rem 0 4rem;
    background: 
      radial-gradient(ellipse at 20% 30%, rgba(255, 60, 43, 0.08) 0%, transparent 50%),
      radial-gradient(ellipse at 80% 70%, rgba(255, 122, 24, 0.06) 0%, transparent 50%),
      linear-gradient(135deg, #0b0b0d 0%, #1a1a1f 50%, #0b0b0d 100%);
    min-height: 100vh;
  }

  .legal-content {
    max-width: 800px;
    margin: 0 auto;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 3rem;
    backdrop-filter: blur(10px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
  }

  .legal-header {
    text-align: center;
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .legal-title {
    font-family: 'Cinzel', serif;
    font-size: clamp(2.5rem, 4vw, 3.5rem);
    font-weight: 700;
    color: var(--ink);
    margin-bottom: 1rem;
    text-shadow: 0 0 20px rgba(220, 20, 60, 0.3);
  }

  .legal-subtitle {
    font-size: 1.1rem;
    color: var(--accent0);
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .legal-last-updated {
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.7);
    font-style: italic;
  }

  .legal-body {
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.9);
  }

  .legal-section {
    margin-bottom: 3rem;
  }

  .legal-section:last-child {
    margin-bottom: 0;
  }

  .section-heading {
    font-family: 'Cinzel', serif;
    font-size: 1.8rem;
    font-weight: 600;
    color: var(--accent0);
    margin-bottom: 1.5rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid rgba(220, 20, 60, 0.3);
  }

  .subsection-heading {
    font-family: 'Cinzel', serif;
    font-size: 1.3rem;
    font-weight: 600;
    color: var(--gold);
    margin: 2rem 0 1rem 0;
  }

  .legal-section p {
    margin-bottom: 1.2rem;
    font-size: 1rem;
    text-align: justify;
  }

  .legal-list {
    margin: 1.5rem 0;
    padding-left: 1.5rem;
  }

  .legal-list li {
    margin-bottom: 0.8rem;
    position: relative;
  }

  .legal-list li::marker {
    color: var(--accent0);
  }

  .legal-list li strong {
    color: var(--gold);
    font-weight: 600;
  }

  .contact-info {
    background: rgba(220, 20, 60, 0.05);
    border: 1px solid rgba(220, 20, 60, 0.2);
    border-radius: 8px;
    padding: 1.5rem;
    margin: 1.5rem 0;
  }

  .contact-info p {
    margin-bottom: 0.5rem;
  }

  .contact-info p:last-child {
    margin-bottom: 0;
  }

  .contact-link {
    color: var(--accent0);
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .contact-link:hover,
  .contact-link:focus {
    color: var(--gold);
    text-decoration: underline;
  }

  /* Mobile Responsiveness */
  @media (max-width: 768px) {
    .legal-page {
      padding: 4rem 0 2rem;
    }

    .legal-content {
      padding: 2rem 1.5rem;
      margin: 0 1rem;
    }

    .legal-title {
      font-size: 2.2rem;
    }

    .section-heading {
      font-size: 1.5rem;
    }

    .subsection-heading {
      font-size: 1.2rem;
    }

    .legal-section p {
      text-align: left;
    }

    .legal-list {
      padding-left: 1.2rem;
    }

    .contact-info {
      padding: 1rem;
    }
  }

  @media (max-width: 480px) {
    .legal-content {
      padding: 1.5rem 1rem;
    }

    .legal-title {
      font-size: 1.8rem;
    }

    .section-heading {
      font-size: 1.3rem;
    }
  }

  /* Accessibility Enhancements */
  @media (prefers-reduced-motion: reduce) {
    * {
      transition: none !important;
      animation: none !important;
    }
  }

  /* High Contrast Mode Support */
  @media (prefers-contrast: high) {
    .legal-content {
      background: rgba(0, 0, 0, 0.9);
      border: 2px solid #ffffff;
    }

    .legal-title,
    .section-heading {
      color: #ffffff;
    }

    .legal-body {
      color: #ffffff;
    }
  }

  /* Focus Styles for Accessibility */
  .contact-link:focus-visible {
    outline: 2px solid var(--accent0);
    outline-offset: 2px;
    border-radius: 2px;
  }
</style>
