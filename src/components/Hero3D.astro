---
export interface Props {
  showPreviewButton?: boolean;
  previewUrl?: string;
}

const { 
  showPreviewButton = false, 
  previewUrl = "/" 
} = Astro.props;
---
<style>
/* Architectural Hero - Professional Lighting */
.hero-fallback {
  background: 
    var(--spotlight),
    radial-gradient(ellipse 1000px 600px at 50% 20%, rgba(255, 255, 255, 0.04) 0%, transparent 60%),
    var(--marble-base),
    var(--stone-texture);
  min-height: 100vh;
  display: grid;
  place-items: center;
  text-align: center;
}

/* Centerpiece logo design */
.logo-centerpiece {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  padding: 2rem 0;
}

.logo-container {
  position: relative;
  display: inline-block;
  margin-bottom: 4rem;
  perspective: 1200px;
}

.logo {
  transition: transform 0.15s ease-out;
  transform-style: preserve-3d;
  will-change: transform;
  filter: drop-shadow(0 0 60px rgba(255, 255, 255, 0.8)) 
          drop-shadow(0 0 120px rgba(255, 255, 255, 0.5))
          drop-shadow(0 0 180px rgba(255, 255, 255, 0.3))
          drop-shadow(0 0 240px rgba(255, 255, 255, 0.2));
  height: 240px;
  width: auto;
  position: relative;
  z-index: 10;
}

/* Architectural Rim Lighting - Mirror-Inspired */
.logo-container::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 340px;
  height: 340px;
  transform: translate(-50%, -50%);
  border: 2px solid rgba(255, 255, 255, 0.4);
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.05) 0%, transparent 70%);
  z-index: 1;
  animation: rimPulse 5s ease-in-out infinite;
  box-shadow: var(--rim-glow);
}

.logo-container::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 420px;
  height: 420px;
  transform: translate(-50%, -50%);
  background: 
    conic-gradient(from 0deg at 50% 50%, 
      transparent 0deg, 
      rgba(255, 255, 255, 0.08) 60deg, 
      transparent 120deg, 
      rgba(255, 255, 255, 0.04) 180deg, 
      transparent 240deg, 
      rgba(255, 255, 255, 0.08) 300deg, 
      transparent 360deg);
  border-radius: 50%;
  z-index: 0;
  animation: architecturalRotate 15s linear infinite;
  opacity: 0.7;
}

@keyframes rimPulse {
  0%, 100% { 
    opacity: 0.6;
    transform: translate(-50%, -50%) scale(1);
    box-shadow: var(--rim-glow);
  }
  50% { 
    opacity: 0.9;
    transform: translate(-50%, -50%) scale(1.03);
    box-shadow: var(--rim-glow), 0 0 60px rgba(255, 255, 255, 0.4);
  }
}

@keyframes architecturalRotate {
  from { transform: translate(-50%, -50%) rotate(0deg); }
  to { transform: translate(-50%, -50%) rotate(360deg); }
}

/* Subtle brand identifier */
.brand-mark {
  font-size: 0.9rem;
  letter-spacing: 0.3em;
  text-transform: uppercase;
  font-weight: 300;
  margin-bottom: 1.5rem;
  opacity: 0.8;
  color: var(--ink);
}

/* Minimal tagline */
.tagline {
  font-size: 1.1rem;
  font-weight: 300;
  letter-spacing: 0.05em;
  margin-bottom: 3rem;
  opacity: 0.9;
  max-width: 400px;
  line-height: 1.5;
}

/* Redesigned social links - more minimal */
.social-minimal {
  display: flex;
  gap: 3rem;
  justify-content: center;
  align-items: center;
}

.social-link {
  display: flex;
  align-items: center;
  gap: 0.8rem;
  padding: 0.8rem 1.2rem;
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 50px;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  font-size: 0.9rem;
  font-weight: 400;
  letter-spacing: 0.02em;
  backdrop-filter: blur(10px);
  position: relative;
  overflow: hidden;
}

.social-link::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.1), transparent);
  transition: left 0.5s ease;
}

.social-link:hover::before {
  left: 100%;
}

.social-link:hover {
  transform: translateY(-2px);
  background: rgba(255, 255, 255, 0.06);
  border-color: rgba(255, 60, 43, 0.3);
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3),
              0 0 20px rgba(255, 60, 43, 0.2);
}

.social-link svg {
  width: 18px;
  height: 18px;
  opacity: 0.8;
  transition: opacity 0.3s ease;
}

.social-link:hover svg {
  opacity: 1;
}

/* Enhanced glow effects */
@keyframes pulseGlow {
  0%, 100% { 
    filter: drop-shadow(0 0 40px rgba(255, 60, 43, 0.7)) 
            drop-shadow(0 0 80px rgba(255, 60, 43, 0.4))
            drop-shadow(0 0 120px rgba(255, 60, 43, 0.2));
  }
  50% { 
    filter: drop-shadow(0 0 60px rgba(255, 60, 43, 0.9)) 
            drop-shadow(0 0 120px rgba(255, 60, 43, 0.6))
            drop-shadow(0 0 180px rgba(255, 60, 43, 0.3));
  }
}

@keyframes pulseRing {
  0%, 100% { 
    opacity: 0.3;
    transform: translate(-50%, -50%) scale(1);
  }
  50% { 
    opacity: 0.6;
    transform: translate(-50%, -50%) scale(1.05);
  }
}

.logo:hover {
  animation: pulseGlow 3s ease-in-out infinite;
}

/* Countdown styling to be more minimal */
  .countdown-minimal {
    font-size: 1rem;
    font-weight: 300;
    letter-spacing: 0.1em;
    margin-top: 2rem;
    opacity: 0.7;
    font-variant-numeric: tabular-nums;
  }

  /* Preview button styling */
  .btn--preview {
    background: linear-gradient(135deg, rgba(255, 122, 24, 0.15), rgba(255, 60, 43, 0.2));
    border: 1px solid rgba(255, 122, 24, 0.4);
    color: var(--accent1);
    font-size: 0.9rem;
    padding: 0.8rem 1.5rem;
    font-weight: 600;
    text-shadow: 0 0 8px rgba(255, 122, 24, 0.3);
    position: relative;
    overflow: hidden;
  }

  .btn--preview::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 122, 24, 0.2), transparent);
    transition: left 0.6s ease;
  }

  .btn--preview:hover::before {
    left: 100%;
  }

  .btn--preview:hover {
    border-color: rgba(255, 122, 24, 0.6);
    box-shadow: 
      0 12px 24px rgba(0, 0, 0, 0.3),
      0 0 20px rgba(255, 122, 24, 0.4);
    color: var(--accent1);
    text-shadow: 0 0 12px rgba(255, 122, 24, 0.5);
  }
</style>

<section class="hero" id="hero-section">
  <canvas id="ink-canvas" aria-hidden="true" role="presentation"></canvas>
  <div class="content container">
    <div class="logo-centerpiece">
      
      <!-- Centered Logo as Main Focus -->
      <div class="logo-container">
        <img 
          class="logo" 
          id="rotating-logo"
          src="/brand/cursed-ink-logo.png?v=4" 
          alt="Cursed Ink Society - Professional tattoo artistry and mystical designs" 
          loading="eager"
          decoding="async"
        />
      </div>
      
      <!-- Minimal Brand Mark -->
      <div class="brand-mark">Cursed Ink Society</div>
      
      <!-- Subtle Tagline -->
      <p class="tagline">Opening soon - Where artistry meets the mystical</p>

      <!-- Minimal Countdown -->
      <div 
        id="countdown" 
        class="countdown-minimal"
        aria-live="polite"
        aria-label="Launch countdown timer"
      ></div>

      <!-- Conditional Site Preview Access -->
      {showPreviewButton && (
        <div class="temp-preview-access" style="margin: 2rem 0;">
          <a href={previewUrl} class="btn btn--preview" aria-label="Preview full website">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/>
            </svg>
            Preview Full Site
          </a>
          <small style="display: block; margin-top: 0.5rem; opacity: 0.6; font-size: 0.75rem;">
            Developer Access • Full website preview
          </small>
        </div>
      )}

      <!-- Redesigned Social Links -->
      <div class="social-minimal" role="navigation" aria-label="Connect with us">
        <a class="social-link" href="https://instagram.com/cursedinksociety" aria-label="Follow us on Instagram" rel="noopener" target="_blank">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M7 2h10a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5V7a5 5 0 0 1 5-5zm5 5a5 5 0 1 0 .001 10.001A5 5 0 0 0 12 7zm0 2.2a2.8 2.8 0 1 1 0 5.6 2.8 2.8 0 0 1 0-5.6zM18 6.5a1 1 0 1 0 0 2 1 1 0 0 0 0-2z"/>
          </svg>
          Instagram
        </a>
        <a class="social-link" href="https://facebook.com/cursedinksociety" aria-label="Follow us on Facebook" rel="noopener" target="_blank">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
          </svg>
          Facebook
        </a>
      </div>
      
    </div>
  </div>
</section>

<script>
  // Enhanced Three.js background with performance optimizations and error handling
  // Dynamic import for better performance and code splitting

  // Check for reduced motion preference
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  
  // Enhanced performance settings with DPR clamping
  const isMobile = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);
  const isLowEnd = navigator.hardwareConcurrency <= 4 || (navigator as any).deviceMemory <= 4;
  
  // Aggressive DPR clamping to prevent fragment shader overload
  const baseDPR = window.devicePixelRatio || 1;
  let pixelRatio: number;
  if (isMobile || isLowEnd) {
    pixelRatio = Math.min(1.5, baseDPR); // Cap mobile/low-end at 1.5x
  } else {
    pixelRatio = Math.min(2, baseDPR); // Cap desktop at 2x max
  }
  
  // Adaptive particle counts based on device capability
  const particleCount = isLowEnd ? 200 : (isMobile ? 400 : (prefersReducedMotion ? 150 : 800));

  async function initThreeJS(): Promise<void> {
    try {
      const canvas = document.getElementById('ink-canvas') as HTMLCanvasElement;
      if (!canvas) return;

      // WebGL capability check
      const gl = canvas.getContext('webgl') || canvas.getContext('experimental-webgl');
      if (!gl) {
        console.warn('WebGL not supported, falling back to CSS background');
        canvas.style.display = 'none';
        return;
      }

      // Use CDN for more reliable loading with fallback
      let THREE;
      try {
        THREE = await import('https://unpkg.com/three@0.180.0/build/three.module.js');
      } catch (error) {
        console.warn('CDN import failed, trying local fallback:', error);
        THREE = await import('three');
      }

      const renderer = new THREE.WebGLRenderer({ 
        canvas, 
        antialias: false, // Disable AA for better performance - use FXAA in post if needed
        alpha: true,
        powerPreference: isMobile || isLowEnd ? 'low-power' : 'high-performance',
        stencil: false, // Disable stencil buffer
        depth: true,
        logarithmicDepthBuffer: false, // Disable for better performance
        preserveDrawingBuffer: false // Don't preserve for screenshots
      });
      
      const scene = new THREE.Scene();
      const camera = new THREE.PerspectiveCamera(55, 2, 0.1, 100);
      camera.position.set(0, 0, 4.2);

      // Optimized resize handler with debouncing
      let resizeTimeout: number;
      function resize(): void {
        clearTimeout(resizeTimeout);
        resizeTimeout = window.setTimeout(() => {
          const { clientWidth: w, clientHeight: h } = canvas;
          if (canvas.width !== w || canvas.height !== h) {
            renderer.setSize(w, h, false);
            camera.aspect = w / h;
            camera.updateProjectionMatrix();
          }
        }, 16);
      }
      
      resize();
      new ResizeObserver(resize).observe(canvas);
      renderer.setPixelRatio(pixelRatio);

      // Optimized sprite creation
      const createSprite = (color: number, size: number, x: number, y: number, z: number): THREE.Sprite => {
        const material = new THREE.SpriteMaterial({ 
          color, 
          transparent: true, 
          opacity: 0.6, 
          blending: THREE.AdditiveBlending, 
          depthWrite: false 
        });
        const sprite = new THREE.Sprite(material);
        sprite.scale.setScalar(size);
        sprite.position.set(x, y, z);
        return sprite;
      };

      // Add glow sprites only if not reduced motion
      if (!prefersReducedMotion) {
        scene.add(createSprite(0xff5a28, 6, -1.2, 0.6, -1));
        scene.add(createSprite(0xffb45a, 5, 1.2, -0.2, -1.2));
      }

      // Optimized particle system
      const geometry = new THREE.BufferGeometry();
      const positions = new Float32Array(particleCount * 3);
      
      for (let i = 0; i < particleCount; i++) {
        const i3 = i * 3;
        positions[i3] = (Math.random() - 0.5) * 14;
        positions[i3 + 1] = (Math.random() - 0.5) * 8;
        positions[i3 + 2] = -(Math.random() * 6 + 1);
      }
      
      geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
      
      const particleMaterial = new THREE.PointsMaterial({
        color: 0xffe7d0,
        size: isMobile ? 0.015 : 0.02,
        transparent: true,
        opacity: prefersReducedMotion ? 0.4 : 0.85,
        blending: THREE.AdditiveBlending,
        depthWrite: false
      });
      
      const particles = new THREE.Points(geometry, particleMaterial);
      scene.add(particles);

      // Enhanced shader material with error handling and enhanced rotation
      const uniforms = { 
        uTime: { value: 0 }, 
        uTex: { value: null as THREE.Texture | null },
        uReducedMotion: { value: prefersReducedMotion ? 1.0 : 0.0 },
        uMouse: { value: new THREE.Vector2(0.0, 0.0) }
      };

      const shaderMaterial = new THREE.ShaderMaterial({
        uniforms,
        vertexShader: `
          varying vec2 vUv;
          uniform float uTime;
          uniform float uReducedMotion;
          uniform vec2 uMouse;
          void main() {
            vUv = uv;
            vec3 p = position;
            float motionScale = mix(1.0, 0.1, uReducedMotion);
            
            // Enhanced rotation based on mouse position
            float rotationIntensity = length(uMouse) * 0.3;
            float angle = atan(uMouse.y, uMouse.x) + uTime * 0.5;
            
            // Apply rotation and gentle wave motion
            p.x += sin(angle + uTime) * 0.02 * rotationIntensity * motionScale;
            p.y += cos(angle + uTime) * 0.02 * rotationIntensity * motionScale;
            p.z += sin((position.x * 3.0 + uTime * 1.2)) * 0.008 * motionScale + 
                    cos((position.y * 2.0 - uTime * 1.6)) * 0.008 * motionScale;
            
            gl_Position = projectionMatrix * modelViewMatrix * vec4(p, 1.0);
          }
        `,
        fragmentShader: `
          varying vec2 vUv;
          uniform sampler2D uTex;
          uniform float uTime;
          uniform float uReducedMotion;
          uniform vec2 uMouse;
          void main() {
            vec2 uv = vUv;
            float motionScale = mix(1.0, 0.1, uReducedMotion);
            
            // Enhanced distortion based on mouse interaction
            float mouseInfluence = length(uMouse) * 0.5;
            uv.x += sin((uv.y * 6.0) + uTime * 1.5) * 0.01 * motionScale * (1.0 + mouseInfluence);
            uv.y += sin((uv.x * 8.0) + uTime * 2.0) * 0.01 * motionScale * (1.0 + mouseInfluence);
            
            vec4 color = texture2D(uTex, uv);
            if (color.a < 0.15) discard;
            
            // Add subtle glow based on mouse proximity
            float glow = 1.0 + mouseInfluence * 0.3;
            color.rgb *= glow;
            
            gl_FragColor = color;
          }
        `,
        transparent: true
      });

      // Optimized texture loading with format detection and precompilation trigger
      const textureLoader = new THREE.TextureLoader();
      
      // Pre-compile shaders while texture loads to prevent first-frame hitch
      const dummyTexture = new THREE.DataTexture(new Uint8Array([255, 255, 255, 255]), 1, 1, THREE.RGBAFormat);
      uniforms.uTex.value = dummyTexture;
      
      // Trigger shader compilation with dummy data
      const tempMesh = new THREE.Mesh(
        new THREE.PlaneGeometry(1, 1), 
        shaderMaterial
      );
      renderer.compile(tempMesh, camera); // Pre-compile shaders
      
      textureLoader.load(
        '/brand/cursed-ink-logo.webp?v=5', // Use WebP for better compression
        (texture: THREE.Texture) => {
          // Optimize texture settings for performance
          texture.generateMipmaps = false;
          texture.minFilter = THREE.LinearFilter;
          texture.magFilter = THREE.LinearFilter;
          texture.wrapS = THREE.ClampToEdgeWrapping;
          texture.wrapT = THREE.ClampToEdgeWrapping;
          texture.flipY = false; // Avoid GPU state change
          
          uniforms.uTex.value = texture;
          dummyTexture.dispose(); // Clean up dummy texture
        },
        undefined,
        (error: unknown) => {
          console.warn('WebP logo failed, falling back to PNG:', error);
          // Fallback to PNG
          textureLoader.load(
            '/brand/cursed-ink-logo.png?v=4',
            (texture: THREE.Texture) => {
              texture.generateMipmaps = false;
              texture.minFilter = THREE.LinearFilter;
              texture.magFilter = THREE.LinearFilter;
              texture.wrapS = THREE.ClampToEdgeWrapping;
              texture.wrapT = THREE.ClampToEdgeWrapping;
              texture.flipY = false;
              uniforms.uTex.value = texture;
              dummyTexture.dispose();
            },
            undefined,
            (fallbackError: unknown) => {
              console.warn('All logo formats failed to load:', fallbackError);
            }
          );
        }
      );

      // Adaptive geometry complexity based on device capability
      const geometrySegments = isLowEnd ? 16 : (isMobile ? 24 : 32);
      const logoPlane = new THREE.Mesh(
        new THREE.PlaneGeometry(4.0, 4.0, geometrySegments, geometrySegments), 
        shaderMaterial
      );
      scene.add(logoPlane);

      // Enhanced mouse tracking for both 3D and 2D logo rotation
      const mouse = new THREE.Vector2();
      let mouseUpdateId = 0;
      
      const updateMouse = (e: PointerEvent): void => {
        cancelAnimationFrame(mouseUpdateId);
        mouseUpdateId = requestAnimationFrame(() => {
          mouse.x = (e.clientX / window.innerWidth) * 2 - 1;
          mouse.y = -(e.clientY / window.innerHeight) * 2 + 1;
          
          // Update shader uniforms
          uniforms.uMouse.value.set(mouse.x, mouse.y);
        });
      };

      window.addEventListener('pointermove', updateMouse, { passive: true });

      // Enhanced performance monitoring with adaptive quality
      let lastTime = performance.now();
      let frameCount = 0;
      let fpsHistory: number[] = [];
      const targetFPS = isLowEnd ? 24 : (isMobile ? 30 : 60);
      const frameInterval = 1000 / targetFPS;
      let qualityScale = 1.0;

      const clock = new THREE.Clock();
      let animationId: number;
      let isPageVisible = !document.hidden;

      // Handle tab visibility changes to prevent timer spikes
      const handleVisibilityChange = () => {
        isPageVisible = !document.hidden;
        if (isPageVisible) {
          // Reset clock to prevent large delta spikes when returning to tab
          clock.start();
          lastTime = performance.now();
        }
      };
      
      document.addEventListener('visibilitychange', handleVisibilityChange);

      function animate() {
        animationId = requestAnimationFrame(animate);
        
        // Skip animation if page is not visible
        if (!isPageVisible) return;
        
        const currentTime = performance.now();
        const deltaTime = currentTime - lastTime;

        // Frame rate limiting for better performance
        if (deltaTime < frameInterval) return;

        // Clamp delta time to prevent large jumps after tab switches
        const dt = Math.min(clock.getDelta(), 0.033); // Cap at ~30fps worth of time
        frameCount++;

        // Update uniforms
        uniforms.uTime.value += dt;

        // Smooth camera movement (reduced on mobile/reduced motion)
        const cameraSpeed = prefersReducedMotion ? 0.02 : (isMobile ? 0.04 : 0.06);
        const mouseInfluence = prefersReducedMotion ? 0.2 : (isMobile ? 0.4 : 0.6);
        
        camera.position.x += (mouse.x * mouseInfluence - camera.position.x) * cameraSpeed;
        camera.position.y += (-mouse.y * (mouseInfluence * 0.6) - camera.position.y) * cameraSpeed;
        camera.lookAt(0, 0, 0);

        // Enhanced logo plane rotation based on mouse position
        if (!prefersReducedMotion) {
          const rotationSpeed = 0.3;
          const rotationX = -mouse.y * rotationSpeed * 0.1;
          const rotationY = mouse.x * rotationSpeed * 0.1;
          const rotationZ = Math.sin(uniforms.uTime.value * 0.5) * 0.05;
          
          logoPlane.rotation.x = rotationX;
          logoPlane.rotation.y = rotationY + uniforms.uTime.value * 0.1;
          logoPlane.rotation.z = rotationZ;
        }

        // Particle rotation (reduced for performance)
        if (!prefersReducedMotion) {
          particles.rotation.y += dt * (isMobile ? 0.01 : 0.02);
        }

        renderer.render(scene, camera);
        lastTime = currentTime;

        // Enhanced performance monitoring with adaptive quality scaling
        if (frameCount % 60 === 0) {
          const currentFPS = 1000 / deltaTime;
          fpsHistory.push(currentFPS);
          
          // Keep only last 5 measurements
          if (fpsHistory.length > 5) fpsHistory.shift();
          
          const avgFPS = fpsHistory.reduce((a, b) => a + b) / fpsHistory.length;
          
          // Adaptive quality scaling based on performance
          if (avgFPS < targetFPS * 0.7) {
            qualityScale = Math.max(0.3, qualityScale * 0.9);
            particleMaterial.opacity *= 0.9;
            console.warn(`Low FPS detected (${avgFPS.toFixed(1)}), reducing quality to ${qualityScale.toFixed(2)}`);
            
            // Further reduce pixel ratio if needed
            if (qualityScale < 0.5) {
              renderer.setPixelRatio(Math.max(1, pixelRatio * 0.8));
            }
          } else if (avgFPS > targetFPS * 1.2 && qualityScale < 1.0) {
            // Gradually restore quality if performance improves
            qualityScale = Math.min(1.0, qualityScale * 1.05);
          }
        }
      }

      animate();

      // Cleanup on page unload
      window.addEventListener('beforeunload', () => {
        cancelAnimationFrame(animationId);
        document.removeEventListener('visibilitychange', handleVisibilityChange);
        renderer.dispose();
        geometry.dispose();
        particleMaterial.dispose();
        shaderMaterial.dispose();
        dummyTexture.dispose();
        if (uniforms.uTex.value && uniforms.uTex.value !== dummyTexture) {
          uniforms.uTex.value.dispose();
        }
      });

    } catch (error) {
      console.error('Three.js initialization failed:', error);
      // Fallback: hide canvas and show CSS background
      const canvas = document.getElementById('ink-canvas');
      if (canvas && canvas.parentElement) {
        canvas.style.display = 'none';
        canvas.parentElement.classList.add('hero-fallback');
      }
    }
  }

  // Initialize with better error handling and critical resource waiting
  function setupLazyThreeJS() {
    const heroSection = document.getElementById('hero-section');
    if (!heroSection) return;

    // Check if user prefers reduced data usage (save-data header)
    const connection = (navigator as any).connection;
    const saveData = connection?.saveData || false;
    
    // Skip Three.js on slow connections or save-data preference
    if (saveData || (connection && connection.effectiveType === 'slow-2g')) {
      console.log('Skipping Three.js due to data saving preference or slow connection');
      heroSection.classList.add('hero-fallback');
      return;
    }

    // Wait for critical page resources before initializing
    const waitForCriticalResources = (): Promise<void> => {
      return new Promise((resolve) => {
        // Check if fonts are loaded
        if (document.fonts && document.fonts.ready) {
          document.fonts.ready.then(() => {
            // Additional delay to ensure layout is stable
            requestAnimationFrame(() => {
              setTimeout(resolve, 100); // Small delay for layout settling
            });
          });
        } else {
          // Fallback for browsers without font loading API
          setTimeout(resolve, 500);
        }
      });
    };

    let initAttempts = 0;
    const maxAttempts = 3;

    // Retry logic for Three.js initialization with critical resource waiting
    const initWithRetry = async () => {
      try {
        // Wait for critical resources first
        await waitForCriticalResources();
        await initThreeJS();
        console.log('Three.js initialized successfully after critical resources loaded');
      } catch (error) {
        initAttempts++;
        console.warn(`Three.js initialization attempt ${initAttempts} failed:`, error);
        
        if (initAttempts < maxAttempts) {
          // Retry after increasing delay
          setTimeout(initWithRetry, initAttempts * 1000);
        } else {
          // Give up and use fallback
          console.error('Three.js initialization failed after maximum attempts, using fallback');
          heroSection.classList.add('hero-fallback');
          const canvas = document.getElementById('ink-canvas');
          if (canvas) canvas.style.display = 'none';
        }
      }
    };

    // Delay Three.js initialization to improve FID
    const initWithDelay = () => {
      // Use requestIdleCallback for better FID performance
      if ('requestIdleCallback' in window) {
        requestIdleCallback(initWithRetry, { timeout: 3000 });
      } else {
        // Fallback for browsers without requestIdleCallback
        setTimeout(initWithRetry, 100);
      }
    };

    // Use Intersection Observer to load Three.js only when hero is visible
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          observer.disconnect(); // Only load once
          initWithDelay();
        }
      });
    }, {
      rootMargin: '50px' // Start loading slightly before it comes into view
    });

    observer.observe(heroSection);
  }

  // Initialize with optimized loading
  function initializeHero3D() {
    // Queue Three.js initialization with optimized loader
    if ((window as any).threeLoader) {
      (window as any).threeLoader.queueThreeJSInit('ink-canvas', initThreeJS);
    } else {
      // Fallback to original lazy loading
      setupLazyThreeJS();
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeHero3D);
  } else {
    initializeHero3D();
  }
</script>

<script>
  // Enhanced 2D logo cursor following effect
  class LogoRotationHandler {
    private logo: HTMLElement | null;
    private container: HTMLElement | null;
    private mouse: { x: number; y: number };
    private animationId: number | null;

    constructor() {
      this.logo = document.getElementById('rotating-logo');
      this.container = this.logo?.parentElement || null;
      this.mouse = { x: 0, y: 0 };
      this.animationId = null;
      this.init();
    }

    init(): void {
      if (!this.logo || !this.container) return;
      
      // Enhanced mouse tracking for 2D logo rotation
      window.addEventListener('mousemove', this.handleMouseMove.bind(this), { passive: true });
      window.addEventListener('touchmove', this.handleTouchMove.bind(this), { passive: true });
      
      // Start animation loop
      this.animate();
    }

    handleMouseMove(e: MouseEvent): void {
      this.updateMousePosition(e.clientX, e.clientY);
    }

    handleTouchMove(e: TouchEvent): void {
      if (e.touches.length > 0) {
        this.updateMousePosition(e.touches[0].clientX, e.touches[0].clientY);
      }
    }

    updateMousePosition(clientX: number, clientY: number): void {
      if (!this.container) return;
      
      const rect = this.container.getBoundingClientRect();
      const centerX = rect.left + rect.width / 2;
      const centerY = rect.top + rect.height / 2;
      
      // Normalize mouse position relative to logo center
      this.mouse.x = (clientX - centerX) / (window.innerWidth / 2);
      this.mouse.y = (clientY - centerY) / (window.innerHeight / 2);
    }

    animate(): void {
      if (!this.logo) return;
      
      // Calculate rotation based on mouse position
      const rotationX = -this.mouse.y * 15; // Tilt up/down
      const rotationY = this.mouse.x * 15;  // Tilt left/right
      const rotationZ = Math.sin(Date.now() * 0.001) * 2; // Subtle continuous rotation
      
      // Calculate scale based on mouse proximity
      const distance = Math.sqrt(this.mouse.x * this.mouse.x + this.mouse.y * this.mouse.y);
      const scale = 1 + Math.min(distance * 0.1, 0.15); // Slight scale increase on hover
      
      // Apply transforms
      this.logo.style.transform = `
        perspective(1000px)
        rotateX(${rotationX}deg)
        rotateY(${rotationY}deg)
        rotateZ(${rotationZ}deg)
        scale(${scale})
      `;
      
      // Continue animation
      this.animationId = requestAnimationFrame(() => this.animate());
    }

    destroy(): void {
      if (this.animationId) {
        cancelAnimationFrame(this.animationId);
      }
      window.removeEventListener('mousemove', this.handleMouseMove.bind(this));
      window.removeEventListener('touchmove', this.handleTouchMove.bind(this));
    }
  }

  // Enhanced countdown with better UX
  class CountdownTimer {
    private target: number;
    private element: HTMLElement | null;
    private animationId: number | null;

    constructor(targetDate: string) {
      this.target = new Date(targetDate).getTime();
      this.element = document.getElementById('countdown');
      this.animationId = null;
      this.init();
    }

    init(): void {
      if (!this.element || isNaN(this.target)) return;
      this.tick();
    }

    tick(): void {
      if (!this.element) return;
      
      const now = Date.now();
      const difference = this.target - now;

      if (difference <= 0) {
        this.element.innerHTML = `
          <div style="font-size: 1.2rem; color: var(--accent1); font-weight: 700;">
            🔥 We're now open! Welcome to Cursed Ink Society 🔥
          </div>
        `;
        return;
      }

      const days = Math.floor(difference / (1000 * 60 * 60 * 24));
      const hours = Math.floor((difference % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
      const minutes = Math.floor((difference % (1000 * 60 * 60)) / (1000 * 60));
      const seconds = Math.floor((difference % (1000 * 60)) / 1000);

      const timeString = [
        days > 0 ? `${String(days).padStart(2, '0')}d` : null,
        `${String(hours).padStart(2, '0')}h`,
        `${String(minutes).padStart(2, '0')}m`,
        `${String(seconds).padStart(2, '0')}s`
      ].filter(Boolean).join(' : ');

      this.element.innerHTML = `
        <div style="font-size: 1.1rem; font-weight: 600; text-align: center;">
          <div style="margin-bottom: 0.5rem; color: var(--accent1); font-size: 0.9rem;">
            Grand Opening
          </div>
          <div>
            ${timeString}
          </div>
        </div>
      `;

      // Use requestAnimationFrame for smooth updates
      this.animationId = requestAnimationFrame(() => this.tick());
    }

    destroy(): void {
      if (this.animationId) {
        cancelAnimationFrame(this.animationId);
      }
    }
  }

  // Initialize enhanced components when DOM is ready
  function initEnhancedComponents() {
    new LogoRotationHandler();
    
    // Calculate 48 hours from now
    const now = new Date();
    const openingTime = new Date(now.getTime() + (48 * 60 * 60 * 1000)); // 48 hours in milliseconds
    
    new CountdownTimer(openingTime.toISOString());
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initEnhancedComponents);
  } else {
    initEnhancedComponents();
  }

  // Cleanup on page unload
  window.addEventListener('beforeunload', () => {
    // Cleanup is handled in individual classes
  });
</script>

