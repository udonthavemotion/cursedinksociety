---
import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
  canonicalURL?: URL;
  ogImage?: URL;
  noIndex?: boolean;
}

const { 
  title, 
  description, 
  canonicalURL = new URL(Astro.url.pathname, Astro.site),
  ogImage = new URL('/og/og-image.jpg', Astro.url),
  noIndex = false
} = Astro.props;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "TattooParlor",
  "name": "Cursed Ink Society",
  "description": "Premium tattoo collective in Houma, Louisiana featuring Anthony, Ashley, Cody, Seth, Luis, and Trent. Specializing in custom designs, traditional work, and mystical ink.",
  "url": canonicalURL.toString(),
  "logo": new URL('/brand/cursed-ink-logo.png', Astro.url).toString(),
  "telephone": "(985) 555-2873",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "123 Main Street",
    "addressLocality": "Houma",
    "addressRegion": "LA",
    "postalCode": "70360",
    "addressCountry": "US"
  },
  "openingHours": [
    "Tu-Th 12:00-20:00",
    "Fr-Sa 12:00-22:00"
  ],
  "sameAs": [
    "https://instagram.com/cursedinksociety",
    "https://facebook.com/cursedinksociety"
  ],
  "priceRange": "$$$",
  "areaServed": "Houma, Louisiana",
  "founder": [
    {"@type": "Person", "name": "Anthony Boudreaux"},
    {"@type": "Person", "name": "Ashley Wood"},
    {"@type": "Person", "name": "Cody Crochet"},
    {"@type": "Person", "name": "Seth Wood"},
    {"@type": "Person", "name": "Luis Reymundo"},
    {"@type": "Person", "name": "Trent"}
  ]
};
---

<!DOCTYPE html>
<html lang="en">
	<head>
    <!-- Essential Meta Tags -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#dc143c" />
    <meta name="color-scheme" content="dark" />
    
    <!-- Additional theme colors for different platforms -->
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#dc143c" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0b0b0d" />
    
    <!-- Safari Pinned Tab -->
    <link rel="mask-icon" href="/favicon.svg" color="#dc143c" />
    
    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noIndex ? "noindex, nofollow" : "index, follow"} />
    <link rel="canonical" href={canonicalURL} />
    
    <!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Cursed Ink Society" />
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImage} />
    
    <!-- Comprehensive Favicon & Icon System -->
    <!-- Primary favicon with cache busting -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico?v=3" />
    <link rel="shortcut icon" type="image/x-icon" href="/favicon.ico?v=3" />
    
    <!-- Modern browsers (SVG favicon) -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=3" />
    
    <!-- PNG favicons for different sizes -->
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=3" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png?v=3" />
    
    <!-- Apple Touch Icons for iOS devices -->
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=3" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=3" />
    
    <!-- Android Chrome Icons -->
    <link rel="icon" type="image/png" sizes="192x192" href="/android-chrome-192x192.png?v=3" />
    <link rel="icon" type="image/png" sizes="512x512" href="/android-chrome-512x512.png?v=3" />
    
    <!-- Web App Manifest for PWA support -->
    <link rel="manifest" href="/site.webmanifest?v=3" />
    
    <!-- Microsoft Tiles for Windows -->
    <meta name="msapplication-TileColor" content="#dc143c" />
    <meta name="msapplication-TileImage" content="/android-chrome-192x192.png" />
    <meta name="msapplication-config" content="/browserconfig.xml" />
    
    <!-- Preload Critical Resources -->
    <link rel="preload" href="/brand/cursed-ink-logo.png" as="image" type="image/png" />
    
    <!-- DNS Prefetch for External Resources -->
    <link rel="dns-prefetch" href="//formspree.io" />
		<link rel="dns-prefetch" href="//fonts.googleapis.com" />
    <link rel="dns-prefetch" href="//instagram.com" />
    
    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    
    <!-- Performance Hints -->
    <meta name="format-detection" content="telephone=no" />
    <meta name="msapplication-tap-highlight" content="no" />
  </head>
  
  <body>
    <!-- Skip Link for Accessibility -->
    <a href="#main-content" class="skip-link">Skip to main content</a>
    
    <!-- Navigation -->
    <nav class="main-nav" role="navigation" aria-label="Main navigation">
      <div class="container nav-container">
        <a href="/" class="nav-logo" aria-label="Cursed Ink Society Home">
          <img src="/brand/cursed-ink-logo.png" alt="Cursed Ink Society" width="60" height="60" />
        </a>
        
        <button class="nav-toggle" aria-expanded="false" aria-controls="nav-menu" aria-label="Toggle navigation">
          <span></span>
          <span></span>
          <span></span>
        </button>
        
        <div class="nav-menu" id="nav-menu">
          <ul class="nav-links">
            <li><a href="/" class="nav-link">Home</a></li>
            <li><a href="/artists" class="nav-link">Guild</a></li>
            <li><a href="/gallery" class="nav-link">Gallery</a></li>
            <li><a href="/services" class="nav-link">Services</a></li>
            <li><a href="/about" class="nav-link">About</a></li>
            <li><a href="/contact" class="nav-link">Contact</a></li>
          </ul>
          <div class="nav-cta">
            <a href="/contact" class="btn btn--primary">Start Your Journey</a>
          </div>
        </div>
      </div>
    </nav>

    <main id="main-content">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="main-footer">
      <div class="container">
        <!-- Main Footer Content - Centered -->
        <div class="footer-content">
          <!-- Brand Section - Centered -->
          <div class="footer-brand">
            <img src="/brand/cursed-ink-logo.png" alt="Cursed Ink Society" width="60" height="60" class="footer-logo" />
            <h3 class="footer-title">Cursed Ink Society</h3>
            <p class="footer-tagline">Where artistry meets the mystical</p>
          </div>
          
          <!-- Navigation Links - Horizontal -->
          <nav class="footer-nav" role="navigation" aria-label="Footer navigation">
            <a href="/artists" class="footer-link">Guild</a>
            <a href="/gallery" class="footer-link">Gallery</a>
            <a href="/services" class="footer-link">Services</a>
            <a href="/about" class="footer-link">About</a>
            <a href="/contact" class="footer-link">Contact</a>
          </nav>
          
          <!-- Contact Info - Compact -->
          <div class="footer-contact">
            <p class="contact-location">123 Main Street, Houma, LA 70360</p>
            <p class="contact-hours">Tue-Thu: 12PM-8PM • Fri-Sat: 12PM-10PM</p>
          </div>
          
          <!-- Social Links -->
          <div class="footer-social">
            <a href="https://instagram.com/cursedinksociety" aria-label="Instagram" rel="noopener" target="_blank" class="social-link">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                <path d="M7 2h10a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5V7a5 5 0 0 1 5-5zm5 5a5 5 0 1 0 .001 10.001A5 5 0 0 0 12 7zm0 2.2a2.8 2.8 0 1 1 0 5.6 2.8 2.8 0 0 1 0-5.6zM18 6.5a1 1 0 1 0 0 2 1 1 0 0 0 0-2z"/>
              </svg>
            </a>
            <a href="https://facebook.com/cursedinksociety" aria-label="Facebook" rel="noopener" target="_blank" class="social-link">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
            </a>
            <a href="tel:+19855552873" aria-label="Phone: (985) 555-CURSE" class="social-link">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                <path d="M6.62 10.79a15.05 15.05 0 006.59 6.59l2.2-2.2a1 1 0 011.11-.21 11.36 11.36 0 003.57.57 1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1 11.36 11.36 0 00.57 3.57 1 1 0 01-.21 1.11z"/>
              </svg>
            </a>
          </div>
        </div>

        <!-- Footer Bottom - Copyright & Legal -->
        <div class="footer-bottom">
          <div class="footer-copyright">
            <small>© {new Date().getFullYear()} Cursed Ink Society — forged in fire & pigment</small>
          </div>
          <div class="footer-legal">
            <a href="/privacy" class="legal-link">Privacy</a>
            <span class="legal-separator">•</span>
            <a href="/terms" class="legal-link">Terms</a>
          </div>
        </div>
      </div>
    </footer>

    <!-- Navigation JavaScript -->
		<script>
      // Enhanced navigation with accessibility
      class Navigation {
        private navToggle: HTMLElement | null;
        private navMenu: HTMLElement | null;
        private navLinks: NodeListOf<HTMLElement>;
        private isOpen: boolean;

        constructor() {
          this.navToggle = document.querySelector('.nav-toggle');
          this.navMenu = document.querySelector('.nav-menu');
          this.navLinks = document.querySelectorAll('.nav-link');
          this.isOpen = false;
          
          this.init();
        }

        init(): void {
          if (!this.navToggle || !this.navMenu) return;
          
          this.navToggle.addEventListener('click', this.toggleMenu.bind(this));
          
          // Close menu when clicking nav links
          this.navLinks.forEach((link: HTMLElement) => {
            link.addEventListener('click', () => this.closeMenu());
          });
          
          // Close menu when clicking outside
          document.addEventListener('click', (e: Event) => {
            const target = e.target as HTMLElement;
            if (target && !target.closest('.main-nav') && this.isOpen) {
              this.closeMenu();
            }
          });
          
          // Handle escape key
          document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && this.isOpen) {
              this.closeMenu();
            }
          });
          
          // Set active nav link
          this.setActiveLink();
          
          // Setup transparent navbar on scroll
          this.setupScrollTransparency();
        }

        setupScrollTransparency(): void {
          const nav = document.querySelector('.main-nav');
          let ticking = false;

          const updateNavTransparency = () => {
            const scrolled = window.pageYOffset;
            const threshold = 100; // Start transparency after 100px scroll
            
            if (scrolled > threshold) {
              nav?.classList.add('nav-transparent');
            } else {
              nav?.classList.remove('nav-transparent');
            }
            
            ticking = false;
          };

          const requestTick = () => {
            if (!ticking) {
              requestAnimationFrame(updateNavTransparency);
              ticking = true;
            }
          };

          window.addEventListener('scroll', requestTick, { passive: true });
        }

        toggleMenu(): void {
          this.isOpen ? this.closeMenu() : this.openMenu();
        }

        openMenu(): void {
          if (!this.navMenu || !this.navToggle) return;
          
          this.isOpen = true;
          this.navMenu.classList.add('nav-menu--open');
          this.navToggle.classList.add('nav-toggle--open');
          this.navToggle.setAttribute('aria-expanded', 'true');
          document.body.style.overflow = 'hidden';
        }

        closeMenu(): void {
          if (!this.navMenu || !this.navToggle) return;
          
          this.isOpen = false;
          this.navMenu.classList.remove('nav-menu--open');
          this.navToggle.classList.remove('nav-toggle--open');
          this.navToggle.setAttribute('aria-expanded', 'false');
          document.body.style.overflow = '';
        }

        setActiveLink(): void {
          const currentPath = window.location.pathname;
          this.navLinks.forEach((link: HTMLElement) => {
            const href = link.getAttribute('href');
            if (href === currentPath || (currentPath === '/' && href === '/')) {
              link.classList.add('nav-link--active');
            }
          });
        }
      }

      // Initialize navigation when DOM is ready
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', () => new Navigation());
      } else {
        new Navigation();
      }
		</script>

    <style>
      /* Navigation Styles */
      .main-nav {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 1000;
        background: rgba(11, 11, 13, 0.95);
        backdrop-filter: blur(10px);
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
      }

      /* Transparent navbar on scroll */
      .main-nav.nav-transparent {
        background: rgba(11, 11, 13, 0.1);
        backdrop-filter: blur(20px);
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
      }

      .main-nav.nav-transparent .nav-logo img {
        filter: drop-shadow(0 0 15px rgba(255, 60, 43, 0.8));
      }

      .main-nav.nav-transparent .nav-link {
        color: rgba(245, 245, 245, 0.9);
        text-shadow: 0 0 10px rgba(255, 60, 43, 0.3);
      }

      .nav-container {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1rem 1.2rem;
        position: relative;
      }

      .nav-logo img {
        height: 50px;
        width: auto;
        filter: drop-shadow(0 0 10px rgba(255, 60, 43, 0.3));
        transition: var(--transition-smooth);
      }

      .nav-logo:hover img {
        filter: drop-shadow(0 0 20px rgba(255, 60, 43, 0.5));
        transform: scale(1.05);
      }

      .nav-toggle {
        display: none;
        flex-direction: column;
        background: none;
        border: none;
        cursor: pointer;
        padding: 0.5rem;
        position: relative;
        z-index: 1001;
      }

      .nav-toggle span {
        display: block;
        width: 25px;
        height: 2px;
        background: var(--ink);
        margin: 3px 0;
        transition: var(--transition-smooth);
        border-radius: 2px;
      }

      .nav-toggle--open span:nth-child(1) {
        transform: rotate(45deg) translate(6px, 6px);
      }

      .nav-toggle--open span:nth-child(2) {
        opacity: 0;
      }

      .nav-toggle--open span:nth-child(3) {
        transform: rotate(-45deg) translate(6px, -6px);
      }

      .nav-menu {
        display: flex;
        align-items: center;
        gap: 2rem;
      }

      .nav-links {
        display: flex;
        align-items: center;
        gap: 2rem;
        list-style: none;
        margin: 0;
        padding: 0;
      }

      .nav-link {
        color: var(--ink);
        text-decoration: none;
        font-weight: 500;
        font-size: 0.95rem;
        letter-spacing: 0.02em;
        transition: var(--transition-smooth);
        position: relative;
        padding: 0.5rem 0;
      }

      .nav-link::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 0;
        width: 0;
        height: 2px;
        background: var(--accent0);
        transition: width 0.3s ease;
      }

      .nav-link:hover::after,
      .nav-link--active::after {
        width: 100%;
      }

      .nav-link:hover,
      .nav-link--active {
        color: var(--accent0);
        text-shadow: var(--glow-subtle);
      }

      .nav-cta .btn {
        font-size: 0.9rem;
        padding: 0.7rem 1.2rem;
      }

      /* Footer Styles - Modern, Elegant, Compact */
      .main-footer {
        background:
          radial-gradient(ellipse at 50% 20%, rgba(255, 60, 43, 0.08) 0%, transparent 60%),
          linear-gradient(135deg, #0a0a0c 0%, #0f0f11 100%);
        border-top: 1px solid rgba(255, 255, 255, 0.08);
        padding: 3rem 0 1.5rem;
        margin-top: 4rem;
      }

      .footer-content {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        gap: 1.5rem;
        margin-bottom: 2rem;
      }

      /* Brand Section - Compact & Centered */
      .footer-brand {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
      }

      .footer-logo {
        filter: drop-shadow(0 0 12px rgba(255, 60, 43, 0.4));
        transition: var(--transition-smooth);
      }

      .footer-logo:hover {
        filter: drop-shadow(0 0 20px rgba(255, 60, 43, 0.6));
        transform: scale(1.05);
      }

      .footer-title {
        font-size: 1.3rem;
        margin: 0;
        color: var(--ink);
        text-shadow: 0 0 8px rgba(220, 20, 60, 0.6), var(--glow-subtle);
        font-weight: 600;
      }

      .footer-tagline {
        font-size: 0.9rem;
        opacity: 0.7;
        margin: 0;
        font-style: italic;
        color: var(--ink);
        text-shadow: 0 0 6px rgba(220, 20, 60, 0.4);
      }

      /* Navigation Links - Horizontal & Compact */
      .footer-nav {
        display: flex;
        gap: 2rem;
        flex-wrap: wrap;
        justify-content: center;
      }

      .footer-link {
        color: var(--ink);
        text-decoration: none;
        font-size: 0.9rem;
        font-weight: 500;
        opacity: 0.8;
        transition: var(--transition-smooth);
        position: relative;
        padding: 0.25rem 0;
      }

      .footer-link::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 50%;
        width: 0;
        height: 1px;
        background: var(--accent0);
        transition: all 0.3s ease;
        transform: translateX(-50%);
      }

      .footer-link:hover {
        opacity: 1;
        color: var(--accent0);
        text-shadow: 0 0 6px rgba(220, 20, 60, 0.5), var(--glow-subtle);
      }

      .footer-link:hover::after {
        width: 100%;
      }

      /* Contact Info - Compact */
      .footer-contact {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
      }

      .contact-location,
      .contact-hours {
        font-size: 0.85rem;
        opacity: 0.7;
        margin: 0;
        line-height: 1.4;
        color: var(--ink);
        text-shadow: 0 0 4px rgba(220, 20, 60, 0.3);
      }

      .contact-hours {
        font-weight: 500;
      }

      /* Social Links - Compact & Modern */
      .footer-social {
        display: flex;
        gap: 1rem;
        justify-content: center;
      }

      .social-link {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        border-radius: 8px;
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.08);
        color: var(--ink);
        transition: var(--transition-smooth);
        opacity: 0.8;
      }

      .social-link:hover {
        opacity: 1;
        background: rgba(255, 60, 43, 0.1);
        border-color: rgba(255, 60, 43, 0.3);
        color: var(--accent0);
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(255, 60, 43, 0.15);
      }

      /* Footer Bottom - Minimal & Elegant */
      .footer-bottom {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-top: 1.5rem;
        border-top: 1px solid rgba(255, 255, 255, 0.06);
        gap: 1rem;
      }

      .footer-copyright small {
        font-size: 0.8rem;
        opacity: 0.6;
        color: var(--ink);
        text-shadow: 0 0 5px rgba(220, 20, 60, 0.4), var(--glow-subtle);
      }

      .footer-legal {
        display: flex;
        align-items: center;
        gap: 0.75rem;
      }

      .legal-link {
        color: var(--ink);
        text-decoration: none;
        font-size: 0.8rem;
        opacity: 0.6;
        transition: var(--transition-smooth);
        font-weight: 500;
      }

      .legal-link:hover {
        opacity: 1;
        color: var(--accent0);
        text-shadow: 0 0 5px rgba(220, 20, 60, 0.5), var(--glow-subtle);
      }

      .legal-separator {
        color: var(--ink);
        opacity: 0.4;
        font-size: 0.8rem;
      }

      /* Mobile Navigation */
      @media (max-width: 768px) {
        .nav-toggle {
          display: flex;
        }

        .nav-menu {
          position: fixed;
          top: 0;
          left: 0;
          width: 100%;
          height: 100vh;
          background: rgba(11, 11, 13, 0.98);
          backdrop-filter: blur(20px);
          flex-direction: column;
          justify-content: center;
          align-items: center;
          gap: 0;
          transform: translateX(-100%);
          transition: transform 0.3s ease;
        }

        .nav-menu--open {
          transform: translateX(0);
        }

        .nav-links {
          flex-direction: column;
          gap: 2.5rem;
          margin-bottom: 3rem;
        }

        .nav-link {
          font-size: 1.2rem;
          text-align: center;
        }

        .footer-nav {
          gap: 1.5rem;
        }

        .footer-link {
          font-size: 0.85rem;
        }

        .footer-bottom {
          flex-direction: column;
          text-align: center;
          gap: 1rem;
        }

        .footer-legal {
          justify-content: center;
        }
      }

      /* Add top padding to body to account for fixed nav */
      body {
        padding-top: 80px;
      }

      /* Skip link styles */
      .skip-link {
        position: absolute;
        top: -40px;
        left: 6px;
        background: var(--accent0);
        color: white;
        padding: 8px;
        text-decoration: none;
        border-radius: 4px;
        z-index: 1000;
        font-weight: 600;
        transition: top 0.2s;
      }

      .skip-link:focus {
        top: 6px;
      }
    </style>
	</body>
</html>