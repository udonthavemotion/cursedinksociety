---
import Layout from '../layouts/Layout.astro';

const title = "Book Free Consultation — Cursed Ink Society";
const description = "Book your free tattoo consultation with Cursed Ink Society. Discuss your ideas, get pricing, and plan your perfect tattoo with our master artists in Houma, LA.";

// Artists data for selection
const artists = [
  {
    id: 'raven',
    name: 'Raven Blackthorne',
    specialty: 'Traditional & Blackwork',
    image: '/assets/artists/raven-blackthorne.jpg'
  },
  {
    id: 'phoenix',
    name: 'Phoenix Ashwood',
    specialty: 'Realism & Portraits',
    image: '/assets/artists/phoenix-ashwood.jpg'
  },
  {
    id: 'sage',
    name: 'Sage Moonwright',
    specialty: 'Fine Line & Minimalist',
    image: '/assets/artists/sage-moonwright.jpg'
  },
  {
    id: 'dante',
    name: 'Dante Crimson',
    specialty: 'Japanese Traditional',
    image: '/assets/artists/dante-crimson.jpg'
  }
];

// Time slots
const timeSlots = [
  '10:00 AM', '11:00 AM', '12:00 PM', '1:00 PM', '2:00 PM', 
  '3:00 PM', '4:00 PM', '5:00 PM', '6:00 PM', '7:00 PM'
];
---

<Layout title={title} description={description}>
  <!-- Hero Section -->
  <section class="consultation-hero">
    <div class="container">
      <div class="hero-content">
        <span class="badge">Free Consultation</span>
        <h1 class="hero-title shine">Book Your Consultation</h1>
        <p class="hero-description">
          Start your tattoo journey with a free consultation. We'll discuss your ideas, 
          provide pricing, and help you plan the perfect tattoo experience.
        </p>
      </div>
    </div>
  </section>

  <!-- Consultation Process -->
  <section class="consultation-process">
    <div class="container">
      <h2 class="section-title">What to Expect</h2>
      <div class="process-grid">
        <div class="process-step">
          <div class="step-number">1</div>
          <h3>Share Your Vision</h3>
          <p>Tell us about your tattoo ideas, bring reference images, and discuss your vision with our artists.</p>
        </div>
        <div class="process-step">
          <div class="step-number">2</div>
          <h3>Design Discussion</h3>
          <p>We'll explore placement, sizing, style options, and create a custom design that's perfect for you.</p>
        </div>
        <div class="process-step">
          <div class="step-number">3</div>
          <h3>Pricing & Planning</h3>
          <p>Get transparent pricing, discuss timeline, and schedule your tattoo session with your chosen artist.</p>
        </div>
        <div class="process-step">
          <div class="step-number">4</div>
          <h3>Next Steps</h3>
          <p>Leave with a clear plan, deposit information, and everything you need for your tattoo appointment.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Booking Form -->
  <section class="booking-section">
    <div class="container">
      <div class="booking-grid">
        <!-- Artist Selection -->
        <div class="artist-selection">
          <h2 class="section-title">Choose Your Artist</h2>
          <p class="selection-description">
            Select an artist whose style matches your vision, or choose "No Preference" 
            and we'll recommend the best fit for your project.
          </p>
          
          <div class="artist-cards">
            <div class="artist-card" data-artist="none">
              <div class="artist-card-content">
                <div class="artist-placeholder">
                  <svg width="40" height="40" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                  </svg>
                </div>
                <h4>No Preference</h4>
                <p>Let us recommend the best artist for your project</p>
              </div>
            </div>
            
            {artists.map((artist) => (
              <div class="artist-card" data-artist={artist.id}>
                <div class="artist-card-content">
                  <img src={artist.image} alt={artist.name} class="artist-card-image" />
                  <h4>{artist.name}</h4>
                  <p>{artist.specialty}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Booking Form -->
        <div class="booking-form-section">
          <h2 class="section-title">Consultation Details</h2>
          
          <form class="booking-form" action="https://formspree.io/f/your-booking-form-id" method="POST">
            <!-- Hidden field for selected artist -->
            <input type="hidden" id="selectedArtist" name="selectedArtist" value="" />
            
            <!-- Personal Information -->
            <div class="form-section">
              <h3>Personal Information</h3>
              <div class="form-row">
                <div class="form-group">
                  <label for="firstName">First Name *</label>
                  <input type="text" id="firstName" name="firstName" required />
                </div>
                <div class="form-group">
                  <label for="lastName">Last Name *</label>
                  <input type="text" id="lastName" name="lastName" required />
                </div>
              </div>

              <div class="form-row">
                <div class="form-group">
                  <label for="email">Email Address *</label>
                  <input type="email" id="email" name="email" required />
                </div>
                <div class="form-group">
                  <label for="phone">Phone Number *</label>
                  <input type="tel" id="phone" name="phone" required />
                </div>
              </div>

              <div class="form-group">
                <label for="age">Age *</label>
                <select id="age" name="age" required>
                  <option value="">Select your age range</option>
                  <option value="18-25">18-25</option>
                  <option value="26-35">26-35</option>
                  <option value="36-45">36-45</option>
                  <option value="46-55">46-55</option>
                  <option value="55+">55+</option>
                </select>
              </div>
            </div>

            <!-- Tattoo Information -->
            <div class="form-section">
              <h3>Tattoo Information</h3>
              
              <div class="form-group">
                <label for="tattooIdea">Describe Your Tattoo Idea *</label>
                <textarea id="tattooIdea" name="tattooIdea" rows="4" required placeholder="Tell us about your vision, style preferences, and any specific elements you want included..."></textarea>
              </div>

              <div class="form-row">
                <div class="form-group">
                  <label for="placement">Placement *</label>
                  <select id="placement" name="placement" required>
                    <option value="">Where do you want it?</option>
                    <option value="arm">Arm</option>
                    <option value="forearm">Forearm</option>
                    <option value="shoulder">Shoulder</option>
                    <option value="back">Back</option>
                    <option value="chest">Chest</option>
                    <option value="leg">Leg</option>
                    <option value="thigh">Thigh</option>
                    <option value="ribs">Ribs</option>
                    <option value="other">Other</option>
                  </select>
                </div>
                <div class="form-group">
                  <label for="size">Approximate Size *</label>
                  <select id="size" name="size" required>
                    <option value="">How big?</option>
                    <option value="small">Small (2-4 inches)</option>
                    <option value="medium">Medium (4-8 inches)</option>
                    <option value="large">Large (8+ inches)</option>
                    <option value="sleeve">Sleeve/Large piece</option>
                  </select>
                </div>
              </div>

              <div class="form-group">
                <label for="style">Preferred Style</label>
                <select id="style" name="style">
                  <option value="">Any preference?</option>
                  <option value="traditional">Traditional</option>
                  <option value="realism">Realism</option>
                  <option value="japanese">Japanese</option>
                  <option value="fineline">Fine Line</option>
                  <option value="blackwork">Blackwork</option>
                  <option value="color">Color Work</option>
                  <option value="coverup">Cover-up</option>
                </select>
              </div>

              <div class="form-group checkbox-group">
                <input type="checkbox" id="firstTattoo" name="firstTattoo" />
                <label for="firstTattoo">This will be my first tattoo</label>
              </div>
            </div>

            <!-- Scheduling -->
            <div class="form-section">
              <h3>Preferred Schedule</h3>
              
              <div class="form-row">
                <div class="form-group">
                  <label for="preferredDate">Preferred Date</label>
                  <input type="date" id="preferredDate" name="preferredDate" />
                </div>
                <div class="form-group">
                  <label for="preferredTime">Preferred Time</label>
                  <select id="preferredTime" name="preferredTime">
                    <option value="">Any time</option>
                    {timeSlots.map((time) => (
                      <option value={time}>{time}</option>
                    ))}
                  </select>
                </div>
              </div>

              <div class="form-group">
                <label for="availability">Your Availability</label>
                <textarea id="availability" name="availability" rows="2" placeholder="Let us know your general availability (days/times that work best)..."></textarea>
              </div>
            </div>

            <!-- Additional Information -->
            <div class="form-section">
              <h3>Additional Information</h3>
              
              <div class="form-group">
                <label for="budget">Budget Range (Optional)</label>
                <select id="budget" name="budget">
                  <option value="">Prefer not to say</option>
                  <option value="under-300">Under $300</option>
                  <option value="300-500">$300 - $500</option>
                  <option value="500-1000">$500 - $1,000</option>
                  <option value="1000-2000">$1,000 - $2,000</option>
                  <option value="over-2000">Over $2,000</option>
                </select>
              </div>

              <div class="form-group">
                <label for="questions">Questions or Special Requests</label>
                <textarea id="questions" name="questions" rows="3" placeholder="Any questions about the process, aftercare, or special accommodations needed?"></textarea>
              </div>

              <div class="form-group checkbox-group">
                <input type="checkbox" id="newsletter" name="newsletter" />
                <label for="newsletter">I'd like to receive updates about events and new work</label>
              </div>
            </div>

            <button type="submit" class="btn btn--primary btn--large form-submit">
              Book Free Consultation
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact Alternative -->
  <section class="contact-alternative">
    <div class="container">
      <div class="alternative-content">
        <h2>Prefer to Talk First?</h2>
        <p>
          Not ready to book online? Give us a call or stop by the studio. 
          We're always happy to chat about your ideas and answer any questions.
        </p>
        <div class="contact-options">
          <a href="tel:+19852082334" class="btn btn--outline">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M6.62 10.79a15.05 15.05 0 006.59 6.59l2.2-2.2a1 1 0 011.11-.21 11.36 11.36 0 003.57.57 1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1 11.36 11.36 0 00.57 3.57 1 1 0 01-.21 1.11z"/>
            </svg>
            Call (985) 208-2334
          </a>
          <a href="/contact" class="btn btn--outline">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
            </svg>
            Visit Our Studio
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  // Artist selection and form management
  class ConsultationBooking {
    constructor() {
      this.artistCards = document.querySelectorAll('.artist-card');
      this.selectedArtistInput = document.getElementById('selectedArtist');
      this.bookingForm = document.querySelector('.booking-form');
      this.submitButton = document.querySelector('.form-submit');
      this.preferredDateInput = document.getElementById('preferredDate');
      
      this.init();
    }

    init() {
      // Artist selection
      this.artistCards.forEach(card => {
        card.addEventListener('click', (e) => this.selectArtist(e));
      });

      // Form submission
      if (this.bookingForm) {
        this.bookingForm.addEventListener('submit', (e) => this.handleSubmit(e));
      }

      // Set minimum date to today
      if (this.preferredDateInput) {
        const today = new Date().toISOString().split('T')[0];
        this.preferredDateInput.min = today;
      }

      // Auto-select if artist is passed in URL
      this.checkURLParams();
    }

    selectArtist(e) {
      const card = e.currentTarget;
      const artistId = card.dataset.artist;

      // Remove active class from all cards
      this.artistCards.forEach(c => c.classList.remove('artist-card--selected'));

      // Add active class to selected card
      card.classList.add('artist-card--selected');

      // Update hidden input
      if (this.selectedArtistInput) {
        this.selectedArtistInput.value = artistId;
      }

      // Update form title if specific artist selected
      this.updateFormTitle(artistId);
    }

    updateFormTitle(artistId) {
      const formTitle = document.querySelector('.booking-form-section .section-title');
      if (!formTitle) return;

      if (artistId === 'none') {
        formTitle.textContent = 'Consultation Details';
      } else {
        const artistCard = document.querySelector(`[data-artist="${artistId}"]`);
        const artistName = artistCard?.querySelector('h4')?.textContent;
        if (artistName) {
          formTitle.textContent = `Consultation with ${artistName}`;
        }
      }
    }

    checkURLParams() {
      const urlParams = new URLSearchParams(window.location.search);
      const artistParam = urlParams.get('artist');
      
      if (artistParam) {
        const targetCard = document.querySelector(`[data-artist="${artistParam}"]`);
        if (targetCard) {
          targetCard.click();
        }
      }
    }

    async handleSubmit(e) {
      e.preventDefault();

      // Validate artist selection
      if (!this.selectedArtistInput.value) {
        this.showMessage('Please select an artist or "No Preference"', 'error');
        return;
      }

      // Show loading state
      this.submitButton.textContent = 'Booking Consultation...';
      this.submitButton.disabled = true;

      try {
        const formData = new FormData(this.bookingForm);
        const response = await fetch(this.bookingForm.action, {
          method: 'POST',
          body: formData,
          headers: {
            'Accept': 'application/json'
          }
        });

        if (response.ok) {
          this.showSuccess();
          this.bookingForm.reset();
          // Reset artist selection
          this.artistCards.forEach(c => c.classList.remove('artist-card--selected'));
          this.selectedArtistInput.value = '';
        } else {
          this.showMessage('There was an error booking your consultation. Please try again or call us directly.', 'error');
        }
      } catch (error) {
        this.showMessage('There was an error booking your consultation. Please try again or call us directly.', 'error');
      } finally {
        this.submitButton.textContent = 'Book Free Consultation';
        this.submitButton.disabled = false;
      }
    }

    showSuccess() {
      // Create success message
      const message = document.createElement('div');
      message.className = 'booking-message booking-message--success';
      message.innerHTML = `
        <div class="message-content">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
            <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
          </svg>
          <div>
            <h4>Consultation Booked!</h4>
            <p>Thank you for booking with us. We'll contact you within 24 hours to confirm your consultation time and answer any questions.</p>
          </div>
        </div>
      `;
      
      this.bookingForm.insertBefore(message, this.bookingForm.firstChild);
      
      // Scroll to message
      message.scrollIntoView({ behavior: 'smooth' });
      
      // Remove message after 10 seconds
      setTimeout(() => {
        message.remove();
      }, 10000);
    }

    showMessage(text, type) {
      // Create message
      const message = document.createElement('div');
      message.className = `booking-message booking-message--${type}`;
      message.innerHTML = `
        <div class="message-content">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/>
          </svg>
          <span>${text}</span>
        </div>
      `;
      
      this.bookingForm.insertBefore(message, this.bookingForm.firstChild);
      
      // Remove message after 5 seconds
      setTimeout(() => {
        message.remove();
      }, 5000);
    }
  }

  // Initialize when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => new ConsultationBooking());
  } else {
    new ConsultationBooking();
  }
</script>

<style>
  /* Consultation Hero */
  .consultation-hero {
    padding: 8rem 0 4rem;
    text-align: center;
    background: 
      radial-gradient(1000px 600px at 50% 20%, rgba(255, 60, 43, 0.03) 0%, transparent 60%);
  }

  .hero-content {
    max-width: 700px;
    margin: 0 auto;
  }

  .hero-title {
    font-size: clamp(3rem, 6vw, 4.5rem);
    margin: 1rem 0 1.5rem;
    line-height: 1.1;
  }

  .hero-description {
    font-size: 1.2rem;
    line-height: 1.6;
    opacity: 0.9;
    margin: 0;
  }

  /* Process Section */
  .consultation-process {
    padding: 6rem 0;
    background: var(--bg-glass);
    border-top: var(--border-glass);
  }

  .section-title {
    text-align: center;
    font-size: clamp(2rem, 4vw, 2.5rem);
    margin: 0 0 3rem;
    color: var(--ink);
    text-shadow: var(--glow-subtle);
  }

  .process-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
  }

  .process-step {
    text-align: center;
    padding: 2rem;
    background: rgba(255, 255, 255, 0.03);
    border: var(--border-glass);
    border-radius: 20px;
    backdrop-filter: blur(5px);
    transition: var(--transition-smooth);
  }

  .process-step:hover {
    transform: translateY(-4px);
    border-color: rgba(255, 60, 43, 0.2);
  }

  .step-number {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 60px;
    height: 60px;
    background: linear-gradient(45deg, var(--accent0), var(--accent1));
    color: var(--bg0);
    font-size: 1.5rem;
    font-weight: 700;
    border-radius: 50%;
    margin-bottom: 1.5rem;
  }

  .process-step h3 {
    font-size: 1.2rem;
    margin: 0 0 1rem;
    color: var(--ink);
    text-shadow: var(--glow-subtle);
  }

  .process-step p {
    font-size: 0.95rem;
    opacity: 0.9;
    line-height: 1.5;
    margin: 0;
  }

  /* Booking Section */
  .booking-section {
    padding: 6rem 0;
  }

  .booking-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: start;
  }

  /* Artist Selection */
  .selection-description {
    font-size: 1rem;
    opacity: 0.9;
    margin: 0 0 2rem;
    line-height: 1.6;
  }

  .artist-cards {
    display: grid;
    gap: 1rem;
  }

  .artist-card {
    background: var(--bg-glass);
    border: var(--border-glass);
    border-radius: 16px;
    padding: 1.5rem;
    cursor: pointer;
    transition: var(--transition-smooth);
    backdrop-filter: blur(10px);
  }

  .artist-card:hover,
  .artist-card--selected {
    border-color: var(--accent0);
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
    transform: translateY(-2px);
  }

  .artist-card--selected {
    background: rgba(255, 60, 43, 0.05);
  }

  .artist-card-content {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .artist-card-image {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid rgba(255, 60, 43, 0.2);
  }

  .artist-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 60px;
    height: 60px;
    background: rgba(255, 60, 43, 0.1);
    border: 2px solid rgba(255, 60, 43, 0.2);
    border-radius: 50%;
    color: var(--accent0);
  }

  .artist-card-content h4 {
    font-size: 1.1rem;
    margin: 0 0 0.25rem;
    color: var(--ink);
  }

  .artist-card-content p {
    font-size: 0.9rem;
    opacity: 0.8;
    margin: 0;
  }

  /* Booking Form */
  .booking-form-section {
    background: var(--bg-glass);
    border: var(--border-glass);
    border-radius: 24px;
    padding: 3rem;
    backdrop-filter: blur(10px);
  }

  .booking-form {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .form-section {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .form-section h3 {
    font-size: 1.3rem;
    margin: 0;
    color: var(--accent0);
    text-shadow: var(--glow-subtle);
    padding-bottom: 0.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .form-group label {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--ink);
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    padding: 1rem;
    border: var(--border-glass);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.03);
    color: var(--ink);
    font-size: 1rem;
    backdrop-filter: blur(5px);
    transition: var(--transition-smooth);
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: rgba(255, 60, 43, 0.5);
    box-shadow: 0 0 0 2px rgba(255, 60, 43, 0.2);
  }

  .form-group textarea {
    resize: vertical;
    min-height: 100px;
  }

  .checkbox-group {
    flex-direction: row;
    align-items: center;
    gap: 0.75rem;
  }

  .checkbox-group input[type="checkbox"] {
    width: auto;
    margin: 0;
  }

  .checkbox-group label {
    font-size: 0.9rem;
    font-weight: 400;
    margin: 0;
  }

  .form-submit {
    align-self: flex-start;
    padding: 1rem 2rem;
    font-size: 1rem;
    min-height: 56px;
  }

  /* Booking Messages */
  .booking-message {
    padding: 1.5rem;
    border-radius: 12px;
    margin-bottom: 2rem;
  }

  .booking-message--success {
    background: rgba(34, 197, 94, 0.1);
    border: 1px solid rgba(34, 197, 94, 0.3);
    color: #22c55e;
  }

  .booking-message--error {
    background: rgba(239, 68, 68, 0.1);
    border: 1px solid rgba(239, 68, 68, 0.3);
    color: #ef4444;
  }

  .message-content {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }

  .message-content svg {
    flex-shrink: 0;
    margin-top: 0.125rem;
