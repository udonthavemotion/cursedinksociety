  .social-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0;
    text-decoration: none;
    font-family: 'Inter', sans-serif;
    font-size: 0.9rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.8);
