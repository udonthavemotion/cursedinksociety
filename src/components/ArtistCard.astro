    padding: 0.4rem 0.8rem !important;
    border-radius: 20px !important;
    border: 1.5px solid rgba(251, 207, 232, 0.4) !important;
    font-size: 0.8rem !important;
    font-weight: 500 !important;
    text-transform: none !important;
    letter-spacing: 0.01em;
    transition: all 0.3s ease;
    box-shadow: 0 2px 6px rgba(251, 207, 232, 0.15);
  }

  .ashley-watercolor-card .skill-tag:hover {
    background: linear-gradient(135deg,
      rgba(251, 207, 232, 0.4),
      rgba(233, 213, 255, 0.35),
      rgba(255, 247, 245, 0.45)
    ) !important;
    border-color: rgba(251, 207, 232, 0.6) !important;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(251, 207, 232, 0.25);
  }

  /* Stats with gold accent */
  .ashley-watercolor-card .artist-stats {
    margin-bottom: 2rem;
  }

  /* CTA Button with pill design */
  .ashley-watercolor-card .artist-cta {
    margin-top: auto;
    padding-top: 1.5rem;
  }

  .ashley-watercolor-card .cta-btn {
    background: linear-gradient(135deg,
      rgba(251, 207, 232, 0.8),
      rgba(233, 213, 255, 0.6),
      rgba(250, 204, 21, 0.4)
    ) !important;
    color: #7c2d12 !important;
    border: 2px solid rgba(251, 207, 232, 0.6) !important;
    border-radius: 25px !important;
    font-weight: 600 !important;
    font-size: 1.1rem !important;
    text-transform: none !important;
    letter-spacing: 0.02em;
    padding: 1.2rem 2.5rem !important;
    box-shadow:
      0 6px 16px rgba(251, 207, 232, 0.3),
      0 3px 8px rgba(233, 213, 255, 0.2);
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    overflow: hidden;
  }

  .ashley-watercolor-card .cta-btn::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg,
      transparent,
      rgba(255, 255, 255, 0.4),
      transparent
    );
    transition: left 0.8s ease;
  }

  .ashley-watercolor-card .cta-btn:hover {
    background: linear-gradient(135deg,
      rgba(251, 207, 232, 0.9),
      rgba(233, 213, 255, 0.7),
      rgba(250, 204, 21, 0.5)
    ) !important;
    transform: translateY(-4px) scale(1.02);
    box-shadow:
      0 10px 24px rgba(251, 207, 232, 0.4),
      0 5px 12px rgba(233, 213, 255, 0.3);
    border-color: rgba(251, 207, 232, 0.8) !important;
  }

  .ashley-watercolor-card .cta-btn:hover::before {
    left: 100%;
  }

  .ashley-watercolor-card .btn-text {
    font-weight: 600 !important;
    font-size: 1rem !important;
  }

  .ashley-watercolor-card .btn-icon {
    font-size: 1.2rem;
    transition: transform 0.3s ease;
  }

  .ashley-watercolor-card .cta-btn:hover .btn-icon {
    transform: scale(1.1);
  }

  /* Mobile responsive adjustments for Ashley */
  @media (max-width: 768px) {
    .ashley-watercolor-card {
      padding: 1.5rem;
      border-radius: 20px !important;
    }

    .ashley-watercolor-wrapper {
      border-radius: 20px;
    }

    .ashley-watercolor-card .artist-name {
      font-size: 1.5rem !important;
    }

    .ashley-watercolor-card .artist-avatar img {
      width: 80px;
      height: 80px;
    }

    .ashley-watercolor-card .work-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.5rem;
    }

    .ashley-watercolor-card .cta-btn {
      padding: 1rem 2rem !important;
      font-size: 1rem !important;
    }
  }

  @media (max-width: 480px) {
    .ashley-watercolor-card {
      padding: 1.25rem;
      border-radius: 16px !important;
    }

    .ashley-watercolor-wrapper {
      border-radius: 16px;
    }

    .ashley-watercolor-card .artist-name {
      font-size: 1.25rem !important;
    }

    .ashley-watercolor-card .artist-avatar img {
