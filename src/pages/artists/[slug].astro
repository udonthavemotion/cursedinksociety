  /* OSRS STICKY ACTION BAR STYLES */
  .osrs-sticky-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 50;
    background: rgba(0, 0, 0, 0.95);
    backdrop-filter: blur(20px);
    border-top: 2px solid rgba(212, 175, 55, 0.3);
    box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.5);
  }

  .osrs-sticky-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .osrs-sticky-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 0;
    gap: 2rem;
  }

  .osrs-sticky-left {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex: 1;
    min-width: 0;
  }

  .osrs-sticky-icon {
    font-size: 2rem;
    filter: drop-shadow(0 0 8px rgba(212, 175, 55, 0.5));
    flex-shrink: 0;
  }

  .osrs-sticky-text {
    min-width: 0;
    flex: 1;
  }

  .osrs-sticky-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: #f5f5f5;
    margin-bottom: 0.25rem;
    text-shadow: 1px 1px 0 rgba(212, 175, 55, 0.3);
  }

  .osrs-sticky-subtitle {
    font-size: 0.9rem;
    color: rgba(245, 245, 245, 0.7);
  }

  .osrs-sticky-actions {
    display: flex;
    gap: 1rem;
    flex-shrink: 0;
  }

  .osrs-sticky-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    border-radius: 6px;
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none;
    transition: all 0.3s ease;
    border: 2px solid;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    cursor: pointer;
    position: relative;
    overflow: hidden;
  }

  .osrs-sticky-primary {
    background: linear-gradient(135deg, #d4af37, #b9931f);
    color: #0b0b0b;
    border-color: rgba(255, 255, 255, 0.3);
    box-shadow:
      0 4px 12px rgba(212, 175, 55, 0.4),
      inset 0 1px 0 rgba(255, 255, 255, 0.6);
  }

  .osrs-sticky-primary:hover {
    transform: translateY(-2px);
    box-shadow:
      0 6px 20px rgba(212, 175, 55, 0.6),
      inset 0 1px 0 rgba(255, 255, 255, 0.7);
  }

  .osrs-sticky-secondary {
    background: rgba(0, 0, 0, 0.4);
    color: #f5f5f5;
    border-color: rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(10px);
  }

  .osrs-sticky-secondary:hover {
    background: rgba(212, 175, 55, 0.1);
    border-color: rgba(212, 175, 55, 0.5);
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(212, 175, 55, 0.2);
  }

  .osrs-sticky-btn-icon {
    font-size: 1rem;
    flex-shrink: 0;
  }

  .osrs-sticky-btn-text {
    font-weight: 700;
  }

  /* Mobile optimizations for sticky bar */
  @media (max-width: 768px) {
    .osrs-sticky-container {
      padding: 0 1rem;
    }

    .osrs-sticky-content {
      padding: 0.75rem 0;
      gap: 1rem;
    }

    .osrs-sticky-left {
      gap: 0.75rem;
    }

    .osrs-sticky-icon {
      font-size: 1.5rem;
    }

    .osrs-sticky-title {
      font-size: 1rem;
    }

    .osrs-sticky-subtitle {
      font-size: 0.8rem;
    }

    .osrs-sticky-actions {
      gap: 0.5rem;
    }

    .osrs-sticky-btn {
      padding: 0.6rem 1rem;
      font-size: 0.8rem;
    }
  }

  @media (max-width: 480px) {
    .osrs-sticky-content {
      flex-direction: column;
      gap: 0.75rem;
      text-align: center;
    }

    .osrs-sticky-left {
      justify-content: center;
    }

    .osrs-sticky-actions {
      width: 100%;
      justify-content: center;
    }

    .osrs-sticky-btn {
      flex: 1;
      justify-content: center;
      max-width: 140px;
    }
  }


  /* ==========================================================================
   * SETH WOOD - OLD SCHOOL PROFESSIONAL DESIGN
   * ========================================================================== */

  /* DragonCapes Font loaded via HTML head for better performance */

  /* Seth Wood - Enhanced Seamless Styles */
  .seth-hero-seamless {
    position: relative;
    min-height: 100vh;
    overflow: hidden;
    background: #0a0a0a;
  }

  .hero-canvas {
    position: relative;
    width: 100%;
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-bg-layer {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .hero-bg-layer .hero-bg-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero-gradient-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      135deg,
      rgba(10, 10, 10, 0.8) 0%,
      rgba(10, 10, 10, 0.4) 40%,
      rgba(10, 10, 10, 0.6) 70%,
      rgba(10, 10, 10, 0.95) 100%
    );
    z-index: 2;
  }

  .artist-intro-panel {
    position: relative;
    z-index: 3;
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 4rem;
    max-width: 1200px;
    width: 100%;
    padding: 3rem;
    align-items: start;
  }

  .artist-profile-circle {
    position: relative;
    width: 200px;
    height: 200px;
    margin-bottom: 2rem;
    border-radius: 50%;
    overflow: hidden;
  }

  .artist-profile-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
    border: 4px solid #c9a96e;
    box-shadow: 
      0 0 0 8px rgba(201, 169, 110, 0.1),
      0 20px 40px rgba(0, 0, 0, 0.8);
    transition: all 0.4s ease;
  }

  .artist-profile-img:hover {
    transform: scale(1.05);
    border-color: #e6c488;
    box-shadow: 
      0 0 0 8px rgba(201, 169, 110, 0.2),
      0 25px 50px rgba(0, 0, 0, 0.9);
  }

  .profile-ring {
    position: absolute;
    top: -12px;
    left: -12px;
    right: -12px;
    bottom: -12px;
    border: 2px solid transparent;
    border-radius: 50%;
    background: linear-gradient(45deg, #c9a96e, transparent, #c9a96e);
    background-clip: padding-box;
    opacity: 0.6;
    animation: rotate 20s linear infinite;
  }

  @keyframes rotate {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  /* Artist Profile Section (Left Column) */
  .artist-profile-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .artist-core-identity {
    margin-top: 2rem;
  }

  .artist-tagline {
    font-family: 'Inter', sans-serif;
    font-size: 1.1rem;
