---
/**
 * Piercing Guidebook Section
 * Educational resource for learning about piercing types, placement, healing, and aftercare
 */
import GuideCard from './GuideCard.astro';
import { piercingGuides } from '../data/piercingGuides';
---

<section id="piercing-guides" class="piercing-guides-section" aria-labelledby="guides-heading">
  <div class="guides-container">
    <!-- Section Header -->
    <div class="section-header">
      <h2 id="guides-heading" class="section-title">Piercing Guidebook</h2>
      <p class="section-subtitle">
        Your complete educational resource for understanding piercing types, placement, healing times, and aftercare. 
        Explore each section to learn what to expect before booking your appointment with Harley.
      </p>
    </div>
    
    <!-- Age Requirement Notice -->
    <div class="age-notice" role="alert">
      <img 
        src="/piercing-guides/compliance/age-requirement.webp" 
        alt="18 and up only - Valid government-issued photo ID required"
        width="200"
        height="150"
        loading="lazy"
        decoding="async"
        class="age-notice-image"
      />
      <div class="age-notice-text">
        <strong>Age Requirement:</strong> All piercings require you to be 18+ with valid government-issued photo ID. No exceptions.
      </div>
    </div>
    
    <!-- Guides Grid -->
    <div class="guides-grid" role="list">
      {piercingGuides.map((guide, index) => (
        <GuideCard guide={guide} index={index} />
      ))}
    </div>
    
    <!-- Education Section -->
    <div class="education-section">
      <h3 class="education-title">Understanding Irritation Bumps</h3>
      <div class="education-content">
        <img 
          src="/piercing-guides/education/irritation-bumps.webp" 
          alt="Irritation bumps guide showing causes and treatment"
          width="800"
          height="600"
          loading="lazy"
          decoding="async"
          class="education-image"
        />
        <div class="education-text">
          <p>
            <strong>Irritation bumps are not infections.</strong> They're typically caused by improper aftercare, 
            snagging, sleeping on fresh piercings, or using harsh products. Most resolve with proper care adjustments.
          </p>
          <p>
            If you notice bumps forming around your piercing, contact Harley immediately. Early intervention 
            prevents complications and ensures successful healing.
          </p>
          <a href="https://www.facebook.com/harley.halford" target="_blank" rel="noopener noreferrer" class="education-link">
            Message Harley About Aftercare
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @import "../styles/tattoo-theme.css";


  .piercing-guides-section {
    padding: clamp(6rem, 12vw, 8rem) 1.5rem;
    background: #111111;
    position: relative;
  }
  
  .guides-container {
    max-width: 1200px;
    margin: 0 auto;
    position: relative;
  }
  
  /* Section Header */
  .section-header {
    text-align: center;
    margin-bottom: 3rem;
  }
  
  .section-title {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    margin: 0 0 1rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text);
  }
  
  .section-subtitle {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--muted);
    max-width: 800px;
    margin: 0 auto;
  }
  
  /* Age Notice */
  .age-notice {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 1.5rem 2rem;
    background: var(--bgcard);
    border: 1px solid rgba(255, 200, 0, 0.3);
    border-radius: 4px;
    margin-bottom: 3rem;
    flex-wrap: wrap;
  }
  
  .age-notice-image {
    width: 100px;
    height: auto;
    flex-shrink: 0;
  }
  
  .age-notice-text {
    flex: 1;
    min-width: 250px;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--text);
  }
  
  .age-notice-text strong {
    color: #ffc800;
    font-weight: 700;
  }
  
  /* Guides Grid */
  .guides-grid {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    margin-bottom: 4rem;
  }
  
  /* Education Section */
  .education-section {
    padding: 1.5rem;
    background: var(--bgcard);
    border: 1px solid var(--line);
    border-radius: 4px;
    margin-top: 4rem;
    max-width: 780px;
    margin-left: auto;
    margin-right: auto;
  }
  
  .education-title {
    font-size: clamp(1.25rem, 3vw, 1.5rem);
    margin: 0 0 1.5rem;
    color: var(--text);
    font-weight: 800;
    text-align: center;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  
  .education-content {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    align-items: start;
  }
  
  @media (min-width: 768px) {
    .education-content {
      grid-template-columns: 260px 1fr;
      gap: 1.5rem;
    }
  }
  
  .education-image {
    width: 100%;
    height: auto;
    border-radius: 4px;
    border: 1px solid var(--line);
  }
  
  .education-text {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  
  .education-text p {
    margin: 0;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--muted);
  }
  
  .education-text strong {
    color: var(--text);
    font-weight: 600;
  }
  
  .education-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 1.25rem;
    height: 44px;
    background: transparent;
    border: 1px solid var(--text);
    color: var(--text);
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
    border-radius: 4px;
    transition: all 0.15s ease-out;
    align-self: flex-start;
  }
  
  .education-link:hover,
  .education-link:focus-visible {
    background: var(--accent);
    border-color: var(--accent);
    color: #000;
  }
  
  .education-link:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  
  /* Responsive */
  @media (max-width: 767px) {
    .piercing-guides-section {
      padding: clamp(4rem, 8vw, 6rem) 1rem;
    }
    
    .age-notice {
      padding: 1rem 1.25rem;
      gap: 1rem;
    }
    
    .age-notice-image {
      width: 70px;
    }
    
    .education-section {
      padding: 1.25rem;
    }

    .education-content {
      grid-template-columns: 1fr;
    }
  }

  /* Reduced Motion */
  @media (prefers-reduced-motion: reduce) {
    .education-link {
      transition: none;
    }
  }
</style>

<script>
  // Smooth scroll for anchor links
  document.querySelectorAll('a[href^="#piercing-guides"]').forEach(anchor => {
    anchor.addEventListener('click', function(e) {
      e.preventDefault();
      const target = document.querySelector('#piercing-guides');
      if (target) {
        target.scrollIntoView({
          behavior: 'smooth',
          block: 'start'
        });
      }
    });
  });
</script>

