---
export interface Props {
  src: string;
  poster?: string;
  width?: number;
  height?: number;
  autoplay?: boolean;
  muted?: boolean;
  loop?: boolean;
  controls?: boolean;
  loading?: 'lazy' | 'eager';
  class?: string;
  priority?: boolean;
}

const {
  src,
  poster,
  width,
  height,
  autoplay = false,
  muted = true,
  loop = false,
  controls = false,
  loading = 'lazy',
  class: className = '',
  priority = false
} = Astro.props;

// Convert relative paths to absolute
const videoSrc = src.startsWith('/') ? src : `/${src}`;
const posterSrc = poster ? (poster.startsWith('/') ? poster : `/${poster}`) : undefined;

// Determine loading strategy
const videoLoading = priority ? 'eager' : loading;

// Generate video attributes
const videoAttrs = {
  width,
  height,
  autoplay: autoplay && muted, // Only autoplay if muted (browser requirement)
  muted,
  loop,
  controls,
  playsinline: true, // Required for iOS
  preload: priority ? 'metadata' : 'none'
};
---

<video
  {...videoAttrs}
  src={videoSrc}
  poster={posterSrc}
  loading={videoLoading}
  class={`transition-opacity duration-300 ${className}`}
  onloadstart="this.style.opacity='1'"
  onerror="this.style.display='none'"
>
  <source src={videoSrc} type="video/mp4" />
  Your browser does not support the video tag.
</video>

<style>
  video {
    max-width: 100%;
    height: auto;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  
  video[loading="lazy"] {
    background-color: #000;
    background-image: 
      radial-gradient(circle, #333 1px, transparent 1px);
    background-size: 20px 20px;
    animation: videoLoading 2s ease-in-out infinite alternate;
  }
  
  @keyframes videoLoading {
    0% { background-position: 0 0; }
    100% { background-position: 20px 20px; }
  }
  
  /* Remove loading animation when video loads */
  video[loading="lazy"]:not([src=""]) {
    animation: none;
    background: none;
  }
  
  /* Ensure video fills container properly */
  video[data-fullwidth="true"] {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>

<script>
  // Intersection Observer for lazy loading
  if ('IntersectionObserver' in window) {
    const videoObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const video = entry.target as HTMLVideoElement;
          if (video.dataset.src) {
            video.src = video.dataset.src;
            video.load();
            videoObserver.unobserve(video);
          }
        }
      });
    });
    
    document.querySelectorAll('video[loading="lazy"]').forEach((video) => {
      videoObserver.observe(video);
    });
  }
</script>
