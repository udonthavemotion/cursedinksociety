            class="hero-bg-image"
            loading="eager"
            width="1920"
            height="1080"
            decoding="async"
          />
        </div>
        
        <!-- Gradient Overlay for Seamless Transition -->
        <div class="hero-gradient-overlay"></div>
        
        <!-- Enhanced Artist Introduction Layout -->
        <div class="artist-intro-panel">
          <!-- Left Column: Profile & Core Identity -->
          <div class="artist-profile-section">
            <div class="artist-profile-circle">
              <img
                src="/assets/artists/seth-wood/SETH PROFILE PICTURE.jpg"
                alt="Seth Wood - Master Tattoo Artist"
                class="artist-profile-img"
                loading="eager"
                width="320"
                height="320"
              />
              <div class="profile-ring"></div>
            </div>
            
            <div class="artist-core-identity">
              <h1 class="artist-name">{artist.name}</h1>
              <div class="artist-tagline">Illustrative Neo-Traditional Mastery</div>
              <div class="experience-badge">
                <span class="experience-number">10+</span>
                <span class="experience-text">Years<br>Experience</span>
              </div>
            </div>
          </div>
          
          <!-- Right Column: Specialization & Flow -->
          <div class="artist-specialization-section">
