  /* ===========================================
     ASHLEY WOOD WATERCOLOR PORTFOLIO STYLES
     =========================================== */

  /* Watercolor Background Overlay */
  .watercolor-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background:
      radial-gradient(circle at 15% 20%, rgba(251, 207, 232, 0.08) 0%, transparent 50%),
      radial-gradient(circle at 85% 80%, rgba(233, 213, 255, 0.08) 0%, transparent 50%),
      radial-gradient(circle at 70% 40%, rgba(255, 247, 245, 0.06) 0%, transparent 40%),
      linear-gradient(135deg, rgba(251, 207, 232, 0.03), rgba(233, 213, 255, 0.03));
    pointer-events: none;
    z-index: -1;
  }

  /* Hero Section */
  .ashley-hero {
    position: relative;
    background: linear-gradient(135deg,
      rgba(251, 207, 232, 0.1),
      rgba(233, 213, 255, 0.08),
      rgba(255, 247, 245, 0.12),
      rgba(251, 207, 232, 0.06)
    );
    padding: 6rem 0;
    overflow: hidden;
  }

  .ashley-hero::before {
    content: '';
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background:
      radial-gradient(circle at 30% 20%, rgba(251, 207, 232, 0.15) 0%, transparent 60%),
      radial-gradient(circle at 70% 80%, rgba(233, 213, 255, 0.15) 0%, transparent 60%),
      radial-gradient(circle at 50% 50%, rgba(255, 247, 245, 0.1) 0%, transparent 50%);
    animation: watercolor-float 20s ease-in-out infinite;
    pointer-events: none;
  }

  @keyframes watercolor-float {
    0%, 100% { transform: translate(0, 0) rotate(0deg); }
    25% { transform: translate(-10px, -10px) rotate(1deg); }
    50% { transform: translate(10px, -20px) rotate(-1deg); }
    75% { transform: translate(-5px, 10px) rotate(0.5deg); }
  }

  .ashley-hero-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
    position: relative;
    z-index: 2;
  }

  /* Avatar Frame */
  .watercolor-frame {
    position: relative;
    border-radius: 50%;
    padding: 8px;
    background: linear-gradient(135deg,
      rgba(251, 207, 232, 0.6),
      rgba(233, 213, 255, 0.4),
      rgba(255, 247, 245, 0.5)
    );
    box-shadow:
      0 8px 24px rgba(251, 207, 232, 0.3),
      0 4px 12px rgba(233, 213, 255, 0.2),
      inset 0 2px 0 rgba(255, 255, 255, 0.4);
  }

  .ashley-avatar {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    border: 4px solid rgba(255, 255, 255, 0.8);
    transition: all 0.4s ease;
  }

  .ashley-avatar:hover {
    transform: scale(1.05);
    box-shadow: 0 12px 32px rgba(251, 207, 232, 0.4);
  }

  /* Badge */
  .watercolor-badge {
    background: linear-gradient(135deg,
      rgba(251, 207, 232, 0.8),
      rgba(233, 213, 255, 0.6),
      rgba(250, 204, 21, 0.4)
