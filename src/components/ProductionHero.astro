---
/**
 * Production-Optimized Hero Component
 * - No Three.js initially (loads via intersection observer)
 * - No staggered animations on load (instant render)
 * - Progressive enhancement after page interactive
 * - Simplified shadows (single layer)
 * - Content-visibility optimization
 */
---

<section class="hero-prod" id="hero">
  <!-- Simple gradient background - no canvas initially -->
  <div class="hero-bg"></div>
  
  <!-- Optional canvas for Three.js - loaded lazily -->
  <canvas id="hero-canvas" class="hero-canvas" style="opacity: 0;"></canvas>

  <div class="hero-content">
    <div class="container">
      <div class="hero-main">
        <!-- Text Section -->
        <div class="hero-text">
          <div class="hero-pretitle">
            <span class="pretitle-accent">✦</span>
            <span class="pretitle-text">HOUMA'S PREMIER TATTOO COLLECTIVE</span>
            <span class="pretitle-accent">✦</span>
          </div>

          <h1 class="hero-title">
            <span class="title-word">CURSED</span>
            <span class="title-word">INK</span>
            <span class="title-word">SOCIETY</span>
          </h1>

          <p class="hero-subtitle">
            Where artistry meets the mystical in Houma, Louisiana
          </p>

          <p class="hero-description">
            Our collective of master artists—Anthony, Ashley, Cody, Seth, Luis, and Trent—specializes in custom designs, traditional work, and sacred ink that tells your story.
          </p>

          <div class="hero-stats">
            <div class="stat-item">
              <div class="stat-number">150+</div>
              <div class="stat-label">Masterpieces</div>
            </div>
            <div class="stat-item">
              <div class="stat-number">6</div>
              <div class="stat-label">Expert Artists</div>
            </div>
            <div class="stat-item">
              <div class="stat-number">38+</div>
              <div class="stat-label">Years</div>
            </div>
          </div>

          <div class="hero-actions">
            <div class="social-links-container">
              <h3 class="social-heading">Follow Us on Socials</h3>
              <div class="social-links">
                <a href="https://instagram.com/cursedinksociety" class="social-link instagram" target="_blank" rel="noopener noreferrer">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M7 2h10a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5V7a5 5 0 0 1 5-5zm5 5a5 5 0 1 0 .001 10.001A5 5 0 0 0 12 7zm0 2.2a2.8 2.8 0 1 1 0 5.6 2.8 2.8 0 0 1 0-5.6zM18 6.5a1 1 0 1 0 0 2 1 1 0 0 0 0-2z"/>
                  </svg>
                  Instagram
                </a>
                <a href="https://facebook.com/cursedinksociety" class="social-link facebook" target="_blank" rel="noopener noreferrer">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                  </svg>
                  Facebook
                </a>
              </div>
            </div>
            
            <div class="artists-link-container">
              <a href="/artists" class="artists-link">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M16 4c0-1.11.89-2 2-2s2 .89 2 2-.89 2-2 2-2-.89-2-2zm4 18v-6h2.5l-2.54-7.63C19.68 7.55 18.92 7 18.06 7h-.12c-.86 0-1.63.55-1.9 1.37L14.5 16H17v6h3z"/>
                </svg>
                Meet Our Artists
              </a>
            </div>
          </div>
        </div>

        <!-- Visual Section -->
        <div class="hero-visual">
          <div class="logo-container">
            <img
              src="/brand/cursed-ink-logo.png"
              alt="Cursed Ink Society Logo"
              class="hero-logo"
              loading="eager"
              width="350"
              height="350"
              fetchpriority="high"
            />
          </div>
        </div>
      </div>

      <!-- Scroll Indicator - Hidden on Mobile -->
      <div class="scroll-indicator">
        <span class="scroll-text">Explore Our World</span>
        <div class="scroll-line"></div>
        <svg class="scroll-arrow" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
          <path d="M7.41 8.59L12 13.17l4.59-4.58L18 10l-6 6-6-6 1.41-1.41z"/>
        </svg>
      </div>
    </div>
  </div>
</section>

<style>
  /* PRODUCTION HERO - Optimized for instant render */
  .hero-prod {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 50% 50%, rgba(255, 60, 43, 0.12) 0%, transparent 50%),
      radial-gradient(circle at 80% 20%, rgba(255, 122, 24, 0.08) 0%, transparent 50%),
      linear-gradient(135deg, #0b0b0d 0%, #1a1a1f 50%, #0b0b0d 100%);
    z-index: 1;
  }

  .hero-canvas {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    transition: opacity 1s ease;
  }

  .hero-content {
    position: relative;
    z-index: 10;
    width: 100%;
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding: 2rem 0;
  }

  .hero-main {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
    max-width: 100%;
  }

  .hero-text {
    max-width: 100%;
  }

  /* Typography - Simplified (single-layer shadows) */
  .hero-pretitle {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.9rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    color: #ffffff;
    margin-bottom: 2rem;
    text-shadow: 0 0 10px rgba(255, 60, 43, 0.6);
  }

  .pretitle-accent {
    color: var(--accent0);
    font-size: 1.2rem;
  }

  .hero-title {
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    font-weight: 700;
    line-height: 1.1;
    margin-bottom: 1.5rem;
    font-family: 'Cinzel', serif;
    text-align: center;
    background: linear-gradient(45deg, var(--accent0), var(--accent1));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    filter: drop-shadow(0 0 15px rgba(255, 60, 43, 0.4));
  }

  .title-word {
    display: inline-block;
    margin-right: 0.2em;
    margin-bottom: 0.3em;
  }

  .hero-subtitle {
    font-size: 1.3rem;
    color: #ffffff;
    font-weight: 500;
    margin-bottom: 1.5rem;
    text-shadow: 0 0 10px rgba(255, 60, 43, 0.5);
  }

  .hero-description {
    font-size: 1.15rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.85);
    margin-bottom: 2.5rem;
    max-width: 550px;
  }

  /* Stats Section */
  .hero-stats {
    display: flex;
    justify-content: center;
    gap: clamp(3rem, 8vw, 6rem);
    margin-bottom: 3rem;
    position: relative;
  }

  .stat-item {
    text-align: center;
    position: relative;
    transition: transform 0.3s ease;
  }

  .stat-item:hover {
    transform: translateY(-4px);
  }

  .stat-number {
    font-size: clamp(2.8rem, 6vw, 4rem);
    font-weight: 900;
    color: var(--accent0);
    margin-bottom: 0.8rem;
    text-shadow: 0 0 20px rgba(255, 60, 43, 0.5);
    line-height: 0.9;
    font-family: 'Cinzel', serif;
    background: linear-gradient(135deg, var(--accent0) 0%, var(--accent1) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    filter: drop-shadow(0 0 15px rgba(255, 60, 43, 0.3));
  }

  .stat-label {
    font-size: clamp(0.8rem, 2vw, 1rem);
    color: rgba(255, 255, 255, 0.75);
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  /* Actions Section */
  .hero-actions {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    align-items: center;
  }

  .social-links-container {
    text-align: center;
  }

  .social-heading {
    font-size: 1.4rem;
    font-weight: 600;
    color: #ffffff;
    margin-bottom: 1.5rem;
    text-shadow: 0 0 10px rgba(255, 60, 43, 0.6);
    letter-spacing: 0.02em;
  }

  .social-links {
    display: flex;
    gap: 2rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.9rem 1.8rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 50px;
    color: var(--ink);
    text-decoration: none;
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
  }

  .social-link:hover {
    transform: translateY(-3px);
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 60, 43, 0.3);
    color: var(--accent0);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
  }

  .social-link svg {
    width: 20px;
    height: 20px;
    opacity: 0.8;
    transition: opacity 0.3s ease;
  }

  .social-link:hover svg {
    opacity: 1;
  }

  /* Artists Link */
  .artists-link-container {
    text-align: center;
  }

  .artists-link {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: rgba(255, 255, 255, 0.7);
    text-decoration: none;
    font-size: 1.1rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    transition: all 0.3s ease;
    padding: 0.8rem 1.2rem;
    border-radius: 8px;
  }

  .artists-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    width: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--accent0), var(--accent1));
    transition: all 0.3s ease;
    transform: translateX(-50%);
  }

  .artists-link:hover {
    color: var(--accent0);
    transform: translateY(-2px);
  }

  .artists-link:hover::after {
    width: 100%;
  }

  .artists-link svg {
    width: 18px;
    height: 18px;
    opacity: 0.6;
    transition: all 0.3s ease;
  }

  .artists-link:hover svg {
    opacity: 1;
  }

  /* Logo Section */
  .hero-visual {
    position: relative;
  }

  .logo-container {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .hero-logo {
    width: 350px;
    height: auto;
    filter: drop-shadow(0 0 20px rgba(255, 60, 43, 0.5));
    transition: all 0.3s ease;
  }

  .hero-logo:hover {
    filter: drop-shadow(0 0 30px rgba(255, 60, 43, 0.7));
    transform: scale(1.02);
  }

  /* Scroll Indicator */
  .scroll-indicator {
    position: absolute;
    bottom: 3rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .scroll-indicator:hover {
    transform: translateX(-50%) translateY(-5px);
  }

  .scroll-text {
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.7);
    letter-spacing: 0.1em;
    font-weight: 500;
  }

  .scroll-line {
    width: 2px;
    height: 60px;
    background: linear-gradient(to bottom, var(--accent1), var(--accent0));
    border-radius: 1px;
  }

  .scroll-arrow {
    color: var(--accent1);
    animation: bounce 2s infinite;
  }

  @keyframes bounce {
    0%, 20%, 50%, 80%, 100% {
      transform: translateY(0);
    }
    40% {
      transform: translateY(-10px);
    }
    60% {
      transform: translateY(-5px);
    }
  }

  /* Mobile Responsive */
  @media (max-width: 768px) {
    .hero-main {
      grid-template-columns: 1fr;
      gap: 2rem;
      text-align: center;
      padding: 2rem 1rem;
    }

    .hero-text {
      order: 2;
    }

    .hero-visual {
      order: 1;
      margin-bottom: 2rem;
    }

    .hero-title {
      font-size: clamp(1.8rem, 6vw, 2.8rem);
    }

    .hero-subtitle {
      font-size: 1.1rem;
    }

    .hero-description {
      font-size: 1rem;
      padding: 0 1rem;
    }

    .hero-stats {
      gap: 2.5rem;
      flex-wrap: wrap;
    }

    .hero-actions {
      gap: 2rem;
    }

    .social-links {
      gap: 1.5rem;
    }

    .social-link {
      padding: 0.8rem 1.5rem;
      font-size: 0.95rem;
    }

    .hero-logo {
      width: 220px;
    }

    .scroll-indicator {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .hero-content {
      padding: 3rem 0 1rem;
    }

    .hero-main {
      padding: 1rem 0.5rem;
    }

    .hero-title {
      font-size: clamp(1.5rem, 5.5vw, 2.2rem);
      padding: 0 1rem;
    }

    .hero-stats {
      gap: 1rem;
    }

    .stat-number {
      font-size: clamp(1.8rem, 6vw, 2.5rem);
    }

    .social-links {
      flex-direction: column;
      gap: 1rem;
      align-items: center;
    }

    .social-link {
      width: 100%;
      max-width: 280px;
      justify-content: center;
    }

    .hero-logo {
      width: 200px;
    }
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .scroll-arrow,
    .pretitle-accent {
      animation: none !important;
    }

    .stat-item:hover {
      transform: none;
    }

    .hero-logo:hover {
      transform: none;
    }
  }
</style>

<script>
  // Progressive enhancement - load Three.js lazily via intersection observer
  const loadThreeJS = () => {
    const canvas = document.getElementById('hero-canvas') as HTMLCanvasElement;
    if (!canvas) return;

    // Check for reduced motion
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const isMobile = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);

    // Skip Three.js on mobile or reduced motion
    if (prefersReducedMotion || isMobile) {
      return;
    }

    // Lazy load Three.js when hero is in viewport
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          observer.disconnect();
          
          // Load after idle
          if ('requestIdleCallback' in window) {
            requestIdleCallback(() => initThreeJS(canvas), { timeout: 2000 });
          } else {
            setTimeout(() => initThreeJS(canvas), 1000);
          }
        }
      });
    }, { threshold: 0.1 });

    observer.observe(canvas);
  };

  const initThreeJS = async (canvas: HTMLCanvasElement) => {
    try {
      // Dynamic import of Three.js
      const THREE = await import('three');

      const renderer = new THREE.WebGLRenderer({
        canvas,
        antialias: false,
        alpha: true,
        powerPreference: 'low-power'
      });

      const scene = new THREE.Scene();
      const camera = new THREE.PerspectiveCamera(75, 2, 0.1, 100);
      camera.position.set(0, 0, 5);

      // Resize
      const resize = () => {
        const { clientWidth: w, clientHeight: h } = canvas;
        if (canvas.width !== w || canvas.height !== h) {
          renderer.setSize(w, h, false);
          camera.aspect = w / h;
          camera.updateProjectionMatrix();
        }
      };

      resize();
      new ResizeObserver(resize).observe(canvas);
      renderer.setPixelRatio(Math.min(1.5, window.devicePixelRatio || 1));

      // Particles
      const particleCount = 300;
      const geometry = new THREE.BufferGeometry();
      const positions = new Float32Array(particleCount * 3);

      for (let i = 0; i < particleCount; i++) {
        const i3 = i * 3;
        positions[i3] = (Math.random() - 0.5) * 20;
        positions[i3 + 1] = (Math.random() - 0.5) * 12;
        positions[i3 + 2] = -(Math.random() * 8 + 2);
      }

      geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));

      const particleMaterial = new THREE.PointsMaterial({
        color: 0xffe7d0,
        size: 0.015,
        transparent: true,
        opacity: 0.4,
        blending: THREE.AdditiveBlending,
        depthWrite: false
      });

      const particles = new THREE.Points(geometry, particleMaterial);
      scene.add(particles);

      // Mouse interaction
      const mouse = new THREE.Vector2();
      let mouseUpdateId = 0;

      const updateMouse = (e: PointerEvent) => {
        cancelAnimationFrame(mouseUpdateId);
        mouseUpdateId = requestAnimationFrame(() => {
          mouse.x = (e.clientX / window.innerWidth) * 2 - 1;
          mouse.y = -(e.clientY / window.innerHeight) * 2 + 1;
        });
      };

      window.addEventListener('pointermove', updateMouse, { passive: true });

      // Animation
      const clock = new THREE.Clock();
      let animationId: number;

      const animate = () => {
        animationId = requestAnimationFrame(animate);

        const dt = clock.getDelta();

        camera.position.x += (mouse.x * 0.3 - camera.position.x) * 0.02;
        camera.position.y += (-mouse.y * 0.2 - camera.position.y) * 0.02;
        camera.lookAt(0, 0, 0);

        particles.rotation.y += dt * 0.005;

        renderer.render(scene, camera);
      };

      animate();

      // Show canvas
      canvas.style.opacity = '1';

      // Cleanup
      window.addEventListener('beforeunload', () => {
        cancelAnimationFrame(animationId);
        renderer.dispose();
        geometry.dispose();
        particleMaterial.dispose();
      });

    } catch (error) {
      console.warn('Three.js failed to load:', error);
    }
  };

  // Initialize on load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', loadThreeJS);
  } else {
    loadThreeJS();
  }

  // Scroll indicator
  const scrollIndicator = document.querySelector('.scroll-indicator');
  scrollIndicator?.addEventListener('click', () => {
    const nextSection = document.querySelector('section:nth-of-type(2)');
    nextSection?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });
</script>

