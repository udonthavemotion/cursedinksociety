---
// Sample gallery data - in production this would come from a CMS or data file
const galleryItems = [
  {
    id: 1,
    image: "/assets/gallery-1.jpg",
    title: "Sacred Geometry",
    artist: "Seth Wood",
    category: "Traditional"
  },
  {
    id: 2,
    image: "/assets/gallery-2.jpg", 
    title: "Mystical Portrait",
    artist: "Ashley Wood",
    category: "Realism"
  },
  {
    id: 3,
    image: "/assets/gallery-3.jpg",
    title: "Dragon's Embrace",
    artist: "Anthony Boudreaux", 
    category: "Japanese"
  },
  {
    id: 4,
    image: "/assets/gallery-4.jpg",
    title: "Shadow Work",
    artist: "Luis Reymundo",
    category: "Black & Grey"
  },
  {
    id: 5,
    image: "/assets/gallery-5.jpg",
    title: "Floral Mandala",
    artist: "Cody Crochet",
    category: "Color"
  },
  {
    id: 6,
    image: "/assets/gallery-6.jpg",
    title: "Occult Symbols",
    artist: "Trent",
    category: "Traditional"
  }
];
---

<section class="blob-gallery">
  <div class="container">
    <div class="gallery-header">
      <h2 class="gallery-title shine">Mystical Manifestations</h2>
      <p class="gallery-subtitle">Witness the transformation of flesh into sacred art</p>
    </div>
    
    <div class="blob-grid">
      {galleryItems.map((item, index) => (
        <div 
          class="blob-item" 
          data-category={item.category.toLowerCase()}
          style={`--delay: ${index * 0.1}s`}
        >
          <div class="blob-shape">
            <div class="blob-inner">
              <img 
                src={item.image} 
                alt={`${item.title} by ${item.artist}`}
                loading="lazy"
                decoding="async"
              />
              <div class="blob-overlay">
                <div class="spotlight-reveal">
                  <div class="item-info">
                    <h3 class="item-title">{item.title}</h3>
                    <p class="item-artist">by {item.artist}</p>
                    <span class="item-category">{item.category}</span>
                  </div>
                  <div class="item-actions">
                    <button class="btn btn--ghost" data-action="view">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/>
                      </svg>
                      View
                    </button>
                    <button class="btn btn--ghost" data-action="book">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M19 3h-1V1h-2v2H8V1H6v2H5c-1.11 0-1.99.9-1.99 2L3 19c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V8h14v11zM7 10h5v5H7z"/>
                      </svg>
                      Book
                    </button>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
    
    <div class="gallery-cta">
      <a href="/gallery" class="btn btn--primary">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
          <path d="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z"/>
        </svg>
        Explore Full Gallery
      </a>
    </div>
  </div>
</section>

<style>
  .blob-gallery {
    padding: 6rem 0;
    position: relative;
    overflow: hidden;
  }

  .gallery-header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .gallery-title {
    font-size: clamp(2.5rem, 5vw, 4rem);
    margin-bottom: 1rem;
  }

  .gallery-subtitle {
    font-size: 1.2rem;
    opacity: 0.8;
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.6;
    text-shadow: var(--glow-warm);
  }

  /* Organic Blob Grid */
  .blob-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  /* Blob Item Container */
  .blob-item {
    position: relative;
    aspect-ratio: 1;
    animation: blobFadeIn 0.8s ease-out forwards;
    animation-delay: var(--delay);
    opacity: 0;
  }

  @keyframes blobFadeIn {
    from {
      opacity: 0;
      transform: translateY(30px) scale(0.9);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  /* Organic Blob Shape - Architectural Lighting */
  .blob-shape {
    width: 100%;
    height: 100%;
    border-radius: 60% 40% 30% 70% / 60% 30% 70% 40%;
    overflow: hidden;
    position: relative;
    transition: var(--transition-material);
    background: 
      var(--marble-base),
      var(--glass-light);
    border: 2px solid rgba(255, 255, 255, 0.15);
    animation: blobMorph 10s ease-in-out infinite;
    box-shadow: var(--shadow-soft);
  }

  @keyframes blobMorph {
    0%, 100% {
      border-radius: 60% 40% 30% 70% / 60% 30% 70% 40%;
    }
    25% {
      border-radius: 30% 60% 70% 40% / 50% 60% 30% 60%;
    }
    50% {
      border-radius: 50% 60% 30% 60% / 60% 30% 60% 40%;
    }
    75% {
      border-radius: 60% 40% 60% 30% / 30% 60% 40% 70%;
    }
  }

  .blob-item:hover .blob-shape {
    border-color: rgba(255, 255, 255, 0.6);
    box-shadow: var(--rim-glow), var(--shadow-medium);
    transform: scale(1.05);
  }

  /* Inner Content */
  .blob-inner {
    width: 100%;
    height: 100%;
    position: relative;
    overflow: hidden;
  }

  .blob-inner img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: var(--transition-smooth);
  }

  .blob-item:hover .blob-inner img {
    transform: scale(1.1);
  }

  /* Spotlight Overlay */
  .blob-overlay {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, transparent 30%, rgba(0, 0, 0, 0.8) 70%);
    opacity: 0;
    transition: var(--transition-glow);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .blob-item:hover .blob-overlay {
    opacity: 1;
  }

  /* Spotlight Reveal Effect */
  .spotlight-reveal {
    text-align: center;
    transform: translateY(20px);
    transition: var(--transition-glow);
    padding: 1rem;
  }

  .blob-item:hover .spotlight-reveal {
    transform: translateY(0);
  }

  .item-info {
    margin-bottom: 1.5rem;
  }

  .item-title {
    font-size: 1.3rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
    text-shadow: var(--glow-inferno-subtle);
  }

  .item-artist {
    font-size: 1rem;
    opacity: 0.9;
    margin-bottom: 0.5rem;
    color: var(--electric-blue);
  }

  .item-category {
    display: inline-block;
    background: rgba(255, 51, 0, 0.2);
    color: var(--inferno-start);
    padding: 0.3rem 0.8rem;
    border-radius: 20px;
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* Action Buttons */
  .item-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
  }

  .btn--ghost {
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: var(--ink);
    padding: 0.6rem 1rem;
    font-size: 0.9rem;
    backdrop-filter: blur(10px);
  }

  .btn--ghost:hover {
    background: rgba(255, 51, 0, 0.2);
    border-color: var(--inferno-start);
    color: var(--inferno-start);
    box-shadow: var(--glow-inferno-subtle);
  }

  /* Gallery CTA */
  .gallery-cta {
    text-align: center;
    margin-top: 4rem;
  }

  /* Category-based styling */
  .blob-item[data-category="traditional"] .blob-shape {
    border-color: rgba(220, 20, 60, 0.3);
  }

  .blob-item[data-category="realism"] .blob-shape {
    border-color: rgba(0, 123, 255, 0.3);
  }

  .blob-item[data-category="japanese"] .blob-shape {
    border-color: rgba(212, 175, 55, 0.3);
  }

  .blob-item[data-category="black & grey"] .blob-shape {
    border-color: rgba(192, 192, 192, 0.3);
  }

  .blob-item[data-category="color"] .blob-shape {
    border-color: rgba(255, 102, 0, 0.3);
  }

  /* Responsive Design */
  @media (max-width: 768px) {
    .blob-gallery {
      padding: 4rem 0;
    }

    .blob-grid {
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 1.5rem;
    }

    .gallery-header {
      margin-bottom: 3rem;
    }

    .item-actions {
      flex-direction: column;
      gap: 0.8rem;
    }

    .btn--ghost {
      width: 100%;
      max-width: 160px;
    }
  }

  /* Reduced Motion */
  @media (prefers-reduced-motion: reduce) {
    .blob-shape {
      animation: none;
    }
    
    .blob-item {
      animation: none;
      opacity: 1;
    }
    
    .blob-item:hover .blob-shape {
      transform: none;
    }
    
    .blob-item:hover .blob-inner img {
      transform: none;
    }
  }
</style>

<script>
  // Enhanced gallery interactions
  class BlobGallery {
    constructor() {
      this.init();
    }

    init() {
      this.setupIntersectionObserver();
      this.setupActionHandlers();
    }

    setupIntersectionObserver() {
      const options = {
        threshold: 0.2,
        rootMargin: '0px 0px -50px 0px'
      };

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.style.animationPlayState = 'running';
          }
        });
      }, options);

      document.querySelectorAll('.blob-item').forEach(item => {
        observer.observe(item);
      });
    }

    setupActionHandlers() {
      document.querySelectorAll('[data-action]').forEach(button => {
        button.addEventListener('click', (e) => {
          // Only prevent default for buttons that need custom handling
          if (button.dataset.action === 'view') {
            e.preventDefault();
          }
          const action = (button as HTMLElement).dataset.action;
          const blobItem = button.closest('.blob-item') as HTMLElement;
          const category = blobItem?.dataset.category;
          
          if (action === 'view') {
            this.handleView(blobItem);
          } else if (action === 'book') {
            this.handleBook(category);
          }
        });
      });
    }

    handleView(item: HTMLElement | null) {
      // In production, this would open a lightbox or navigate to detail page
      console.log('Opening gallery item:', item);
      // For now, just add a visual feedback
      if (item) {
        item.style.transform = 'scale(0.95)';
        setTimeout(() => {
          item.style.transform = '';
        }, 150);
      }
    }

    handleBook(category: string | undefined) {
      // Navigate to consultation with category pre-selected
      if (category) {
        const params = new URLSearchParams({ category });
        window.location.href = `/consultation?${params.toString()}`;
      }
    }
  }

  // Initialize when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => new BlobGallery());
  } else {
    new BlobGallery();
  }
</script>
