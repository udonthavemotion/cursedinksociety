---
export interface Props {
  showPreviewButton?: boolean;
  previewUrl?: string;
}

const { 
  showPreviewButton = false, 
  previewUrl = "/" 
} = Astro.props;
---

<style>
/* Fallback hero styling for when Three.js fails */
.hero-fallback {
  background: 
    radial-gradient(ellipse 800px 400px at 50% 20%, rgba(255, 122, 24, 0.08) 0%, transparent 50%),
    radial-gradient(ellipse 600px 300px at 80% 70%, rgba(255, 60, 43, 0.06) 0%, transparent 50%),
    linear-gradient(135deg, #0b0b0d 0%, #1a1a1f 50%, #0b0b0d 100%);
  min-height: 100vh;
  display: grid;
  place-items: center;
  text-align: center;
}

/* Performance-optimized canvas */
#ink-canvas {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
  pointer-events: none;
  will-change: transform;
  /* GPU layer promotion */
  transform: translateZ(0);
}

/* Logo styling optimized for performance */
.logo-centerpiece {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  padding: 2rem 0;
  z-index: 10;
}

.logo-container {
  position: relative;
  display: inline-block;
  margin-bottom: 4rem;
  perspective: 1200px;
}

.logo {
  transition: transform 0.15s ease-out;
  transform-style: preserve-3d;
  will-change: transform;
  filter: drop-shadow(0 0 60px rgba(255, 255, 255, 0.8));
  height: 240px;
  width: auto;
  position: relative;
  z-index: 10;
}

/* Reduced motion support */
@media (prefers-reduced-motion: reduce) {
  .logo {
    filter: drop-shadow(0 0 40px rgba(255, 255, 255, 0.6));
  }
}

/* Mobile optimizations */
@media (max-width: 768px) {
  .logo {
    height: 180px;
  }
}
</style>

<section class="hero" id="hero-section">
  <canvas id="ink-canvas" aria-hidden="true" role="presentation"></canvas>
  <div class="content container">
    <div class="logo-centerpiece">
      
      <!-- Centered Logo -->
      <div class="logo-container">
        <img 
          class="logo" 
          id="rotating-logo"
          src="/brand/cursed-ink-logo.webp" 
          alt="Cursed Ink Society - Professional tattoo artistry and mystical designs" 
          loading="eager"
          decoding="async"
        />
      </div>
      
      <!-- Brand Mark -->
      <div class="brand-mark">Cursed Ink Society</div>
      
      <!-- Tagline -->
      <p class="tagline">Opening soon - Where artistry meets the mystical</p>

      <!-- Countdown -->
      <div 
        id="countdown" 
        class="countdown-minimal"
        aria-live="polite"
        aria-label="Launch countdown timer"
      ></div>

      <!-- Preview Button -->
      {showPreviewButton && (
        <div class="temp-preview-access" style="margin: 2rem 0;">
          <a href={previewUrl} class="btn btn--preview">
            Preview Full Site
          </a>
        </div>
      )}

      <!-- Social Links -->
      <div class="social-minimal">
        <a class="social-link" href="https://instagram.com/cursedinksociety" aria-label="Follow us on Instagram">
          Instagram
        </a>
        <a class="social-link" href="https://facebook.com/cursedinksociety" aria-label="Follow us on Facebook">
          Facebook
        </a>
      </div>
      
    </div>
  </div>
</section>

<script>
  // Ultra-optimized Three.js implementation
  async function initOptimizedThreeJS(): Promise<void> {
    try {
      const canvas = document.getElementById('ink-canvas') as HTMLCanvasElement;
      if (!canvas) return;

      // Enhanced device detection
      const isMobile = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);
      const isLowEnd = navigator.hardwareConcurrency <= 4 || (navigator as any).deviceMemory <= 4;
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      
      // Skip Three.js on very low-end devices
      if (isLowEnd && isMobile) {
        console.log('Skipping Three.js on low-end mobile device');
        canvas.style.display = 'none';
        return;
      }

      // WebGL check
      const gl = canvas.getContext('webgl', { antialias: false, alpha: true });
      if (!gl) {
        canvas.style.display = 'none';
        return;
      }

      // Load Three.js with retry
      let THREE;
      try {
        THREE = await import('https://unpkg.com/three@0.180.0/build/three.module.js');
      } catch {
        THREE = await import('three');
      }

      // Ultra-conservative settings
      const pixelRatio = Math.min(isLowEnd ? 1.2 : (isMobile ? 1.5 : 2), window.devicePixelRatio || 1);
      const particleCount = isLowEnd ? 100 : (isMobile ? 200 : (prefersReducedMotion ? 50 : 400));

      const renderer = new THREE.WebGLRenderer({
        canvas,
        antialias: false,
        alpha: true,
        powerPreference: isLowEnd ? 'low-power' : 'default',
        stencil: false,
        depth: false, // Disable depth buffer for 2D-like content
        preserveDrawingBuffer: false
      });

      renderer.setPixelRatio(pixelRatio);
      renderer.setClearColor(0x000000, 0);

      const scene = new THREE.Scene();
      const camera = new THREE.PerspectiveCamera(50, 2, 0.1, 50);
      camera.position.set(0, 0, 5);

      // Simplified particle system
      const geometry = new THREE.BufferGeometry();
      const positions = new Float32Array(particleCount * 3);
      
      for (let i = 0; i < particleCount; i++) {
        const i3 = i * 3;
        positions[i3] = (Math.random() - 0.5) * 10;
        positions[i3 + 1] = (Math.random() - 0.5) * 6;
        positions[i3 + 2] = -(Math.random() * 4 + 1);
      }
      
      geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
      
      const material = new THREE.PointsMaterial({
        color: 0xffe7d0,
        size: isMobile ? 0.008 : 0.012,
        transparent: true,
        opacity: prefersReducedMotion ? 0.2 : 0.4,
        blending: THREE.AdditiveBlending,
        depthWrite: false,
        depthTest: false
      });
      
      const particles = new THREE.Points(geometry, material);
      scene.add(particles);

      // Optimized resize
      let resizeTimeout: number;
      const resize = () => {
        clearTimeout(resizeTimeout);
        resizeTimeout = window.setTimeout(() => {
          const { clientWidth: w, clientHeight: h } = canvas;
          if (canvas.width !== w || canvas.height !== h) {
            renderer.setSize(w, h, false);
            camera.aspect = w / h;
            camera.updateProjectionMatrix();
          }
        }, 100); // Debounce resize
      };

      resize();
      new ResizeObserver(resize).observe(canvas);

      // Ultra-simple animation
      const targetFPS = isLowEnd ? 20 : (isMobile ? 24 : 30);
      const frameInterval = 1000 / targetFPS;
      let lastTime = 0;
      let animationId: number;
      let isVisible = !document.hidden;

      // Visibility handling
      const handleVisibilityChange = () => {
        isVisible = !document.hidden;
      };
      document.addEventListener('visibilitychange', handleVisibilityChange);

      const animate = (currentTime: number) => {
        animationId = requestAnimationFrame(animate);
        
        if (!isVisible || (currentTime - lastTime) < frameInterval) return;
        
        const dt = (currentTime - lastTime) * 0.001;
        lastTime = currentTime;

        // Minimal animation
        if (!prefersReducedMotion) {
          particles.rotation.y += dt * 0.1;
        }

        renderer.render(scene, camera);
      };

      animate(performance.now());

      // Cleanup
      window.addEventListener('beforeunload', () => {
        cancelAnimationFrame(animationId);
        document.removeEventListener('visibilitychange', handleVisibilityChange);
        renderer.dispose();
        geometry.dispose();
        material.dispose();
      });

    } catch (error) {
      console.warn('Optimized Three.js failed:', error);
      const canvas = document.getElementById('ink-canvas');
      if (canvas) {
        canvas.style.display = 'none';
        canvas.parentElement?.classList.add('hero-fallback');
      }
    }
  }

  // Initialize only when hero is visible and page is settled
  function initWhenReady() {
    const heroSection = document.getElementById('hero-section');
    if (!heroSection) return;

    // Wait for critical resources
    const waitForResources = () => {
      return new Promise<void>((resolve) => {
        if (document.readyState === 'complete' && document.fonts?.ready) {
          document.fonts.ready.then(() => {
            setTimeout(resolve, 200); // Let layout settle
          });
        } else {
          window.addEventListener('load', () => {
            setTimeout(resolve, 200);
          });
        }
      });
    };

    // Use intersection observer for lazy loading
    const observer = new IntersectionObserver(async (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          observer.disconnect();
          await waitForResources();
          
          // Use idle callback for non-blocking init
          if ('requestIdleCallback' in window) {
            requestIdleCallback(() => initOptimizedThreeJS(), { timeout: 2000 });
          } else {
            setTimeout(initOptimizedThreeJS, 100);
          }
          break;
        }
      }
    }, { rootMargin: '50px' });

    observer.observe(heroSection);
  }

  // Initialize
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initWhenReady);
  } else {
    initWhenReady();
  }
</script>
