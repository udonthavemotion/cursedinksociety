    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
  }

  .faq-answer p {
    padding: 0 2rem 1.5rem;
    margin: 0;
    line-height: 1.6;
    opacity: 0.9;
  }

  /* Social Section */
  .social-section {
