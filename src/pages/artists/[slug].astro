  /* RPG Gallery Section */
  .rpg-gallery {
    padding: 6rem 0;
    background:
      radial-gradient(700px 500px at 70% 30%, rgba(138, 43, 226, 0.06) 0%, transparent 70%),
      linear-gradient(180deg, #111114, #0a0a0c);
    position: relative;
  }

  .gallery-subtitle {
    text-align: center;
    font-size: 1.1rem;
    color: rgba(245, 245, 245, 0.7);
    margin: -1rem 0 3rem;
    font-style: italic;
  }

  .masonry-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
    margin-bottom: 4rem;
    padding: 0 1rem;
  }

  @media (min-width: 1200px) {
    .masonry-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 2.5rem;
    }
  }

  .masonry-item {
    opacity: 0;
    transform: translateY(20px);
    animation: galleryItemAppear 0.6s ease forwards;
  }

  @keyframes galleryItemAppear {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .pixel-gallery-frame {
    position: relative;
    border: 3px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    overflow: hidden;
    background: rgba(0, 0, 0, 0.3);
    transition: all 0.3s ease;
    box-shadow: 
      0 0 0 1px rgba(255, 255, 255, 0.06) inset,
      0 8px 24px rgba(0, 0, 0, 0.2);
  }

  .pixel-gallery-frame:hover {
    transform: translateY(-4px) scale(1.02);
    border-color: rgba(138, 43, 226, 0.4);
    box-shadow:
      0 0 0 1px rgba(138, 43, 226, 0.2) inset,
      0 12px 32px rgba(0, 0, 0, 0.3),
      0 0 20px rgba(138, 43, 226, 0.3);
  }

  .gallery-image {
    width: 100%;
    height: 300px;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease, filter 0.3s ease;
    background: linear-gradient(135deg, rgba(220, 20, 60, 0.1), rgba(0, 0, 0, 0.2));
  }

  .gallery-image:not([src]) {
    background: linear-gradient(135deg, rgba(220, 20, 60, 0.1), rgba(0, 0, 0, 0.2));
    position: relative;
  }

  .gallery-image:not([src])::after {
    content: '🎨';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-size: 2rem;
    opacity: 0.3;
  }

  .pixel-gallery-frame:hover .gallery-image {
    transform: scale(1.05);
  }

  .image-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(
      135deg,
      rgba(0, 0, 0, 0.8) 0%,
      rgba(138, 43, 226, 0.3) 50%,
      rgba(0, 0, 0, 0.8) 100%
    );
    opacity: 0;
    transition: opacity 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .pixel-gallery-frame:hover .image-overlay {
    opacity: 1;
  }

  .overlay-content {
    text-align: center;
    color: white;
    transform: translateY(10px);
    transition: transform 0.3s ease;
  }

  .pixel-gallery-frame:hover .overlay-content {
    transform: translateY(0);
  }

  .work-label {
    font-size: 1.1rem;
    font-weight: bold;
    margin-bottom: 0.5rem;
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.8);
  }

  .zoom-hint {
    font-size: 0.9rem;
    opacity: 0.8;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8);
  }

  .gallery-footer {
    background: rgba(0, 0, 0, 0.4);
    border: 2px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    padding: 2rem;
    backdrop-filter: blur(10px);
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.06) inset;
  }

  .gallery-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    text-align: center;
  }

  .gallery-stats .stat-item {
    padding: 1rem;
  }

  .gallery-stats .stat-number {
    display: block;
    font-size: 2rem;
    font-weight: 800;
    color: #8a2be2;
    text-shadow: 0 0 10px rgba(138, 43, 226, 0.4);
    margin-bottom: 0.5rem;
  }

  .gallery-stats .stat-label {
    font-size: 0.9rem;
    color: rgba(245, 245, 245, 0.7);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  /* Mobile Optimizations for Gallery */
  @media (max-width: 768px) {
    .rpg-gallery {
      padding: 4rem 0;
    }

    .masonry-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }

    .gallery-image {
      height: 200px;
    }

    .gallery-stats {
