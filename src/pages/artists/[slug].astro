    height: auto;
    border-radius: 20px;
    border: 3px solid rgba(255, 60, 43, 0.3);
    box-shadow:
      0 20px 40px rgba(0, 0, 0, 0.3),
      0 0 30px rgba(255, 60, 43, 0.2);
  }

  .artist-badge {
    margin-bottom: 1rem;
  }

  .artist-hero-name {
