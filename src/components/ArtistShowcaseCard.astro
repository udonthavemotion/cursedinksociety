---
import { slugify } from '../lib/slugify';
import type { Artist } from '../data/artists';

export interface Props {
  artist: Artist;
}

const { artist } = Astro.props;

// Get the first featured work image as hero background
const heroImage = artist.featuredWork?.[0] || artist.portfolio?.[0] || artist.avatar;
const additionalImages = artist.featuredWork?.slice(1, 3) || artist.portfolio?.slice(1, 3) || [];
---

<article class="artist-showcase-card">
  <a href={`/artists/${slugify(artist.slug ?? artist.name)}`} class="card-link">
    <!-- Hero Background Image -->
    <div class="hero-background">
      <img
        src={heroImage}
        alt={`${artist.name} featured work`}
        class="hero-image"
        loading="lazy"
      />
      <div class="hero-overlay"></div>
      <div class="decorative-corner"></div>
    </div>

    <!-- Content Overlay -->
    <div class="content-overlay">
      <!-- Artist Name & Title -->
      <div class="artist-header">
        <h3 class="artist-name">{artist.name}</h3>
        <p class="artist-title">{artist.title}</p>
        <p class="artist-experience">{artist.experience}</p>
      </div>

      <!-- Signature Styles -->
      <div class="signature-styles">
        {artist.styles.slice(0, 3).map(style => (
          <span class="style-tag">{style}</span>
        ))}
      </div>

      <!-- Additional Work Preview -->
      {additionalImages.length > 0 && (
        <div class="work-preview">
          {additionalImages.map((image, index) => (
            <div class="preview-thumb">
              <img
                src={image}
                alt={`${artist.name} work ${index + 2}`}
                loading="lazy"
              />
            </div>
          ))}
        </div>
      )}

      <!-- CTA -->
      <div class="card-cta">
        <span class="cta-text">View Portfolio</span>
        <svg class="cta-arrow" width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
          <path d="M8 0L6.59 1.41L12.17 7H0v2h12.17l-5.58 5.59L8 16l8-8z"/>
        </svg>
      </div>
    </div>

    <!-- Floating Avatar -->
    <div class="floating-avatar">
      <img
        src={artist.avatar}
        alt={`${artist.name} portrait`}
        loading="lazy"
      />
    </div>
  </a>
</article>

<style>
  .artist-showcase-card {
    position: relative;
    height: 400px;
    border-radius: 24px;
    overflow: hidden;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 
      0 8px 32px rgba(0, 0, 0, 0.3),
      0 4px 16px rgba(0, 0, 0, 0.2);
  }

  .artist-showcase-card:hover {
    transform: translateY(-8px) scale(1.02);
    box-shadow: 
      0 20px 40px rgba(0, 0, 0, 0.4),
      0 8px 24px rgba(0, 0, 0, 0.3);
  }

  .card-link {
    display: block;
    width: 100%;
    height: 100%;
    text-decoration: none;
    color: inherit;
    position: relative;
  }

  /* Hero Background */
  .hero-background {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .artist-showcase-card:hover .hero-image {
    transform: scale(1.1);
  }

  .hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      135deg,
      rgba(0, 0, 0, 0.3) 0%,
      rgba(0, 0, 0, 0.1) 40%,
      rgba(0, 0, 0, 0.7) 100%
    );
    z-index: 2;
  }

  .decorative-corner {
    position: absolute;
    top: 0;
    right: 0;
    width: 0;
    height: 0;
    border-left: 60px solid transparent;
    border-top: 60px solid rgba(212, 175, 55, 0.15);
    z-index: 2;
    transition: all 0.3s ease;
  }

  .artist-showcase-card:hover .decorative-corner {
    border-top-color: rgba(212, 175, 55, 0.25);
    transform: scale(1.1);
  }

  /* Content Overlay */
  .content-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 2rem;
    z-index: 3;
  }

  /* Artist Header */
  .artist-header {
    color: white;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.6);
  }

  .artist-name {
    font-size: 1.75rem;
    font-weight: 800;
    margin: 0 0 0.5rem 0;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .artist-title {
    font-size: 1rem;
    font-weight: 600;
    margin: 0 0 0.25rem 0;
    opacity: 0.9;
    font-style: italic;
  }

  .artist-experience {
    font-size: 0.875rem;
    font-weight: 500;
    margin: 0;
    opacity: 0.8;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* Signature Styles */
  .signature-styles {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: auto;
    margin-bottom: 1rem;
  }

  .style-tag {
    background: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(10px);
    color: white;
    padding: 0.5rem 1rem;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border: 1px solid rgba(255, 255, 255, 0.2);
    transition: all 0.3s ease;
    white-space: nowrap;
  }

  .artist-showcase-card:hover .style-tag {
    background: rgba(255, 255, 255, 0.25);
    border-color: rgba(255, 255, 255, 0.4);
    transform: translateY(-2px);
  }

  /* Work Preview */
  .work-preview {
    display: flex;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .preview-thumb {
    width: 60px;
    height: 60px;
    border-radius: 12px;
    overflow: hidden;
    border: 2px solid rgba(255, 255, 255, 0.3);
    transition: all 0.3s ease;
  }

  .preview-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .artist-showcase-card:hover .preview-thumb {
    border-color: rgba(255, 255, 255, 0.6);
    transform: translateY(-4px);
  }

  .artist-showcase-card:hover .preview-thumb img {
    transform: scale(1.1);
  }

  /* CTA */
  .card-cta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: white;
    font-weight: 700;
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    transition: all 0.3s ease;
  }

  .cta-text {
    position: relative;
  }

  .cta-text::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 2px;
    background: white;
    transition: width 0.3s ease;
  }

  .artist-showcase-card:hover .cta-text::after {
    width: 100%;
  }

  .cta-arrow {
    transition: transform 0.3s ease;
  }

  .artist-showcase-card:hover .cta-arrow {
    transform: translateX(4px);
  }

  /* Floating Avatar */
  .floating-avatar {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    overflow: hidden;
    border: 3px solid rgba(255, 255, 255, 0.8);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);
    z-index: 4;
    transition: all 0.3s ease;
  }

  .floating-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .artist-showcase-card:hover .floating-avatar {
    transform: scale(1.1);
    border-color: white;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.4);
  }

  /* Responsive Design */
  @media (max-width: 768px) {
    .artist-showcase-card {
      height: 350px;
    }

    .content-overlay {
      padding: 1.5rem;
    }

    .artist-name {
      font-size: 1.5rem;
    }

    .artist-title {
      font-size: 0.9rem;
    }

    .artist-experience {
      font-size: 0.8rem;
    }

    .style-tag {
      font-size: 0.7rem;
      padding: 0.4rem 0.8rem;
    }

    .preview-thumb {
      width: 50px;
      height: 50px;
    }

    .floating-avatar {
      width: 50px;
      height: 50px;
      top: 1rem;
      right: 1rem;
    }
  }

  @media (max-width: 480px) {
    .artist-showcase-card {
      height: 320px;
    }

    .content-overlay {
      padding: 1.25rem;
    }

    .artist-name {
      font-size: 1.25rem;
    }

    .work-preview {
      gap: 0.5rem;
    }

    .preview-thumb {
      width: 40px;
      height: 40px;
    }

    .signature-styles {
      gap: 0.375rem;
    }

    .style-tag {
      font-size: 0.65rem;
      padding: 0.3rem 0.6rem;
    }
  }

  /* Accessibility */
  @media (prefers-reduced-motion: reduce) {
    .artist-showcase-card,
    .hero-image,
    .style-tag,
    .preview-thumb,
    .preview-thumb img,
    .floating-avatar,
    .cta-arrow {
      transition: none;
    }

    .artist-showcase-card:hover {
      transform: none;
    }

    .artist-showcase-card:hover .hero-image {
      transform: none;
    }
  }

  @media (prefers-contrast: high) {
    .hero-overlay {
      background: linear-gradient(
        135deg,
        rgba(0, 0, 0, 0.6) 0%,
        rgba(0, 0, 0, 0.4) 40%,
        rgba(0, 0, 0, 0.8) 100%
      );
    }

    .style-tag {
      background: rgba(0, 0, 0, 0.8);
      border-color: white;
    }

    .floating-avatar {
      border-width: 4px;
    }
  }

  /* Focus states for accessibility */
  .card-link:focus {
    outline: 3px solid #ffd700;
    outline-offset: 2px;
  }

  .card-link:focus .artist-showcase-card {
    transform: translateY(-4px) scale(1.01);
  }
</style>
