---
// Dynamic artist profile page
import Layout from '../../layouts/Layout.astro';
import ArtistPortfolioGallery from '../../components/ArtistPortfolioGallery.astro';
import MicroInteractions from '../../components/MicroInteractions.astro';
import cisData from '../../data/cis.json';

export async function getStaticPaths() {
  return cisData.artists.map((artist) => ({
    params: { slug: artist.slug },
    props: { artist },
  }));
}

const { artist } = Astro.props;
const title = `${artist.name} — Tattoo Artist | Cursed Ink Society`;
const description = `${artist.positioning} Specializing in ${artist.specialties.join(', ')}. View ${artist.name}'s portfolio and book a consultation at Cursed Ink Society.`;

  // Check if this is Cody's page for special RPG layout
  const isCodyPage = artist.slug === 'cody-crochet';

  // Check if this is Seth's page for special Affliction layout
  const isSethPage = artist.slug === 'seth-wood';

  // Check if this is Ashley's page for special watercolor layout
  const isAshleyPage = artist.slug === 'ashley-wood';

  // Ashley's watercolor data - Chromancer & Color Specialist
  const ashleyData = {
    stats: { creativity: 97, technique: 93, colorMastery: 96 },
    title: "Chromancer",
    subtitle: "Color & Kawaii Specialist",
    creed: "Vibrant energy through masterful color work",
    badges: ["Color Virtuoso", "Kawaii Master", "Pop Culture Artist", "10yr Veteran"],
    rates: "$150-200/hr • $120 min"
  };

  // Cody's RPG-style data - Anime & Color Specialist
const codyData = {
  stats: { hp: 98, atk: 92, def: 95, ink: 100 },
  moves: [
    { title: "Anime Awakening", desc: "Brings anime characters to life with vibrant colors and emotional depth." },
    { title: "Color Symphony", desc: "Creates stunning color palettes that tell stories through hue and saturation." },
    { title: "Manga Precision", desc: "Captures the intricate linework and shading of manga illustrations." },
    { title: "Character Genesis", desc: "Breathes life into beloved characters with photorealistic anime styling." }
  ],
  badges: ["Anime Master", "Color Virtuoso", "Manga Artist", "Character Creator", "10yr Veteran"],
  rates: "$180-220/hr • $150 min"
};

  // Seth's Affliction-style data - Guild Master & Traditional Specialist
  const sethData = {
    stats: { power: 98, precision: 97, mastery: 96, honor: 100 },
    moves: [
      { title: "Traditional Mastery", desc: "Authentic American Traditional tattoos with bold lines and vibrant shading." },
      { title: "Naturalistic Vision", desc: "Brings natural forms to life with incredible detail and artistic depth." },
      { title: "Japanese Fusion", desc: "Blends traditional Japanese elements with American techniques for unique compositions." }
    ],
    badges: ["Guild Master", "Traditional Authority", "25yr Veteran", "Master Shading", "Linework Legend"],
    rates: "$200-280/hr • $180 min",
    creed: "Authenticity • Honor • Mastery",
    code: "Strength through tradition, power through precision"
  };
---

<Layout title={title} description={description}>
  <!-- Micro Interactions -->
  <MicroInteractions />

  {isAshleyPage ? (
    <!-- ASHLEY'S WATERCOLOR FEMININE LAYOUT -->

    <!-- Watercolor Background Overlay -->
    <div class="watercolor-overlay"></div>

    <!-- Hero Section -->
    <section class="ashley-hero">
      <div class="container">
        <div class="ashley-hero-content">
          <div class="ashley-hero-image">
            <div class="watercolor-frame">
              <img
                src={artist.avatar}
                alt={`${artist.name} - Chromancer Tattoo Artist`}
                class="ashley-avatar"
                loading="lazy"
                width="350"
                height="350"
              />
            </div>
          </div>

          <div class="ashley-hero-info">
            <div class="ashley-badge">
              <span class="watercolor-badge">🌸 CHROMANCER</span>
            </div>
            <h1 class="ashley-name">{artist.name}</h1>
            <p class="ashley-title">{ashleyData.subtitle}</p>
            <p class="ashley-creed">{ashleyData.creed}</p>
            <div class="ashley-location">📍 Houma, LA</div>
            <div class="ashley-experience">🎨 {artist.experience}</div>

            <!-- Chroma Stats -->
            <div class="chroma-stats">
              <div class="chroma-bar">
                <span class="chroma-label">CREATIVITY</span>
                <div class="chroma-fill">
                  <div class="chroma-value" style={`width: ${ashleyData.stats.creativity}%`}></div>
                </div>
                <span class="chroma-number">{ashleyData.stats.creativity}%</span>
              </div>
              <div class="chroma-bar">
                <span class="chroma-label">TECHNIQUE</span>
                <div class="chroma-fill">
                  <div class="chroma-value" style={`width: ${ashleyData.stats.technique}%`}></div>
                </div>
                <span class="chroma-number">{ashleyData.stats.technique}%</span>
              </div>
              <div class="chroma-bar">
                <span class="chroma-label">COLOR MASTERY</span>
                <div class="chroma-fill">
                  <div class="chroma-value" style={`width: ${ashleyData.stats.colorMastery}%`}></div>
                </div>
                <span class="chroma-number">{ashleyData.stats.colorMastery}%</span>
              </div>
            </div>

            <!-- CTA Buttons -->
            <div class="ashley-ctas">
              <a href={`/contact`} class="ashley-btn primary">
                <span class="btn-icon">🎨</span>
                Book Consultation
              </a>
              <a href={artist.cta.url} class="ashley-btn secondary" target="_blank" rel="noopener">
                <span class="btn-icon">📱</span>
                DM Ashley on Instagram
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Portfolio Gallery -->
    <section class="ashley-portfolio">
      <div class="container">
        <div class="portfolio-header">
          <h2 class="portfolio-title">Recent Work</h2>
          <p class="portfolio-subtitle">Vibrant colors bringing pop culture to life</p>
        </div>

        <div class="portfolio-grid">
          {artist.portfolio.slice(0, 12).map((work, index) => (
            <div class="portfolio-item">
              <div class="watercolor-border">
                <img
                  src={work}
                  alt={`${artist.name} portfolio piece ${index + 1}`}
                  loading="lazy"
                  class="portfolio-image"
                />
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

  ) : isSethPage ? (
    <!-- SETH'S AFFLICTION-STYLE GUILD MASTER LAYOUT -->

    <!-- Tribal Scanlines Overlay -->
    <div class="affliction-scanlines"></div>

    <!-- Hero "Guild Master" Section -->
    <section class="affliction-hero">
      <div class="container">
        <div class="guild-master-card">
          <div class="guild-portrait">
            <div class="tribal-frame">
              <img
                src={artist.avatar}
                alt={`${artist.name} - Guild Master Tattoo Artist`}
                class="portrait-image"
                loading="lazy"
                width="320"
                height="400"
              />
            </div>
          </div>

          <div class="guild-info">
            <div class="guild-badge">
              <span class="tribal-badge">⚔️ GUILD MASTER</span>
            </div>
            <h1 class="guild-name">{artist.name}</h1>
            <p class="guild-creed">{sethData.creed}</p>
            <div class="guild-code">{sethData.code}</div>
            <div class="guild-location">📍 Houma, LA</div>
            <div class="guild-experience">🏆 {artist.experience}</div>

            <!-- Honor Stats Strip -->
            <div class="honor-stats">
              <div class="stat-bar">
                <span class="stat-label">POWER</span>
                <div class="stat-fill">
                  <div class="stat-value" style={`width: ${sethData.stats.power}%`}></div>
                </div>
                <span class="stat-num">{sethData.stats.power}</span>
              </div>
              <div class="stat-bar">
                <span class="stat-label">PRECISION</span>
                <div class="stat-fill">
                  <div class="stat-value" style={`width: ${sethData.stats.precision}%`}></div>
                </div>
                <span class="stat-num">{sethData.stats.precision}</span>
              </div>
              <div class="stat-bar">
                <span class="stat-label">MASTERY</span>
                <div class="stat-fill">
                  <div class="stat-value" style={`width: ${sethData.stats.mastery}%`}></div>
                </div>
                <span class="stat-num">{sethData.stats.mastery}</span>
              </div>
              <div class="stat-bar">
                <span class="stat-label">HONOR</span>
                <div class="stat-fill">
                  <div class="stat-value honor-special" style={`width: ${sethData.stats.honor}%`}></div>
                </div>
                <span class="stat-num">{sethData.stats.honor}%</span>
              </div>
            </div>

            <!-- Primary CTAs -->
            <div class="guild-actions">
              <a href={artist.cta.url} class="btn-primary affliction-btn" target="_blank" rel="noopener">
                💀 Book with Guild Master
              </a>
              <a href="#seth-gallery" class="btn-secondary affliction-btn">
                🎨 View Masterpieces
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Signature Techniques Section -->
    <section class="affliction-techniques">
      <div class="container">
        <h2 class="section-title">⚔️ Signature Techniques</h2>
        <div class="techniques-grid">
          {sethData.moves.map((move, index) => (
            <div class="technique-card" style={`animation-delay: ${index * 0.1}s`}>
              <div class="technique-header">
                <h3 class="technique-name">{move.title}</h3>
                <div class="technique-type">Master</div>
              </div>
              <p class="technique-description">{move.desc}</p>
              <div class="technique-stats">
                <div class="technique-power">Power: ⭐⭐⭐⭐⭐</div>
                <div class="technique-accuracy">Accuracy: 100%</div>
              </div>
            </div>
          ))}
        </div>
        <div class="rates-banner">
          <div class="rates-content">
            <span class="rates-label">💰 Guild Rates:</span>
            <span class="rates-price">{sethData.rates}</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Earned Honors Section -->
    <section class="affliction-honors">
      <div class="container">
        <h2 class="section-title">🏆 Earned Honors</h2>
        <div class="honors-container">
          {sethData.badges.map((badge, index) => (
            <div class="honor-pill" style={`animation-delay: ${index * 0.1}s`}>
              <span class="honor-text">{badge}</span>
            </div>
          ))}
        </div>
        <div class="master-note">
          <div class="master-icon">⚔️</div>
          <p class="master-text">
            Honors earned through 25+ years of dedication to the craft.
            Each represents mastery in traditional tattoo disciplines.
          </p>
        </div>
      </div>
    </section>

    <!-- Gallery "Masterpieces" Section -->
    <section class="affliction-gallery" id="seth-gallery">
      <div class="container">
        <h2 class="section-title">🎨 Masterpieces</h2>
        <p class="gallery-subtitle">Legendary works from the Guild Master</p>
        <div class="tribal-masonry-grid">
          {artist.portfolio.map((image, index) => (
            <div class="tribal-masonry-item" style={`animation-delay: ${index * 0.05}s`}>
              <div class="tribal-gallery-frame" tabindex="0" role="button" aria-label={`View ${artist.name} tattoo work ${index + 1}`}>
                <img
                  src={image}
                  alt={`${artist.name} tattoo work ${index + 1} - ${artist.specialties[index % artist.specialties.length]} style tattoo`}
                  class="gallery-image"
                  loading="lazy"
                  decoding="async"
                />
                <div class="tribal-overlay">
                  <div class="tribal-content">
                    <div class="masterpiece-label">Masterpiece #{index + 1}</div>
                    <div class="view-hint">👁️ View Details</div>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
        <div class="gallery-footer">
          <div class="gallery-stats">
            <div class="stat-item">
              <span class="stat-number">{artist.portfolio.length}</span>
              <span class="stat-label">Masterpieces</span>
            </div>
            <div class="stat-item">
              <span class="stat-number">100%</span>
              <span class="stat-label">Client Satisfaction</span>
            </div>
            <div class="stat-item">
              <span class="stat-number">{artist.experience}</span>
              <span class="stat-label">Years Experience</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Final CTA Bar -->
    <section class="affliction-cta-bar">
      <div class="container">
        <div class="cta-bar-content">
          <div class="cta-left">
            <div class="cta-icon">💀</div>
            <div class="cta-text">
              <div class="cta-title">Ready for Mastery?</div>
              <div class="cta-subtitle">Book with Guild Master Seth</div>
            </div>
          </div>
          <div class="cta-actions">
            <a href="https://instagram.com/sethta2_bp" class="btn-instagram affliction-btn" target="_blank" rel="noopener">
              📱 @sethta2_bp
            </a>
            <a href={artist.cta.url} class="btn-book affliction-btn" target="_blank" rel="noopener">
              💀 Book Consultation
            </a>
          </div>
        </div>
      </div>
    </section>

  ) : isCodyPage ? (
    <!-- CODY'S RPG TRAINER CARD LAYOUT -->
    
    <!-- Scanline Overlay -->
    <div class="rpg-scanlines"></div>
    
    <!-- Hero "Trainer Card" -->
    <section class="rpg-hero">
    <div class="container">
        <div class="trainer-card">
          <div class="trainer-portrait">
            <div class="pixel-frame">
          <img
            src={artist.avatar}
                alt={`${artist.name} - Tattoo Trainer`}
                class="portrait-image"
            loading="lazy"
                width="320"
            height="400"
          />
        </div>
            </div>
          
          <div class="trainer-info">
            <div class="trainer-badge">
              <span class="pixel-badge">⚡ TATTOO MASTER</span>
            </div>
            <h1 class="trainer-name">{artist.name}</h1>
            <p class="trainer-class">
              {artist.slug === 'cody-crochet' ? 'Anime & Color Specialist' : artist.positioning.split(' - ')[0]}
            </p>
            <div class="trainer-location">📍 Houma, LA</div>
            <div class="trainer-exp">🎖️ {artist.experience}</div>
            
            <!-- Stats Strip -->
            <div class="stats-strip">
              <div class="stat-bar">
                <span class="stat-label">HP</span>
                <div class="stat-fill">
                  <div class="stat-value" style={`width: ${codyData.stats.hp}%`}></div>
            </div>
                <span class="stat-num">{codyData.stats.hp}</span>
            </div>
              <div class="stat-bar">
                <span class="stat-label">ATK</span>
                <div class="stat-fill">
                  <div class="stat-value" style={`width: ${codyData.stats.atk}%`}></div>
          </div>
                <span class="stat-num">{codyData.stats.atk}</span>
        </div>
              <div class="stat-bar">
                <span class="stat-label">DEF</span>
                <div class="stat-fill">
                  <div class="stat-value" style={`width: ${codyData.stats.def}%`}></div>
                </div>
                <span class="stat-num">{codyData.stats.def}</span>
              </div>
              <div class="stat-bar">
                <span class="stat-label">INK</span>
                <div class="stat-fill">
                  <div class="stat-value ink-special" style={`width: ${codyData.stats.ink}%`}></div>
                </div>
                <span class="stat-num">{codyData.stats.ink}%</span>
              </div>
            </div>
            
            <!-- Primary CTAs -->
            <div class="trainer-actions">
              <a href={artist.cta.url} class="btn-primary rpg-btn" target="_blank" rel="noopener">
                📱 DM Cody on Instagram
              </a>
              <a href="#cody-gallery" class="btn-secondary rpg-btn">
                🎨 View Gallery
              </a>
            </div>
          </div>
      </div>
    </div>
  </section>

    <!-- MoveSet (Services) Section -->
    <section class="rpg-moveset">
    <div class="container">
        <h2 class="section-title">⚔️ Signature Moves</h2>
        <div class="moves-grid">
          {codyData.moves.map((move, index) => (
            <div class="move-card" style={`animation-delay: ${index * 0.1}s`}>
              <div class="move-header">
                <h3 class="move-name">{move.title}</h3>
                <div class="move-type">Special</div>
            </div>
              <p class="move-description">{move.desc}</p>
              <div class="move-stats">
                <div class="move-power">Power: ⭐⭐⭐⭐⭐</div>
                <div class="move-accuracy">Accuracy: 100%</div>
              </div>
          </div>
        ))}
      </div>
        <div class="rates-banner">
          <div class="rates-content">
            <span class="rates-label">💰 Battle Rates:</span>
            <span class="rates-price">{codyData.rates}</span>
          </div>
      </div>
    </div>
  </section>

    <!-- Badges (Expertise) Section -->
    <section class="rpg-badges">
      <div class="container">
        <h2 class="section-title">🏆 Earned Badges</h2>
        <div class="badges-container">
          {codyData.badges.map((badge, index) => (
            <div class="badge-pill" style={`animation-delay: ${index * 0.1}s`}>
              <span class="badge-text">{badge}</span>
            </div>
          ))}
            </div>
        <div class="achievement-note">
          <div class="achievement-icon">🎖️</div>
          <p class="achievement-text">
            Badges earned through years of dedicated practice and countless satisfied clients. 
            Each represents mastery in a specific tattoo discipline.
          </p>
        </div>
      </div>
    </section>

    <!-- Gallery (Masonry) Section -->
    <section class="rpg-gallery" id="cody-gallery">
      <div class="container">
        <h2 class="section-title">🎨 Battle Gallery</h2>
        <p class="gallery-subtitle">Legendary works from the battlefield</p>
        <div class="masonry-grid">
          {artist.portfolio.map((image, index) => (
            <div class="masonry-item" style={`animation-delay: ${index * 0.05}s`}>
              <div class="pixel-gallery-frame" tabindex="0" role="button" aria-label={`View ${artist.name} tattoo work ${index + 1}`}>
                <img
                  src={image}
                  alt={`${artist.name} tattoo work ${index + 1} - ${artist.specialties[index % artist.specialties.length]} style tattoo`}
                  class="gallery-image"
                  loading="lazy"
                  decoding="async"
                />
                <div class="image-overlay">
                  <div class="overlay-content">
                    <div class="work-label">Epic Work #{index + 1}</div>
                    <div class="zoom-hint">👁️ View Details</div>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
        <div class="gallery-footer">
          <div class="gallery-stats">
            <div class="stat-item">
              <span class="stat-number">{artist.portfolio.length}</span>
              <span class="stat-label">Epic Pieces</span>
            </div>
            <div class="stat-item">
              <span class="stat-number">100%</span>
              <span class="stat-label">Client Satisfaction</span>
            </div>
            <div class="stat-item">
              <span class="stat-number">{artist.experience}</span>
              <span class="stat-label">Experience</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Final CTA Bar -->
    <section class="rpg-cta-bar">
    <div class="container">
        <div class="cta-bar-content">
          <div class="cta-left">
            <div class="cta-icon">💬</div>
            <div class="cta-text">
              <div class="cta-title">Questions?</div>
              <div class="cta-subtitle">DM us on Instagram</div>
            </div>
          </div>
        <div class="cta-actions">
            <a href="https://instagram.com/cursedingksociety" class="btn-instagram rpg-btn" target="_blank" rel="noopener">
              📱 @cursedingksociety
          </a>
            <a href={artist.cta.url} class="btn-book rpg-btn" target="_blank" rel="noopener">
              📱 DM Cody on Instagram
            </a>
        </div>
      </div>
    </div>
  </section>
  ) : (
    <!-- ORIGINAL LAYOUT FOR OTHER ARTISTS -->
  <section class="artist-hero">
    <div class="container">
      <div class="artist-hero-content">
        <div class="artist-hero-image">
          <img
            src={artist.avatar}
            alt={`${artist.name} - Professional tattoo artist`}
            class="hero-avatar"
            loading="lazy"
            width="400"
            height="400"
          />
        </div>
          <div class="artist-hero-info">
            <div class="artist-badge">
              <span class="badge glow-text">Master Artist</span>
            </div>
            <h1 class="artist-hero-name shine interactive-element">{artist.name}</h1>
          <p class="artist-hero-positioning">{artist.positioning}</p>

          <div class="artist-quick-stats">
            <div class="stat-item">
              <span class="stat-number">50+</span>
              <span class="stat-label">Years Combined Experience</span>
            </div>
            <div class="stat-item">
              <span class="stat-number">6</span>
              <span class="stat-label">Expert Artists</span>
            </div>
            <div class="stat-item">
              <span class="stat-number">2024</span>
              <span class="stat-label">Founded</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
  )}

  <!-- OSRS SKILL PANEL FOR LUIS -->
  {artist.slug === 'luis-reymundo' && (
    <section class="osrs-skills-panel">
      <div class="container">
        <h2 class="osrs-section-title">⚔️ Master Skills</h2>
        <p class="osrs-section-subtitle">Forged through 12+ years of dedication</p>

        <div class="osrs-skills-grid">
          {[
            { name: "Geometric", level: 94, desc: "Precision geometric patterns and sacred geometry mastery" },
            { name: "Bold Linework", level: 91, desc: "Powerful, clean lines that command attention" },
            { name: "Abstract", level: 88, desc: "Creative compositions that transcend traditional boundaries" },
            { name: "Precision", level: 89, desc: "Surgical accuracy in every stroke and placement" },
            { name: "Color Theory", level: 85, desc: "Harmonious color palettes and gradient expertise" },
            { name: "Healing", level: 86, desc: "Clean, fast-healing work with minimal downtime" }
          ].map((skill) => (
            <div class="osrs-skill-row">
              <div class="osrs-skill-icon">
                <div class="osrs-skill-circle"></div>
              </div>
              <div class="osrs-skill-info">
                <div class="osrs-skill-name">{skill.name}</div>
                <div class="osrs-skill-desc">{skill.desc}</div>
              </div>
              <div class="osrs-skill-bar">
                <div class="osrs-skill-fill" style={`width: ${skill.level}%`}></div>
                <div class="osrs-skill-fill-shine"></div>
              </div>
              <div class="osrs-skill-level">{skill.level}</div>
            </div>
          ))}
        </div>

        <div class="osrs-total-level">
          <div class="osrs-total-badge">
            <span class="osrs-total-text">Total Level: 533</span>
            <span class="osrs-total-desc">Master Tattoo Artist</span>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- OSRS QUEST SCROLL BIO FOR LUIS -->
  {artist.slug === 'luis-reymundo' && (
    <section class="osrs-quest-scroll">
      <div class="container">
        <div class="osrs-quest-container">
          <h2 class="osrs-quest-title">📜 Quest: About Luis</h2>

          <div class="osrs-parchment">
