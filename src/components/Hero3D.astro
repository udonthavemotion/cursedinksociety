---
export interface Props {
  variant?: "comingSoon" | "site";
  ctaHref?: string;
  showGlow?: boolean;
}

const {
  variant = "site",
  ctaHref = "/contact",
  showGlow = false
} = Astro.props;
---
<style>
/* Minimal Hero Component */
.hero-section {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 2rem 1rem;
  position: relative;
}

.hero-content {
  max-width: 800px;
  width: 100%;
  z-index: 10;
}

.logo-container {
  position: relative;
  margin-bottom: 2rem;
}

.logo {
  height: 200px;
  width: auto;
  filter: {variant === 'comingSoon' ? 'drop-shadow(0 0 20px rgba(220, 38, 38, 0.6))' : 'none'};
  transition: transform 0.3s ease;
}

.logo:hover {
  transform: scale(1.05);
}

.brand-mark {
  font-family: var(--font-family-display);
  font-size: clamp(1.2rem, 3vw, 1.8rem);
  letter-spacing: 0.15em;
  text-transform: uppercase;
  font-weight: 500;
  margin-bottom: 1rem;
  color: var(--white);
}

.tagline {
  font-size: clamp(1rem, 2.5vw, 1.3rem);
  font-weight: 400;
  letter-spacing: 0.08em;
  margin-bottom: 2rem;
  opacity: 0.9;
  max-width: 400px;
  line-height: 1.5;
  color: var(--gray-200);
  margin-left: auto;
  margin-right: auto;
}

.countdown-minimal {
  font-size: 1rem;
  font-weight: 300;
  letter-spacing: 0.1em;
  margin-top: 2rem;
  opacity: 0.7;
  font-variant-numeric: tabular-nums;
  color: var(--gray-400);
}

.btn--preview {
  background: var(--red-600);
  border: 2px solid var(--red-600);
  color: var(--white);
  font-size: 0.9rem;
  padding: 0.8rem 1.5rem;
  font-weight: 600;
  border-radius: 12px;
  transition: var(--transition);
}

.btn--preview:hover {
  background: var(--red-700);
  border-color: var(--red-700);
  transform: translateY(-2px);
}

.social-minimal {
  display: flex;
  gap: 2rem;
  justify-content: center;
  align-items: center;
  margin-top: 3rem;
}

.social-link {
  display: flex;
  align-items: center;
  gap: 0.8rem;
  padding: 0.8rem 1.2rem;
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 50px;
  transition: var(--transition);
  font-size: 0.9rem;
  font-weight: 400;
  letter-spacing: 0.02em;
  color: var(--gray-200);
}

.social-link:hover {
  background: rgba(255, 255, 255, 0.06);
  border-color: var(--red-600);
  color: var(--white);
  transform: translateY(-1px);
}

.social-link svg {
  width: 18px;
  height: 18px;
  opacity: 0.8;
  transition: opacity 0.3s ease;
}

.social-link:hover svg {
  opacity: 1;
}

/* Responsive adjustments */
@media (max-width: 768px) {
  .hero-section {
    padding: 1rem;
    min-height: 100vh;
  }

  .logo {
    height: 150px;
  }

  .social-minimal {
    gap: 1.5rem;
    flex-direction: column;
  }

  .social-link {
    width: 200px;
    justify-content: center;
  }
}
</style>

<section class="hero-section">
  <div class="hero-content">
    <!-- Centered Logo as Main Focus -->
    <div class="logo-container">
      <img
        class="logo"
        src="/brand/cursed-ink-logo.png"
        alt="Cursed Ink Society - Professional tattoo artistry and mystical designs"
        loading="eager"
        decoding="async"
      />
    </div>

    <!-- Brand Mark -->
    <div class="brand-mark">Cursed Ink Society</div>

    <!-- Tagline -->
    <p class="tagline">Where artistry meets the mystical</p>

    <!-- Conditional CTA based on variant -->
    {variant === 'comingSoon' && (
      <div style="margin: 2rem 0;">
        <a href={ctaHref} class="btn btn--preview" aria-label="Preview full website">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/>
          </svg>
          Preview Full Site
        </a>
        <small style="display: block; margin-top: 0.5rem; opacity: 0.6; font-size: 0.75rem; color: var(--gray-400);">
          Developer Access • Full website preview
        </small>
      </div>
    )}

    {variant === 'site' && (
      <div style="margin: 2rem 0;">
        <a href={ctaHref} class="btn" aria-label="Start your journey">
          Start Your Journey
        </a>
      </div>
    )}

    <!-- Social Links -->
    <div class="social-minimal" role="navigation" aria-label="Connect with us">
      <a class="social-link" href="https://instagram.com/cursedinksociety" aria-label="Follow us on Instagram" rel="noopener" target="_blank">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M7 2h10a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5V7a5 5 0 0 1 5-5zm5 5a5 5 0 1 0 .001 10.001A5 5 0 0 0 12 7zm0 2.2a2.8 2.8 0 1 1 0 5.6 2.8 2.8 0 0 1 0-5.6zM18 6.5a1 1 0 1 0 0 2 1 1 0 0 0 0-2z"/>
        </svg>
        Instagram
      </a>
      <a class="social-link" href="https://facebook.com/cursedinksociety" aria-label="Follow us on Facebook" rel="noopener" target="_blank">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
        </svg>
        Facebook
      </a>
    </div>
  </div>
</section>

<script>
  // Simple countdown timer for coming soon variant
  class CountdownTimer {
    private target: number;
    private element: HTMLElement | null;
    private animationId: number | null;

    constructor(targetDate: string) {
      this.target = new Date(targetDate).getTime();
      this.element = document.getElementById('countdown');
      this.animationId = null;
      this.init();
    }

    init(): void {
      if (!this.element || isNaN(this.target)) return;
      this.tick();
    }

    tick(): void {
      if (!this.element) return;

      const now = Date.now();
      const difference = this.target - now;

      if (difference <= 0) {
        this.element.innerHTML = `
          <div style="font-size: 1.2rem; color: var(--red-600); font-weight: 700;">
            🔥 The gates are open! 🔥
          </div>
        `;
        return;
      }

      const days = Math.floor(difference / (1000 * 60 * 60 * 24));
      const hours = Math.floor((difference % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
      const minutes = Math.floor((difference % (1000 * 60 * 60)) / (1000 * 60));
      const seconds = Math.floor((difference % (1000 * 60)) / 1000);

      const timeString = [
        days > 0 ? `${String(days).padStart(2, '0')}d` : null,
        `${String(hours).padStart(2, '0')}h`,
        `${String(minutes).padStart(2, '0')}m`,
        `${String(seconds).padStart(2, '0')}s`
      ].filter(Boolean).join(' : ');

      this.element.innerHTML = `
        <div style="font-size: 1.1rem; font-weight: 600; color: var(--gray-400);">
          Opens in ${timeString}
        </div>
      `;

      this.animationId = requestAnimationFrame(() => this.tick());
    }

    destroy(): void {
      if (this.animationId) {
        cancelAnimationFrame(this.animationId);
      }
    }
  }

  // Initialize countdown only if element exists
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      if (document.getElementById('countdown')) {
        new CountdownTimer('2025-10-31T17:00:00Z');
      }
    });
  } else {
    if (document.getElementById('countdown')) {
      new CountdownTimer('2025-10-31T17:00:00Z');
    }
  }
</script>

  <!-- Minimal countdown element that only shows for coming soon variant -->
  {variant === 'comingSoon' && (
    <div id="countdown" class="countdown-minimal" aria-live="polite" aria-label="Launch countdown timer"></div>
  )}
</section>
