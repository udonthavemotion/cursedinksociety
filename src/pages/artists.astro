---
import Layout from '../layouts/Layout.astro';
import ArtistsHero from '../components/ArtistsHero.astro';
import ArtistCardUniversal from '../components/ArtistCardUniversal.astro';
import { artists } from '../data/artists';

const pageTitle = "Artists - Cursed Ink Society";
const pageDescription = "Meet our talented tattoo artists at Cursed Ink Society. Professional artisans specializing in custom tattoos, traditional styles, and unique designs.";
---

<Layout title={pageTitle} description={pageDescription}>
  <!-- Beautiful Hero Section -->
  <ArtistsHero showStats={false} />

  <!-- Artists Grid -->
  <section class="artists-section">
    <div class="container">
      <div class="artists-grid">
        {artists.map((artist) => (
          <ArtistCardUniversal artist={artist} />
        ))}
      </div>
    </div>
  </section>

  <!-- Call to Action -->
  <section class="cta-section">
    <div class="container">
      <div class="cta-content">
        <h2>Ready to Begin Your Journey?</h2>
        <p>Connect with our artists on Instagram to explore their work and start your tattoo conversation</p>
        <a href="/contact" class="cta-button">Contact the Shop</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Artists Section */
  .artists-section {
    padding: 4rem 0;
    position: relative;
    z-index: 2;
    background:
      radial-gradient(ellipse at 30% 20%, rgba(220, 20, 60, 0.04) 0%, transparent 60%),
      radial-gradient(ellipse at 70% 80%, rgba(178, 34, 52, 0.03) 0%, transparent 60%),
      linear-gradient(180deg, #0a0a0c 0%, #1a0a0a 100%);
  }


  /* Artists Grid - Responsive */
  .artists-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: 2rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  /* CTA Section */
  .cta-section {
    padding: 4rem 0;
    position: relative;
    z-index: 2;
    background:
      radial-gradient(ellipse at 50% 50%, rgba(220, 20, 60, 0.03) 0%, transparent 70%),
      linear-gradient(180deg, rgba(0,0,0,0.1) 0%, rgba(26, 10, 10, 0.95) 100%);
  }

  .cta-content {
    text-align: center;
    max-width: 600px;
    margin: 0 auto;
  }

  .cta-content h2 {
    font-size: clamp(2rem, 4vw, 3rem);
    color: #f5f5f5;
    margin-bottom: 1rem;
    text-shadow: 0 0 15px rgba(220, 20, 60, 0.4);
    font-weight: 700;
  }

  .cta-content p {
    font-size: 1.1rem;
    color: rgba(245, 245, 245, 0.8);
    margin-bottom: 2rem;
    line-height: 1.6;
  }

  .cta-button {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1.25rem 2.5rem;
    background: rgba(220, 20, 60, 0.9);
    color: #f5f5f5;
    border: 2px solid rgba(178, 34, 52, 0.8);
    border-radius: 12px;
    font-weight: 700;
    font-size: 1.1rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    text-decoration: none;
    transition: all 0.3s ease;
    box-shadow: 0 6px 16px rgba(220, 20, 60, 0.3);
    position: relative;
    overflow: hidden;
  }

  .cta-button::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
    transition: left 0.6s ease;
  }

  .cta-button:hover::before {
    left: 100%;
  }

  .cta-button:hover {
    background: rgba(178, 34, 52, 0.9);
    transform: translateY(-2px);
    box-shadow: 0 10px 24px rgba(220, 20, 60, 0.4);
    border-color: rgba(220, 20, 60, 0.8);
  }

  /* Container */
  .container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 1rem;
  }

  /* Responsive Design */
  @media (min-width: 768px) {
    .artists-grid {
      grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
      gap: 2.5rem;
    }

  }

  @media (min-width: 1024px) {
    .artists-grid {
      grid-template-columns: repeat(auto-fit, minmax(450px, 1fr));
      gap: 3rem;
    }
  }

  @media (min-width: 1280px) {
    .artists-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }


  /* Mobile Optimizations */
  @media (max-width: 767px) {
    .artists-page {
      background-attachment: scroll;
    }

    .artists-header {
      padding: 3rem 0 2rem;
    }

    .page-title {
      font-size: 2.5rem;
    }

    .page-subtitle {
      font-size: 1.1rem;
      margin-bottom: 2rem;
    }


    .artists-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .cta-section {
      padding: 3rem 0;
    }

    .cta-content h2 {
      font-size: 2rem;
    }

    .cta-content p {
      font-size: 1rem;
    }

    .cta-button {
      padding: 1rem 2rem;
      font-size: 1rem;
    }
  }

  @media (max-width: 480px) {
    .artists-header {
      padding: 2rem 0 1.5rem;
    }

    .page-title {
      font-size: 2rem;
    }

    .page-subtitle {
      font-size: 1rem;
    }


    .cta-content h2 {
      font-size: 1.5rem;
    }

    .cta-button {
      padding: 0.875rem 1.5rem;
      font-size: 0.9rem;
    }
  }

  /* Accessibility & Reduced Motion */
  @media (prefers-reduced-motion: reduce) {
    .cta-button {
      transition: none;
    }

    .cta-button::before {
      display: none;
    }

    .cta-button:hover {
      transform: none;
    }
  }

  /* High Contrast Mode */
  @media (prefers-contrast: high) {
    .cta-button {
      border-width: 3px;
    }
  }

  /* Print Styles */
  @media print {
    .artists-page {
      background: white !important;
    }

    .page-title,
    .cta-content h2 {
      color: black !important;
      text-shadow: none !important;
    }

    .cta-button {
      display: none;
    }
  }
</style>