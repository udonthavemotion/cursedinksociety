
---
import Layout from '../layouts/Layout.astro';
import { slugify } from '../lib/slugify';
import { getPrioritizedPortfolioItems, getMergedArtists, getTotalPortfolioCount } from '../lib/portfolioAggregator';

const title = "Gallery — Cursed Ink Society Portfolio";
const description = "Browse our extensive portfolio of tattoo artwork. See examples of traditional, realism, fine line, Japanese, and custom tattoo designs by our master artists.";

// Get prioritized and randomized portfolio items 
const allPortfolioItems = getPrioritizedPortfolioItems();

// Get merged artist data for the artist showcase section
const artists = getMergedArtists();

// Calculate total items (now includes videos too)
const totalImages = getTotalPortfolioCount();
---

<Layout title={title} description={description}>
  <!-- Hero Section with Enhanced Logo Display -->
  <section class="gallery-hero enhanced-hero">
    <!-- Three.js Canvas Background -->
    <canvas id="gallery-hero-canvas" aria-hidden="true" role="presentation"></canvas>

    <div class="hero-content">
      <div class="container">
        <!-- Main Hero Content -->
        <div class="hero-main">
          <div class="hero-text-section">
            <div class="hero-pretitle">
              <span class="pretitle-accent">✦</span>
              <span class="pretitle-text">OUR MASTERPIECES</span>
              <span class="pretitle-accent">✦</span>
            </div>

            <h1 class="hero-title">
              <span class="title-word">
                <span class="letter" data-letter="C">C</span>
                <span class="letter" data-letter="U">U</span>
                <span class="letter" data-letter="R">R</span>
                <span class="letter" data-letter="S">S</span>
                <span class="letter" data-letter="E">E</span>
                <span class="letter" data-letter="D">D</span>
              </span>
              <span class="title-word">
                <span class="letter" data-letter="I">I</span>
                <span class="letter" data-letter="N">N</span>
                <span class="letter" data-letter="K">K</span>
              </span>
              <span class="title-word">
                <span class="letter" data-letter="S">S</span>
                <span class="letter" data-letter="O">O</span>
                <span class="letter" data-letter="C">C</span>
                <span class="letter" data-letter="I">I</span>
                <span class="letter" data-letter="E">E</span>
                <span class="letter" data-letter="T">T</span>
                <span class="letter" data-letter="Y">Y</span>
              </span>
              <span class="title-word">
                <span class="letter" data-letter="G">G</span>
                <span class="letter" data-letter="A">A</span>
                <span class="letter" data-letter="L">L</span>
                <span class="letter" data-letter="L">L</span>
                <span class="letter" data-letter="E">E</span>
                <span class="letter" data-letter="R">R</span>
                <span class="letter" data-letter="Y">Y</span>
              </span>
            </h1>

            <p class="hero-subtitle">
              WITNESS THE ARTISTRY OF SIX MASTER TATTOO ARTISTS. EXPLORE OUR EXTENSIVE COLLECTION OF SACRED INK, FROM TRADITIONAL MASTERPIECES TO CONTEMPORARY VISIONS, EACH PIECE CRAFTED WITH PASSION AND PRECISION.
            </p>

          </div>

          <div class="hero-visual-section">
            <!-- 3D Interactive Logo -->
            <div class="logo-showcase">
              <div class="logo-container" id="gallery-logo-container">
                <img
                  src="/brand/cursed-ink-logo.png"
                  alt="Cursed Ink Society Logo"
                  class="hero-logo"
                  id="gallery-interactive-logo"
                  loading="eager"
                />

                <!-- Animated Glow Rings -->
                <div class="glow-ring ring-1"></div>
                <div class="glow-ring ring-2"></div>
                <div class="glow-ring ring-3"></div>

                <!-- Floating Particles -->
                <div class="floating-particles">
                  <div class="particle particle-1"></div>
                  <div class="particle particle-2"></div>
                  <div class="particle particle-3"></div>
                  <div class="particle particle-4"></div>
                  <div class="particle particle-5"></div>
                </div>
              </div>

              <!-- Holographic Effect Overlay -->
              <div class="holographic-overlay"></div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>



  <!-- Unified Gallery Grid -->
  <section class="gallery-section">
    <div class="container">
      <div class="gallery-grid" id="gallery-grid">
        {allPortfolioItems.map((item) => (
          <article class="gallery-item" data-category="all" data-item-id={item.id} data-type={item.type}>
            <div class="gallery-image-container">
              {item.type === 'video' ? (
                <video
                  src={item.video}
                  class="gallery-video"
                  loop
                  muted
                  playsinline
                  preload="metadata"
                  poster={item.image || undefined}
                  width="300"
                  height="400"
                />
              ) : (
                <img
                  src={item.image}
                  alt={item.alt}
                  class="gallery-image"
                  loading="lazy"
                  width="300"
                  height="400"
                />
              )}
              <div class="image-placeholder">
                <div class="placeholder-shimmer"></div>
              </div>
              {item.type === 'video' && (
                <div class="video-play-indicator">
                  <svg width="48" height="48" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M8 5v14l11-7z"/>
                  </svg>
                </div>
              )}
              <div class="gallery-overlay">
                <div class="gallery-info">
                  <h3 class="gallery-title">{item.title}</h3>
                  <p class="gallery-artist">by {item.artist}</p>
                  <span class="gallery-specialty">{item.specialty}</span>
                  {item.type === 'video' && (
                    <span class="media-type-badge">Video</span>
                  )}
                </div>
                <button class="gallery-view-btn" data-lightbox={item.id} data-type={item.type}>
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/>
                  </svg>
                  {item.type === 'video' ? 'Play Video' : 'View Masterpiece'}
                </button>
              </div>
            </div>
          </article>
        ))}
      </div>

      <!-- Load More Button -->
      <div class="gallery-load-more">
        <button class="btn btn--outline btn--large" id="load-more-btn">
          Load More Work
        </button>
      </div>
    </div>
  </section>

  <!-- Artist Showcase -->
  <section class="artist-showcase">
    <div class="container">
      <h2 class="section-title">Meet the Artists Behind the Work</h2>
      <div class="artist-preview-grid">
        {artists.map((artist) => (
          <div class="artist-preview">
            <img src={artist.avatar} alt={`${artist.name} - Professional tattoo artist`} class="artist-avatar" />
            <div class="artist-preview-info">
              <h3>{artist.name}</h3>
              <p>{artist.title || artist.blurb}</p>
              <a href={`/artists/${slugify(artist.slug ?? artist.name)}`} class="artist-link">View Profile →</a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="gallery-cta">
    <div class="container">
      <div class="cta-content">
        <h2>Ready to Create Your Own Masterpiece?</h2>
        <p class="text-center text-sm opacity-80">
          Message your artist directly or visit the shop for a consultation.
        </p>
        <div class="cta-actions">
          <a href="/artists" class="btn btn--primary btn--large">Meet Our Artists</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Lightbox Modal -->
  <div class="lightbox" id="lightbox">
    <div class="lightbox-backdrop"></div>
    <div class="lightbox-content">
      <button class="lightbox-close" id="lightbox-close">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
          <path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
        </svg>
      </button>
      <img class="lightbox-image" id="lightbox-image" alt="" />
      <div class="lightbox-info" id="lightbox-info">
        <h3 class="lightbox-title"></h3>
        <p class="lightbox-artist"></p>
        <span class="lightbox-specialty"></span>
      </div>
    </div>
  </div>
</Layout>

<script>
  // Gallery Manager with enhanced lightbox and smooth animations
  class GalleryManager {
    galleryItems: NodeListOf<Element>;
    viewButtons: NodeListOf<Element>;
    lightbox: HTMLElement | null;
    lightboxImage: HTMLElement | null;
    lightboxInfo: HTMLElement | null;
    lightboxClose: HTMLElement | null;
    loadMoreBtn: HTMLElement | null;
    currentFilter: string;
    visibleItems: number;
    allImages: string[];
    currentImageIndex: number;
    touchStartX: number;
    touchStartY: number;
    touchEndX: number;
    touchEndY: number;

    constructor() {
      this.galleryItems = document.querySelectorAll('.gallery-item');
      this.viewButtons = document.querySelectorAll('.gallery-view-btn');
      this.lightbox = document.getElementById('lightbox');
      this.lightboxImage = document.getElementById('lightbox-image');
      this.lightboxInfo = document.getElementById('lightbox-info');
      this.lightboxClose = document.getElementById('lightbox-close');
      this.loadMoreBtn = document.getElementById('load-more-btn');

      this.currentFilter = 'all';
      this.visibleItems = 12; // Initially show 12 items
      this.allImages = [];
      this.currentImageIndex = 0;
      this.touchStartX = 0;
      this.touchStartY = 0;
      this.touchEndX = 0;
      this.touchEndY = 0;

      this.init();
    }

    init() {
      // Lightbox functionality
      this.viewButtons.forEach((btn: Element) => {
        btn.addEventListener('click', (e: Event) => this.openLightbox(e));
      });

      // Lightbox close functionality
      if (this.lightboxClose) {
        this.lightboxClose.addEventListener('click', () => this.closeLightbox());
      }

      if (this.lightbox) {
        this.lightbox.addEventListener('click', (e: Event) => {
          if (e.target === this.lightbox || (e.target as Element).classList.contains('lightbox-backdrop')) {
            this.closeLightbox();
          }
        });

        // Add touch gesture support for mobile navigation
        this.lightbox.addEventListener('touchstart', this.handleTouchStart.bind(this), { passive: true });
        this.lightbox.addEventListener('touchmove', this.handleTouchMove.bind(this), { passive: true });
        this.lightbox.addEventListener('touchend', this.handleTouchEnd.bind(this), { passive: false });
      }

      // Load more functionality
      if (this.loadMoreBtn) {
        this.loadMoreBtn.addEventListener('click', () => this.loadMoreItems());
      }

      // Keyboard navigation
      document.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'Escape' && this.lightbox?.classList.contains('lightbox--open')) {
          this.closeLightbox();
        }
        if (e.key === 'ArrowLeft' && this.lightbox?.classList.contains('lightbox--open')) {
          this.navigateLightbox(-1);
        }
        if (e.key === 'ArrowRight' && this.lightbox?.classList.contains('lightbox--open')) {
          this.navigateLightbox(1);
        }
      });

      // Initial load
      this.updateGalleryDisplay();
      this.collectAllImages();
      this.setupVideoHovers();
    }

    setupVideoHovers() {
      // Add hover interactions for videos
      this.galleryItems.forEach(item => {
        const video = item.querySelector('.gallery-video') as HTMLVideoElement;
        if (video) {
          item.addEventListener('mouseenter', () => {
            video.play().catch(() => {
              // Handle autoplay restrictions
            });
          });
          
          item.addEventListener('mouseleave', () => {
            video.pause();
            video.currentTime = 0; // Reset to beginning
          });
        }
      });
    }

    collectAllImages() {
      this.allImages = Array.from(this.galleryItems).map(item => {
        const img = item.querySelector('.gallery-image') as HTMLImageElement;
        const video = item.querySelector('.gallery-video') as HTMLVideoElement;
        
        if (video && video.src) {
          return video.src;
        } else if (img && img.src) {
          return img.src;
        }
        return '';
      }).filter(src => src !== '');
    }

    updateGalleryDisplay() {
      // Hide all items first
      this.galleryItems.forEach((item: Element) => {
        (item as HTMLElement).style.display = 'none';
        item.classList.remove('gallery-item--visible');
      });

      // Show items up to visible limit
      const itemsToShow = Array.from(this.galleryItems).slice(0, this.visibleItems);
      itemsToShow.forEach((item: Element) => {
        (item as HTMLElement).style.display = 'block';
        setTimeout(() => item.classList.add('gallery-item--visible'), 50);
      });

      // Update load more button
      if (this.loadMoreBtn) {
        if (this.galleryItems.length > this.visibleItems) {
          this.loadMoreBtn.style.display = 'block';
        } else {
          this.loadMoreBtn.style.display = 'none';
        }
      }
    }

    loadMoreItems() {
      this.visibleItems += 12;
      this.updateGalleryDisplay();
    }

    openLightbox(e: Event) {
      e.preventDefault();
      const button = e.currentTarget as HTMLElement;
      const galleryItem = button.closest('.gallery-item') as HTMLElement;
      const mediaType = button.getAttribute('data-type') || 'image';
      const image = galleryItem.querySelector('.gallery-image') as HTMLImageElement;
      const video = galleryItem.querySelector('.gallery-video') as HTMLVideoElement;
      const title = galleryItem.querySelector('.gallery-title')?.textContent || '';
      const artist = galleryItem.querySelector('.gallery-artist')?.textContent || '';
      const specialty = galleryItem.querySelector('.gallery-specialty')?.textContent || '';

      let mediaSrc = '';
      let mediaAlt = '';

      if (mediaType === 'video' && video) {
        mediaSrc = video.src || '';
        mediaAlt = `Video by ${artist}`;

        // Find current media index in all media array
        this.currentImageIndex = this.allImages.indexOf(mediaSrc);
      } else if (image) {
        mediaSrc = image.src || '';
        mediaAlt = image.alt;

        // Find current image index in all images array
        this.currentImageIndex = this.allImages.indexOf(mediaSrc);
      } else {
        return;
      }

      // Update lightbox content
      if (this.lightboxImage) {
        if (mediaType === 'video') {
          // Convert img element to video element for video content
          const lightboxContent = this.lightbox?.querySelector('.lightbox-content');
          if (lightboxContent) {
            const existingImage = lightboxContent.querySelector('.lightbox-image');
            if (existingImage) {
              const videoElement = document.createElement('video');
              videoElement.className = 'lightbox-image';
              videoElement.id = 'lightbox-image';
              videoElement.src = mediaSrc;
              videoElement.controls = true;
              videoElement.autoplay = true;
              videoElement.loop = true;
              videoElement.muted = false;
              videoElement.style.maxWidth = '100%';
              videoElement.style.maxHeight = '70vh';
              videoElement.style.objectFit = 'contain';

              existingImage.replaceWith(videoElement);
              this.lightboxImage = videoElement;
            }
          }
        } else {
          // Ensure it's an image element
          if (this.lightboxImage.tagName === 'VIDEO') {
            const lightboxContent = this.lightbox?.querySelector('.lightbox-content');
            if (lightboxContent) {
              const imageElement = document.createElement('img');
              imageElement.className = 'lightbox-image';
              imageElement.id = 'lightbox-image';
              imageElement.src = mediaSrc;
              imageElement.alt = mediaAlt;
              imageElement.style.maxWidth = '100%';
              imageElement.style.maxHeight = '70vh';
              imageElement.style.objectFit = 'contain';

              this.lightboxImage.replaceWith(imageElement);
              this.lightboxImage = imageElement;
            }
          } else {
            (this.lightboxImage as HTMLImageElement).src = mediaSrc;
            (this.lightboxImage as HTMLImageElement).alt = mediaAlt;
          }
        }
      }

      if (this.lightboxInfo) {
        this.lightboxInfo.querySelector('.lightbox-title')!.textContent = title;
        this.lightboxInfo.querySelector('.lightbox-artist')!.textContent = artist;
        this.lightboxInfo.querySelector('.lightbox-specialty')!.textContent = specialty;
      }

      // Show lightbox with smooth animation
      this.lightbox?.classList.add('lightbox--open');

      // Mobile-friendly overflow handling - improved to prevent scrolling issues
      const isMobile = /Android|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);
      if (isMobile) {
        // Store current scroll position
        const scrollY = window.scrollY;

        // Prevent background scrolling while lightbox is open
        document.body.style.position = 'fixed';
        document.body.style.top = `-${scrollY}px`;
        document.body.style.left = '0';
        document.body.style.right = '0';
        document.body.style.width = '100%';

        // Ensure lightbox takes full viewport height
        if (this.lightbox) {
          this.lightbox.style.height = '100vh';
          this.lightbox.style.overflow = 'hidden';
        }
      } else {
        document.body.style.overflow = 'hidden';
      }

      // Add navigation arrows if there are multiple images
      if (this.allImages.length > 1) {
        this.addNavigationArrows();
      }
    }

    closeLightbox() {
      this.lightbox?.classList.remove('lightbox--open');

      // Mobile-friendly overflow restoration - improved
      const isMobile = /Android|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);
      if (isMobile) {
        // Restore scroll position and body styles
        const scrollY = document.body.style.top;
        document.body.style.position = '';
        document.body.style.width = '';
        document.body.style.left = '';
        document.body.style.right = '';
        document.body.style.top = '';

        // Restore scroll position
        if (scrollY) {
          const scrollPosition = parseInt(scrollY) * -1;
          window.scrollTo(0, scrollPosition);
        }

        // Clear any inline styles on lightbox
        if (this.lightbox) {
          this.lightbox.style.height = '';
          this.lightbox.style.overflow = '';
        }
      } else {
        document.body.style.overflow = '';
      }

      // Remove navigation arrows
      this.removeNavigationArrows();
    }

    addNavigationArrows() {
      if (!this.lightbox) return;

      // Create navigation arrows using safe SVG creation methods
      const leftArrow = document.createElement('button');
      leftArrow.className = 'lightbox-nav lightbox-nav--left';
      leftArrow.setAttribute('aria-label', 'Previous image');
      
      const leftSvg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
      leftSvg.setAttribute('width', '24');
      leftSvg.setAttribute('height', '24');
      leftSvg.setAttribute('viewBox', '0 0 24 24');
      leftSvg.setAttribute('fill', 'currentColor');
      const leftPath = document.createElementNS('http://www.w3.org/2000/svg', 'path');
      leftPath.setAttribute('d', 'M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z');
      leftSvg.appendChild(leftPath);
      leftArrow.appendChild(leftSvg);
      leftArrow.addEventListener('click', () => this.navigateLightbox(-1));

      const rightArrow = document.createElement('button');
      rightArrow.className = 'lightbox-nav lightbox-nav--right';
      rightArrow.setAttribute('aria-label', 'Next image');
      
      const rightSvg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
      rightSvg.setAttribute('width', '24');
      rightSvg.setAttribute('height', '24');
      rightSvg.setAttribute('viewBox', '0 0 24 24');
      rightSvg.setAttribute('fill', 'currentColor');
      const rightPath = document.createElementNS('http://www.w3.org/2000/svg', 'path');
      rightPath.setAttribute('d', 'M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z');
      rightSvg.appendChild(rightPath);
      rightArrow.appendChild(rightSvg);
      rightArrow.addEventListener('click', () => this.navigateLightbox(1));

      this.lightbox.appendChild(leftArrow);
      this.lightbox.appendChild(rightArrow);

      // Update arrow visibility
      this.updateNavigationArrows();
    }

    removeNavigationArrows() {
      const arrows = document.querySelectorAll('.lightbox-nav');
      arrows.forEach(arrow => arrow.remove());
    }

    updateNavigationArrows() {
      const leftArrow = document.querySelector('.lightbox-nav--left') as HTMLElement;
      const rightArrow = document.querySelector('.lightbox-nav--right') as HTMLElement;

      if (leftArrow) {
        leftArrow.style.opacity = this.currentImageIndex > 0 ? '1' : '0.3';
        leftArrow.style.pointerEvents = this.currentImageIndex > 0 ? 'auto' : 'none';
      }

      if (rightArrow) {
        rightArrow.style.opacity = this.currentImageIndex < this.allImages.length - 1 ? '1' : '0.3';
        rightArrow.style.pointerEvents = this.currentImageIndex < this.allImages.length - 1 ? 'auto' : 'none';
      }
    }

    navigateLightbox(direction: number) {
      if (this.allImages.length <= 1) return;

      const newIndex = this.currentImageIndex + direction;
      if (newIndex >= 0 && newIndex < this.allImages.length) {
        this.currentImageIndex = newIndex;
        this.updateLightboxImage();
        this.updateNavigationArrows();
      }
    }

    updateLightboxImage() {
      if (this.lightboxImage && this.allImages[this.currentImageIndex]) {
        (this.lightboxImage as HTMLImageElement).src = this.allImages[this.currentImageIndex];

        // Update info for the new image
        const currentGalleryItem = Array.from(this.galleryItems)[this.currentImageIndex];
        if (currentGalleryItem) {
          const title = currentGalleryItem.querySelector('.gallery-title')?.textContent || '';
          const artist = currentGalleryItem.querySelector('.gallery-artist')?.textContent || '';
          const specialty = currentGalleryItem.querySelector('.gallery-specialty')?.textContent || '';
          const image = currentGalleryItem.querySelector('.gallery-image') as HTMLImageElement;

          if (this.lightboxInfo) {
            this.lightboxInfo.querySelector('.lightbox-title')!.textContent = title;
            this.lightboxInfo.querySelector('.lightbox-artist')!.textContent = artist;
            this.lightboxInfo.querySelector('.lightbox-specialty')!.textContent = specialty;
          }

          if (image) {
            (this.lightboxImage as HTMLImageElement).alt = image.alt;
          }
        }
      }
    }

    // Touch gesture handling for mobile navigation
    handleTouchStart(e: TouchEvent) {
      this.touchStartX = e.changedTouches[0].screenX;
      this.touchStartY = e.changedTouches[0].screenY;
    }

    handleTouchMove(e: TouchEvent) {
      this.touchEndX = e.changedTouches[0].screenX;
      this.touchEndY = e.changedTouches[0].screenY;
    }

    handleTouchEnd(e: TouchEvent) {
      if (!this.touchStartX || !this.touchStartY) return;

      const deltaX = this.touchStartX - this.touchEndX;
      const deltaY = this.touchStartY - this.touchEndY;
      const minSwipeDistance = 50;

      // Check if it's a horizontal swipe (more significant than vertical)
      if (Math.abs(deltaX) > Math.abs(deltaY) && Math.abs(deltaX) > minSwipeDistance) {
        if (deltaX > 0) {
          // Swipe left - next image
          this.navigateLightbox(1);
        } else {
          // Swipe right - previous image
          this.navigateLightbox(-1);
        }
      }

      // Reset touch coordinates
      this.touchStartX = 0;
      this.touchStartY = 0;
      this.touchEndX = 0;
      this.touchEndY = 0;
    }
  }

  // Enhanced lazy loading with performance optimizations
  class OptimizedImageLoader {
    imageObserver: IntersectionObserver | null;

    constructor() {
      this.imageObserver = null;
      this.init();
    }

    init() {
      if ('IntersectionObserver' in window) {
        this.imageObserver = new IntersectionObserver((entries: IntersectionObserverEntry[]) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              const img = entry.target as HTMLImageElement;
              this.loadImage(img);
              this.imageObserver!.unobserve(img);
            }
          });
        }, {
          rootMargin: '100px',
          threshold: 0.01
        });

        // Observe all gallery images
        document.querySelectorAll('.gallery-image').forEach((img: Element) => {
          this.imageObserver!.observe(img);
        });
      }
    }

    loadImage(img: HTMLImageElement) {
      // Add loading class for smooth transition
      img.classList.add('loading');

      // If image is already loaded, mark it as loaded
      if (img.complete && img.naturalHeight !== 0) {
        img.classList.add('loaded');
        img.classList.remove('loading');
        return;
      }

      img.addEventListener('load', () => {
        img.classList.add('loaded');
        img.classList.remove('loading');
      });

      // Handle load errors gracefully
      img.addEventListener('error', () => {
        img.classList.add('error');
        img.classList.remove('loading');
        console.warn(`Failed to load image: ${img.src}`);
      });
    }
  }

  // Hero Video Manager (unchanged)
  class HeroVideoManager {
    video: HTMLVideoElement | null;
    fallback: HTMLElement | null;

    constructor() {
      this.video = document.querySelector('.hero-video') as HTMLVideoElement | null;
      this.fallback = document.querySelector('.hero-fallback') as HTMLElement | null;
      this.init();
    }

    init() {
      if (!this.video) return;

      // Performance optimization: Reduce video quality on mobile
      if (this.isMobile()) {
        this.video.style.filter = 'blur(1px) contrast(0.9)';
        this.video.style.opacity = '0.2';
      }

      // Handle video loading and errors
      this.video.addEventListener('loadeddata', () => {
        if (this.video) {
          this.video.style.opacity = this.isMobile() ? '0.2' : '0.4';
        }
      });

      this.video.addEventListener('error', () => {
        console.warn('Video failed to load, using fallback image');
        if (this.fallback) {
          this.fallback.style.display = 'block';
        }
      });

      // Pause video when page becomes hidden to save resources
      document.addEventListener('visibilitychange', () => {
        if (this.video) {
          if (document.hidden) {
            this.video.pause();
          } else {
            this.video.play().catch(() => {
              // Silently handle autoplay failures (common on mobile)
            });
          }
        }
      });

      // Intersection Observer for performance
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver((entries: IntersectionObserverEntry[]) => {
          entries.forEach(entry => {
            if (entry.isIntersecting && this.video) {
              this.video.play().catch(() => {
                // Handle autoplay restrictions
              });
            } else if (this.video) {
              this.video.pause();
            }
          });
        }, { threshold: 0.1 });

        observer.observe(this.video);
      }
    }

    isMobile(): boolean {
      return window.innerWidth < 768 || /Android|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);
    }
  }

  // Enhanced 3D Logo Interaction for Gallery Page
  class GalleryLogoInteraction {
    private logo: HTMLElement | null;
    private container: HTMLElement | null;
    private mouse: { x: number; y: number };
    private animationId: number | null;

    constructor() {
      this.logo = document.getElementById('gallery-interactive-logo');
      this.container = document.getElementById('gallery-logo-container');
      this.mouse = { x: 0, y: 0 };
      this.animationId = null;
      this.init();
    }

    init(): void {
      if (!this.logo || !this.container) return;

      window.addEventListener('mousemove', this.handleMouseMove.bind(this), { passive: true });

      // Only add touch events on non-mobile devices to prevent scroll interference
      const isMobile = /Android|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);
      if (!isMobile) {
        window.addEventListener('touchmove', this.handleTouchMove.bind(this), { passive: true });
      }

      // Add hover effects
      this.container.addEventListener('mouseenter', this.handleMouseEnter.bind(this));
      this.container.addEventListener('mouseleave', this.handleMouseLeave.bind(this));

      this.animate();
    }

    handleMouseMove(e: MouseEvent): void {
      this.updateMousePosition(e.clientX, e.clientY);
    }

    handleTouchMove(e: TouchEvent): void {
      if (e.touches.length > 0) {
        this.updateMousePosition(e.touches[0].clientX, e.touches[0].clientY);
      }
    }

    updateMousePosition(clientX: number, clientY: number): void {
      if (!this.container) return;

      const rect = this.container.getBoundingClientRect();
      const centerX = rect.left + rect.width / 2;
      const centerY = rect.top + rect.height / 2;

      this.mouse.x = (clientX - centerX) / (window.innerWidth / 2);
      this.mouse.y = (clientY - centerY) / (window.innerHeight / 2);
    }

    handleMouseEnter(): void {
      if (this.logo) {
        (this.logo as HTMLElement).style.filter = `
          drop-shadow(0 0 80px rgba(255, 60, 43, 1))
          drop-shadow(0 0 160px rgba(255, 60, 43, 0.7))
          drop-shadow(0 0 240px rgba(255, 60, 43, 0.4))
        `;
      }
    }

    handleMouseLeave(): void {
      if (this.logo) {
        (this.logo as HTMLElement).style.filter = `
          drop-shadow(0 0 50px rgba(255, 60, 43, 0.8))
          drop-shadow(0 0 100px rgba(255, 60, 43, 0.5))
          drop-shadow(0 0 150px rgba(255, 60, 43, 0.3))
        `;
      }
    }

    animate(): void {
      if (!this.logo) return;

      const rotationX = -this.mouse.y * 20;
      const rotationY = this.mouse.x * 20;
      const rotationZ = Math.sin(Date.now() * 0.001) * 3;
      const scale = 1 + Math.min(Math.sqrt(this.mouse.x * this.mouse.x + this.mouse.y * this.mouse.y) * 0.1, 0.2);

      (this.logo as HTMLElement).style.transform = `
        perspective(1200px)
        rotateX(${rotationX}deg)
        rotateY(${rotationY}deg)
        rotateZ(${rotationZ}deg)
        scale(${scale})
      `;

      this.animationId = requestAnimationFrame(() => this.animate());
    }
  }

  // Initialize Gallery Hero Components
  function initGalleryHeroComponents() {
    new GalleryLogoInteraction();
  }

  // Three.js Background for Gallery Hero
  async function initGalleryHeroBackground(): Promise<void> {
    try {
      const canvas = document.getElementById('gallery-hero-canvas') as HTMLCanvasElement;
      if (!canvas) return;

      // Check for reduced motion preference
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const isMobile = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);
      
      // WebGL capability check
      const gl = canvas.getContext('webgl') || canvas.getContext('experimental-webgl');
      if (!gl) {
        canvas.style.display = 'none';
        return;
      }

      const THREE = await import('three');

      const renderer = new THREE.WebGLRenderer({
        canvas,
        antialias: !isMobile,
        alpha: true,
        powerPreference: isMobile ? 'low-power' : 'high-performance'
      });

      const scene = new THREE.Scene();
      const camera = new THREE.PerspectiveCamera(75, 2, 0.1, 100);
      camera.position.set(0, 0, 5);

      // Optimized resize handler
      function resize(): void {
        const { clientWidth: w, clientHeight: h } = canvas;
        if (canvas.width !== w || canvas.height !== h) {
          renderer.setSize(w, h, false);
          camera.aspect = w / h;
          camera.updateProjectionMatrix();
        }
      }

      resize();
      new ResizeObserver(resize).observe(canvas);
      renderer.setPixelRatio(Math.min(isMobile ? 1.5 : 2, window.devicePixelRatio || 1));

      // Create floating particles with gallery theme - optimized for mobile
      const particleCount = isMobile ? 200 : (prefersReducedMotion ? 150 : 600);
      const geometry = new THREE.BufferGeometry();
      const positions = new Float32Array(particleCount * 3);

      for (let i = 0; i < particleCount; i++) {
        const i3 = i * 3;
        positions[i3] = (Math.random() - 0.5) * 25;
        positions[i3 + 1] = (Math.random() - 0.5) * 15;
        positions[i3 + 2] = -(Math.random() * 10 + 3);
      }

      geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));

      const particleMaterial = new THREE.PointsMaterial({
        color: 0xffd4b3,
        size: isMobile ? 0.012 : 0.025,
        transparent: true,
        opacity: prefersReducedMotion ? 0.3 : (isMobile ? 0.5 : 0.7),
        blending: THREE.AdditiveBlending,
        depthWrite: false,
        // Performance optimization: reduce quality on mobile
        alphaTest: isMobile ? 0.01 : 0,
        sizeAttenuation: !isMobile
      });

      const particles = new THREE.Points(geometry, particleMaterial);
      scene.add(particles);

      // Mouse interaction
      const mouse = new THREE.Vector2();
      let mouseUpdateId = 0;

      const updateMouse = (e: PointerEvent): void => {
        cancelAnimationFrame(mouseUpdateId);
        mouseUpdateId = requestAnimationFrame(() => {
          mouse.x = (e.clientX / window.innerWidth) * 2 - 1;
          mouse.y = -(e.clientY / window.innerHeight) * 2 + 1;
        });
      };

      window.addEventListener('pointermove', updateMouse, { passive: true });

      // Animation loop - optimized for mobile performance
      const clock = new THREE.Clock();
      let animationId: number;
      let lastFrameTime = 0;
      const targetFPS = isMobile ? 30 : 60;
      const frameInterval = 1000 / targetFPS;

      function animate(currentTime = 0) {
        // Throttle animation on mobile for better performance
        if (isMobile && currentTime - lastFrameTime < frameInterval) {
          animationId = requestAnimationFrame(animate);
          return;
        }
        lastFrameTime = currentTime;

        animationId = requestAnimationFrame(animate);
        const dt = Math.min(clock.getDelta(), 1/30); // Cap delta time to prevent large jumps

        // Smooth camera movement - reduced frequency on mobile
        if (!prefersReducedMotion) {
          const cameraSpeed = isMobile ? 0.03 : 0.06;
          camera.position.x += (mouse.x * 0.6 - camera.position.x) * cameraSpeed;
          camera.position.y += (-mouse.y * 0.4 - camera.position.y) * cameraSpeed;
          camera.lookAt(0, 0, 0);

          // Particle rotation with gallery-specific motion - reduced on mobile
          const rotationSpeed = isMobile ? 0.5 : 1;
          particles.rotation.y += dt * 0.015 * rotationSpeed;
          particles.rotation.x += dt * 0.003 * rotationSpeed;
          particles.rotation.z += dt * 0.001 * rotationSpeed;
        }

        renderer.render(scene, camera);
      }

      animate();

      // Cleanup
      window.addEventListener('beforeunload', () => {
        cancelAnimationFrame(animationId);
        renderer.dispose();
        geometry.dispose();
        particleMaterial.dispose();
      });

    } catch (error) {
      console.warn('Gallery hero background initialization failed:', error);
      const canvas = document.getElementById('gallery-hero-canvas');
      if (canvas) canvas.style.display = 'none';
    }
  }

  // Initialize with optimized loading
  function initializeGalleryComponents() {
    // Initialize critical components first
    new GalleryManager();
    new OptimizedImageLoader();
    new HeroVideoManager();
    initGalleryHeroComponents();
    
    // Queue Three.js initialization with optimized loader
    if ((window as any).threeLoader) {
      (window as any).threeLoader.queueThreeJSInit('gallery-hero-canvas', initGalleryHeroBackground);
    } else {
      // Fallback if loader not available
      setTimeout(initGalleryHeroBackground, 1000);
    }
  }

  // Initialize everything when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeGalleryComponents);
  } else {
    initializeGalleryComponents();
  }
</script>

