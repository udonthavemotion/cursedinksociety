---
// ArtistPortfolioGallery.astro - Sophisticated portfolio display component
export interface Props {
  images: string[];
  artistName: string;
  artistSlug: string;
}

const { images, artistName, artistSlug } = Astro.props;
---

<div class="artist-portfolio-gallery">
  <!-- Gallery Header -->
  <div class="gallery-header">
    <h3 class="gallery-title">Portfolio Showcase</h3>
    <p class="gallery-subtitle">Explore {artistName}'s artistry through carefully curated works</p>
  </div>

  <!-- Masonry Gallery Grid -->
  <div class="gallery-masonry">
    {images.map((image, index) => {
      const isVideo = image.endsWith('.mp4') || image.endsWith('.mov') || image.endsWith('.webm');
      return (
        <div class="gallery-item" data-index={index}>
          <div class="gallery-image-wrapper">
            {isVideo ? (
              <video
                src={image}
                class="gallery-video"
                autoplay
                muted
                loop
                playsinline
                preload="metadata"
                width="400"
                height="400"
              >
                Your browser does not support the video tag.
              </video>
            ) : (
              <img
                src={image}
                alt={`${artistName} portfolio piece ${index + 1}`}
                class="gallery-image"
                loading={index < 6 ? "eager" : "lazy"}
                width="400"
                height="400"
              />
            )}
            <div class="gallery-overlay">
              <div class="gallery-actions">
                <button
                  class="gallery-zoom-btn"
                  aria-label={`View ${artistName} portfolio piece ${index + 1} in full size`}
                  data-image={image}
                  data-artist={artistName}
                  data-is-video={isVideo}
                >
                  {isVideo ? (
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <polygon points="5,3 19,12 5,21"/>
                    </svg>
                  ) : (
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <circle cx="11" cy="11" r="8"/>
                      <path d="m21 21-4.35-4.35"/>
                      <line x1="13" y1="9" x2="9" y2="13"/>
                      <line x1="9" y1="9" x2="13" y2="13"/>
                    </svg>
                  )}
                  <span class="sr-only">{isVideo ? 'Play' : 'Zoom'}</span>
                </button>
              </div>
            </div>
          </div>
        </div>
      );
    })}
  </div>

  <!-- Lightbox Modal -->
  <div id="portfolio-lightbox" class="lightbox-modal" aria-hidden="true">
    <div class="lightbox-backdrop" data-close-lightbox></div>
    <div class="lightbox-content">
      <button class="lightbox-close" data-close-lightbox aria-label="Close gallery">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="6" x2="6" y2="18"/>
          <line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>

      <div class="lightbox-image-container">
        <img id="lightbox-image" src="" alt="" class="lightbox-image" style="display: none;" />
        <video id="lightbox-video" src="" class="lightbox-video" controls muted loop playsinline preload="metadata" style="display: none;">
          Your browser does not support the video tag.
        </video>
        <div class="lightbox-info">
          <p id="lightbox-artist" class="lightbox-artist-name"></p>
          <p id="lightbox-caption" class="lightbox-caption"></p>
        </div>
      </div>

      <button class="lightbox-nav lightbox-prev" aria-label="Previous image">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="15,18 9,12 15,6"/>
        </svg>
      </button>

      <button class="lightbox-nav lightbox-next" aria-label="Next image">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="9,18 15,12 9,6"/>
        </svg>
      </button>
    </div>
  </div>
</div>

<style>
  /* Gallery Header */
  .gallery-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .gallery-title {
    font-size: clamp(2rem, 4vw, 2.5rem);
    font-weight: 700;
    margin: 0 0 0.5rem;
    color: #2d1b69;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.3), 0 1px 2px rgba(0, 0, 0, 0.2);
    letter-spacing: 0.02em;
  }

  .gallery-subtitle {
    font-size: 1.1rem;
    opacity: 0.8;
    margin: 0;
    max-width: 600px;
    margin: 0 auto;
  }

  /* Masonry Gallery */
  .gallery-masonry {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .gallery-item {
    position: relative;
    overflow: hidden;
    border-radius: 16px;
    background: var(--bg-glass);
    border: var(--border-glass);
    transition: var(--transition-smooth);
    cursor: pointer;
  }

  .gallery-item:hover {
    transform: translateY(-4px);
    box-shadow:
      0 20px 40px rgba(0, 0, 0, 0.2),
      0 0 30px rgba(255, 60, 43, 0.1);
    border-color: rgba(255, 60, 43, 0.2);
  }

  .gallery-image-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
  }

  .gallery-image, .gallery-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: var(--transition-smooth);
  }

  .gallery-item:hover .gallery-image,
  .gallery-item:hover .gallery-video {
    transform: scale(1.05);
  }

  .gallery-video {
    cursor: pointer;
    background: #000;
  }

  .gallery-video::-webkit-media-controls {
    display: none !important;
  }

  .gallery-video::-webkit-media-controls-enclosure {
    display: none !important;
  }

  /* Gallery Overlay */
  .gallery-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0) 60%,
      rgba(0, 0, 0, 0.8) 100%
    );
    opacity: 0;
    transition: var(--transition-smooth);
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding: 2rem;
  }

  .gallery-item:hover .gallery-overlay {
    opacity: 1;
  }

  .gallery-actions {
    display: flex;
    gap: 1rem;
  }

  .gallery-zoom-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 60px;
    height: 60px;
    background: rgba(255, 60, 43, 0.9);
    border: 2px solid rgba(255, 255, 255, 0.3);
    border-radius: 50%;
    color: white;
    backdrop-filter: blur(10px);
    transition: var(--transition-smooth);
    cursor: pointer;
  }

  .gallery-zoom-btn:hover {
    background: rgba(255, 60, 43, 1);
    border-color: rgba(255, 255, 255, 0.5);
    transform: scale(1.1);
  }

  /* Lightbox Modal */
  .lightbox-modal {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition: var(--transition-smooth);
  }

  .lightbox-modal[aria-hidden="false"] {
    opacity: 1;
    visibility: visible;
  }

  .lightbox-backdrop {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.9);
    backdrop-filter: blur(5px);
  }

  .lightbox-content {
    position: relative;
    max-width: 90vw;
    max-height: 90vh;
    z-index: 1001;
  }

  .lightbox-close {
    position: absolute;
    top: -60px;
    right: 0;
    width: 48px;
    height: 48px;
    background: rgba(0, 0, 0, 0.8);
    border: 2px solid rgba(255, 255, 255, 0.3);
    border-radius: 50%;
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    backdrop-filter: blur(10px);
    transition: var(--transition-smooth);
  }

  .lightbox-close:hover {
    background: rgba(255, 60, 43, 0.8);
    border-color: rgba(255, 60, 43, 0.5);
  }

  .lightbox-image-container {
    position: relative;
    background: var(--bg-glass);
    border: var(--border-glass);
    border-radius: 16px;
    overflow: hidden;
    backdrop-filter: blur(10px);
  }

  .lightbox-image, .lightbox-video {
    display: block;
    max-width: 100%;
    max-height: 80vh;
    object-fit: contain;
  }

  .lightbox-video {
    border-radius: 8px;
    background: #000;
    width: 100%;
    height: auto;
  }

  .lightbox-info {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.9) 0%,
      rgba(0, 0, 0, 0.7) 50%,
      transparent 100%
    );
    padding: 2rem 2rem 1rem;
    color: white;
  }

  .lightbox-artist-name {
    font-size: 1.2rem;
    font-weight: 600;
    margin: 0 0 0.5rem;
    color: var(--accent0);
  }

  .lightbox-caption {
    font-size: 1rem;
    margin: 0;
    opacity: 0.9;
  }

  .lightbox-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 60px;
    height: 60px;
    background: rgba(0, 0, 0, 0.8);
    border: 2px solid rgba(255, 255, 255, 0.3);
    border-radius: 50%;
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    backdrop-filter: blur(10px);
    transition: var(--transition-smooth);
    z-index: 1002;
  }

  .lightbox-nav:hover {
    background: rgba(255, 60, 43, 0.8);
    border-color: rgba(255, 60, 43, 0.5);
  }

  .lightbox-prev {
    left: -100px;
  }

  .lightbox-next {
    right: -100px;
  }

  /* Responsive Design */
  @media (max-width: 768px) {
    .gallery-masonry {
      grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
      gap: 1rem;
    }

    .lightbox-close {
      top: -50px;
      right: 10px;
      width: 40px;
      height: 40px;
    }

    .lightbox-nav {
      width: 50px;
      height: 50px;
    }

    .lightbox-prev {
      left: -60px;
    }

    .lightbox-next {
      right: -60px;
    }

    .lightbox-info {
      padding: 1.5rem 1rem 0.75rem;
    }
  }

  @media (max-width: 480px) {
    .gallery-masonry {
      grid-template-columns: 1fr;
    }

    .lightbox-close {
      top: 10px;
      right: 10px;
    }

    .lightbox-nav {
      display: none; /* Hide navigation on very small screens */
    }
  }

  /* Accessibility */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* Focus states */
  .gallery-zoom-btn:focus,
  .lightbox-close:focus,
  .lightbox-nav:focus {
    outline: 2px solid var(--accent0);
    outline-offset: 2px;
  }
</style>

<script>
  class ArtistPortfolioGallery {
    private lightbox: HTMLElement;
    private lightboxImage: HTMLImageElement;
    private lightboxVideo: HTMLVideoElement;
    private lightboxArtist: HTMLElement;
    private lightboxCaption: HTMLElement;
    private currentImages: string[] = [];
    private currentArtist: string = '';
    private currentIndex: number = 0;

    constructor() {
      this.lightbox = document.getElementById('portfolio-lightbox')!;
      this.lightboxImage = document.getElementById('lightbox-image') as HTMLImageElement;
      this.lightboxVideo = document.getElementById('lightbox-video') as HTMLVideoElement;
      this.lightboxArtist = document.getElementById('lightbox-artist')!;
      this.lightboxCaption = document.getElementById('lightbox-caption')!;

      this.init();
    }

    private init() {
      // Initialize lightbox functionality
      this.setupGalleryButtons();
      this.setupLightboxControls();
      this.setupKeyboardNavigation();
    }

    private setupGalleryButtons() {
      document.querySelectorAll('.gallery-zoom-btn').forEach(button => {
        button.addEventListener('click', (e) => {
          e.preventDefault();
          const imageSrc = button.getAttribute('data-image');
          const artistName = button.getAttribute('data-artist');
          if (imageSrc && artistName) {
            this.openLightbox(imageSrc, artistName);
          }
        });
      });
    }

    private setupLightboxControls() {
      // Close lightbox
      document.querySelectorAll('[data-close-lightbox]').forEach(element => {
        element.addEventListener('click', () => this.closeLightbox());
      });

      // Navigation
      const prevBtn = document.querySelector('.lightbox-prev');
      const nextBtn = document.querySelector('.lightbox-next');

      if (prevBtn) {
        prevBtn.addEventListener('click', () => this.navigate(-1));
      }

      if (nextBtn) {
        nextBtn.addEventListener('click', () => this.navigate(1));
      }
    }

    private setupKeyboardNavigation() {
      document.addEventListener('keydown', (e) => {
        if (this.lightbox.getAttribute('aria-hidden') === 'false') {
          switch (e.key) {
            case 'Escape':
              this.closeLightbox();
              break;
            case 'ArrowLeft':
              this.navigate(-1);
              break;
            case 'ArrowRight':
              this.navigate(1);
              break;
          }
        }
      });
    }

    private openLightbox(imageSrc: string, artistName: string) {
      // Find all images from the same gallery
      const galleryItem = document.querySelector(`[data-image="${imageSrc}"]`)?.closest('.gallery-item');
      if (!galleryItem) return;

      const galleryContainer = galleryItem.closest('.artist-portfolio-gallery');
      if (!galleryContainer) return;

      this.currentImages = Array.from(galleryContainer.querySelectorAll('.gallery-image, .gallery-video'))
        .map(media => media.getAttribute('src')!)
        .filter(src => src);

      this.currentArtist = artistName;
      this.currentIndex = this.currentImages.indexOf(imageSrc);

      this.updateLightbox();
      this.lightbox.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    private closeLightbox() {
      // Pause any playing video
      if (!this.lightboxVideo.paused) {
        this.lightboxVideo.pause();
      }
      this.lightbox.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    private navigate(direction: number) {
      if (this.currentImages.length === 0) return;

      this.currentIndex = (this.currentIndex + direction + this.currentImages.length) % this.currentImages.length;
      this.updateLightbox();
    }

    private updateLightbox() {
      if (this.currentImages.length === 0) return;

      const mediaSrc = this.currentImages[this.currentIndex];
      const isVideo = mediaSrc.endsWith('.mp4') || mediaSrc.endsWith('.mov') || mediaSrc.endsWith('.webm');
      
      if (isVideo) {
        this.lightboxImage.style.display = 'none';
        this.lightboxVideo.style.display = 'block';
        this.lightboxVideo.src = mediaSrc;
        this.lightboxVideo.load(); // Reload the video
        // Auto-play the video when it's ready
        this.lightboxVideo.addEventListener('loadeddata', () => {
          this.lightboxVideo.play().catch(e => {
            console.log('Video autoplay prevented:', e);
          });
        }, { once: true });
      } else {
        this.lightboxVideo.style.display = 'none';
        this.lightboxImage.style.display = 'block';
        this.lightboxImage.src = mediaSrc;
        this.lightboxImage.alt = `${this.currentArtist} portfolio piece ${this.currentIndex + 1}`;
      }
      
      this.lightboxArtist.textContent = this.currentArtist;
      this.lightboxCaption.textContent = `Portfolio Piece ${this.currentIndex + 1} of ${this.currentImages.length}`;
    }
  }

  // Initialize when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => new ArtistPortfolioGallery());
  } else {
    new ArtistPortfolioGallery();
  }
</script>
