---
/**
 * Production-Optimized Gallery Component
 * - Lazy loading images via intersection observer
 * - No expensive morphing animations initially
 * - Content-visibility optimization
 * - Progressive enhancement
 */
import { slugify } from '../lib/slugify';
import cisData from '../data/cis.json';

const galleryItems = cisData.artists.map((artist, index) => ({
  id: index + 1,
  image: artist.avatar,
  title: artist.name,
  artist: artist.name,
  slug: artist.slug,
  positioning: artist.positioning,
  specialties: artist.specialties,
  category: artist.specialties[0] || "Traditional"
}));
---

<section class="gallery-prod lazy-section">
  <div class="container">
    <div class="gallery-header">
      <h2 class="gallery-title shine">Meet Our Master Artists</h2>
      <p class="gallery-subtitle">Discover the talented artists behind our extraordinary work</p>
      
      <!-- Artist Counter -->
      <div class="artist-counter">
        <div class="counter-content">
          <span class="counter-number" data-count="6">0</span>
          <span class="counter-label">Master Artists</span>
        </div>
      </div>
    </div>
    
    <div class="gallery-grid">
      {galleryItems.map((item, index) => (
        <div 
          class="gallery-item" 
          data-category={item.category.toLowerCase()}
          data-artist={item.slug}
          style={`--delay: ${index * 0.05}s`}
        >
          <div class="item-shape">
            <img 
              src={item.image} 
              alt={`${item.title} - Tattoo Artist`}
              loading="lazy"
              decoding="async"
              class="item-image"
            />
            <div class="item-overlay">
              <div class="item-info">
                <h3 class="item-title">{item.title}</h3>
                <p class="item-artist">{item.positioning.split(' - ')[0]}</p>
                <div class="item-specialties">
                  {item.specialties.slice(0, 2).map(specialty => (
                    <span class="specialty-tag">{specialty}</span>
                  ))}
                </div>
              </div>
              <div class="item-actions">
                <a href={`/artists/${slugify(item.slug ?? item.title)}`} class="btn btn--ghost">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/>
                  </svg>
                  View Portfolio
                </a>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
    
    <div class="gallery-cta">
      <a href="/artists" class="btn btn--primary">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
          <path d="M16 4c0-1.11.89-2 2-2s2 .89 2 2-.89 2-2 2-2-.89-2-2zm4 18v-6h2.5l-2.54-7.63A1.5 1.5 0 0 0 18.5 7.5h-1c-.83 0-1.5.67-1.5 1.5s.67 1.5 1.5 1.5H18l1.8 5.4H16V21h4z"/>
        </svg>
        Meet All Our Artists
      </a>
    </div>
  </div>
</section>

<style>
  /* PRODUCTION GALLERY - Optimized */
  .gallery-prod {
    padding: 6rem 0;
    position: relative;
    overflow: hidden;
    background: linear-gradient(135deg, #0b0b0d 0%, #1a1a1f 50%, #0b0b0d 100%);
  }

  .gallery-header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .gallery-title {
    font-size: clamp(2.5rem, 5vw, 4rem);
    margin-bottom: 1rem;
    position: relative;
  }

  .gallery-title::before {
    content: '';
    position: absolute;
    top: -20px;
    left: 50%;
    transform: translateX(-50%);
    width: 100px;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--accent0), transparent);
    opacity: 0.7;
  }

  .gallery-subtitle {
    font-size: 1.2rem;
    opacity: 0.8;
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.6;
  }

  /* Counter */
  .artist-counter {
    display: flex;
    justify-content: center;
    margin: 2rem 0 0;
  }

  .counter-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    background: rgba(0, 0, 0, 0.3);
    border: 2px solid rgba(255, 60, 43, 0.3);
    border-radius: 20px;
    padding: 1.5rem 2.5rem;
  }

  .counter-number {
    font-size: 3rem;
    font-weight: 900;
    color: var(--accent0);
    text-shadow: 0 0 20px rgba(255, 60, 43, 0.6);
    line-height: 1;
    margin-bottom: 0.5rem;
  }

  .counter-label {
    font-size: 0.9rem;
    color: rgba(245, 245, 245, 0.8);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 600;
  }

  /* Grid - Simplified */
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  /* Gallery Item - NO morphing animation initially */
  .gallery-item {
    position: relative;
    aspect-ratio: 1;
    opacity: 0;
    transition: opacity 0.3s ease, transform 0.2s ease;
    cursor: pointer;
    touch-action: manipulation;
  }

  .gallery-item.visible {
    opacity: 1;
  }

  .gallery-item:hover {
    z-index: 10;
    transform: scale(1.02);
  }

  /* Item Shape - Static initially (no expensive morphing) */
  .item-shape {
    width: 100%;
    height: 100%;
    border-radius: 45% 55% 35% 65% / 55% 35% 65% 45%;
    overflow: hidden;
    position: relative;
    transition: all 0.3s ease;
    background: rgba(255, 255, 255, 0.1);
    border: 3px solid rgba(255, 255, 255, 0.4);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
  }

  .gallery-item:hover .item-shape {
    border-color: rgba(255, 255, 255, 0.8);
    box-shadow: 0 0 40px rgba(255, 255, 255, 0.4);
    transform: scale(1.03);
  }

  /* Image */
  .item-image {
    width: 120%;
    height: 120%;
    object-fit: cover;
    position: absolute;
    top: -10%;
    left: -10%;
    transition: transform 0.3s ease;
    mask: radial-gradient(ellipse 50% 60% at 50% 50%, black 70%, transparent 100%);
  }

  .gallery-item:hover .item-image {
    transform: scale(1.05);
  }

  /* Overlay */
  .item-overlay {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, transparent 30%, rgba(0, 0, 0, 0.8) 70%);
    opacity: 0;
    transition: opacity 0.3s ease;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border-radius: inherit;
    padding: 1.5rem;
  }

  .gallery-item:hover .item-overlay {
    opacity: 1;
  }

  /* Item Info */
  .item-info {
    margin-bottom: 1.5rem;
    text-align: center;
    width: 100%;
  }

  .item-title {
    font-size: clamp(1.1rem, 4vw, 1.4rem);
    font-weight: 700;
    margin-bottom: 0.5rem;
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.8);
    color: #ffffff;
    line-height: 1.2;
  }

  .item-artist {
    font-size: clamp(0.9rem, 3.5vw, 1.1rem);
    opacity: 1;
    margin-bottom: 1rem;
    color: var(--accent0);
    font-weight: 600;
    text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.9);
  }

  .item-specialties {
    display: flex;
    gap: 0.4rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }

  .specialty-tag {
    display: inline-block;
    background: rgba(0, 0, 0, 0.7);
    color: var(--accent0);
    padding: 0.3rem 0.8rem;
    border-radius: 15px;
    font-size: clamp(0.65rem, 2.5vw, 0.8rem);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border: 1px solid rgba(255, 60, 43, 0.5);
    transition: all 0.3s ease;
  }

  /* Item Actions */
  .item-actions {
    display: flex;
    justify-content: center;
    width: 100%;
  }

  /* CTA */
  .gallery-cta {
    text-align: center;
    margin-top: 4rem;
  }

  /* Mobile */
  @media (max-width: 768px) {
    .gallery-prod {
      padding: 3rem 0;
    }

    .gallery-grid {
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 1rem;
      padding: 0 1rem;
    }

    .gallery-header {
      margin-bottom: 2.5rem;
    }

    .item-overlay {
      padding: 1rem;
    }

    .gallery-item:hover {
      transform: scale(1.01);
    }
  }

  @media (max-width: 480px) {
    .gallery-grid {
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 0.8rem;
    }
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .gallery-item {
      animation: none;
      opacity: 1;
    }

    .gallery-item:hover {
      transform: scale(1.01);
    }

    .gallery-item:hover .item-image {
      transform: scale(1.02);
    }
  }
</style>

<script>
  // Optimized gallery with progressive enhancement
  class ProductionGallery {
    private observer: IntersectionObserver | null = null;
    
    constructor() {
      this.init();
    }

    private init(): void {
      // Intersection observer for fade-in
      this.setupIntersectionObserver();
      
      // Counter animation
      this.animateCounter();
      
      // Touch handling for mobile
      this.setupTouchHandling();
    }

    private setupIntersectionObserver(): void {
      const options = {
        threshold: 0.1,
        rootMargin: '50px 0px'
      };

      this.observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            (entry.target as HTMLElement).classList.add('visible');
            this.observer?.unobserve(entry.target);
          }
        });
      }, options);

      document.querySelectorAll('.gallery-item').forEach(item => {
        this.observer?.observe(item);
      });
    }

    private setupTouchHandling(): void {
      document.querySelectorAll('.gallery-item').forEach(item => {
        let touchStartY = 0;
        let touchStartX = 0;
        let touchMoved = false;
        const scrollThreshold = 10;

        item.addEventListener('touchstart', (e) => {
          const touch = (e as TouchEvent).touches[0];
          touchStartY = touch.clientY;
          touchStartX = touch.clientX;
          touchMoved = false;
        }, { passive: true });

        item.addEventListener('touchmove', (e) => {
          const touch = (e as TouchEvent).touches[0];
          const deltaY = Math.abs(touch.clientY - touchStartY);
          const deltaX = Math.abs(touch.clientX - touchStartX);
          
          if (deltaY > scrollThreshold || deltaX > scrollThreshold) {
            touchMoved = true;
          }
        }, { passive: true });

        item.addEventListener('touchend', (e) => {
          const target = e.target as HTMLElement;
          const isButton = target.closest('.btn--ghost');
          
          if (!touchMoved && !isButton) {
            const link = item.querySelector('.btn--ghost') as HTMLAnchorElement;
            if (link) {
              setTimeout(() => {
                window.location.href = link.href;
              }, 100);
            }
          }
        }, { passive: true });
      });
    }

    private animateCounter(): void {
      const counter = document.querySelector('.counter-number') as HTMLElement;
      if (!counter) return;

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            this.countUp(counter);
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.5 });

      observer.observe(counter);
    }

    private countUp(element: HTMLElement): void {
      const target = parseInt(element.getAttribute('data-count') || '6');
      let current = 0;
      const increment = target / 30;
      
      const timer = setInterval(() => {
        current += increment;
        if (current >= target) {
          element.textContent = target.toString();
          clearInterval(timer);
        } else {
          element.textContent = Math.floor(current).toString();
        }
      }, 30);
    }
  }

  // Initialize
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => new ProductionGallery());
  } else {
    new ProductionGallery();
  }
</script>

