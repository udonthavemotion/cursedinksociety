    .osrs-chatbox-container {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      padding: 0 1rem;
    }

    .osrs-chatbox-sidebar {
      order: -1;
      gap: 1rem;
    }

    .osrs-online-players {
