    border: 2px solid rgba(212, 175, 55, 0.5);
    box-shadow: 0 0 8px rgba(212, 175, 55, 0.3);
  }

  .osrs-skill-info {
    flex: 1;
  }

  .osrs-skill-name {
    font-size: 1.1rem;
    font-weight: 700;
    color: #f5f5f5;
    margin-bottom: 0.25rem;
    text-shadow: 1px 1px 0 rgba(212, 175, 55, 0.3);
  }

  .osrs-skill-desc {
    font-size: 0.85rem;
    color: rgba(245, 245, 245, 0.7);
    line-height: 1.4;
  }

  .osrs-skill-bar {
    height: 12px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 6px;
    border: 1px solid rgba(255, 255, 255, 0.15);
    overflow: hidden;
    position: relative;
    box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.3);
  }

  .osrs-skill-fill {
    height: 100%;
    background: linear-gradient(90deg, #d4af37, #b9931f);
    border-radius: 5px;
    transition: width 1s ease;
    position: relative;
    overflow: hidden;
  }

  .osrs-skill-fill::after {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.4), transparent);
    animation: skillShine 3s ease-in-out infinite;
