--- 
import Layout from '../layouts/Layout.astro';

const title = "Consultations — Cursed Ink Society";
const description = "We don't book consultations online. Message your preferred artist directly or visit us during business hours.";
---

<Layout title={title} description={description}>
  <section class="max-w-3xl mx-auto py-16 text-center">
    <h1 class="text-3xl font-semibold mb-4">Consultations</h1>
    <p class="opacity-80">We don't book consultations online. Message your preferred artist directly or visit us during business hours.</p>
    <a href="/artists" class="inline-block mt-6 px-4 py-2 rounded-md bg-red-600/80 hover:bg-red-600 transition">Meet Our Artists</a>
  </section>
</Layout>