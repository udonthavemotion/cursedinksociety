    height: 1px;
    background: linear-gradient(90deg, transparent, #c9a96e, transparent);
    animation: slideGlow 3s ease-in-out infinite;
  }

  @keyframes slideGlow {
    0%, 100% { transform: translateX(-100%); }
    50% { transform: translateX(100%); }
  }

  .cta-content {
    text-align: center;
    max-width: 700px;
    margin: 0 auto;
    position: relative;
