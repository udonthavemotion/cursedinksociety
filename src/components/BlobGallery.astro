---
// Artist gallery data with actual profile pictures
import cisData from '../data/cis.json';

const galleryItems = cisData.artists.map((artist, index) => ({
  id: index + 1,
  image: artist.avatar,
  title: artist.name,
  artist: artist.name,
  slug: artist.slug,
  positioning: artist.positioning,
  specialties: artist.specialties,
  category: artist.specialties[0] || "Traditional"
}));
---

<section class="blob-gallery">
  <div class="container">
    <div class="gallery-header">
      <h2 class="gallery-title shine">Meet Our Master Artists</h2>
      <p class="gallery-subtitle">Discover the talented artists behind our extraordinary work</p>
      
      <!-- Artist Counter with Animation -->
      <div class="artist-counter">
        <div class="counter-content">
          <span class="counter-number" data-count="6">0</span>
          <span class="counter-label">Master Artists</span>
        </div>
        <div class="counter-glow"></div>
      </div>
    </div>
    
    <div class="blob-grid">
      {galleryItems.map((item, index) => (
        <div 
          class="blob-item" 
          data-category={item.category.toLowerCase()}
          style={`--delay: ${index * 0.1}s`}
        >
          <div class="blob-shape">
            <div class="blob-inner">
              <img 
                src={item.image} 
                alt={`${item.title} - Tattoo Artist`}
                loading="lazy"
                decoding="async"
              />
              <div class="blob-overlay">
                <div class="spotlight-reveal">
                  <div class="item-info">
                    <h3 class="item-title">{item.title}</h3>
                    <p class="item-artist">{item.positioning.split(' - ')[0]}</p>
                    <div class="item-specialties">
                      {item.specialties.slice(0, 2).map(specialty => (
                        <span class="specialty-tag">{specialty}</span>
                      ))}
                    </div>
                  </div>
                  <div class="item-actions">
                    <a href={`/artists/${item.slug}`} class="btn btn--ghost">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/>
                      </svg>
                      View Portfolio
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
    
    <div class="gallery-cta">
      <a href="/artists" class="btn btn--primary">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
          <path d="M16 4c0-1.11.89-2 2-2s2 .89 2 2-.89 2-2 2-2-.89-2-2zm4 18v-6h2.5l-2.54-7.63A1.5 1.5 0 0 0 18.5 7.5h-1c-.83 0-1.5.67-1.5 1.5s.67 1.5 1.5 1.5H18l1.8 5.4H16V21h4zM12.5 11.5c.83 0 1.5-.67 1.5-1.5s-.67-1.5-1.5-1.5S11 9.17 11 10s.67 1.5 1.5 1.5zM5.5 6c1.11 0 2-.89 2-2s-.89-2-2-2-2 .89-2 2 .89 2 2 2zm2 16v-7H9V9.5C9 8.67 8.33 8 7.5 8S6 8.67 6 9.5V15H4v7h3.5z"/>
        </svg>
        Meet All Our Artists
      </a>
    </div>
  </div>
</section>

<style>
  .blob-gallery {
    padding: 6rem 0;
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(ellipse at 20% 30%, rgba(255, 60, 43, 0.15) 0%, transparent 50%),
      radial-gradient(ellipse at 80% 70%, rgba(255, 122, 24, 0.1) 0%, transparent 50%),
      linear-gradient(135deg, #0b0b0d 0%, #1a1a1f 50%, #0b0b0d 100%);
  }

  .gallery-header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .gallery-title {
    font-size: clamp(2.5rem, 5vw, 4rem);
    margin-bottom: 1rem;
    position: relative;
  }

  .gallery-title::before {
    content: '';
    position: absolute;
    top: -20px;
    left: 50%;
    transform: translateX(-50%);
    width: 100px;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--accent0), transparent);
    opacity: 0.7;
  }

  .gallery-title::after {
    content: '✦';
    position: absolute;
    top: -30px;
    left: 50%;
    transform: translateX(-50%);
    color: var(--accent0);
    font-size: 1rem;
    animation: titleSparkle 3s ease-in-out infinite;
  }

  @keyframes titleSparkle {
    0%, 100% { opacity: 0.7; transform: translateX(-50%) scale(1); }
    50% { opacity: 1; transform: translateX(-50%) scale(1.2); }
  }

  .gallery-subtitle {
    font-size: 1.2rem;
    opacity: 0.8;
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.6;
    text-shadow: var(--glow-warm);
  }

  /* Organic Blob Grid */
  .blob-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  /* Blob Item Container */
  .blob-item {
    position: relative;
    aspect-ratio: 1;
    animation: blobFadeIn 0.8s ease-out forwards;
    animation-delay: var(--delay);
    opacity: 0;
    cursor: pointer;
  }

  /* Magnetic hover effect */
  .blob-item {
    transition: transform 0.3s cubic-bezier(0.23, 1, 0.320, 1);
  }

  .blob-item:hover {
    z-index: 10;
  }

  @keyframes blobFadeIn {
    from {
      opacity: 0;
      transform: translateY(30px) scale(0.9);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  /* Organic Blob Shape - White Theme */
  .blob-shape {
    width: 100%;
    height: 100%;
    border-radius: 60% 40% 30% 70% / 60% 30% 70% 40%;
    overflow: hidden;
    position: relative;
    transition: var(--transition-material);
    background: 
      linear-gradient(135deg, rgba(255, 255, 255, 0.9) 0%, rgba(255, 255, 255, 0.7) 100%),
      rgba(255, 255, 255, 0.1);
    border: 3px solid rgba(255, 255, 255, 0.4);
    animation: blobMorph 10s ease-in-out infinite;
    box-shadow: 
      0 8px 32px rgba(0, 0, 0, 0.1),
      inset 0 1px 0 rgba(255, 255, 255, 0.6);
    backdrop-filter: blur(10px);
  }

  @keyframes blobMorph {
    0%, 100% {
      border-radius: 60% 40% 30% 70% / 60% 30% 70% 40%;
    }
    25% {
      border-radius: 30% 60% 70% 40% / 50% 60% 30% 60%;
    }
    50% {
      border-radius: 50% 60% 30% 60% / 60% 30% 60% 40%;
    }
    75% {
      border-radius: 60% 40% 60% 30% / 30% 60% 40% 70%;
    }
  }

  @keyframes blobHoverMorph {
    0% {
      border-radius: 60% 40% 30% 70% / 60% 30% 70% 40%;
    }
    33% {
      border-radius: 45% 55% 35% 65% / 55% 35% 65% 45%;
    }
    66% {
      border-radius: 55% 45% 40% 60% / 50% 40% 60% 50%;
    }
    100% {
      border-radius: 50% 50% 45% 55% / 55% 45% 55% 45%;
    }
  }

  @keyframes blobPulse {
    0%, 100% {
      box-shadow: 
        0 0 40px rgba(255, 255, 255, 0.6),
        0 0 80px rgba(255, 255, 255, 0.4),
        0 12px 48px rgba(0, 0, 0, 0.2),
        inset 0 1px 0 rgba(255, 255, 255, 0.8);
    }
    50% {
      box-shadow: 
        0 0 60px rgba(255, 60, 43, 0.4),
        0 0 120px rgba(255, 122, 24, 0.3),
        0 12px 48px rgba(0, 0, 0, 0.2),
        inset 0 1px 0 rgba(255, 255, 255, 0.8);
    }
  }

  .blob-item:hover .blob-shape {
    border-color: rgba(255, 255, 255, 0.8);
    box-shadow: 
      0 0 40px rgba(255, 255, 255, 0.6),
      0 0 80px rgba(255, 255, 255, 0.4),
      0 12px 48px rgba(0, 0, 0, 0.2),
      inset 0 1px 0 rgba(255, 255, 255, 0.8);
    transform: scale(1.05);
    background: 
      linear-gradient(135deg, rgba(255, 255, 255, 1) 0%, rgba(255, 255, 255, 0.9) 100%),
      rgba(255, 255, 255, 0.2);
    /* Remove fixed border-radius - let the animation handle the morphing */
    animation: blobHoverMorph 0.6s ease-out forwards, blobPulse 2s ease-in-out infinite;
  }

  /* Inner Content */
  .blob-inner {
    width: 100%;
    height: 100%;
    position: relative;
    overflow: hidden;
  }

  .blob-inner img {
    width: 120%;
    height: 120%;
    object-fit: cover;
    position: absolute;
    top: -10%;
    left: -10%;
    transition: var(--transition-smooth);
    transform-origin: center;
    /* Ensure image follows blob distortion */
    border-radius: inherit;
  }

  .blob-item:hover .blob-inner img {
    transform: scale(1.08);
  }

  /* Spotlight Overlay */
  .blob-overlay {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, transparent 30%, rgba(0, 0, 0, 0.8) 70%);
    opacity: 0;
    transition: var(--transition-glow);
    display: flex;
    align-items: center;
    justify-content: center;
    
    /* Ensure overlay follows exact blob shape dynamically */
    border-radius: inherit;
    overflow: hidden;
  }

  .blob-item:hover .blob-overlay {
    opacity: 1;
  }

  /* Spotlight Reveal Effect */
  .spotlight-reveal {
    text-align: center;
    transform: translateY(20px);
    transition: var(--transition-glow);
    padding: 1rem;
  }

  .blob-item:hover .spotlight-reveal {
    transform: translateY(0);
  }

  .item-info {
    margin-bottom: 1.5rem;
  }

  .item-title {
    font-size: 1.3rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
    text-shadow: var(--glow-inferno-subtle);
  }

  .item-artist {
    font-size: 1rem;
    opacity: 0.9;
    margin-bottom: 1rem;
    color: var(--accent0);
    font-weight: 500;
  }

  .item-specialties {
    display: flex;
    gap: 0.5rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }

  .specialty-tag {
    display: inline-block;
    background: rgba(255, 60, 43, 0.2);
    color: var(--accent0);
    padding: 0.25rem 0.6rem;
    border-radius: 12px;
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border: 1px solid rgba(255, 60, 43, 0.3);
  }

  /* Action Buttons */
  .item-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
  }

  .btn--ghost {
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: var(--ink);
    padding: 0.6rem 1rem;
    font-size: 0.9rem;
    backdrop-filter: blur(10px);
  }

  .btn--ghost:hover {
    background: rgba(255, 51, 0, 0.2);
    border-color: var(--inferno-start);
    color: var(--inferno-start);
    box-shadow: var(--glow-inferno-subtle);
  }

  /* Gallery CTA */
  .gallery-cta {
    text-align: center;
    margin-top: 4rem;
  }

  /* Consistent white theme for all categories */
  .blob-item .blob-shape {
    border-color: rgba(255, 255, 255, 0.4);
  }

  .blob-item:hover .blob-shape {
    border-color: rgba(255, 255, 255, 0.8);
  }

  /* Responsive Design */
  @media (max-width: 768px) {
    .blob-gallery {
      padding: 4rem 0;
    }

    .blob-grid {
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 1.5rem;
    }

    .gallery-header {
      margin-bottom: 3rem;
    }

    .item-actions {
      flex-direction: column;
      gap: 0.8rem;
    }

    .btn--ghost {
      width: 100%;
      max-width: 160px;
    }
  }

  /* Reduced Motion */
  /* Artist Counter Styles */
  .artist-counter {
    display: flex;
    justify-content: center;
    margin: 2rem 0 0;
    position: relative;
  }

  .counter-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    background: rgba(0, 0, 0, 0.3);
    border: 2px solid rgba(255, 60, 43, 0.3);
    border-radius: 20px;
    padding: 1.5rem 2.5rem;
    backdrop-filter: blur(15px);
    position: relative;
    overflow: hidden;
  }

  .counter-number {
    font-size: 3rem;
    font-weight: 900;
    color: var(--accent0);
    text-shadow: 
      0 0 20px rgba(255, 60, 43, 0.8),
      0 0 40px rgba(255, 60, 43, 0.4);
    line-height: 1;
    margin-bottom: 0.5rem;
  }

  .counter-label {
    font-size: 0.9rem;
    color: rgba(245, 245, 245, 0.8);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 600;
  }

  .counter-glow {
    position: absolute;
    top: -2px;
    left: -2px;
    right: -2px;
    bottom: -2px;
    background: linear-gradient(45deg, var(--accent0), var(--accent1), var(--accent0));
    border-radius: 20px;
    opacity: 0;
    transition: opacity 0.3s ease;
    animation: counterRotate 4s linear infinite;
    z-index: -1;
  }

  .counter-content:hover .counter-glow {
    opacity: 0.3;
  }

  @keyframes counterRotate {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  /* Parallax blob movement */
  .blob-item {
    transform-style: preserve-3d;
  }

  .blob-item:hover {
    animation-play-state: paused;
  }

  .blob-item:hover .blob-shape {
    animation: blobHoverMorph 0.6s ease-out forwards, blobParallax 1s ease-out forwards;
  }

  @keyframes blobParallax {
    0% { transform: scale(1.05) translateZ(0); }
    50% { transform: scale(1.08) translateZ(20px) rotateX(5deg); }
    100% { transform: scale(1.05) translateZ(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .blob-shape,
    .counter-glow,
    .gallery-title::after {
      animation: none !important;
    }
    
    .blob-item {
      animation: none;
      opacity: 1;
    }
    
    .blob-item:hover .blob-shape {
      transform: scale(1.02);
      animation: none;
    }
    
    .blob-item:hover .blob-inner img {
      transform: scale(1.05);
    }
  }
</style>

<script>
  // Enhanced gallery interactions
  class BlobGallery {
    constructor() {
      this.init();
    }

    init() {
      this.setupIntersectionObserver();
      this.setupActionHandlers();
    }

    setupIntersectionObserver() {
      const options = {
        threshold: 0.2,
        rootMargin: '0px 0px -50px 0px'
      };

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            (entry.target as HTMLElement).style.animationPlayState = 'running';
          }
        });
      }, options);

      document.querySelectorAll('.blob-item').forEach(item => {
        observer.observe(item);
      });
    }

    setupActionHandlers() {
      // Enhanced hover effects for blob items
      document.querySelectorAll('.blob-item').forEach(item => {
        item.addEventListener('mouseenter', () => {
          this.addHoverGlow(item as HTMLElement);
        });
        
        item.addEventListener('mouseleave', () => {
          this.removeHoverGlow(item as HTMLElement);
        });
      });

      // Animate counter when in view
      this.animateCounter();
    }

    animateCounter() {
      const counter = document.querySelector('.counter-number') as HTMLElement;
      if (!counter) return;

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            this.countUp(counter);
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.5 });

      observer.observe(counter);
    }

    countUp(element: HTMLElement) {
      const target = parseInt(element.getAttribute('data-count') || '6');
      let current = 0;
      const increment = target / 60; // 60 frames for smooth animation
      
      const timer = setInterval(() => {
        current += increment;
        if (current >= target) {
          element.textContent = target.toString();
          clearInterval(timer);
        } else {
          element.textContent = Math.floor(current).toString();
        }
      }, 16); // ~60fps
    }

    addHoverGlow(item: HTMLElement) {
      const blob = item.querySelector('.blob-shape') as HTMLElement;
      if (blob) {
        blob.style.filter = 'brightness(1.1) drop-shadow(0 0 20px rgba(255, 255, 255, 0.8))';
      }
    }

    removeHoverGlow(item: HTMLElement) {
      const blob = item.querySelector('.blob-shape') as HTMLElement;
      if (blob) {
        blob.style.filter = '';
      }
    }
  }

  // Initialize when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => new BlobGallery());
  } else {
    new BlobGallery();
  }
</script>
