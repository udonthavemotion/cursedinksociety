---
/**
 * Pricing Section - Harley Halford Verified Pricing
 * Strict pricing data from verified photo - no modifications
 */
---

<section id="pricing" class="pricing-section" aria-labelledby="pricing-heading">
  <div class="pricing-container">
    <!-- Header -->
    <h2 id="pricing-heading" class="pricing-title">Pricing Guide</h2>
    <p class="pricing-disclaimer">All prices include wound-wash saline aftercare and titanium jewelry</p>
    
    <!-- Pricing Grid -->
    <div class="pricing-grid">
      
      <!-- EAR PIERCINGS -->
      <div class="pricing-category">
        <h3 class="category-heading">Ear Piercings</h3>
        <div class="price-list">
          <div class="price-item">
            <span class="price-name">Single Lobe</span>
            <span class="price-value">$50</span>
          </div>
          <div class="price-item">
            <span class="price-name">Double Lobe</span>
            <span class="price-value">$70</span>
          </div>
          <div class="price-item">
            <span class="price-name">Cartilage (helix, daith, etc.)</span>
            <span class="price-value">$60</span>
          </div>
          <div class="price-item">
            <span class="price-name">Industrial</span>
            <span class="price-value">$60</span>
          </div>
        </div>
      </div>
      
      <!-- NOSE PIERCINGS -->
      <div class="pricing-category">
        <h3 class="category-heading">Nose Piercings</h3>
        <div class="price-list">
          <div class="price-item">
            <span class="price-name">Septum</span>
            <span class="price-value">$50</span>
          </div>
          <div class="price-item">
            <span class="price-name">Nostril</span>
            <span class="price-value">$50</span>
          </div>
        </div>
      </div>
      
      <!-- MOUTH PIERCINGS -->
      <div class="pricing-category">
        <h3 class="category-heading">Mouth Piercings</h3>
        <div class="price-list">
          <div class="price-item">
            <span class="price-name">Single Labret (Medusa, Monroe, Vertical etc.)</span>
            <span class="price-value">$60</span>
          </div>
          <div class="price-item">
            <span class="price-name">Double Labret (Snake/Spider Bites etc.)</span>
            <span class="price-value">$100</span>
          </div>
          <div class="price-item">
            <span class="price-name">Tongue</span>
            <span class="price-value">$60</span>
          </div>
          <div class="price-item">
            <span class="price-name">Smiley</span>
            <span class="price-value">$60</span>
          </div>
          <div class="price-item">
            <span class="price-name">Canine Bites</span>
            <span class="price-value">$140</span>
          </div>
        </div>
      </div>
      
      <!-- BODY PIERCINGS -->
      <div class="pricing-category">
        <h3 class="category-heading">Body Piercings</h3>
        <div class="price-list">
          <div class="price-item">
            <span class="price-name">Navel</span>
            <span class="price-value">$50</span>
          </div>
          <div class="price-item">
            <span class="price-name">Eyebrow</span>
            <span class="price-value">$50</span>
          </div>
          <div class="price-item">
            <span class="price-name">Surface</span>
            <span class="price-value">$100</span>
          </div>
          <div class="price-item">
            <span class="price-name">Single Nipple</span>
            <span class="price-value">$50</span>
          </div>
          <div class="price-item">
            <span class="price-name">Double Nipple</span>
            <span class="price-value">$100</span>
          </div>
          <div class="price-item">
            <span class="price-name">Genitals</span>
            <span class="price-value">$100</span>
          </div>
        </div>
      </div>
      
      <!-- JEWELRY PRICES / SERVICES -->
      <div class="pricing-category">
        <h3 class="category-heading">Jewelry Prices / Services</h3>
        <div class="price-list">
          <div class="price-item">
            <span class="price-name">Single Top / Bottom</span>
            <span class="price-value">$5</span>
          </div>
          <div class="price-item">
            <span class="price-name">Single Piece (20g, 18g or 16g)</span>
            <span class="price-value">$10</span>
          </div>
          <div class="price-item">
            <span class="price-name">Single Navel / Industrial (14g)</span>
            <span class="price-value">$15</span>
          </div>
          <div class="price-item">
            <span class="price-name">Double / Pair (20g, 18g or 16g)</span>
            <span class="price-value">$20</span>
          </div>
          <div class="price-item">
            <span class="price-name">Aftercare Replacement</span>
            <span class="price-value">$10</span>
          </div>
          <div class="price-item">
            <span class="price-name">Jewelry Change with purchase of jewelry</span>
            <span class="price-value">Included</span>
          </div>
          <div class="price-item">
            <span class="price-name">Jewelry Change with outside jewelry</span>
            <span class="price-value">$5</span>
          </div>
        </div>
      </div>
      
    </div>
    
    <!-- Footer Note -->
    <p class="pricing-footer">*Prices subject to change based on anatomy or jewelry upgrades.</p>
  </div>
</section>

<style>
  @import "../styles/tattoo-theme.css";


  .pricing-section {
    padding: clamp(6rem, 12vw, 8rem) 1.5rem;
    background: #0B0B0B;
    position: relative;
  }
  
  .pricing-container {
    max-width: 1200px;
    margin: 0 auto;
    position: relative;
  }
  
  /* Header */
  .pricing-title {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    margin: 0 0 1rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text);
    text-align: center;
  }
  
  .pricing-disclaimer {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #ffc800;
    text-align: center;
    margin: 0 0 3rem;
    font-weight: 600;
  }
  
  /* Pricing Grid */
  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2.5rem;
    margin-bottom: 2.5rem;
  }
  
  @media (max-width: 640px) {
    .pricing-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
  
  /* Category */
  .pricing-category {
    display: flex;
    flex-direction: column;
  }
  
  .category-heading {
    font-size: 0.875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text);
    margin: 0 0 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid rgba(155, 92, 246, 0.3);
  }
  
  /* Price List */
  .price-list {
    display: flex;
    flex-direction: column;
  }
  
  .price-item {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 0.6rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    gap: 1rem;
    transition: background 0.15s ease-out;
  }
  
  .price-item:hover {
    background: rgba(255, 255, 255, 0.02);
  }
  
  .price-item:last-child {
    border-bottom: none;
  }
  
  .price-name {
    font-size: 0.9375rem;
    color: var(--muted);
    line-height: 1.4;
    flex: 1;
  }
  
  .price-value {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--text);
    white-space: nowrap;
    text-align: right;
  }
  
  /* Footer Note */
  .pricing-footer {
    font-size: 0.875rem;
    color: var(--muted);
    text-align: center;
    margin: 0;
    font-style: italic;
  }
  
  /* Responsive */
  @media (max-width: 767px) {
    .pricing-section {
      padding: clamp(4rem, 8vw, 6rem) 1rem;
    }
    
    .pricing-disclaimer {
      font-size: 0.6875rem;
    }
    
    .price-item {
      padding: 0.5rem 0;
      flex-direction: row;
      align-items: baseline;
    }
    
    .price-name {
      font-size: 0.875rem;
    }
    
    .price-value {
      font-size: 0.875rem;
    }
  }
  
  /* Reduced Motion */
  @media (prefers-reduced-motion: reduce) {
    .price-item {
      transition: none;
    }
  }
</style>

