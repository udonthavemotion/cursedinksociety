---
// Optimized Three.js Loader - Non-blocking initialization
---

<script>
  // Optimized Three.js Loader that doesn't block scrolling
  class OptimizedThreeLoader {
    private static instance: OptimizedThreeLoader;
    private loadQueue: Array<() => Promise<void>> = [];
    private isProcessing = false;
    private loadedCanvases = new Set<string>();

    static getInstance(): OptimizedThreeLoader {
      if (!OptimizedThreeLoader.instance) {
        OptimizedThreeLoader.instance = new OptimizedThreeLoader();
      }
      return OptimizedThreeLoader.instance;
    }

    private constructor() {
      this.init();
    }

    private init(): void {
      // Start processing queue after initial page load
      this.startProcessing();
    }

    private async startProcessing(): Promise<void> {
      // Wait for critical resources to load first
      await this.waitForCriticalLoad();
      
      // Process queue with proper scheduling
      this.processQueue();
    }

    private waitForCriticalLoad(): Promise<void> {
      return new Promise((resolve) => {
        if (document.readyState === 'complete') {
          resolve();
        } else {
          window.addEventListener('load', () => resolve());
          // Fallback timeout
          setTimeout(resolve, 3000);
        }
      });
    }

    private async processQueue(): Promise<void> {
      if (this.isProcessing || this.loadQueue.length === 0) return;
      
      this.isProcessing = true;
      
      while (this.loadQueue.length > 0) {
        const loader = this.loadQueue.shift();
        if (loader) {
          try {
            // Use scheduler API if available
            if ('scheduler' in window && 'postTask' in (window as any).scheduler) {
              await (window as any).scheduler.postTask(loader, { priority: 'background' });
            } else if ('requestIdleCallback' in window) {
              await new Promise<void>((resolve) => {
                requestIdleCallback(async () => {
                  await loader();
                  resolve();
                }, { timeout: 5000 });
              });
            } else {
              // Fallback with setTimeout
              await new Promise<void>((resolve) => {
                setTimeout(async () => {
                  await loader();
                  resolve();
                }, 16); // ~1 frame
              });
            }
          } catch (error) {
            console.warn('Three.js loader failed:', error);
          }
        }
        
        // Yield control between loads
        await this.yieldToMain();
      }
      
      this.isProcessing = false;
    }

    private yieldToMain(): Promise<void> {
      return new Promise(resolve => {
        if ('scheduler' in window && 'postTask' in (window as any).scheduler) {
          (window as any).scheduler.postTask(resolve, { priority: 'background' });
        } else {
          setTimeout(resolve, 0);
        }
      });
    }

    public queueThreeJSInit(canvasId: string, initFunction: () => Promise<void>): void {
      // Prevent duplicate loading
      if (this.loadedCanvases.has(canvasId)) {
        return;
      }

      this.loadedCanvases.add(canvasId);
      
      const wrappedFunction = async () => {
        try {
          const canvas = document.getElementById(canvasId);
          if (!canvas) return;

          // Check if canvas is in viewport before loading
          const rect = canvas.getBoundingClientRect();
          const isInViewport = rect.top < window.innerHeight && rect.bottom > 0;
          
          if (!isInViewport) {
            // Use intersection observer for lazy loading
            return new Promise<void>((resolve) => {
              const observer = new IntersectionObserver((entries) => {
                entries.forEach(async (entry) => {
                  if (entry.isIntersecting) {
                    observer.disconnect();
                    await initFunction();
                    resolve();
                  }
                });
              }, { rootMargin: '100px' });
              
              observer.observe(canvas);
            });
          } else {
            await initFunction();
          }
        } catch (error) {
          console.warn(`Failed to load Three.js for ${canvasId}:`, error);
        }
      };

      this.loadQueue.push(wrappedFunction);
      
      // Start processing if not already running
      if (!this.isProcessing) {
        this.processQueue();
      }
    }

    public createOptimizedThreeJS(canvasId: string, options: {
      particleCount?: number;
      enableShaders?: boolean;
      enableMouse?: boolean;
    } = {}): void {
      const initFunction = async () => {
        try {
          const canvas = document.getElementById(canvasId) as HTMLCanvasElement;
          if (!canvas) return;

          // WebGL capability check
          const gl = canvas.getContext('webgl') || canvas.getContext('experimental-webgl');
          if (!gl) {
            console.warn('WebGL not supported, skipping Three.js');
            canvas.style.display = 'none';
            return;
          }

          // Performance settings
          const isMobile = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);
          const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          
          // Load Three.js dynamically
          let THREE;
          try {
            THREE = await import('https://unpkg.com/three@0.180.0/build/three.module.js');
          } catch {
            THREE = await import('three');
          }

          const renderer = new THREE.WebGLRenderer({
            canvas,
            antialias: !isMobile,
            alpha: true,
            powerPreference: isMobile ? 'low-power' : 'high-performance'
          });

          const scene = new THREE.Scene();
          const camera = new THREE.PerspectiveCamera(55, 2, 0.1, 100);
          camera.position.set(0, 0, 4.2);

          // Optimized resize with debouncing
          let resizeTimeout: number;
          const resize = () => {
            clearTimeout(resizeTimeout);
            resizeTimeout = window.setTimeout(() => {
              const { clientWidth: w, clientHeight: h } = canvas;
              if (canvas.width !== w || canvas.height !== h) {
                renderer.setSize(w, h, false);
                camera.aspect = w / h;
                camera.updateProjectionMatrix();
              }
            }, 16);
          };

          resize();
          new ResizeObserver(resize).observe(canvas);
          renderer.setPixelRatio(Math.min(isMobile ? 1.5 : 2, window.devicePixelRatio || 1));

          // Create optimized particle system
          const particleCount = options.particleCount || (isMobile ? 300 : (prefersReducedMotion ? 150 : 600));
          const geometry = new THREE.BufferGeometry();
          const positions = new Float32Array(particleCount * 3);

          for (let i = 0; i < particleCount; i++) {
            const i3 = i * 3;
            positions[i3] = (Math.random() - 0.5) * 14;
            positions[i3 + 1] = (Math.random() - 0.5) * 8;
            positions[i3 + 2] = -(Math.random() * 6 + 1);
          }

          geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));

          const particleMaterial = new THREE.PointsMaterial({
            color: 0xffe7d0,
            size: isMobile ? 0.01 : 0.015,
            transparent: true,
            opacity: prefersReducedMotion ? 0.3 : 0.6,
            blending: THREE.AdditiveBlending,
            depthWrite: false
          });

          const particles = new THREE.Points(geometry, particleMaterial);
          scene.add(particles);

          // Mouse tracking (optional)
          const mouse = new THREE.Vector2();
          if (options.enableMouse) {
            let mouseUpdateId = 0;
            const updateMouse = (e: PointerEvent) => {
              cancelAnimationFrame(mouseUpdateId);
              mouseUpdateId = requestAnimationFrame(() => {
                mouse.x = (e.clientX / window.innerWidth) * 2 - 1;
                mouse.y = -(e.clientY / window.innerHeight) * 2 + 1;
              });
            };
            window.addEventListener('pointermove', updateMouse, { passive: true });
          }

          // Optimized animation loop
          const clock = new THREE.Clock();
          let animationId: number;
          const targetFPS = isMobile ? 30 : 60;
          const frameInterval = 1000 / targetFPS;
          let lastTime = performance.now();

          const animate = () => {
            animationId = requestAnimationFrame(animate);

            const currentTime = performance.now();
            const deltaTime = currentTime - lastTime;

            if (deltaTime < frameInterval) return;

            const dt = clock.getDelta();

            // Simple camera movement
            if (options.enableMouse) {
              const cameraSpeed = prefersReducedMotion ? 0.01 : (isMobile ? 0.02 : 0.03);
              camera.position.x += (mouse.x * 0.3 - camera.position.x) * cameraSpeed;
              camera.position.y += (-mouse.y * 0.2 - camera.position.y) * cameraSpeed;
              camera.lookAt(0, 0, 0);
            }

            // Particle rotation
            if (!prefersReducedMotion) {
              particles.rotation.y += dt * (isMobile ? 0.005 : 0.01);
            }

            renderer.render(scene, camera);
            lastTime = currentTime;
          };

          animate();

          // Cleanup
          window.addEventListener('beforeunload', () => {
            cancelAnimationFrame(animationId);
            renderer.dispose();
            geometry.dispose();
            particleMaterial.dispose();
          });

        } catch (error) {
          console.warn(`Three.js initialization failed for ${canvasId}:`, error);
          const canvas = document.getElementById(canvasId);
          if (canvas) canvas.style.display = 'none';
        }
      };

      this.queueThreeJSInit(canvasId, initFunction);
    }
  }

  // Export for global use
  (window as any).OptimizedThreeLoader = OptimizedThreeLoader;
  (window as any).threeLoader = OptimizedThreeLoader.getInstance();
</script>
