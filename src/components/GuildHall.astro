---
// Guild Hall Component - Works with existing cis.json data
interface Artist {
  name: string;
  slug: string;
  positioning: string;
  specialties: string[];
  avatar: string;
  cta: {
    text: string;
    url: string;
  };
}

export interface Props {
  artists: Artist[];
  title?: string;
}

const { artists, title = "Meet Our Guild" } = Astro.props;

// Add guild-specific data mapping
const guildMembers = artists.map(artist => ({
  ...artist,
  guildRole: getGuildRole(artist.specialties),
  guildStats: {
    creativity: Math.floor(Math.random() * 20) + 80, // 80-100
    experience: Math.floor(Math.random() * 15) + 85, // 85-100
    mastery: Math.floor(Math.random() * 10) + 90     // 90-100
  }
}));

function getGuildRole(specialties: string[]) {
  const roleMap: Record<string, string> = {
    'Traditional': 'Guild Master',
    'Naturalistic American Traditional': 'Guild Master',
    'Color': 'Chromancer',
    'Black & Grey': 'Shadow Weaver',
    'Realism': 'Reality Bender',
    'Neo-Traditional': 'Modern Mystic',
    'Japanese': 'Eastern Sage',
    'Naturalistic Japanese': 'Eastern Sage',
    'Newschool': 'Modern Mystic',
    'Geometric': 'Pattern Keeper',
    'Illustrative': 'Vision Scribe'
  };
  return roleMap[specialties[0]] || 'Artisan';
}
---

<div class="guild-hall">
  <div class="guild-header">
    <h1 class="guild-title">{title}</h1>
    <p class="guild-subtitle">Choose your artisan for your next legendary piece</p>
  </div>
  
  <div class="tavern-background">
    <div class="character-roster">
      {guildMembers.map((artist) => (
        <div class="guild-member" data-specialty={artist.specialties[0]}>
          <div class="character-portrait">
            <img src={artist.avatar} alt={artist.name} loading="lazy" />
            <div class="class-badge">{artist.guildRole}</div>
          </div>
          
          <div class="character-info">
            <h3 class="character-name">{artist.name}</h3>
            <p class="character-specialty">{artist.positioning}</p>
            
            <div class="skill-bars">
              <div class="skill">
                <span class="skill-name">Creativity</span>
                <div class="skill-bar">
                  <div class="skill-fill" style={`width: ${artist.guildStats.creativity}%`}></div>
                </div>
                <span class="skill-value">{artist.guildStats.creativity}</span>
              </div>
              
              <div class="skill">
                <span class="skill-name">Experience</span>
                <div class="skill-bar">
                  <div class="skill-fill" style={`width: ${artist.guildStats.experience}%`}></div>
                </div>
                <span class="skill-value">{artist.guildStats.experience}</span>
              </div>
              
              <div class="skill">
                <span class="skill-name">Mastery</span>
                <div class="skill-bar">
                  <div class="skill-fill" style={`width: ${artist.guildStats.mastery}%`}></div>
                </div>
                <span class="skill-value">{artist.guildStats.mastery}</span>
              </div>
            </div>
          </div>
          
          <div class="character-actions">
            <a href={`/artists/${artist.slug}`} class="select-character">
              View Portfolio
            </a>
            <a href={artist.cta.url} class="contact-character" target="_blank" rel="noopener">
              Contact Artist
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</div>

<style>
  .guild-hall {
    background: linear-gradient(135deg, var(--bg0) 0%, #1a0b0b 100%);
    min-height: 100vh;
    padding: 2rem 1rem;
    position: relative;
    overflow: hidden;
  }

  .guild-hall::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-image: 
      radial-gradient(circle at 20% 50%, rgba(212, 175, 55, 0.05) 0%, transparent 50%),
      radial-gradient(circle at 80% 20%, rgba(220, 20, 60, 0.05) 0%, transparent 50%);
    pointer-events: none;
  }

  .guild-header {
    text-align: center;
    margin-bottom: 3rem;
    position: relative;
    z-index: 2;
  }

  .guild-title {
    font-size: clamp(2.5rem, 5vw, 4rem);
    color: var(--gold);
    margin-bottom: 1rem;
    text-shadow: 2px 2px 4px rgba(0,0,0,0.8);
    font-weight: 700;
  }

  .guild-subtitle {
    font-size: 1.2rem;
    color: var(--ink);
    opacity: 0.8;
    max-width: 600px;
    margin: 0 auto;
  }

  .tavern-background {
    position: relative;
    z-index: 1;
  }

  .character-roster {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: 2rem;
    max-width: 1400px;
    margin: 0 auto;
  }

  .guild-member {
    background: linear-gradient(145deg, #2a1a1a, #1a0f0f);
    border: 2px solid var(--gold);
    border-radius: 20px;
    padding: 2rem;
    position: relative;
    transform: perspective(1000px) rotateX(2deg);
    transition: var(--transition-smooth);
    box-shadow: 
      0 15px 35px rgba(0,0,0,0.4),
      inset 0 1px 0 rgba(212, 175, 55, 0.2);
    overflow: hidden;
  }

  .guild-member::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(45deg, transparent, rgba(212, 175, 55, 0.03), transparent);
    pointer-events: none;
  }

  .guild-member:hover {
    transform: perspective(1000px) rotateX(0deg) translateY(-10px);
    box-shadow: 
      0 25px 50px rgba(0,0,0,0.6),
      0 0 30px rgba(212, 175, 55, 0.2),
      inset 0 1px 0 rgba(212, 175, 55, 0.3);
    border-color: var(--accent0);
  }

  .character-portrait {
    position: relative;
    width: 120px;
    height: 120px;
    margin: 0 auto 1.5rem;
  }

  .character-portrait img {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    border: 4px solid var(--gold);
    object-fit: cover;
    filter: sepia(10%) contrast(1.1);
    transition: var(--transition-smooth);
  }

  .guild-member:hover .character-portrait img {
    border-color: var(--accent0);
    filter: sepia(20%) contrast(1.2);
  }

  .class-badge {
    position: absolute;
    bottom: -8px;
    right: -8px;
    background: linear-gradient(45deg, var(--accent0), var(--gold));
    color: white;
    padding: 0.4rem 0.8rem;
    border-radius: 15px;
    font-size: 0.75rem;
    font-weight: bold;
    text-transform: uppercase;
    border: 2px solid #1a0f0f;
    letter-spacing: 0.5px;
  }

  .character-info {
    text-align: center;
    margin-bottom: 1.5rem;
  }

  .character-name {
    color: var(--gold);
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
    text-shadow: 1px 1px 2px rgba(0,0,0,0.7);
  }

  .character-specialty {
    color: var(--ink);
    opacity: 0.8;
    font-size: 0.95rem;
    margin-bottom: 1rem;
  }

  .skill-bars {
    margin: 1.5rem 0;
  }

  .skill {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .skill-name {
    color: var(--gold);
    font-size: 0.85rem;
    min-width: 80px;
    text-align: left;
  }

  .skill-bar {
    flex: 1;
    background: #1a0f0f;
    height: 10px;
    border-radius: 5px;
    overflow: hidden;
    border: 1px solid var(--gold);
    position: relative;
  }

  .skill-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--accent0), var(--gold));
    transition: width 1s ease-out;
    border-radius: 4px;
    position: relative;
  }

  .skill-fill::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
    animation: shimmer 2s ease-in-out infinite;
  }

  @keyframes shimmer {
    0% { transform: translateX(-100%); }
    100% { transform: translateX(100%); }
  }

  .skill-value {
    color: var(--gold);
    font-size: 0.8rem;
    font-weight: bold;
    min-width: 30px;
    text-align: right;
  }

  .character-actions {
    display: flex;
    gap: 1rem;
    flex-direction: column;
  }

  .select-character,
  .contact-character {
    padding: 0.75rem 1.5rem;
    border: none;
    border-radius: 10px;
    font-weight: bold;
    text-transform: uppercase;
    cursor: pointer;
    transition: var(--transition-smooth);
    text-decoration: none;
    text-align: center;
    font-size: 0.9rem;
    letter-spacing: 0.5px;
    position: relative;
    overflow: hidden;
  }

  .select-character {
    background: linear-gradient(45deg, var(--accent0), var(--gold));
    color: white;
  }

  .contact-character {
    background: linear-gradient(45deg, #1a0f0f, #2a1a1a);
    color: var(--gold);
    border: 2px solid var(--gold);
  }

  .select-character::before,
  .contact-character::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
    transition: left 0.5s ease;
  }

  .select-character:hover::before,
  .contact-character:hover::before {
    left: 100%;
  }

  .select-character:hover {
    background: linear-gradient(45deg, var(--gold), #ffd700);
    transform: translateY(-2px);
    box-shadow: var(--glow-primary);
  }

  .contact-character:hover {
    background: linear-gradient(45deg, var(--gold), #ffd700);
    color: #1a0f0f;
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(212, 175, 55, 0.3);
  }

  /* Mobile Responsiveness */
  @media (max-width: 768px) {
    .guild-hall {
      padding: 1rem 0.5rem;
    }

    .character-roster {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .guild-member {
      transform: none;
      padding: 1.5rem;
    }

    .guild-member:hover {
      transform: translateY(-5px);
    }

    .character-actions {
      flex-direction: column;
      gap: 0.75rem;
    }
  }

  /* Reduced motion accessibility */
  @media (prefers-reduced-motion: reduce) {
    .guild-member {
      transition: none;
      transform: none;
    }
    
    .skill-fill {
      transition: none;
    }
    
    .skill-fill::after {
      animation: none;
    }
  }
</style>
